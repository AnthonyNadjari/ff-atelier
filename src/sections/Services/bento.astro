---
/** Services "bento" : grille bento, les services vedettes prennent 4/6 colonnes sur 2 rangees. */
import { site } from '@/lib/site';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';

let usedFirstImage = false;
---

<section id="services" class="section-y bg-bg-2">
  <div class="container-ff">
    <SectionHeading eyebrow="Ce que nous faisons" title="Nos services" text={`${site.business.trade} à ${site.contact.address.city} et alentours.`} />
    <ul class="mt-14 grid grid-cols-2 lg:grid-cols-6 auto-rows-[minmax(180px,auto)] gap-5" data-stagger="80">
      {site.services.map((s) => {
        const big = s.featured && !usedFirstImage && !!s.image;
        if (s.featured && s.image) usedFirstImage = true;
        return (
          <li class:list={['group relative col-span-2 overflow-hidden rounded-card bg-surface shadow-card', big && 'lg:col-span-4 lg:row-span-2']}>
            <a href={`/services/${s.slug}`} class="flex h-full flex-col">
              {big ? (
                <figure class="relative min-h-[220px] flex-1">
                  <img src={s.image!.src} alt={s.image!.alt} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
                  <div class="absolute inset-0 bg-gradient-to-t from-ink/80 to-transparent"></div>
                  <div class="absolute inset-x-0 bottom-0 p-6 text-on-ink">
                    <h3 class="text-display-sm">{s.title}</h3>
                    <p class="mt-2 max-w-md text-sm opacity-85">{s.short}</p>
                    {s.priceFrom && <p class="mt-2 text-sm opacity-70">{s.priceFrom}</p>}
                  </div>
                </figure>
              ) : (
                <div class="flex h-full flex-col p-6">
                  <div class="flex h-11 w-11 items-center justify-center rounded-ui bg-accent/10 text-accent">
                    <Icon name={s.icon} size={22} />
                  </div>
                  <h3 class="mt-5 text-display-sm">{s.title}</h3>
                  <p class="mt-2 flex-1 text-sm text-muted">{s.short}</p>
                  {s.priceFrom && <p class="mt-3 text-xs font-medium">{s.priceFrom}</p>}
                  <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-accent">
                    En savoir plus <Icon name="ArrowRight" size={14} class="transition-transform group-hover:translate-x-1" />
                  </span>
                </div>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
