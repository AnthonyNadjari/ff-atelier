---
/** Services "list" : liste verticale numerotee, filets entre les lignes, fleche qui glisse au survol. */
import { site } from '@/lib/site';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
---

<section id="services" class="section-y">
  <div class="container-ff">
    <SectionHeading eyebrow="Ce que nous faisons" title="Nos services" text={`${site.business.trade} à ${site.contact.address.city} et alentours.`} />
    <ul class="mt-14 border-t border-line" data-stagger="80">
      {site.services.map((s, i) => (
        <li class="group border-b border-line">
          <a
            href={`/services/${s.slug}`}
            class="grid grid-cols-[auto_1fr] md:grid-cols-[auto_1fr_1fr] items-baseline md:items-center gap-x-6 gap-y-2 py-7"
          >
            <span class="eyebrow">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-display-sm">{s.title}</h3>
            <div class="col-span-2 md:col-span-1 flex items-center justify-between gap-4 md:justify-end">
              <p class="text-muted max-w-sm md:text-right">
                {s.short}
                {s.priceFrom && <span class="text-fg"> — {s.priceFrom}</span>}
              </p>
              <Icon
                name="ArrowRight"
                size={20}
                class="shrink-0 text-accent transition-transform duration-500 ease-out-expo group-hover:translate-x-2"
              />
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
