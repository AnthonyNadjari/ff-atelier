---
/**
 * Services "buvard" (geste signature du style buvard, relevé sur florawellnesscafe.com le 30 oct 2026, fiche
 * docs/veille/styles/buvard.md § Construction, bloc 3 « Explore our menu ») : LA CARTE EN COLONNES, COMME IMPRIMÉE.
 * À gauche (3/12), le titre de la section (wording.servicesTitle) en caslon, la phrase d'introduction (wording.servicesIntro,
 * sinon le métier à la ville) et, dessous, la photo de la prestation phare (featured, sinon la première qui a une photo),
 * verticale 4:5 ; à droite (colonnes 5 à 12), les rubriques en deux colonnes (une au téléphone) : chaque rubrique a son
 * titre en caslon gras (lien vers sa page), puis ses lignes de carte (services[].lignes) en machine à écrire, en
 * capitales courtes : le nom à gauche, le prix aligné à droite sur la même ligne, le détail en petit dessous. Une rubrique
 * sans lignes montre sa phrase courte et ses points. Puis le filet tremblé.
 * Mouvement (profil « filet-qui-se-trace ») : les rubriques apparaissent en fondu (data-reveal, 60 ms entre elles) ; les
 * liens changent de rouge en 0,4 s linéaire ; rien ne suit le défilement.
 * Rien d'inventé : un prix absent laisse la ligne sans prix ; jamais de pointillés, d'icônes ou de coches.
 */
import { site, metierEtVille } from '@/lib/site';
import Img from '@/components/Img.astro';
import Titre from '@/components/Titre.astro';
import FiletTremble from '@/components/FiletTremble.astro';

const services = site.services;
const intro = site.wording.servicesIntro ?? metierEtVille();
const phare = services.find((s) => s.featured && s.image) ?? services.find((s) => s.image);
---

<section id="services" class="buvard-large pt-[var(--section-y)]" aria-labelledby="buvard-carte-titre">
  <div class="grid gap-10 md:grid-cols-12 md:gap-x-10">
    <div class="md:col-span-3">
      <Titre id="buvard-carte-titre" class="buvard-titre" title={site.wording.servicesTitle} />
      <p class="mt-3 max-w-[34ch] text-[0.9375rem] leading-snug">{intro}</p>
      {phare && (
        <a href={`/services/${phare.slug}`} class="mt-6 block">
          <figure class="relative m-0 aspect-[4/5] overflow-hidden">
            <Img src={phare.image!.src} alt={phare.image!.alt} class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 48rem) 24vw, 92vw" loading="lazy" />
          </figure>
        </a>
      )}
    </div>
    <div class="buvard-rubriques md:col-span-8 md:col-start-5" data-stagger="60">
      {services.map((s) => (
        <div class="buvard-rubrique" data-reveal>
          <h3 class="buvard-rubrique-titre"><a href={`/services/${s.slug}`} class="buvard-lien">{s.title}</a></h3>
          {s.lignes.length > 0 ? (
            <ul class="mt-3 grid gap-2">
              {s.lignes.map((l) => (
                <li class="buvard-ligne">
                  <span class="buvard-nom font-[family-name:var(--font-mono)]">{l.nom}</span>
                  {l.prix && <span class="buvard-prix font-[family-name:var(--font-mono)]">{l.prix}</span>}
                  {l.detail && <span class="buvard-detail font-[family-name:var(--font-mono)]">{l.detail}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <>
              <p class="mt-3 text-[0.9375rem] leading-snug">{s.short}</p>
              {s.bullets.length > 0 && <p class="buvard-detail font-[family-name:var(--font-mono)] mt-2">{s.bullets.join(', ')}</p>}
              {s.priceFrom && <p class="buvard-prix font-[family-name:var(--font-mono)] mt-2">{s.priceFrom}</p>}
            </>
          )}
        </div>
      ))}
    </div>
  </div>
  <FiletTremble class="mt-14 md:mt-16" variante={1} />
</section>

<style>
  .buvard-large { width: 100%; padding-inline: clamp(1.25rem, 2.8vw, 2.5rem); }
  .buvard-titre { font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem); line-height: 1.02; }
  .buvard-rubriques { display: grid; gap: 2.75rem 3.5rem; align-content: start; }
  @media (min-width: 40rem) { .buvard-rubriques { grid-template-columns: 1fr 1fr; } }
  .buvard-rubrique-titre { font-size: 1.25rem; font-weight: 400; }
  .buvard-lien { transition: color var(--motion-ui) var(--ease-brand); }
  .buvard-lien:hover { color: var(--accent); }
  .buvard-ligne { display: grid; grid-template-columns: 1fr auto; column-gap: 1rem; align-items: baseline; }
  .buvard-nom, .buvard-prix { font-size: 0.8125rem; text-transform: uppercase; line-height: 1.3; }
  .buvard-prix { text-align: right; white-space: nowrap; }
  .buvard-detail { grid-column: 1 / -1; font-size: 0.75rem; line-height: 1.3; color: var(--muted); }
</style>
