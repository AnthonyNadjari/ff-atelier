---
/**
 * Services "enduit" (geste signature du style enduit, relevé sur bcgbuildingdesign.com.au le 29 oct 2026, fiche
 * docs/veille/styles/enduit.md § Construction, bloc 4 « Featured Works ») : L'INDEX DES PRESTATIONS DONT LA LIGNE
 * SURVOLÉE MONTRE SA PHOTO. Sur le crème, une petite étiquette (le titre de section, puis le métier à la ville), puis la
 * liste pleine largeur : une ligne par service, séparée par un filet, avec son numéro (01, 02…) et son nom à gauche, son
 * prix « à partir de » à droite s'il est donné ; la ligne active est à l'encre pleine et son filet se trace en brun de
 * gauche à droite, les autres restent en second plan. AU MILIEU de la liste, posée PAR-DESSUS les lignes (colonnes 5 à
 * 8 sur 12, verticale 4:5, plus haute que la liste), la photo de la ligne active : au survol ou au focus clavier d'une
 * ligne, sa photo remplace la précédente (fondu 0,4 s, courbe de la source ; les photos de toutes les lignes sont déjà
 * là, superposées). Chaque ligne est un lien vers la page du service.
 * Au téléphone (la source fait pareil) : rien ne se survole, chaque service montre SA photo pleine largeur au-dessus de
 * sa ligne (numéro, nom, prix) : une pile de photos et de lignes, aucun script.
 * Profil « index-qui-change-la-photo » (docs/veille/styles/MOUVEMENTS.md) : opacité seule et un filet en scaleX, au
 * geste, jamais au défilement (tient sur iPhone) ; en mouvement réduit, la photo change sans fondu.
 * Sous l'index, le bloc « approche » de la source : la prestation phare (featured, avec photo et texte long) en phrase
 * de grand corps, sa photo sur 8/12 et son texte dans la colonne de droite ; sans elle, rien.
 * Rien d'inventé : sans photo pour aucun service, la liste reste seule, pleine largeur ; une ligne sans photo garde la
 * photo précédente au survol ; jamais d'icône à la place d'une photo.
 */
import { site, metierEtVille, paragraphs } from '@/lib/site';
import Button from '@/components/Button.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Img from '@/components/Img.astro';

const services = site.services;
const avecPhoto = services.filter((s) => s.image);
const numero = (i: number) => String(i + 1).padStart(2, '0');
// Bloc « approche » de la source (bloc 5) : la prestation phare du client, si elle a une photo et un texte long.
const phare = services.find((s) => s.featured && s.image && s.description);
const phareTexte = phare?.description ? paragraphs(phare.description)[0] : '';
---

<div id="services" class="enduit-services">
<section class="enduit-index section-y" data-index-photo>
  <div class="enduit-large">
    <SectionHeading title={site.wording.servicesTitle} text={metierEtVille()} class="[&_h2]:text-base [&_h2]:font-medium md:[&_h2]:text-lg [&_p]:mt-0 [&_p]:text-base [&_p]:text-muted" />
  </div>
  <div class="relative mt-14 md:mt-24">
    {avecPhoto.length > 0 && (
      <div class="enduit-cadre pointer-events-none absolute z-10 left-1/2 top-1/2 hidden w-[28%] -translate-x-1/2 -translate-y-1/2 md:block" aria-hidden="true">
        <div class="relative aspect-[0.8] w-full overflow-hidden">
          {avecPhoto.map((s, i) => (
            <div class:list={['enduit-vue absolute inset-0', i === 0 && 'est-active']} data-vue={s.slug}>
              <Img src={s.image!.src} alt="" class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 76rem) 400px, 28vw" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    )}
    <ol class:list={['enduit-large', avecPhoto.length > 0 && 'enduit-liste-haute md:flex md:flex-col md:justify-center']}>
      {services.map((s, i) => (
        <li class:list={['enduit-ligne', i === 0 && 'est-active']} data-ligne={s.image ? s.slug : undefined}>
          {s.image && (
            <figure class="relative mb-4 aspect-[0.8] overflow-hidden md:hidden">
              <Img src={s.image.src} alt={s.image.alt} class="absolute inset-0 h-full w-full object-cover" sizes="92vw" loading="lazy" />
            </figure>
          )}
          <a href={`/services/${s.slug}`} class="enduit-lien-ligne relative grid grid-cols-[3rem_1fr_auto] items-baseline gap-x-4 py-4 md:grid-cols-12 md:gap-x-6">
            <span class="text-sm md:col-span-1">{numero(i)}</span>
            <h3 class="text-base font-medium md:col-span-3 md:text-lg">{s.title}</h3>
            <span class="text-right text-sm md:col-span-3 md:col-start-10">{s.priceFrom ?? 'Voir'}</span>
            <span class="enduit-filet absolute inset-x-0 bottom-0" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
{phare && (
  <section class="enduit-phare pb-[var(--section-y)]" aria-label={phare.title}>
    <div class="enduit-large grid gap-8 md:grid-cols-12 md:gap-6">
      <h3 id={`enduit-phare-${phare.slug}`} class="enduit-phare-titre md:col-span-7">{phare.short}</h3>
      <figure class="relative aspect-[4/3] overflow-hidden md:col-span-8">
        <Img src={phare.image!.src} alt={phare.image!.alt} class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 48rem) 66vw, 92vw" loading="lazy" />
      </figure>
      <div class="text-sm leading-relaxed md:col-span-3 md:col-start-10 md:text-base">
        <p class="font-medium">{phare.title}</p>
        <p class="mt-3">{phareTexte}</p>
        <div class="mt-8"><Button href={`/services/${phare.slug}`} variant="ghost" size="sm" class="w-full">Voir la prestation</Button></div>
      </div>
    </div>
  </section>
)}
</div>

<script>
  import { onPage } from '@/scripts/page';
  // Index : la ligne survolée (ou atteinte au clavier) devient active et montre sa photo. Ordinateur seulement (la
  // photo du milieu est cachée au téléphone, où chaque ligne a la sienne).
  onPage(() => {
    document.querySelectorAll<HTMLElement>('[data-index-photo]').forEach((bloc) => {
      const lignes = [...bloc.querySelectorAll<HTMLElement>('.enduit-ligne')];
      const vues = [...bloc.querySelectorAll<HTMLElement>('[data-vue]')];
      const activer = (ligne: HTMLElement) => {
        lignes.forEach((l) => l.classList.toggle('est-active', l === ligne));
        const slug = ligne.dataset.ligne;
        if (slug) vues.forEach((v) => v.classList.toggle('est-active', v.dataset.vue === slug));
      };
      lignes.forEach((l) => {
        l.addEventListener('pointerenter', () => activer(l));
        l.addEventListener('focusin', () => activer(l));
      });
    });
  });
</script>

<style>
  /* Cadre de la source : toute la largeur de l'écran, marge de 16 à 28 px (gouttière mesurée 22 px à 1 440 px). */
  .enduit-large { width: 100%; padding-inline: clamp(1rem, 1.6vw, 1.75rem); }
  /* Ordinateur : la liste est au moins aussi haute que la photo du milieu (4:5 de 28 % de la largeur), qui la déborde. */
  @media (min-width: 48rem) {
    .enduit-liste-haute { min-height: calc(28vw * 1.25 + 6rem); }
    .enduit-ligne { color: var(--muted); }
    .enduit-ligne.est-active { color: var(--fg); }
  }
  .enduit-lien-ligne { transition: color var(--motion-ui) var(--ease-brand); }
  .enduit-lien-ligne::before { content: ''; position: absolute; inset-inline: 0; bottom: 0; border-bottom: 1px solid var(--line); }
  .enduit-filet { height: 1px; background: var(--fg); transform: scaleX(0); transform-origin: left; transition: transform var(--motion-duration) var(--ease-brand); }
  .est-active .enduit-filet { transform: scaleX(1); }
  .enduit-vue { opacity: 0; transition: opacity var(--motion-ui) var(--ease-brand); }
  .enduit-vue.est-active { opacity: 1; }
  .enduit-phare-titre { font-size: clamp(1.4rem, 1.1rem + 1.1vw, 2.1rem); line-height: 1.08; font-weight: 500; max-width: 26ch; }
  @media (prefers-reduced-motion: reduce) {
    .enduit-vue, .enduit-filet { transition: none; }
  }
  .enduit-cadre :global(.ff-illustration) { top: 0.5rem; bottom: auto; }
</style>
