---
/**
 * Services "pinceau" (geste signature du style pinceau, relevé sur pickyjoe.com, Coyot Bar à Montpellier, le 29 oct 2026 ;
 * fiche docs/veille/styles/pinceau.md § Construction) : la page devient une PILE DE BANDES DE COULEUR pleine largeur
 * dont chaque frontière est un BORD BROSSÉ (BordPinceau : coup de pinceau ondulé, éclats et traits secs).
 * 1. Bande terracotta (--accent, celle qui monte du premier écran) : à gauche (6/12) le titre de la section, la phrase
 *    du client (wording.servicesIntro, sinon métier à ville) et sa présentation (business.description) ; à droite (5/12),
 *    avec le hero pinceau, la PHOTO DU LIEU (images.hero, 4:5, ombre portée) qui chevauche le bord brossé, moitié sur le
 *    bleu du premier écran, et POSÉE SUR SON COIN bas gauche, la plaque des horaires : carte sable à filet moutarde épais et ombre portée, « Horaires d'ouverture », puis chaque ligne de
 *    contact.hours (les jours en capitales condensées, les heures en terracotta). Sans horaires, pas de plaque.
 * 2. Une bande par prestation, couleurs en rotation sable (--bg-2), moutarde (--fill), clair (--bg) ; une prestation
 *    qui a des lignes à prix (services[].lignes) prend la bande bleu nuit (--ink) et devient une CARTE : rubrique en
 *    capitales, filet hachuré terracotta, chaque ligne avec ses points de conduite jusqu'au prix, le détail dessous en
 *    petit. Dans chaque bande, tout est centré : nom en capitales condensées (plus petit que le h1), phrase courte en
 *    chasse fixe, « à partir de » s'il est donné, puis les photos du service (services[].image + images, quatre au
 *    plus : une seule = large 16:9 ; plusieurs = rangée 4:5), et le bouton vers sa page.
 * 3. Un dernier bord brossé rend la main au fond de page.
 * Au téléphone : tout s'empile, la plaque passe sous le texte, les photos en deux colonnes.
 * Rien d'inventé : pas de photo = pas de rangée ; pas de lignes = pas de carte ; pas de prix = pas de prix.
 * Mouvement (profil `bandes-au-pinceau`, docs/veille/styles/MOUVEMENTS.md) : les traits détachés de chaque bord se
 * brossent de gauche à droite à l'entrée (data-reveal="wipe", 0,6 s) ; la plaque se pose (data-reveal="up") ; boutons
 * en 0,15 s linéaire. Les titres ne bougent pas.
 */
import { site, paragraphs, metierEtVille } from '@/lib/site';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import Img from '@/components/Img.astro';
import BordPinceau from '@/components/BordPinceau.astro';
import { HERO_SIZES } from '@/lib/images';

type Ton = 'terre' | 'sable' | 'moutarde' | 'clair' | 'nuit';
const COULEUR: Record<Ton, string> = {
  terre: 'var(--accent)',
  sable: 'var(--bg-2)',
  moutarde: 'var(--fill, color-mix(in oklab, var(--accent) 28%, var(--bg)))',
  clair: 'var(--bg)',
  nuit: 'var(--ink)',
};
const rotation: Ton[] = ['sable', 'moutarde', 'clair'];
let r = 0;
let precedent: Ton = 'terre';
const bandes = site.services.map((s) => {
  let ton: Ton = s.lignes.length > 0 ? 'nuit' : rotation[r++ % rotation.length];
  if (ton === precedent && ton !== 'nuit') ton = rotation[r++ % rotation.length];
  const avant = precedent;
  precedent = ton;
  const photos = [s.image, ...s.images].filter(Boolean).slice(0, 4) as { src: string; alt: string }[];
  return { s, ton, avant, photos };
});
// La phrase du client sous le titre (servicesIntro, sinon métier à ville), puis sa présentation (business.description).
const intro = paragraphs(site.business.description);
const horaires = site.contact.hours;
// La photo du lieu (images.hero : le premier écran pinceau n'en met jamais derrière l'enseigne) monte sur le bord brossé.
const photoLieu = site.layout.hero === 'pinceau' ? site.images.hero : undefined;
const cote = Boolean(photoLieu) || horaires.length > 0;
---

<div id="services" class="pinceau-services relative">
  <section class="pb-bande pb-terre relative" aria-label={site.wording.servicesTitle.replace(/<[^>]+>/g, '')}>
    <div class:list={['container-ff grid gap-10 pb-[var(--section-y)] md:grid-cols-12 md:gap-8', cote ? 'pt-4 md:pt-0' : 'pt-[var(--section-y)]', !cote && 'text-center']}>
      <div class:list={['md:self-center', cote ? 'md:col-span-6 md:pt-[var(--section-y)]' : 'md:col-span-12 mx-auto max-w-3xl']}>
        <SectionHeading title={site.wording.servicesTitle} text={site.wording.servicesIntro ?? metierEtVille()} align={cote ? 'left' : 'center'} class="pb-tete [&_p]:font-mono [&_p]:text-base [&_p]:text-on-accent" />
        {intro.map((p) => <p class="mt-4 max-w-[62ch] font-mono">{p}</p>)}
      </div>
      {cote && (
        <div class:list={['pb-scene relative md:col-span-5 md:col-start-8', photoLieu && 'pb-scene-photo order-first md:order-none']}>
          {photoLieu && (
            <figure class="pb-lieu relative aspect-[4/5] overflow-hidden rounded-card">
              <Img src={photoLieu.src} alt={photoLieu.alt} class="absolute inset-0 h-full w-full object-cover" sizes={HERO_SIZES.pinceau} loading="eager" />
            </figure>
          )}
          {horaires.length > 0 && (
            <aside class="pb-plaque" aria-labelledby="pb-horaires" data-reveal="up">
              <h3 id="pb-horaires" class="font-display text-2xl md:text-3xl">Horaires d’ouverture</h3>
              <dl class="mt-4 space-y-3">
                {horaires.map((h) => (
                  <div>
                    <dt class="font-display text-xl uppercase tracking-wide">{h.days}</dt>
                    <dd class="pb-heures font-mono">{h.hours}</dd>
                  </div>
                ))}
              </dl>
            </aside>
          )}
        </div>
      )}
    </div>
  </section>

  {bandes.map(({ s, ton, avant, photos }, i) => (
    <section class:list={['pb-bande relative', `pb-${ton}`]} aria-labelledby={`pb-${s.slug}`}>
      <BordPinceau couleur={COULEUR[ton]} avant={COULEUR[avant]} forme={i + 1} />
      <div class="container-ff flex flex-col items-center py-[var(--section-y)] text-center">
        <h3 id={`pb-${s.slug}`} class="pb-nom font-display">
          <a href={`/services/${s.slug}`} class="hover:underline underline-offset-8">{s.title}</a>
        </h3>
        <p class="mt-5 max-w-[60ch] font-mono">{s.short}</p>
        {s.priceFrom && <p class="pb-prix mt-3 font-display text-xl uppercase">{s.priceFrom}</p>}

        {s.lignes.length > 0 && (
          <div class="mt-10 w-full max-w-4xl text-left">
            <hr class="rule w-56 max-w-full" />
            <ul class="mt-6 space-y-4">
              {s.lignes.map((l) => (
                <li>
                  <div class="flex items-baseline gap-3">
                    <span class="pb-ligne-nom font-display text-lg uppercase md:text-xl">{l.nom}</span>
                    <span class="pb-points flex-1" aria-hidden="true"></span>
                    {l.prix && <span class="pb-ligne-prix font-display text-lg md:text-xl">{l.prix}</span>}
                  </div>
                  {(l.detail || l.duree) && <p class="mt-1 font-mono text-sm">{[l.detail, l.duree].filter(Boolean).join(', ')}</p>}
                </li>
              ))}
            </ul>
          </div>
        )}

        {photos.length === 1 && (
          <figure class="pb-photo relative mt-12 aspect-[16/9] w-full max-w-4xl overflow-hidden rounded-card">
            <Img src={photos[0].src} alt={photos[0].alt} class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 64rem) 896px, 92vw" loading="lazy" />
          </figure>
        )}
        {photos.length > 1 && (
          <div class:list={['mt-12 grid w-full gap-3 md:gap-4', photos.length === 2 ? 'max-w-4xl grid-cols-2' : photos.length === 3 ? 'max-w-5xl grid-cols-2 md:grid-cols-3' : 'grid-cols-2 md:grid-cols-4']}>
            {photos.map((p) => (
              <figure class="pb-photo relative aspect-[4/5] overflow-hidden rounded-card">
                <Img src={p.src} alt={p.alt} class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 64rem) 300px, 46vw" loading="lazy" />
              </figure>
            ))}
          </div>
        )}

        <div class="mt-10">
          <Button href={`/services/${s.slug}`} variant={ton === 'nuit' || ton === 'clair' ? 'ghost' : 'ink'}>Voir la prestation</Button>
        </div>
      </div>
    </section>
  ))}

  <div class="relative h-px">
    <BordPinceau couleur="var(--bg)" avant={COULEUR[bandes.at(-1)?.ton ?? 'terre']} forme={bandes.length + 1} />
  </div>
</div>

<style>
  .pb-terre { background: var(--accent); color: var(--on-accent); }
  .pb-sable { background: var(--bg-2); color: var(--fg); }
  .pb-moutarde { background: var(--fill, color-mix(in oklab, var(--accent) 28%, var(--bg))); color: var(--on-fill, var(--fg)); }
  .pb-clair { background: var(--bg); color: var(--fg); }
  .pb-nuit { background: var(--ink); color: var(--on-ink); }
  .pb-nuit :is(.pb-nom, .pb-ligne-nom, .pb-ligne-prix, .pb-prix) { color: var(--fill, var(--on-ink)); }
  .pb-tete :global(h2) { font-size: clamp(2.3rem, 1.5rem + 3.2vw, 4.25rem); line-height: 1; }
  .pb-nom { font-size: clamp(2.1rem, 1.4rem + 2.9vw, 3.9rem); line-height: 1; font-weight: 700; letter-spacing: 0.01em; }
  /* La plaque : posée sur la terracotta, sable cerné de moutarde, vraie ombre portée (deux plans). */
  /* La photo du lieu chevauche le bord brossé (moitié sur le bleu du premier écran) ; la plaque chevauche la photo. */
  .pb-scene-photo { margin-top: -3rem; }
  @media (min-width: 48rem) { .pb-scene-photo { margin-top: calc(-1 * clamp(5rem, 10vw, 10rem)); } }
  .pb-lieu { box-shadow: 0 26px 48px -22px color-mix(in oklab, var(--ink) 75%, transparent); }
  .pb-scene-photo .pb-plaque { position: relative; margin: -4.5rem 1rem 0 -0.5rem; }
  @media (min-width: 48rem) { .pb-scene-photo .pb-plaque { position: absolute; left: -3.5rem; bottom: -2.5rem; margin: 0; width: min(19rem, 80%); } }
  .pb-plaque {
    background: var(--bg-2);
    color: var(--fg);
    border: 4px solid var(--fill, var(--line));
    border-radius: var(--radius-card);
    padding: 1.75rem 1.75rem 2rem;
    box-shadow: 0 22px 40px -18px color-mix(in oklab, var(--ink) 70%, transparent);
  }
  .pb-heures { color: var(--accent-2); font-weight: 600; }
  .pb-points { border-bottom: 2px dotted currentColor; opacity: 0.55; transform: translateY(-0.3em); }
  .pb-photo :global(.ff-illustration) { bottom: 0.5rem; }
  .pb-lieu :global(.ff-illustration) { top: 0.5rem; bottom: auto; }
</style>
