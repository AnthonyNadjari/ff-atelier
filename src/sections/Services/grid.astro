---
/** Services "grid" : cartes 3 colonnes, icone, titre, phrase, lien page service. */
import { site } from '@/lib/site';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
---

<section id="services" class="section-y bg-bg-2">
  <div class="container-ff">
    <SectionHeading eyebrow="Ce que nous faisons" title="Nos services" text={`${site.business.trade} à ${site.contact.address.city} et alentours.`} />
    <ul class="mt-14 grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-stagger="80">
      {site.services.map((s) => (
        <li class="card group rounded-card bg-surface p-7 shadow-card transition-transform duration-500 ease-out-expo hover:-translate-y-1" data-tilt="6">
          <div class="flex h-12 w-12 items-center justify-center rounded-ui bg-accent/10 text-accent"><Icon name={s.icon} size={24} /></div>
          <h3 class="mt-6 text-display-sm">{s.title}</h3>
          <p class="mt-3 text-muted">{s.short}</p>
          {s.priceFrom && <p class="mt-3 text-sm font-medium tabular-nums">{s.priceFrom}</p>}
          <a href={`/services/${s.slug}`} class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-accent">
            En savoir plus <Icon name="ArrowRight" size={16} class="transition-transform group-hover:translate-x-1" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
