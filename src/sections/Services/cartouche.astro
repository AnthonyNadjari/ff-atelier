---
/**
 * Services "cartouche" (style cartouche, relevé sur hotel-gilbert.at le 30 oct 2026, fiche docs/veille/styles/cartouche.md
 * § Construction, blocs 4 et 6, le geste signature) : UNE PHOTO PAR SERVICE ET SON CARTOUCHE POSÉ À CHEVAL SUR SON BORD.
 * Chaque service : sa photo (services[].image), large (8/12 à l'ordinateur, pleine largeur au téléphone) ; et par-dessus son
 * bord bas, décalé sur le côté (à droite puis à gauche, en quinconce), le CARTOUCHE : une plaque blanche à filet cobalt, le
 * titre en capitales étroites (h3), la phrase (short) à la machine à écrire, centrés, le prix s'il est donné ; et à cheval sur
 * le filet du bas de la plaque, le lien encadré « Voir » à longue flèche vers la page du service. Le cartouche se pose : il
 * monte de 24 px et s'éclaire quand il arrive à l'écran (0,4 s, courbe de la source, une fois ; profil
 * « cartouche-qui-se-pose »).
 * En tête : le titre de section en serif d'affiche en capitales, centré.
 * Rien d'inventé : un service sans photo garde son cartouche seul ; prix seulement s'il est donné ; aucune icône.
 */
import { site, metierEtVille } from '@/lib/site';
import Img from '@/components/Img.astro';
import Titre from '@/components/Titre.astro';

const services = site.services;
---

<section id="services" class="cartouche-services section-y" aria-labelledby="cartouche-services-titre">
  <Titre id="cartouche-services-titre" class="cartouche-h2 font-display px-4 text-center" title={site.wording.servicesTitle} />
  <p class="sr-only">{metierEtVille()}</p>
  <ul class="mt-12 flex flex-col gap-24 md:mt-16 md:gap-28">
    {services.map((s, i) => (
      <li class:list={['cartouche-svc', i % 2 === 1 && 'cartouche-svc-g', !s.image && 'cartouche-svc-nu']}>
        {s.image && (
          <div class="cartouche-svc-photo relative overflow-hidden">
            <Img src={s.image.src} alt={s.image.alt} class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 48rem) 66vw, 100vw" loading="lazy" />
          </div>
        )}
        <div class="cartouche-plaque" data-cartouche>
          <h3 class="cartouche-h3">{s.title}</h3>
          <p class="mt-4 text-base md:text-[1.0625rem]">{s.short}</p>
          {s.priceFrom && <p class="mt-3 text-fg">{s.priceFrom}</p>}
          <a href={`/services/${s.slug}`} class="cartouche-lien">Voir<span class="sr-only"> : {s.title}</span></a>
        </div>
      </li>
    ))}
  </ul>
</section>

<script>
  import { onPage } from '@/scripts/page';
  // Le cartouche se pose une fois, quand il arrive à l'écran. Sans script ou en mouvement réduit, il est en place
  // (l'état « pas encore posé » n'existe que sous la classe ajoutée ici).
  onPage(() => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.dataset.motion === 'none') return;
    const io = new IntersectionObserver((entrees) => {
      for (const e of entrees) if (e.isIntersecting) { e.target.classList.add('cartouche-pose'); io.unobserve(e.target); }
    }, { threshold: 0.25 });
    document.querySelectorAll<HTMLElement>('[data-cartouche]').forEach((c) => { c.classList.add('cartouche-attend'); io.observe(c); });
  });
</script>

<style>
  .cartouche-h2 { font-size: clamp(2.4rem, 1.6rem + 3vw, 4.5rem); line-height: 1; }
  .cartouche-h3 { font-size: clamp(1.9rem, 1.4rem + 1.4vw, 2.75rem); }
  .cartouche-svc { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .cartouche-svc-photo { grid-column: 1 / -1; grid-row: 1; aspect-ratio: 4 / 3; }
  .cartouche-plaque {
    position: relative; z-index: 1; grid-column: 2 / span 10; grid-row: 2; margin-top: -3.5rem;
    background: var(--surface); border: 1px solid var(--line); padding: 1.75rem 1.25rem 2.75rem; text-align: center;
  }
  .cartouche-svc-nu .cartouche-plaque { grid-row: 1; margin-top: 0; }
  @media (min-width: 48rem) {
    .cartouche-svc-photo { grid-column: 2 / span 8; aspect-ratio: 3 / 2; }
    .cartouche-plaque { grid-column: 8 / span 4; grid-row: 1; align-self: end; margin: 0 0 -3rem; padding: 2.25rem 1.75rem 3rem; }
    .cartouche-svc-g .cartouche-svc-photo { grid-column: 4 / span 8; }
    .cartouche-svc-g .cartouche-plaque { grid-column: 2 / span 4; }
    .cartouche-svc-nu .cartouche-plaque { grid-column: 4 / span 6; margin: 0; }
  }
  /* Le lien encadré, à cheval sur le filet du bas de la plaque, longue flèche au trait. */
  .cartouche-lien {
    position: absolute; left: 50%; bottom: 0; transform: translate(-50%, 50%);
    display: inline-flex; align-items: center; gap: 1rem; white-space: nowrap;
    border: 1px solid var(--line); background: var(--surface); color: var(--fg);
    padding: 0.6rem 1rem; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.02em;
  }
  .cartouche-lien::after { content: ''; width: 2.25rem; height: 1px; background: currentColor; transition: width var(--motion-ui) var(--ease-brand); }
  .cartouche-lien:hover::after, .cartouche-lien:focus-visible::after { width: 3.25rem; }
  /* La mention « Photo d’illustration » des démos passe en haut : le cartouche couvre le bas de la photo. */
  .cartouche-services :global(.ff-illustration) { top: 0.5rem; bottom: auto; }
  .cartouche-attend { opacity: 0; translate: 0 24px; transition: opacity var(--motion-duration) var(--ease-brand), translate var(--motion-duration) var(--ease-brand); }
  .cartouche-attend.cartouche-pose { opacity: 1; translate: 0 0; }
</style>
