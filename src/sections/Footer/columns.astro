---
/** Footer "columns" : nom + description, services, zones, coordonnees, mentions legales. */
import { site, tel, mailto, fullAddress, navLinks, hasCredits } from '@/lib/site';
import Icon from '@/components/Icon.astro';
import Horaires from '@/components/Horaires.astro';
const year = new Date().getFullYear();
const socials = Object.entries(site.social).filter(([, v]) => v) as [string, string][];
const iconFor: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'Linkedin', tiktok: 'Music2' };
// Sans section contact dans le layout (contact en tiroir seul, architecture accueil-portes), la colonne Contact porte
// id="contact" : sans script, les liens « /#contact » y mènent au lieu de remonter en haut de page (ff verifier).
const sansSectionContact = !site.layout.sections.some((s) => s.type === 'contact');
---

<footer class="bg-ink text-on-ink">
  <div class="container-ff py-16 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <p class="font-display text-2xl">{site.business.name}</p>
      <p class="mt-3 text-on-ink/70 text-sm max-w-xs">{site.business.trade} à {site.contact.address.city}. {site.business.certifications.length > 0 && site.business.certifications.join(', ')}</p>
      {socials.length > 0 && (
        <ul class="mt-5 flex gap-3">{socials.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener" aria-label={k} class="inline-flex h-9 w-9 items-center justify-center rounded-ui border border-on-ink/20 hover:border-on-ink"><Icon name={iconFor[k]} size={16} /></a></li>)}</ul>
      )}
    </div>
    <div>
      <p class="mb-4 text-sm font-medium">Services</p>
      <ul class="space-y-2 text-sm text-on-ink/80">{site.services.map((s) => <li><a href={`/services/${s.slug}`} class="hover:text-on-ink">{s.title}</a></li>)}</ul>
    </div>
    <div>
      <p class="mb-4 text-sm font-medium">Navigation</p>
      <ul class="space-y-2 text-sm text-on-ink/80">{navLinks().map((l) => <li><a href={l.href} class="hover:text-on-ink">{l.label}</a></li>)}</ul>
      {site.zones.cities.length > 0 && <p class="mt-6 text-xs text-on-ink/65">Intervention : {site.zones.cities.slice(0, 8).join(', ')}{site.zones.cities.length > 8 && '…'}</p>}
    </div>
    <div id={sansSectionContact ? 'contact' : undefined}>
      <p class="mb-4 text-sm font-medium">Contact</p>
      <ul class="space-y-2 text-sm text-on-ink/80">
        <li><a href={tel()} class="hover:text-on-ink">{site.contact.phoneDisplay}</a></li>
        {site.contact.email && (<li><a href={mailto()} class="hover:text-on-ink break-all">{site.contact.email}</a></li>)}
        <li class="text-on-ink/60">{fullAddress()}</li>
      </ul>
      {site.contact.hours.length > 0 && <Horaires class="mt-5 text-sm text-on-ink/80" />}
    </div>
  </div>
  <div class="border-t border-on-ink/10">
    <div class="container-ff py-5 flex flex-col sm:flex-row gap-2 justify-between text-xs text-on-ink/65">
      <p>© {year} {site.business.name}. Tous droits réservés.</p>
      {site.legal.demo && <p class="text-xs">Site de démonstration réalisé par Finck & Fisch : l’entreprise, les personnes et les coordonnées sont inventées, aucun client derrière.</p>}
      <p class="flex flex-wrap gap-x-5 gap-y-1"><a href="/mentions-legales" class="hover:text-on-ink">Mentions légales</a><a href="/confidentialite" class="hover:text-on-ink">Confidentialité</a>{hasCredits && <a href="/credits" class="hover:text-on-ink">Crédits photos</a>}<span>Site réalisé par <a href="https://finckfisch.fr" class="hover:text-on-ink" rel="noopener">Finck &amp; Fisch</a></span></p>
    </div>
  </div>
</footer>
