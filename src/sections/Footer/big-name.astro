---
/** Footer "big-name" : le nom de l'entreprise en tres grand, sur fond ink. */
import { site, tel, mailto, fullAddress, hasCredits } from '@/lib/site';
import Icon from '@/components/Icon.astro';
import Horaires from '@/components/Horaires.astro';
const year = new Date().getFullYear();
const socials = Object.entries(site.social).filter(([, v]) => v) as [string, string][];
const iconFor: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'Linkedin', tiktok: 'Music2' };
---

<footer class="bg-ink text-on-ink overflow-hidden">
  <div class="container-ff pt-16 pb-8">
    <p
      class="font-display leading-[0.9] tracking-tight opacity-90 whitespace-nowrap"
      style={`font-size: clamp(2.5rem, ${Math.min(14, 150 / Math.max(site.business.name.length, 6)).toFixed(1)}vw, 12rem);`}
     
    >
      {site.business.name}
    </p>

    <div class="mt-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6 border-t border-on-ink/10 pt-8" data-stagger="90">
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-on-ink/70">
        {site.services.slice(0, 5).map((s) => <a href={`/services/${s.slug}`} class="hover:text-on-ink">{s.title}</a>)}
        <a href="/mentions-legales" class="hover:text-on-ink">Mentions légales</a>
        <a href="/confidentialite" class="hover:text-on-ink">Confidentialité</a>
        {hasCredits && <a href="/credits" class="hover:text-on-ink">Crédits photos</a>}
      </nav>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-on-ink/70">
        <a href={tel()} class="hover:text-on-ink">{site.contact.phoneDisplay}</a>
        {site.contact.email && (<a href={mailto()} class="hover:text-on-ink break-all">{site.contact.email}</a>)}
        <span>{fullAddress()}</span>
        {site.contact.hours.length > 0 && <Horaires class="basis-full" />}
      </div>

      {socials.length > 0 && (
        <div class="flex gap-3">
          {socials.map(([k, url]) => (
            <a href={url} target="_blank" rel="noopener" aria-label={k} class="inline-flex h-9 w-9 items-center justify-center rounded-ui border border-on-ink/20 hover:border-on-ink"><Icon name={iconFor[k]} size={16} /></a>
          ))}
        </div>
      )}
    </div>

    <p class="mt-6 text-xs text-on-ink/65">© {year} {site.business.name}. Tous droits réservés. Site réalisé par <a href="https://finckfisch.fr" class="hover:text-on-ink" rel="noopener" target="_blank">Finck &amp; Fisch</a>.</p>

    {site.legal.demo && <p class="text-xs text-on-ink/65">Site de démonstration réalisé par Finck & Fisch : l’entreprise, les personnes et les coordonnées sont inventées, aucun client derrière.</p>}
  </div>
</footer>
