---
/** Footer "minimal" : une seule ligne, nom, telephone, e-mail, mentions legales, credit. */
import { site, tel, mailto } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="bg-bg border-t border-line">
  <div class="container-ff py-8 flex flex-col sm:flex-row flex-wrap items-center justify-between gap-4 text-sm text-muted">
    <p class="text-fg font-medium">{site.business.name}</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a href={tel()} class="hover:text-fg">{site.contact.phoneDisplay}</a>
      <a href={mailto()} class="hover:text-fg break-all">{site.contact.email}</a>
      <a href="/mentions-legales" class="hover:text-fg">Mentions légales</a>
      <a href="/confidentialite" class="hover:text-fg">Confidentialité</a>
    </div>
    <p class="text-xs">© {year} · Site réalisé par <a href="https://finckfisch.fr" class="hover:text-fg" rel="noopener" target="_blank">Finck &amp; Fisch</a></p>
  </div>
</footer>
