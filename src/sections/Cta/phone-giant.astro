---
/** CTA "phone-giant" : le telephone occupe tout l'espace, sur fond accent. */
import { site, tel } from '@/lib/site';
---

<section class="section-y bg-accent text-on-accent">
  <div class="container-ff text-center">
    <p class="text-lg text-on-accent">Appelez maintenant</p>
    <a
      href={tel()}
      class="mt-4 block font-display leading-none tracking-tight text-on-accent whitespace-nowrap"
      style={`font-size: clamp(2rem, ${Math.min(10, 120 / Math.max(site.contact.phoneDisplay.length, 8)).toFixed(1)}vw, 8rem);`}
     
      data-magnetic="0.15"
    >
      {site.contact.phoneDisplay}
    </a>
    {site.contact.hours.length > 0 && (
      <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-on-accent text-sm" data-stagger="80">
        {site.contact.hours.map((h) => (
          <p data-reveal><span class="font-medium text-on-accent">{h.days}</span>, {h.hours}</p>
        ))}
      </div>
    )}
  </div>
</section>
