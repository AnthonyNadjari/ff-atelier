---
/** About "story" : colonne centree unique, grand premier paragraphe, puis equipe si presente. */
import { site, paragraphs } from '@/lib/site';
import Img from '@/components/Img.astro';

const a = site.about;
const paras = paragraphs(a.story);
const [first, ...rest] = paras;
---

<section id="about" class="section-y">
  <div class="container-ff">
    <div class="mx-auto max-w-3xl text-center" data-stagger="120">
      <p class="eyebrow mb-4">L’atelier</p>
      <h2 class="text-display-md" set:html={a.title ?? 'Qui sommes-nous&nbsp;?'} />
    </div>
    <div class="mx-auto mt-10 flex max-w-3xl flex-col gap-5">
      {first && <p class="text-xl text-fg">{first}</p>}
      {rest.map((p) => <p class="text-lg text-muted">{p}</p>)}
    </div>
    {a.team.length > 0 && (
      <ul class="mx-auto mt-16 grid max-w-4xl gap-8 sm:grid-cols-2 lg:grid-cols-3" data-stagger="90">
        {a.team.map((m) => (
          <li class="text-center">
            {m.photo ? (
              <Img src={m.photo.src} alt={m.photo.alt} class="mx-auto h-24 w-24 rounded-full object-cover shadow-card" sizes="96px" loading="lazy" />
            ) : (
              <div class="mx-auto flex h-24 w-24 items-center justify-center rounded-full bg-bg-2 font-display text-2xl text-accent">
                {m.name.charAt(0)}
              </div>
            )}
            <p class="mt-4 font-display text-lg">{m.name}</p>
            <p class="text-sm text-muted">{m.role}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
