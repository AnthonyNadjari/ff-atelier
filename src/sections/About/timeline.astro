---
/** About "timeline" : histoire au-dessus, puis frise verticale des jalons (ou des valeurs a defaut). */
import { site, paragraphs } from '@/lib/site';

const a = site.about;
const paras = paragraphs(a.story);

type Item = { year?: string; title?: string; text: string };
const items: Item[] =
  a.milestones.length > 0
    ? a.milestones.map((m): Item => ({ year: m.year, text: m.text }))
    : a.values.map((v): Item => ({ title: v.title, text: v.text }));
---

<section id="about" class="section-y">
  <div class="container-ff">
    <div class="max-w-2xl" data-stagger="110">
      <p class="eyebrow mb-4">L’atelier</p>
      <h2 class="text-display-md" set:html={a.title ?? 'Qui sommes-nous&nbsp;?'} />
      <div class="mt-6 flex flex-col gap-4 text-lg text-muted">
        {paras.map((p) => <p>{p}</p>)}
      </div>
    </div>
    {items.length > 0 && (
      <ol class="relative mt-16 flex max-w-2xl flex-col gap-10 border-l border-accent/25 pl-8" data-stagger="100">
        {items.map((it) => (
          <li class="relative">
            <span class="absolute -left-8 top-1.5 h-2.5 w-2.5 -translate-x-1/2 rounded-full bg-accent ring-4 ring-bg"></span>
            {it.year && <p class="eyebrow">{it.year}</p>}
            {it.title && <p class:list={['font-display text-lg', it.year && 'mt-1']}>{it.title}</p>}
            <p class:list={['text-muted', (it.year || it.title) && 'mt-1']}>{it.text}</p>
          </li>
        ))}
      </ol>
    )}
  </div>
</section>
