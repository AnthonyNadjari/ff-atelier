---
/** About "values" : histoire a gauche, valeurs en cartes 2x2 a droite. */
import { site, paragraphs } from '@/lib/site';
import Icon from '@/components/Icon.astro';

const a = site.about;
const paras = paragraphs(a.story);
const hasValues = a.values.length > 0;
const valueIcons = ['Sparkles', 'ShieldCheck', 'Handshake', 'Hammer'];
---

<section id="about" class="section-y bg-bg-2">
  <div class:list={['container-ff grid gap-12 lg:gap-16', hasValues ? 'lg:grid-cols-12' : '']}>
    <div class:list={[hasValues ? 'lg:col-span-5' : 'max-w-2xl']} data-stagger="110">
      <h2 class="text-display-md" set:html={a.title ?? 'Qui sommes-nous&nbsp;?'} />
      <div class="mt-6 flex max-w-prose flex-col gap-4 text-muted">
        {paras.map((p) => <p>{p}</p>)}
      </div>
    </div>
    {hasValues && (
      <div class="lg:col-span-7">
        <ul class="grid gap-5 sm:grid-cols-2" data-stagger="90">
          {a.values.map((v, i) => (
            <li class="card rounded-card border border-line bg-surface p-7">
              <div class="flex h-11 w-11 items-center justify-center rounded-ui bg-accent/10 text-accent">
                <Icon name={valueIcons[i % valueIcons.length]} size={22} />
              </div>
              <h3 class="mt-5 font-display text-lg">{v.title}</h3>
              <p class="mt-2 text-sm text-muted">{v.text}</p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
