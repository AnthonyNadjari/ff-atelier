---
/**
 * Hero "video" : comme fullbleed, mais avec une video en fond (site.images.heroVideo), pilotee par le moteur
 * (data-video-fond, src/scripts/motion.ts) : pas d'autoplay HTML, lecture seulement a l'ecran, bouton pause, rien sous
 * prefers-reduced-motion. Poster OBLIGATOIRE (images.heroVideoPoster, sinon images.hero) : iPhone en economie
 * d'energie bloque tout autoplay, le poster porte seul le premier ecran. Sans poster, la video n'est pas rendue.
 * Sans video, rendu fullbleed a l'identique. Profil « video-de-fond » de docs/veille/styles/MOUVEMENTS.md.
 */
import { site, ligneMetier, tel, yearsSince, paragraphs, hasContactDoor } from '@/lib/site';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import { HERO_SIZES } from '@/lib/images';
const years = yearsSince();
const intro = paragraphs(site.business.description)[0];
const hero = site.images.hero;
const poster = site.images.heroVideoPoster ?? hero?.src;
const video = poster ? site.images.heroVideo : undefined;
---

<section id="hero" class:list={['relative min-h-[92svh] flex items-end overflow-hidden', !hero && !video && 'bg-ink']} data-video-fond={video ? '' : undefined}>
  {video && (
    <div class="absolute inset-0 -z-10">
      <video class="absolute inset-0 h-full w-full object-cover" muted loop playsinline preload="none" poster={poster} aria-hidden="true">
        <source src={video} type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/10"></div>
    </div>
  )}
  {!video && hero && (
    <div class="absolute inset-0 -z-10">
      <Img src={hero.src} alt={hero.alt} class="absolute inset-0 h-full w-full object-cover" sizes={HERO_SIZES.video} data-parallax="0.2" priority />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/50 to-ink/10"></div>
    </div>
  )}
  {!video && !hero && (
    <div class="absolute inset-0 -z-10 flex items-center justify-end pr-4 md:pr-16 opacity-10" aria-hidden="true">
      <Icon name={site.services[0]?.icon ?? 'Wrench'} size={480} class="text-on-ink" strokeWidth={0.6} />
    </div>
  )}
  <div class="container-ff relative pb-16 pt-40 md:pb-24 text-on-ink" data-stagger="110">
    {ligneMetier() && <p class="hero-metier text-base">{ligneMetier()}</p>}
    <h1 class="hero-titre text-display-xl mt-5 max-w-3xl" data-split set:html={site.business.tagline} />
    <p class="mt-6 text-lg md:text-xl text-on-ink/80 max-w-xl">{intro}</p>
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <Button href={tel()} size="lg" magnetic><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</Button>
      {/* Suffixe ! : les directions restylent .btn-ghost hors couche (color: var(--fg)), illisible sur fond ink sans lui. */}
      {hasContactDoor(site) && <Button href="/#contact" variant="ghost" size="lg" class="border-on-ink/30! bg-transparent! text-on-ink! hover:border-on-ink!">{site.wording.devis}</Button>}
    </div>
    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm text-on-ink/70">
      {years && <li class="flex items-center gap-2">Depuis {site.business.since}</li>}
      {site.contact.emergency24h && <li class="flex items-center gap-2">Urgences 24 h/24</li>}
      {site.business.insurance && <li class="flex items-center gap-2">Assuré décennale</li>}
      {site.proof.google && <li class="flex items-center gap-2">{site.proof.google.rating.toFixed(1).replace('.', ',')}/5 sur Google ({site.proof.google.count} avis)</li>}
    </ul>
  </div>
</section>
