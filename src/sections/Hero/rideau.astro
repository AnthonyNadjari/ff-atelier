---
/**
 * Hero "rideau" (style réel rideau, relevé sur holographik.space le 30 oct 2026, fiche docs/veille/styles/rideau.md
 * § Construction, blocs 1 à 3) :
 * 1. LE VIDE NOIR (ramené à un tiers d'écran à l'ordinateur, aucun au téléphone), puis au bas, à gauche, quelques lignes
 *    (la source : 14 px, trois lignes, la première rentrée) : ici le h1 (business.tagline) en grotesque moyenne jusqu'à 44 px, première ligne
 *    rentrée, puis le métier et la ville, l'ancienneté, la note Google, et la porte Devis / Réserver (plaque à filet) ;
 *    le numéro est dans la barre du haut (nav « minimal », porte Appeler) et dans la barre de raccourcis.
 * 2. LE PREMIER ÉCRAN PLEIN DE PHOTO (images.hero), 100 % de la hauteur à l'ordinateur, 4:3 debout au téléphone (133vw,
 *    mesuré), voile noir à 20 % ; au centre, la petite étiquette (le métier, sur une plaque noire à 40 %) et le NOM du client
 *    en grotesque moyenne jusqu'à 90 px, serré, blanc ; il se floute et s'efface quand il sort par le haut de l'écran
 *    (profil « titre-qui-se-floute-en-sortant »).
 * 3. LA BARRE DE RACCOURCIS FLOTTANTE de la source : posée en haut au centre à l'ordinateur, en bas au téléphone, quatre
 *    liens vers les blocs de la page (prestations, avis, contact, et l'appel) sur une plaque claire à 6 px de rayon (la
 *    source : pilule, refusée).
 * Données : sans images.hero, pas d'écran photo (le texte reste au bas du vide) ; chaque lien de la barre n'existe que si
 * son bloc existe.
 */
import { site, tel, metierEtVille, hasContactDoor } from '@/lib/site';
import Button from '@/components/Button.astro';
import Img from '@/components/Img.astro';
import { HERO_SIZES } from '@/lib/images';

const hero = site.images.hero;
const google = site.proof.google;
const faits = [
  metierEtVille().replace(/\.$/, ''),
  site.business.since && `depuis ${site.business.since}`,
  google && `${google.rating.toFixed(1).replace('.', ',')}/5 sur Google (${google.count} avis)`,
].filter(Boolean) as string[];
const types = new Set(site.layout.sections.map((s) => s.type));
const avis = site.proof.testimonials.length > 0 || Boolean(google);
const raccourcis = [
  types.has('services') && { href: '#services', label: site.wording.servicesNav ?? 'Prestations' },
  types.has('proof') && avis && { href: '#proof', label: 'Avis' },
  types.has('contact') && { href: '#contact', label: 'Venir' },
  { href: tel(), label: 'Appeler' },
].filter(Boolean) as { href: string; label: string }[];
---

<section id="hero" class="hero-rideau">
  <div class="rideau-intro rideau-marges">
    <h1 class="rideau-h1 hero-titre" set:html={site.business.tagline} />
    <p class="mt-3 max-w-[60ch] text-sm text-muted md:text-lg">{faits.join(', ')}.</p>
    {hasContactDoor(site) && (
      <div class="mt-4">
        <Button href="/#contact" variant="ghost" size="sm">{site.wording.devis}</Button>
      </div>
    )}
  </div>
  {hero && (
    <div class="rideau-ecran relative overflow-hidden">
      <Img src={hero.src} alt={hero.alt} class="absolute inset-0 h-full w-full object-cover" sizes={HERO_SIZES.rideau} priority />
      <div class="rideau-voile" aria-hidden="true"></div>
      <div class="rideau-centre" aria-hidden="true">
        <span class="rideau-etiquette">{site.business.trade}</span>
        <p class="rideau-titre-ecran font-[family-name:var(--font-display)]" data-rideau-flou>{site.business.name}</p>
      </div>
    </div>
  )}
  <nav class="rideau-barre" aria-label="Raccourcis">
    {raccourcis.map((r) => <a href={r.href}>{r.label}</a>)}
  </nav>
</section>

<style>
  .rideau-marges { width: 100%; padding-inline: clamp(0.625rem, 1.4vw, 1.25rem); }
  /* Le vide de la source (ses lignes à 380 px du haut) est ramené à un souffle sous la barre : au téléphone le texte suit
     la barre, à l'ordinateur il se pose au bas d'un tiers d'écran (essai du 30 oct 2026 : un bloc noir vide en tête de
     téléphone ne se lit pas comme un choix). */
  .rideau-intro { display: flex; flex-direction: column; justify-content: flex-end; padding-top: 5.5rem; padding-bottom: 1.5rem; }
  @media (min-width: 64rem) { .rideau-intro { min-height: 34svh; padding-bottom: 2rem; } }
  .rideau-h1 { font-size: clamp(1.2rem, 0.8rem + 2vw, 2.75rem); line-height: 1.08; max-width: 28ch; text-indent: 1.7em; text-wrap: pretty; }
  .rideau-ecran { height: 133.333vw; }
  @media (min-width: 40rem) { .rideau-ecran { height: 100svh; } }
  .rideau-voile { position: absolute; inset: 0; background: var(--bg); opacity: 0.2; }
  .rideau-centre { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding-inline: 1rem; text-align: center; color: var(--fg); }
  .rideau-etiquette { border-radius: var(--radius); background: color-mix(in srgb, var(--bg) 40%, transparent); padding: 0.2rem 0.55rem; font-size: 0.8125rem; line-height: 1.2; }
  .rideau-titre-ecran { font-weight: 500; font-size: clamp(1.8rem, 4.8vw, 5.6rem); line-height: 0.95; letter-spacing: -0.022em; max-width: 20ch; text-wrap: balance; }

  /* La barre de raccourcis : plaque claire flottante, en haut au centre à l'ordinateur, en bas au téléphone. */
  .rideau-barre {
    position: fixed; z-index: 45; left: 0.625rem; right: 0.625rem; bottom: max(0.75rem, env(safe-area-inset-bottom));
    display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 0.25rem; padding: 0.3rem;
    border-radius: 6px; background: color-mix(in srgb, var(--ink) 88%, transparent); backdrop-filter: blur(10px);
    color: var(--on-ink); font-size: 0.875rem; font-weight: 500; text-align: center;
  }
  .rideau-barre a { border-radius: var(--radius); padding: 0.6rem 0.25rem; transition: background var(--motion-ui) var(--ease-brand), color var(--motion-ui) var(--ease-brand); }
  .rideau-barre a:hover, .rideau-barre a:focus-visible { background: var(--on-ink); color: var(--ink); }
  @media (min-width: 64rem) {
    .rideau-barre { top: 0.75rem; bottom: auto; left: 50%; right: auto; width: 26rem; transform: translateX(-50%); }
  }

  /* Le nom se floute et s'efface en sortant par le haut (la source : jusqu'à 16 px de flou, en JavaScript au défilement).
     Ici en CSS natif, animation liée à la vue (rien sur le fil principal) ; sans prise en charge ou en mouvement réduit,
     le nom reste net. */
  @keyframes rideau-flou { to { filter: blur(16px); opacity: 0.2; } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-rideau-flou] { animation: rideau-flou linear both; animation-timeline: view(); animation-range: exit 10% exit 100%; }
    }
  }
  .hero-rideau :global(.ff-illustration) { z-index: 2; }
</style>
