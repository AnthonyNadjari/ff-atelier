---
/**
 * Hero "buvard" (style réel buvard, relevé sur florawellnesscafe.com le 30 oct 2026, fiche docs/veille/styles/buvard.md
 * § Construction, bloc 2) : LA PHOTO CADRÉE DANS LES MARGES. Sous la barre, le bandeau rouge d'une ligne de la source, en
 * machine à écrire (ici le métier à la ville, l'ancienneté et la note Google, ce que la source pose à côté de son logo),
 * puis la photo du lieu (images.hero) sur toute la
 * largeur moins les marges de la page (40 px), format 2:1 à l'ordinateur, 4:5 au téléphone (un peu plus de la moitié de l'écran, comme la source), sans arrondi ni ombre ; sous
 * elle, deux colonnes : à gauche la phrase (business.tagline, le h1) en caslon droit de grand corps (48 px), dessous les deux étiquettes (la première porte
 * d'action en rouge plein, Appeler en contour), à la place du petit dessin de la source ; à droite la présentation
 * (premier paragraphe de business.description) en caslon de lecture. Puis le filet tremblé qui sépare de la carte.
 * Mouvement (profil « filet-qui-se-trace », docs/veille/styles/MOUVEMENTS.md) : aucun à l'entrée ; le filet se trace.
 * Données : sans images.hero, la phrase et la présentation restent seules sous la barre (jamais une photo de banque
 * présentée comme celle du client).
 */
import { site, tel, metierEtVille, actions, paragraphs } from '@/lib/site';
import Button from '@/components/Button.astro';
import Porte from '@/components/Porte.astro';
import Img from '@/components/Img.astro';
import FiletTremble from '@/components/FiletTremble.astro';
import { HERO_SIZES } from '@/lib/images';

const hero = site.images.hero;
const google = site.proof.google;
const presentation = site.business.description ? paragraphs(site.business.description)[0] : '';
// La ligne au-dessus de la photo : ce que la source met à côté de son logo (« Modesto, ESTD 2024 ») : le métier à la ville
// et l'ancienneté à gauche, la note Google à droite.
const lieu = `${metierEtVille().replace(/\.$/, '')}${site.business.since ? `, depuis ${site.business.since}` : ''}`;
const note = google ? `${google.rating.toFixed(1).replace('.', ',')}/5 sur Google (${google.count} avis)` : '';
const porte = actions().find((a) => a.kind !== 'call');
---

<section id="hero" class="buvard-hero">
  <p class="buvard-bandeau font-mono bg-accent text-on-accent">{lieu}{note && <span class="hidden sm:inline">, {note}</span>}</p>
  <div class="buvard-large pt-3 md:pt-4">
  {hero && (
    <figure class="buvard-photo relative m-0 overflow-hidden">
      <Img src={hero.src} alt={hero.alt} class="absolute inset-0 h-full w-full object-cover" sizes={HERO_SIZES.buvard} priority />
    </figure>
  )}
  <div class="mt-6 grid gap-6 md:mt-5 md:grid-cols-12 md:gap-x-10">
    <div class="md:col-span-6">
      <h1 class="buvard-phrase hero-titre" set:html={site.business.tagline} />
      <div class="mt-4 flex flex-wrap gap-3">
        {porte && <Porte action={porte} size="md" />}
        <Button href={tel()} variant={porte ? 'ghost' : 'primary'} size="md">Appeler le {site.contact.phoneDisplay}</Button>
      </div>
    </div>
    {presentation && <p class="text-[0.9375rem] leading-snug md:col-span-5 md:col-start-8 md:pt-2">{presentation}</p>}
  </div>
  <FiletTremble class="mt-12 md:mt-16" />
  </div>
</section>

<style>
  /* Le bandeau rouge d'une ligne de la source, ici avec le métier à la ville, l'ancienneté et la note (jamais une annonce inventée). */
  .buvard-bandeau { margin: 0; padding: 0.45rem 1.25rem; text-align: center; font-size: 0.8125rem; line-height: 1.3; }
  .buvard-large { width: 100%; padding-inline: clamp(1.25rem, 2.8vw, 2.5rem); }
  /* Hauteur fixée par la largeur (4:5 au téléphone), plafonnée à l'écran ; la largeur reste celle de la page. À l'ordinateur,
     56 % de l'écran (la source : 75 %) : à 66 %, le premier écran ressemblait à 0,71 à maison-aurore (ff ressemblance,
     « image sur plus de la moitié de l'écran ») ; écart voulu et noté dans la fiche. */
  .buvard-photo { height: min(118vw, 56svh); }
  @media (min-width: 48rem) { .buvard-photo { height: min(44vw, 56svh); } }
  .buvard-phrase { font-size: clamp(2rem, 1.4rem + 2vw, 3rem); line-height: 1.02; max-width: 16ch; text-wrap: balance; }
</style>
