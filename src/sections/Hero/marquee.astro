---
/** Hero "marquee" : texte a gauche, pile verticale de reperes a droite, bandes defilantes (services, villes) en pied de hero. */
import { site, ligneMetier, tel, yearsSince, paragraphs, hasContactDoor } from '@/lib/site';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
const years = yearsSince();
const intro = paragraphs(site.business.description)[0];
const google = site.proof.google;
const cities = site.zones.cities;
---

<section id="hero" class="relative section-y overflow-hidden">
  <div class="container-ff grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
    <div class="lg:col-span-7" data-stagger="110">
      {ligneMetier() && <p class="hero-metier text-base">{ligneMetier()}</p>}
      <h1 class="hero-titre text-display-xl mt-5" data-split set:html={site.business.tagline} />
      <p class="mt-6 text-lg md:text-xl text-muted max-w-xl">{intro}</p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <Button href={tel()} size="lg" magnetic><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</Button>
        {hasContactDoor(site) && <Button href="/#contact" variant="ghost" size="lg">{site.wording.devis}</Button>}
      </div>
    </div>

    <div class="lg:col-span-5 flex flex-col gap-4" data-stagger="90">
      {years && (
        <div class="card flex items-center gap-4 rounded-card bg-surface px-5 py-4 shadow-card">
                    <p><span class="text-sm text-muted">Depuis</span> <span class="font-display text-lg">{site.business.since}</span></p>
        </div>
      )}
      {site.contact.emergency24h && (
        <div class="card flex items-center gap-4 rounded-card bg-surface px-5 py-4 shadow-card">
                    <p class="font-display text-lg">Urgences 24 h/24</p>
        </div>
      )}
      {site.business.insurance && (
        <div class="card flex items-center gap-4 rounded-card bg-surface px-5 py-4 shadow-card">
                    <p class="font-display text-lg">Assuré décennale</p>
        </div>
      )}
      {google && (
        <div class="card flex items-center gap-4 rounded-card bg-surface px-5 py-4 shadow-card">
                    <p><span class="font-display text-lg">{google.rating.toFixed(1).replace('.', ',')}/5</span> <span class="text-sm text-muted">sur Google ({google.count} avis)</span></p>
        </div>
      )}
    </div>
  </div>

  {site.services.length > 0 && (
    <div class="mt-16 bg-accent py-4 text-on-accent" data-marquee="28s">
      <div class="marquee-track font-display text-display-sm">
        {site.services.map((s) => (
          <>
            <span>{s.title}</span>
            <span aria-hidden="true" class="opacity-60">/</span>
          </>
        ))}
      </div>
    </div>
  )}

  {cities.length > 0 && (
    <div class="border-t border-line py-4" data-marquee="55s">
      <div class="marquee-track font-display text-sm uppercase text-muted">
        {cities.map((c) => (
          <>
            <span>{c}</span>
            <span class="text-accent" aria-hidden="true">•</span>
          </>
        ))}
      </div>
    </div>
  )}
</section>
