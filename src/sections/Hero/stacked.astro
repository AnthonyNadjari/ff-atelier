---
/** Hero "stacked" : bloc de texte centre en haut, image pleine largeur en dessous. Sans image : 3 services en cartes. */
import { site, tel, yearsSince, paragraphs, featuredServices } from '@/lib/site';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
const years = yearsSince();
const intro = paragraphs(site.business.description)[0];
const hero = site.images.hero;
const featured = featuredServices();
const shown = (featured.length > 0 ? featured : site.services).slice(0, 3);
---

<section id="hero" class="relative section-y overflow-hidden">
  <div class="container-ff">
    <div class="max-w-3xl mx-auto text-center" data-stagger="110">
      <p class="eyebrow justify-center flex">{site.business.trade} · {site.contact.address.city}</p>
      <h1 class="text-display-xl mt-5" data-split set:html={site.business.tagline} />
      <p class="mt-6 text-lg md:text-xl text-muted mx-auto max-w-xl">{intro}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
        <Button href={tel()} size="lg" magnetic><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</Button>
        <Button href="#contact" variant="ghost" size="lg">{site.wording.devis}</Button>
      </div>
      <ul class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-3 text-sm text-muted">
        {years && <li class="flex items-center gap-2"><Icon name="Award" size={16} class="text-accent" /> {years} ans d'expérience</li>}
        {site.contact.emergency24h && <li class="flex items-center gap-2"><Icon name="Clock" size={16} class="text-accent" /> Urgences 24h/24</li>}
        {site.business.insurance && <li class="flex items-center gap-2"><Icon name="ShieldCheck" size={16} class="text-accent" /> Assuré décennale</li>}
        {site.proof.google && <li class="flex items-center gap-2"><Icon name="Star" size={16} class="text-accent" /> {site.proof.google.rating.toFixed(1)}/5 sur Google ({site.proof.google.count} avis)</li>}
      </ul>
    </div>

    <div class="mt-14 md:mt-20">
      {hero ? (
        <figure class="relative aspect-[16/9] w-full overflow-hidden rounded-card shadow-lift" data-reveal="scale">
          <Img src={hero.src} alt={hero.alt} class="absolute inset-0 h-full w-full object-cover" sizes="100vw" priority />
        </figure>
      ) : (
        <ul class="grid sm:grid-cols-3 gap-5 max-w-3xl mx-auto" data-stagger="90">
          {shown.map((s) => (
            <li class="card rounded-card bg-surface p-6 shadow-card text-center">
              <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-ui bg-accent/10 text-accent">
                <Icon name={s.icon} size={22} />
              </div>
              <h3 class="mt-4 text-display-sm">{s.title}</h3>
              <p class="mt-2 text-sm text-muted">{s.short}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
