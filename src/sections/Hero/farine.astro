---
/**
 * Hero "farine" (style réel farine, relevé sur impastofornoantico.com le 30 oct 2026, fiche docs/veille/styles/farine.md
 * § Construction, bloc 1) : LES NOMS DES PAINS EN CAPITALES GÉANTES, centrés, une ligne par prestation (les titres des
 * services, trois au plus), en grotesque étroite et légère sur le crème ; AU MILIEU, posée par-dessus, la photo du
 * premier écran (images.hero) en noir et blanc, rectangle 16:9 de 40 % de la largeur : là où les
 * lettres passent sur la photo, elles deviennent crème (une seconde copie des mots, crème, découpée exactement au cadre
 * de la photo par clip-path ; la source fait la même chose par mélange d'images). Dessous, sur une ligne : la phrase
 * (business.tagline, le h1) et le métier à la ville, l'ancienneté, la note Google ; à droite, Appeler le numéro et la
 * porte Devis en liens de texte.
 * Mouvement (profil « mots-sous-la-photo », docs/veille/styles/MOUVEMENTS.md) : à l'arrivée, la photo apparaît d'abord
 * (opacité, 0,7 s), puis chaque ligne de mots monte de sous sa ligne (translateY 100 % -> 0 dans un cadre overflow
 * hidden, 0,7 s, 120 ms entre deux lignes, courbe de la source cubic-bezier(0.625, 0.05, 0, 1)), CSS seul, une fois ;
 * en mouvement réduit, tout est en place.
 * Données : sans images.hero, les mots restent seuls sur le crème (jamais une photo de banque présentée comme celle du
 * client) ; un titre de service long réduit la taille de toutes les lignes pour qu'elles tiennent dans la largeur.
 */
import { site, tel, metierEtVille, hasContactDoor } from '@/lib/site';
import Button from '@/components/Button.astro';
import Img from '@/components/Img.astro';
import { HERO_SIZES } from '@/lib/images';

const hero = site.images.hero;
const google = site.proof.google;
const mots = site.services.slice(0, 3).map((s) => s.title);
const plusLong = Math.max(...mots.map((m) => m.length), 6);
// Archivo étroite (wdth 86 %) en capitales : environ 0,6 em par lettre ; la ligne la plus longue tient dans 80 % de la largeur.
const taille = Math.min(11.6, 80 / (plusLong * 0.6)).toFixed(2);
// Au téléphone, les mots prennent plus de place autour d'une photo plus petite (la source : photo d'un tiers de l'écran).
const tailleTel = Math.min(14.5, 88 / (plusLong * 0.6)).toFixed(2);
const faits = [
  metierEtVille().replace(/\.$/, ''),
  site.business.since && `depuis ${site.business.since}`,
  google && `${google.rating.toFixed(1).replace('.', ',')}/5 sur Google (${google.count} avis)`,
].filter(Boolean) as string[];
---

<section id="hero" class="farine-hero">
  <div class="farine-scene" style={`--farine-taille: ${taille}vw; --farine-taille-tel: ${tailleTel}vw;`}>
    <p class="farine-mots font-[family-name:var(--font-display)]">
      <span class="sr-only">{mots.join(', ')}</span>
      {mots.map((m, i) => <span class="farine-ligne" aria-hidden="true"><span style={`--i: ${i}`}>{m}</span></span>)}
    </p>
    {hero && (
      <>
        <figure class="farine-photo">
          <Img src={hero.src} alt={hero.alt} class="h-full w-full object-cover" sizes={HERO_SIZES.farine} priority />
        </figure>
        <p class="farine-mots font-[family-name:var(--font-display)] farine-mots-clair" aria-hidden="true">
          {mots.map((m, i) => <span class="farine-ligne"><span style={`--i: ${i}`}>{m}</span></span>)}
        </p>
      </>
    )}
  </div>
  <div class="farine-large grid gap-6 pb-10 md:grid-cols-12 md:items-end md:pb-12">
    <div class="md:col-span-7">
      <h1 class="farine-phrase hero-titre" set:html={site.business.tagline} />
      <p class="mt-3 text-base text-muted">{faits.join(', ')}.</p>
    </div>
    <div class="flex flex-wrap gap-x-8 gap-y-2 md:col-span-4 md:col-start-9 md:justify-end">
      <Button href={tel()} variant="ghost" size="sm">Appeler le {site.contact.phoneDisplay}</Button>
      {hasContactDoor(site) && <Button href="/#contact" variant="ghost" size="sm">{site.wording.devis}</Button>}
    </div>
  </div>
</section>

<style>
  .farine-large { width: 100%; padding-inline: clamp(1.125rem, 3.3vw, 3rem); }
  /* La scène : le crème, les mots au centre, la photo par-dessus. container-type pour caler la photo et la découpe des
     mots clairs sur la même mesure (cqw = 1 % de la largeur de la scène). */
  .farine-scene { position: relative; container-type: inline-size; min-height: max(24rem, calc(78svh - 76px)); display: grid; place-items: center; }
  @media (min-width: 48rem) { .farine-scene { min-height: max(30rem, calc(84svh - 76px)); } }
  .farine-mots {
    position: absolute; inset: 0; margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
    font-stretch: 86%; font-weight: 330; text-transform: uppercase; letter-spacing: -0.015em;
    font-size: var(--farine-taille); line-height: 0.98; color: var(--fg); text-align: center; white-space: nowrap;
  }
  .farine-ligne { display: block; overflow: hidden; padding-block: 0.02em; }
  .farine-ligne > span { display: block; animation: farine-monte var(--motion-duration) var(--ease-brand) both; animation-delay: calc(450ms + var(--i) * 120ms); }
  /* La photo : rectangle 16:9 au centre, en noir et blanc comme la vidéo de la source. */
  .farine-photo { --l: 40cqw; position: absolute; left: 50%; top: 50%; width: var(--l); aspect-ratio: 16 / 9; margin: 0; transform: translate(-50%, -50%); overflow: hidden; z-index: 1; animation: farine-parait var(--motion-duration) var(--ease-brand) both; }
  .farine-photo :global(img) { filter: grayscale(1) contrast(1.05); }
  /* La copie claire des mots, au-dessus de la photo, découpée exactement à son cadre. */
  .farine-mots-clair { z-index: 2; color: var(--on-ink); --l: 40cqw; clip-path: inset(calc(50% - var(--l) * 9 / 32) calc(50% - var(--l) / 2)); pointer-events: none; }
  @media (max-width: 47.99rem) {
    .farine-mots { font-size: var(--farine-taille-tel); }
    .farine-photo, .farine-mots-clair { --l: 40cqw; }
  }
  .farine-phrase { font-size: clamp(1.45rem, 1rem + 1.6vw, 2.25rem); line-height: 1.02; max-width: 24ch; text-wrap: balance; }
  @keyframes farine-monte { from { transform: translateY(102%); } to { transform: none; } }
  @keyframes farine-parait { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .farine-ligne > span, .farine-photo { animation: none; }
  }
  .farine-photo :global(.ff-illustration) { top: 0.4rem; bottom: auto; }
</style>
