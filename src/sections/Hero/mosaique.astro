---
/**
 * Hero "mosaique" (famille `mosaique`, .claude/skills/site-final/premiers-ecrans.md) : les photos du client en
 * mosaïque serrée occupent le premier écran, le titre et le numéro dans une case de la mosaïque, surélevée (ombre
 * portée, elle déborde de 0,75 rem sur ses voisines : deux plans). Photos : images.hero d'abord (la plus grande case),
 * puis photosDuSite() (portrait, réalisations, services), 6 au plus, sans doublon. Grilles écrites pour 4, 5 et 6
 * photos : jamais de trou. Données : 4 photos au moins (HERO_DE_FAMILLE ne la propose pas sans) ; en dessous, la case
 * seule et les photos qu'il y a sur une rangée, rien d'inventé.
 * Téléphone : une rangée de photos, la case (h1, métier à ville, numéro) qui la chevauche, puis les autres photos.
 */
import { site, tel, paragraphs, hasContactDoor, metierEtVille, photosDuSite } from '@/lib/site';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';

const intro = paragraphs(site.business.description)[0];
const google = site.proof.google;
const photos = [...(site.images.hero ? [site.images.hero] : []), ...photosDuSite()].slice(0, 6);
const n = photos.length;
const grille = n >= 4; // 4, 5 ou 6 photos : la mosaïque ; moins : rangée simple
// Zones de grille dans l'ordre des photos : la couverture prend la plus grande case (b).
const zones = n >= 6 ? ['b', 'e', 'a', 'c', 'd', 'f'] : n === 5 ? ['b', 'e', 'a', 'c', 'd'] : ['b', 'a', 'c', 'd'];
const tailles: Record<string, string> = {
  b: '(min-width: 64rem) 34vw, 50vw',
  e: '(min-width: 64rem) 34vw, 50vw',
  a: '(min-width: 64rem) 42vw, 66vw',
  c: '(min-width: 64rem) 25vw, 34vw',
  d: '(min-width: 64rem) 25vw, 50vw',
  f: '(min-width: 64rem) 25vw, 50vw',
};
---

<section id="hero" class="hero-mosaique relative pt-3 md:pt-6 pb-10 md:pb-16">
  <div class="mx-auto w-full max-w-[112rem] px-2 md:px-4 lg:px-6">
    <div class:list={['mos-grille', grille ? `mos-n${n}` : 'mos-rangee']}>
      {photos.map((p, i) => (
        <figure class="mos-photo relative overflow-hidden rounded-ui bg-bg-2" style={grille ? `grid-area: ${zones[i]}` : undefined}>
          <Img src={p.src} alt={p.alt} class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out-quart" sizes={grille ? tailles[zones[i]] : '(min-width: 64rem) 25vw, 50vw'} priority={i === 0} loading={i < 3 ? 'eager' : 'lazy'} />
        </figure>
      ))}
      <div class="mos-case relative z-10 flex flex-col justify-center rounded-card bg-ink text-on-ink shadow-lift px-6 py-7 sm:px-8 lg:px-10 lg:py-10" style={grille ? 'grid-area: t' : undefined} data-stagger="110">
        <h1 class="hero-titre text-display-lg" data-split set:html={site.business.tagline} />
        <p class="mt-4 text-lg text-on-ink/80">{metierEtVille()}</p>
        {intro && <p class="mt-4 hidden max-w-md text-on-ink/70 xl:block">{intro}</p>}
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <Button href={tel()} size="lg" magnetic><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</Button>
          {/* Suffixe ! : les directions restylent .btn-ghost hors couche (color: var(--fg)), illisible sur fond encre sans lui. */}
          {hasContactDoor(site) && <Button href="/#contact" variant="ghost" size="lg" class="border-on-ink/30! bg-transparent! text-on-ink! hover:border-on-ink!">{site.wording.devis}</Button>}
        </div>
        {(google || site.business.since) && (
          <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-on-ink/70">
            {site.business.since && <li>Depuis {site.business.since}</li>}
            {google && <li>{google.rating.toFixed(1).replace('.', ',')}/5 sur Google ({google.count} avis)</li>}
          </ul>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .mos-grille { display: grid; gap: 0.375rem; }
  /* Rangée simple (moins de 4 photos) : la case puis les photos côte à côte. */
  .mos-rangee { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mos-rangee .mos-case { grid-column: 1 / -1; order: -1; }
  .mos-rangee .mos-photo { aspect-ratio: 4 / 3; }

  /* Téléphone : rangée de deux photos, la case qui la chevauche, puis les autres photos par deux. */
  .mos-n4, .mos-n5, .mos-n6 { grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: minmax(0, auto); }
  .mos-n6 { grid-template-areas: 'a a a a c c' 't t t t t t' 'b b b d d d' 'e e e f f f'; grid-template-rows: 8.5rem auto 11rem 11rem; }
  .mos-n5 { grid-template-areas: 'a a a a c c' 't t t t t t' 'b b b d d d' 'e e e e e e'; grid-template-rows: 8.5rem auto 11rem 11rem; }
  .mos-n4 { grid-template-areas: 'a a a a c c' 't t t t t t' 'b b b d d d'; grid-template-rows: 8.5rem auto 12rem; }
  .mos-n4 .mos-case, .mos-n5 .mos-case, .mos-n6 .mos-case { margin: -2rem 0.5rem 0; }

  @media (min-width: 64rem) {
    .mos-grille { gap: 0.5rem; }
    .mos-n4, .mos-n5, .mos-n6 {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: repeat(6, minmax(0, 1fr));
      height: clamp(36rem, calc(100svh - 8rem), 56rem);
    }
    /* La case prend cinq rangées sur six : la photo « a » en bandeau au-dessus d'elle. */
    .mos-n6 { grid-template-areas: 'a a a a a b b b b c c c' 't t t t t b b b b c c c' 't t t t t b b b b d d d' 't t t t t e e e e d d d' 't t t t t e e e e f f f' 't t t t t e e e e f f f'; }
    .mos-n5 { grid-template-areas: 'a a a a a b b b b c c c' 't t t t t b b b b c c c' 't t t t t b b b b d d d' 't t t t t e e e e d d d' 't t t t t e e e e d d d' 't t t t t e e e e d d d'; }
    .mos-n4 { grid-template-areas: 'a a a a a b b b b c c c' 't t t t t b b b b c c c' 't t t t t b b b b d d d' 't t t t t b b b b d d d' 't t t t t b b b b d d d' 't t t t t b b b b d d d'; }
    /* La case déborde sur ses voisines (dessus et droite) : elle est posée sur la mosaïque, pas dedans. */
    .mos-n4 .mos-case, .mos-n5 .mos-case, .mos-n6 .mos-case { margin: -1.5rem -1.5rem 0 1.5rem; }
    .mos-rangee { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .mos-photo:hover :global(img) { transform: scale(1.04); }
  }
  /* Démo à photos de banque : la mention « Photo d’illustration » (Img) monte en haut de la photo, le bas est couvert
     par ce qui la chevauche. */
  .mos-photo :global(.ff-illustration) { top: 0.5rem; bottom: auto; }
</style>
