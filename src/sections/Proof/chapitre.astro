---
/**
 * Proof "chapitre" (style chapitre, relevé sur 23gradicoffee.com le 29 oct 2026, fiche docs/veille/styles/chapitre.md
 * § Construction, bloc 7 « Storia ») : le chapitre des preuves, dans la mise en page de l'histoire de la source.
 * La règle de chapitre (Chapitre), puis deux moitiés : à gauche, UNE PHOTO qui touche le bord gauche de l'écran (la
 * première réalisation du client, sinon son portrait), verticale ; à droite, centré, le titre en capitales fines (la note
 * Google, sinon l'ancienneté), puis les avis recopiés en chasse fixe et capitales, petit, chacun avec son auteur ; un
 * lien souligné vers la fiche Google. Au téléphone : la photo pleine largeur, puis le texte centré.
 * Rien d'inventé : sans note, avis ni photo, pas de chapitre.
 */
import { site } from '@/lib/site';
import Img from '@/components/Img.astro';
import Chapitre from '@/components/Chapitre.astro';

const google = site.proof.google;
const avis = site.proof.testimonials.slice(0, 3);
const photo = site.proof.gallery.find((g) => g.src !== site.about.portrait?.src) ?? site.about.portrait;
const titre = google ? `${google.rating.toFixed(1).replace('.', ',')}/5 sur Google, ${google.count} avis` : site.business.since ? `Depuis ${site.business.since}` : 'Avis';
const rien = !google && avis.length === 0;
---

{!rien && (
  <section id="proof" class="pt-10 pb-[var(--section-y)]" aria-labelledby="ch-proof-titre">
    <div class="px-4 md:px-5"><Chapitre type="proof" intitule="Avis" /></div>
    <div class="mt-16 grid items-center gap-12 md:mt-24 md:grid-cols-2 md:gap-0">
      {photo && (
        <figure class="ch-preuve-photo relative overflow-hidden">
          <Img src={photo.src} alt={photo.alt} class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 48rem) 40vw, 100vw" loading="lazy" />
        </figure>
      )}
      <div class:list={['px-6 text-center md:px-12', !photo && 'md:col-span-2']}>
        <h2 id="ch-proof-titre" class="ch-preuve-titre mx-auto font-display uppercase">{titre}</h2>
        {avis.length > 0 && (
          <ul class="mx-auto mt-10 max-w-[40ch] space-y-8" role="list">
            {avis.map((a) => (
              <li>
                <blockquote class="text-xs uppercase leading-relaxed">« {a.text} »</blockquote>
                <p class="mt-3 font-display text-sm uppercase">{a.author}{a.city && `, ${a.city}`}</p>
              </li>
            ))}
          </ul>
        )}
        {google && <a href={google.url} target="_blank" rel="noopener" class="mt-10 inline-block font-mono text-xs uppercase underline underline-offset-4">Tous les avis sur Google</a>}
      </div>
    </div>
  </section>
)}

<style>
  .ch-preuve-photo { aspect-ratio: 4 / 5; }
  @media (min-width: 48rem) { .ch-preuve-photo { width: 80%; } }
  .ch-preuve-titre { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.6rem); line-height: 1; max-width: 18ch; }
</style>
