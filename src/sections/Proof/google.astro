---
/** Proof "google" : gros chiffre de note, etoiles proportionnelles, lien vers l'avis. Avis en dessous si fournis. */
import { site } from '@/lib/site';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
const google = site.proof.google;
const testimonials = site.proof.testimonials.slice(0, 3);
---

{google && (
  <section id="proof" class="section-y">
    <div class="container-ff">
      <div class="flex flex-col items-center text-center">
        <p class="text-base text-muted">Avis clients sur Google</p>
        <p class="mt-4 font-display text-display-lg">{google.rating.toFixed(1)}</p>
        <div class="mt-3 flex items-center gap-1" aria-hidden="true">
          {Array.from({ length: 5 }).map((_, i) => {
            const filled = i < Math.round(google.rating);
            return <Icon name="Star" size={22} class={filled ? 'text-accent fill-accent' : 'text-muted'} />;
          })}
        </div>
        <p class="mt-4 text-muted">{google.count} avis Google</p>
        <Button href={google.url} variant="ghost" size="md" class="mt-6">Voir les avis</Button>
      </div>

      {testimonials.length > 0 && (
        <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger="120">
          {testimonials.map((t) => (
            <figure class="card rounded-card bg-surface border border-line p-6 shadow-card" data-reveal>
              <blockquote class="text-fg">« {t.text} »</blockquote>
              <figcaption class="mt-4 text-sm text-muted">
                <span class="font-medium text-fg">{t.author}</span>{t.city && <>, {t.city}</>}, via {t.source}
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>
)}
