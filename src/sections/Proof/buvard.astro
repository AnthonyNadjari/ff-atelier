---
/**
 * Proof "buvard" (style buvard, relevé sur florawellnesscafe.com le 30 oct 2026, fiche docs/veille/styles/buvard.md
 * § Construction, bloc 7 « The Daily Pour ») : à gauche (4/12), le titre « Avis » en caslon, la note Google en machine à
 * écrire et l'étiquette rouge « Lire les avis » ; à droite, les avis comme les articles de la source : chacun sous une
 * photo verticale de la galerie (3:4), avec l'auteur en caslon gras et, à droite sur la même ligne, la source en machine
 * à écrire (« GOOGLE »), puis l'avis en petit corps. Deux avis au plus. Au téléphone : le titre, puis les avis en piste
 * horizontale native (défilement aimanté, au doigt). Puis le filet tremblé.
 * Avant, LA RANGÉE (« Flora Merch » de la source : quatre produits en rangée, légendes en machine à écrire) : sous le titre
 * wording.galleryTitle, quatre photos 4:5 de la galerie au plus, légendées par leur type et leur lieu s'ils sont donnés ;
 * piste au doigt au téléphone. Il faut trois photos libres au moins, sinon pas de rangée.
 * Rien d'inventé : sans avis ni note, pas de section ; un avis sans photo libre garde son texte seul (jamais une photo de
 * prestation déjà montrée) ; ni étoile, ni carte.
 */
import { site } from '@/lib/site';
import Button from '@/components/Button.astro';
import Img from '@/components/Img.astro';
import FiletTremble from '@/components/FiletTremble.astro';

const google = site.proof.google;
const avis = site.proof.testimonials.slice(0, 2);
// Photos déjà montrées : le premier écran, puis celles d'About/buvard (le portrait ou la première de la galerie, puis la suivante).
const galerie = site.proof.gallery.filter((g) => g.src !== site.images.hero?.src);
const p1 = site.about.portrait ?? galerie[0];
const p2 = galerie.find((g) => g.src !== p1?.src);
const libres = galerie.filter((g) => g.src !== p1?.src && g.src !== p2?.src);
// Jamais de photo au-dessus d'un avis nommé (elle passerait pour le portrait du client) : la rangée « au comptoir »
// (la rangée de produits de la source) prend les quatre premières photos libres.
const rangee = libres.slice(0, 4);
const legende = (g: { kind?: string; place?: string }) => [g.kind, g.place].filter(Boolean).join(', ');
---

{rangee.length >= 3 && (
  <section class="buvard-large buvard-rangee pt-[var(--section-y)]" aria-labelledby="buvard-rangee-titre">
    <h2 id="buvard-rangee-titre" class="buvard-titre">{site.wording.galleryTitle}</h2>
    <ul class="buvard-rangee-liste mt-6" tabindex="0" aria-label={site.wording.galleryTitle}>
      {rangee.map((g) => (
        <li>
          <figure class="m-0">
            <span class="relative block aspect-[4/5] overflow-hidden">
              <Img src={g.src} alt={g.alt} class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 48rem) 24vw, 46vw" loading="lazy" />
            </span>
            {legende(g) && <figcaption class="mt-2 text-center font-mono text-[0.75rem] uppercase">{legende(g)}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
    <FiletTremble class="mt-14 md:mt-16" variante={2} />
  </section>
)}
{(avis.length > 0 || google) && (
  <section id="proof" class="buvard-large pt-[var(--section-y)]" aria-labelledby="buvard-avis-titre">
    <div class="grid gap-8 md:grid-cols-12 md:gap-x-10">
      <div class="md:col-span-4">
        <h2 id="buvard-avis-titre" class="buvard-titre">Avis</h2>
        {google && <p class="mt-3 font-mono text-[0.8125rem] uppercase">{google.rating.toFixed(1).replace('.', ',')}/5 sur Google, {google.count} avis</p>}
        {google && <div class="mt-5"><Button href={google.url} variant="primary" size="sm" target="_blank" rel="noopener">Lire les avis</Button></div>}
      </div>
      {avis.length > 0 && (
        <ul class="buvard-avis md:col-span-8" tabindex="0" aria-label="Avis des clients">
          {avis.map((t) => (
            <li class="buvard-un-avis">
              <p class="flex items-baseline justify-between gap-4">
                <span class="text-lg">{t.author}{t.city && `, ${t.city}`}</span>
                <span class="font-mono text-[0.75rem] uppercase">{t.source}</span>
              </p>
              <blockquote class="mt-2 text-[0.9375rem] leading-snug">«&nbsp;{t.text}&nbsp;»</blockquote>
            </li>
          ))}
        </ul>
      )}
    </div>
    <FiletTremble class="mt-14 md:mt-16" variante={1} />
  </section>
)}

<style>
  .buvard-large { width: 100%; padding-inline: clamp(1.25rem, 2.8vw, 2.5rem); }
  .buvard-titre { font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem); line-height: 1.02; }
  .buvard-avis { display: grid; grid-auto-flow: column; grid-auto-columns: 72%; gap: 1.25rem; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0; padding: 0; list-style: none; }
  .buvard-un-avis { scroll-snap-align: start; }
  .buvard-rangee-liste { display: grid; grid-auto-flow: column; grid-auto-columns: 46%; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; margin: 0; padding: 0; list-style: none; }
  .buvard-rangee-liste > li { scroll-snap-align: start; }
  @media (min-width: 48rem) { .buvard-rangee-liste { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; gap: 1.5rem; } }
  @media (min-width: 48rem) {
    .buvard-avis { grid-auto-flow: row; grid-template-columns: 1fr 1fr; grid-auto-columns: auto; overflow: visible; gap: 2.5rem; }
  }
</style>
