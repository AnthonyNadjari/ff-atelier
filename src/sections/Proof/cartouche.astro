---
/**
 * Proof "cartouche" (style cartouche, relevé sur hotel-gilbert.at le 30 oct 2026, fiche docs/veille/styles/cartouche.md
 * § Construction, blocs 5 et 8) : LE PAPIER QUADRILLÉ. Une bande pleine largeur quadrillée de filets cobalt pâles (le
 * « Waiting for you » de la source, en tokens : dégradés de --line à 18 %), le titre en serif d'affiche en capitales, centré ;
 * puis les avis recopiés, chacun dans un cartouche blanc à filet cobalt posé sur le quadrillage (l'avis à la machine à écrire,
 * l'auteur et sa ville en capitales étroites) ; la note Google dans un dernier cartouche, comme le « Empfohlen auf
 * Tripadvisor » de la source, avec son lien encadré.
 * Rien d'inventé : avis recopiés seulement (trois au plus) ; sans avis ni note, pas de section ; aucune étoile dessinée.
 */
import { site } from '@/lib/site';

const google = site.proof.google;
const avis = site.proof.testimonials.slice(0, 3);
---

{(avis.length > 0 || google) && (
  <section id="proof" class="cartouche-quadrille section-y" aria-labelledby="cartouche-avis-titre">
    <h2 id="cartouche-avis-titre" class="cartouche-h2 font-display px-4 text-center">Ils sont passés</h2>
    <ul class="mx-auto mt-12 grid max-w-6xl gap-10 px-5 md:grid-cols-3 md:gap-8">
      {avis.map((t) => (
        <li class="cartouche-avis">
          <blockquote>«&nbsp;{t.text}&nbsp;»</blockquote>
          <p class="mt-5 font-[family-name:var(--font-mono)] text-lg uppercase leading-none text-fg">{t.author}{t.city && <span class="mt-1 block text-sm text-muted">{t.city}</span>}</p>
        </li>
      ))}
    </ul>
    {google && (
      <div class="cartouche-avis mx-auto mt-14 w-[min(20rem,86%)]">
        <p class="font-[family-name:var(--font-display)] text-2xl uppercase leading-tight text-fg">Recommandé sur Google</p>
        <p class="mt-2">{google.rating.toFixed(1).replace('.', ',')}/5, {google.count} avis</p>
        <a href={google.url} target="_blank" rel="noopener" class="cartouche-lien">Lire les avis</a>
      </div>
    )}
  </section>
)}

<style>
  .cartouche-h2 { font-size: clamp(2.4rem, 1.6rem + 3vw, 4.5rem); line-height: 1; }
  /* Le quadrillage : cases de 6 rem, filets cobalt pâles (tokens seulement). */
  .cartouche-quadrille {
    --q: color-mix(in srgb, var(--line) 18%, transparent);
    background-color: var(--bg);
    background-image: linear-gradient(var(--q) 1px, transparent 1px), linear-gradient(90deg, var(--q) 1px, transparent 1px);
    background-size: 6rem 6rem;
    background-position: center top;
    border-block: 1px solid var(--line);
  }
  .cartouche-avis { position: relative; background: var(--surface); border: 1px solid var(--line); padding: 1.75rem 1.5rem 2.75rem; text-align: center; }
  .cartouche-lien {
    position: absolute; left: 50%; bottom: 0; transform: translate(-50%, 50%);
    display: inline-flex; align-items: center; gap: 1rem; white-space: nowrap;
    border: 1px solid var(--line); background: var(--surface); color: var(--fg);
    padding: 0.6rem 1rem; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.02em;
  }
  .cartouche-lien::after { content: ''; width: 2.25rem; height: 1px; background: currentColor; transition: width var(--motion-ui) var(--ease-brand); }
  .cartouche-lien:hover::after, .cartouche-lien:focus-visible::after { width: 3.25rem; }
</style>
