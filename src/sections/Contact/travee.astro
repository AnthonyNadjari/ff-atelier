---
/**
 * Contact "travee" (style travee, relevé sur driessenarchitectuur.nl le 31 oct 2026, fiche docs/veille/styles/travee.md
 * § Construction, blocs 7 et 8) : la fin de page de la source, sans formulaire, sans bandeau d'appel ni barre basse.
 * LA FIN NOIRE : un bloc noir d'encre (--ink) pleine largeur ; à gauche la phrase d'appel en grand corps blanc
 * (wording.contactTitle), dessous en petit la phrase de contact (wording.contactText), puis les portes : Appeler le
 * numéro (bouton blanc plein), Écrire (au trait, si un e-mail est donné), Prendre rendez-vous (contact.bookingUrl, au
 * trait, s'il est donné) ; plus bas, en trois petites colonnes comme le pied de la source : l'adresse (et « Voir sur le
 * plan » si contact.mapsUrl), les horaires, la ligne directe. À droite, la photo de l'équipe ou de la personne
 * (about.portrait, sinon la photo du premier membre de l'équipe) en grand, 4:5, qui DESCEND sous le bas du bloc noir et
 * chevauche le pied clair (la source pose ses photos de l'agence à cheval sur ses blocs).
 * Rien d'inventé : chaque ligne disparaît sans sa donnée ; sans portrait, la phrase prend toute la largeur.
 */
import { site, tel, mailto, fullAddress } from '@/lib/site';
import Img from '@/components/Img.astro';

const photo = site.about.portrait ?? site.about.team.find((m) => m.photo)?.photo;
const adresse = site.contact.address ? fullAddress() : '';
const horaires = site.contact.hours;
const ecrire = mailto();
const rdv = site.contact.bookingUrl;
---

<section id="contact" class:list={['travee-fin', photo && 'travee-fin-photo']} aria-labelledby="travee-fin-titre">
  <div class="travee-marges grid gap-10 md:grid-cols-12 md:gap-x-6">
    <div class:list={[photo ? 'md:col-span-6' : 'md:col-span-9']}>
      <h2 id="travee-fin-titre" class="travee-fin-h2" set:html={site.wording.contactTitle} />
      {site.wording.contactText && <p class="mt-5 max-w-[42ch] text-[0.9375rem] leading-[1.55]">{site.wording.contactText}</p>}
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={tel()} class="btn travee-fin-pleine inline-flex items-center px-4 py-2 font-medium whitespace-nowrap">Appeler le {site.contact.phoneDisplay}</a>
        {ecrire && <a href={ecrire} class="btn btn-ghost inline-flex items-center px-4 py-2 font-medium whitespace-nowrap">Écrire</a>}
        {rdv && <a href={rdv} class="btn btn-ghost inline-flex items-center px-4 py-2 font-medium whitespace-nowrap" target="_blank" rel="noopener">{site.wording.actions?.booking ?? 'Prendre rendez-vous'}</a>}
      </div>
      <dl class="travee-fin-infos mt-12">
        {adresse && (
          <div>
            <dt>Adresse</dt>
            <dd>{site.business.name}<br />{adresse}{site.contact.mapsUrl && <><br /><a href={site.contact.mapsUrl} target="_blank" rel="noopener" class="underline underline-offset-4">Voir sur le plan</a></>}</dd>
          </div>
        )}
        {horaires.length > 0 && (
          <div>
            <dt>Horaires</dt>
            <dd>{horaires.map((h) => <>{h.days}, {h.hours}<br /></>)}</dd>
          </div>
        )}
        <div>
          <dt>Ligne directe</dt>
          <dd><a href={tel()} class="whitespace-nowrap underline underline-offset-4">{site.contact.phoneDisplay}</a>{site.contact.email && <><br /><a href={ecrire} class="break-all underline underline-offset-4">{site.contact.email}</a></>}</dd>
        </div>
      </dl>
    </div>
    {photo && (
      <figure class="travee-fin-figure md:col-span-5 md:col-start-8">
        <span class="relative block aspect-[4/5] overflow-hidden">
          <Img src={photo.src} alt={photo.alt} class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 48rem) 40vw, 92vw" loading="lazy" />
        </span>
      </figure>
    )}
  </div>
</section>

<style>
  .travee-fin { background: var(--ink); color: var(--on-ink); padding-block: var(--section-y); }
  .travee-fin-photo { margin-bottom: clamp(4rem, 10vw, 9rem); padding-bottom: 0; }
  .travee-marges { width: 100%; padding-inline: clamp(1.25rem, 2.6vw, 2.5rem); }
  .travee-fin-h2 { font-size: clamp(2rem, 1.3rem + 2.6vw, 3.6rem); line-height: 1.04; max-width: 17ch; text-wrap: balance; color: var(--on-ink); }
  .travee-fin-pleine { background: var(--on-ink); color: var(--ink); }
  .travee-fin-pleine:hover { background: var(--surface); }
  .travee-fin-infos { display: grid; gap: 1.5rem; font-size: 0.8125rem; line-height: 1.6; }
  @media (min-width: 40rem) { .travee-fin-infos { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .travee-fin-infos dt { opacity: 0.75; margin-bottom: 0.35rem; }
  .travee-fin-infos a:focus-visible, .travee-fin a.btn:focus-visible { outline: 2px solid var(--on-ink); outline-offset: 2px; }
  /* La photo descend sous le bloc noir et chevauche le blanc qui suit. */
  .travee-fin-figure { margin: 0; align-self: end; margin-bottom: calc(-1 * clamp(4rem, 10vw, 9rem)); position: relative; z-index: 1; }
</style>
