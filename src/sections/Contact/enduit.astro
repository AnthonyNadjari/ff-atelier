---
/**
 * Contact "enduit" (style enduit, relevé sur bcgbuildingdesign.com.au le 29 oct 2026, fiche docs/veille/styles/enduit.md
 * § Construction, bloc 7, le pied de la source) : la page finit SUR LE CRÈME, sans bandeau d'appel ni carte. Sous un
 * filet, une rangée de colonnes en petit corps : les réseaux du client, ses coordonnées (téléphone, e-mail, adresse), ses
 * horaires ; à droite (5/12) la phrase de contact (wording.contactTitle) en grotesque de graisse moyenne, le lien
 * « Appeler le … » sur son filet et le formulaire du site posé à plat (la porte Devis du premier écran y arrive). En
 * bas, le NOM du client en lettres géantes brunes sur le crème (la marque de la source répétée en pied), avec le métier
 * à la ville en petit à droite.
 * Rien d'inventé : chaque colonne disparaît sans sa donnée ; pas de formulaire si le site n'en a pas. Mouvement : aucun
 * (le nom a déjà monté dans la bande brune de la présentation).
 */
import { site, tel, mailto, fullAddress, metierEtVille } from '@/lib/site';
import Button from '@/components/Button.astro';
import ContactForm from '@/components/ContactForm.astro';

const adresse = site.contact.address ? fullAddress() : '';
const horaires = site.contact.hours;
const formulaire = site.form.provider !== 'none';
const reseaux = Object.entries(site.social).filter(([, v]) => v) as [string, string][];
const noms: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', tiktok: 'TikTok', youtube: 'YouTube', pinterest: 'Pinterest' };
const nom = site.business.name;
// Un nom de plusieurs mots passe à une ligne par mot (le plus long fixe la taille) : les lettres restent géantes.
const mots = nom.length > 9 ? nom.split(/\s+/) : [nom];
const taille = Math.min(20, 118 / Math.max(...mots.map((m) => m.length), 4)).toFixed(1);
---

<section id="contact" class="enduit-contact" aria-labelledby="enduit-contact-titre">
  <div class="enduit-large grid gap-10 border-t border-fg pt-10 pb-16 text-sm leading-relaxed md:grid-cols-12 md:gap-6 md:pb-24">
    {reseaux.length > 0 && (
      <ul class="md:col-span-2">
        {reseaux.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener" class="hover:underline underline-offset-4">{noms[k] ?? k}</a></li>)}
      </ul>
    )}
    <ul class:list={['md:col-span-3', reseaux.length === 0 && 'md:col-start-1']}>
      <li><a href={tel()} class="hover:underline underline-offset-4">{site.contact.phoneDisplay}</a></li>
      {site.contact.email && <li><a href={mailto()} class="break-all hover:underline underline-offset-4">{site.contact.email}</a></li>}
      {adresse && <li class="mt-3 text-muted">{adresse}</li>}
    </ul>
    {horaires.length > 0 && (
      <dl class="grid grid-cols-[auto_1fr] content-start gap-x-4 md:col-span-2">
        {horaires.map((h) => (
          <>
            <dt>{h.days}</dt>
            <dd class="text-muted">{h.hours}</dd>
          </>
        ))}
      </dl>
    )}
    <div class="md:col-span-5 md:col-start-8">
      <h2 id="enduit-contact-titre" class="enduit-contact-phrase" set:html={site.wording.contactTitle} />
      {site.wording.contactText && <p class="mt-4 max-w-[40ch] text-base text-muted">{site.wording.contactText}</p>}
      <div class="mt-6 flex flex-col gap-3">
        <Button href={tel()} variant="ghost" size="sm" class="w-full">Appeler le {site.contact.phoneDisplay}</Button>
        {site.contact.email && <Button href={mailto()} variant="ghost" size="sm" class="w-full">Écrire</Button>}
      </div>
      {formulaire && (
        <div class="enduit-form mt-10">
          <ContactForm compact idPrefix="enduit" />
        </div>
      )}
    </div>
  </div>
  <div class="enduit-large flex flex-col gap-2 pb-6 md:flex-row md:items-end md:justify-between">
    <p class="enduit-nom-pied font-display" style={`font-size: ${taille}vw;`}>{mots.map((m) => <span class="block">{m}</span>)}</p>
    <p class="text-sm md:pb-[1.5vw]">{metierEtVille().replace(/\.$/, '')}</p>
  </div>
</section>

<style>
  /* Cadre de la source : toute la largeur de l'écran, marge de 16 à 28 px (gouttière mesurée 22 px à 1 440 px). */
  .enduit-large { width: 100%; padding-inline: clamp(1rem, 1.6vw, 1.75rem); }
  .enduit-contact-phrase { font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem); line-height: 1.1; font-weight: 500; }
  .enduit-nom-pied { font-weight: 600; line-height: 0.8; letter-spacing: -0.045em; white-space: nowrap; color: var(--fg); }
  .enduit-form :global(input), .enduit-form :global(select), .enduit-form :global(textarea) { background: var(--surface); border-radius: var(--radius); }
</style>
