---
/**
 * Contact "rideau" (style rideau, relevé sur holographik.space le 30 oct 2026, fiche docs/veille/styles/rideau.md
 * § Construction, bloc 5, le pied de la source) : après les écrans noirs, LA PAGE SE RALLUME. Un bloc gris très pâle
 * (--ink, #f1f1f1 mesuré) où les tokens s'inversent : en haut à gauche le titre de contact en grotesque moyenne ; puis
 * quatre colonnes en petit corps comme le pied de la source : le nom, l'adresse, l'e-mail et le téléphone ; les horaires
 * en tableau (jour à gauche, heures à droite) ; la porte (réservation en ligne du client s'il en a une, sinon Appeler,
 * en plaque) ; les réseaux. Pas de formulaire (la source n'en a pas : le pied donne les coordonnées et la porte).
 * Rien d'inventé : chaque colonne disparaît sans sa donnée ; pas d'heure locale
 * (gadget de la source, refusé).
 */
import { site, tel, mailto, fullAddress } from '@/lib/site';
import Button from '@/components/Button.astro';

const adresse = site.contact.address ? fullAddress() : '';
const horaires = site.contact.hours;
const porte = site.contact.bookingUrl ?? tel();
const porteLibelle = site.contact.bookingUrl ? site.wording.devis : `Appeler le ${site.contact.phoneDisplay}`;
const reseaux = Object.entries(site.social).filter(([, v]) => v) as [string, string][];
const noms: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', tiktok: 'TikTok', youtube: 'YouTube', pinterest: 'Pinterest' };
---

<section id="contact" class="rideau-clair" aria-labelledby="rideau-contact-titre">
  <div class="rideau-marges pt-[var(--section-y)] pb-12">
    <h2 id="rideau-contact-titre" class="rideau-h2 max-w-[22ch]" set:html={site.wording.contactTitle} />
    {site.wording.contactText && <p class="mt-3 max-w-[50ch] text-base text-muted">{site.wording.contactText}</p>}
    <div class="mt-16 grid gap-10 text-[0.9375rem] leading-snug md:grid-cols-12 md:gap-5">
      <div class="md:col-span-3">
        <p class="font-medium">{site.business.name}</p>
        {adresse && <p class="text-muted">{adresse}</p>}
        <p class="mt-2"><a href={tel()} class="inline-block py-1.5 hover:underline underline-offset-4">{site.contact.phoneDisplay}</a></p>
        {site.contact.email && <p><a href={mailto()} class="inline-block break-all py-1.5 hover:underline underline-offset-4">{site.contact.email}</a></p>}
      </div>
      {horaires.length > 0 && (
        <div class="md:col-span-4">
          <p class="font-medium">Horaires</p>
          <dl class="mt-1 grid grid-cols-[auto_1fr] gap-x-6">
            {horaires.map((h) => (<><dt>{h.days}</dt><dd class="text-muted">{h.hours}</dd></>))}
          </dl>
        </div>
      )}
      <div class="md:col-span-3">
        <p class="font-medium">{site.wording.devis}</p>
        <div class="mt-3"><Button href={porte} variant="primary" size="sm">{porteLibelle}</Button></div>
      </div>
      {reseaux.length > 0 && (
        <ul class="md:col-span-2 md:text-right">
          {reseaux.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener" class="inline-block py-1.5 hover:underline underline-offset-4">{noms[k] ?? k}</a></li>)}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .rideau-marges { width: 100%; padding-inline: clamp(0.625rem, 1.4vw, 1.25rem); }
  .rideau-h2 { font-size: clamp(1.4rem, 1.1rem + 0.9vw, 1.75rem); line-height: 1.12; }
  /* Le bloc clair : les tokens s'inversent localement (le pied de la source, gris très pâle, texte noir). */
  .rideau-clair {
    --bg: var(--ink);
    --surface: var(--ink);
    --fg: var(--on-ink);
    --muted: color-mix(in srgb, var(--on-ink) 66%, var(--ink));
    --line: color-mix(in srgb, var(--on-ink) 22%, var(--ink));
    --accent: var(--on-ink);
    --on-accent: var(--ink);
    background: var(--bg);
    color: var(--fg);
    color-scheme: light;
    padding-bottom: 5rem;
  }
  @media (min-width: 64rem) { .rideau-clair { padding-bottom: 0; } }
</style>
