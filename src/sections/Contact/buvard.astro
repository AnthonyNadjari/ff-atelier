---
/**
 * Contact "buvard" (style buvard, relevé sur florawellnesscafe.com le 30 oct 2026, fiche docs/veille/styles/buvard.md
 * § Construction, bloc 8, le pied de la source) : la page finit SUR LA LIE-DE-VIN (--ink), texte crème. À gauche, la
 * phrase de contact (wording.contactTitle) en caslon, une ligne de texte, les étiquettes Appeler et Écrire (pas de
 * formulaire : le pied de la source est fait de coordonnées et de liens) ; à droite, les
 * deux colonnes de la source en petit corps, titrées en machine à écrire : « Nous trouver » (adresse, horaires, téléphone,
 * e-mail, réseaux) et « Pages » (accueil, prestations, mentions). Puis la ligne des mentions (Footer/bande).
 * Rien d'inventé : chaque ligne disparaît sans sa donnée. Mouvement : aucun.
 */
import { site, tel, mailto, fullAddress } from '@/lib/site';

const adresse = site.contact.address ? fullAddress() : '';
const horaires = site.contact.hours;
const reseaux = Object.entries(site.social).filter(([, v]) => v) as [string, string][];
const noms: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', tiktok: 'TikTok', youtube: 'YouTube', pinterest: 'Pinterest' };
---

<section id="contact" class="buvard-fin mt-[var(--section-y)] bg-ink text-on-ink" aria-labelledby="buvard-contact-titre">
  <div class="buvard-large grid gap-12 py-12 md:grid-cols-12 md:gap-x-10 md:py-16">
    <div class="md:col-span-5">
      <h2 id="buvard-contact-titre" class="buvard-titre" set:html={site.wording.contactTitle} />
      {site.wording.contactText && <p class="mt-3 max-w-[40ch] text-[0.9375rem] leading-snug">{site.wording.contactText}</p>}
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={tel()} class="buvard-etiquette font-mono">Appeler le {site.contact.phoneDisplay}</a>
        {site.contact.email && <a href={mailto()} class="buvard-etiquette font-mono">Écrire</a>}
      </div>
    </div>
    <div class="grid content-start gap-10 text-[0.9375rem] leading-snug sm:grid-cols-2 md:col-span-6 md:col-start-7">
      <div>
        <p class="buvard-mono font-mono">Nous trouver</p>
        <ul class="mt-3 grid gap-1">
          {adresse && <li>{adresse}</li>}
          {horaires.map((h) => <li>{h.days} : {h.hours}</li>)}
          <li class="mt-2"><a href={tel()} class="underline underline-offset-4">{site.contact.phoneDisplay}</a></li>
          {site.contact.email && <li><a href={mailto()} class="break-all underline-offset-4 hover:underline">{site.contact.email}</a></li>}
          {reseaux.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener" class="underline-offset-4 hover:underline">{noms[k] ?? k}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="buvard-mono font-mono">Pages</p>
        <ul class="mt-3 grid gap-1">
          <li><a href="/" class="underline-offset-4 hover:underline">Accueil</a></li>
          {site.services.map((s) => <li><a href={`/services/${s.slug}`} class="underline-offset-4 hover:underline">{s.title}</a></li>)}
          <li><a href="/mentions-legales" class="underline-offset-4 hover:underline">Mentions légales</a></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .buvard-large { width: 100%; padding-inline: clamp(1.25rem, 2.8vw, 2.5rem); }
  .buvard-titre { font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem); line-height: 1.02; max-width: 18ch; }
  .buvard-mono { font-size: 0.8125rem; text-transform: uppercase; }
  .buvard-etiquette {
    display: inline-flex; padding: 0.4rem 0.75rem; border: 1px solid currentColor; font-weight: 700;
    font-size: 0.8125rem; text-transform: uppercase; transition: background var(--motion-ui) var(--ease-brand), color var(--motion-ui) var(--ease-brand);
  }
  .buvard-etiquette:hover { background: var(--on-ink); color: var(--ink); }
</style>
