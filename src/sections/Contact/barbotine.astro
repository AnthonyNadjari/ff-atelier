---
/**
 * Contact "barbotine" (style barbotine, relevé sur laboroflovestudio.com le 30 oct 2026, fiche docs/veille/styles/barbotine.md
 * § Construction, bloc 7 « Learn With Us ») : L'INVITATION SUR SA CARTE. Une bande sable (--sable) d'un écran, et posée au
 * milieu une grande carte crème à 12 px de rayon (66 % de la largeur à l'ordinateur) : le logo du client s'il en a un, le
 * titre du contact (wording.contactTitle) centré en serif vert géant, la phrase (wording.contactText) ou le métier à la
 * ville, puis les coordonnées centrées (téléphone en grand, e-mail, adresse, horaires) et deux portes : le bouton plein
 * Appeler et le lien à point « Demander un devis par e-mail ». Courte comme la source : pas de formulaire générique.
 * Puis, comme la source (« Hear from our students » après « Learn With Us »), LES AVIS SUR CARTES JAUNES : titre centré en
 * serif vert, la note Google en une ligne, puis une rangée de cartes jaune d'ocre (--email-signal) à 12 px de rayon, l'avis
 * recopié en petit corps charbon, l'auteur en serif et sa ville et sa source dessous ; la rangée défile au doigt ou à la
 * molette (piste native aimantée, atteignable au clavier, jamais seule) et ses deux bords se fondent dans le crème ; le lien
 * vers la fiche Google. Avis recopiés seulement, aucune étoile dessinée ; sans avis ni note, pas de rangée.
 * La source pose une texture de toile sur le sable : refusée (grain et texture, GOUT § 2), le sable reste uni.
 * Rien d'inventé : chaque ligne disparaît sans sa donnée. Mouvement : aucun.
 */
import { site, tel, mailto, fullAddress, metierEtVille } from '@/lib/site';
import Button from '@/components/Button.astro';
import Img from '@/components/Img.astro';

const adresse = site.contact.address ? fullAddress() : '';
const horaires = site.contact.hours;
const logo = site.images.logo;
const google = site.proof.google;
const avis = site.proof.testimonials.slice(0, 8);
---

<section id="contact" class="barbotine-contact" aria-labelledby="barbotine-contact-titre">
  <div class="container-ff py-[calc(var(--section-y)*1.2)]">
    <div class="barbotine-carte-invit mx-auto max-w-[60rem] text-center">
      {logo && <Img src={logo.src} alt={logo.alt} class="mx-auto h-16 w-auto" sizes="160px" loading="lazy" />}
      <h2 id="barbotine-contact-titre" class="barbotine-contact-titre mx-auto mt-6" set:html={site.wording.contactTitle} />
      <p class="mx-auto mt-6 max-w-[44ch] text-base leading-relaxed md:text-lg">{site.wording.contactText ?? metierEtVille()}</p>
      <p class="mt-8"><a href={tel()} class="barbotine-tel font-display">{site.contact.phoneDisplay}</a></p>
      <ul class="mt-4 space-y-1 text-base">
        {site.contact.email && <li><a href={mailto()} class="break-all underline underline-offset-4">{site.contact.email}</a></li>}
        {adresse && <li>{adresse}</li>}
      </ul>
      {horaires.length > 0 && (
        <dl class="mx-auto mt-6 grid max-w-[26rem] grid-cols-[auto_1fr] gap-x-6 gap-y-1 text-left text-sm md:text-base">
          {horaires.map((h) => (
            <>
              <dt class="font-bold">{h.days}</dt>
              <dd>{h.hours}</dd>
            </>
          ))}
        </dl>
      )}
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-8">
        <Button href={tel()} variant="primary" size="md">Appeler l’atelier</Button>
        {site.contact.email && <Button href={`${mailto()}?subject=${encodeURIComponent(site.wording.devis)}`} variant="ghost" size="sm">{site.wording.devis} par e-mail</Button>}
      </div>
    </div>
  </div>
</section>

{(avis.length > 0 || google) && (
  <section id="avis" class="barbotine-avis section-y" aria-labelledby="barbotine-avis-titre">
    <div class="container-ff text-center">
      <h2 id="barbotine-avis-titre" class="barbotine-contact-titre mx-auto">Ce qu’en disent les clients</h2>
      {google && <p class="mt-5 text-base md:text-lg">{google.rating.toFixed(1).replace('.', ',')}/5 sur Google, {google.count} avis</p>}
    </div>
    {avis.length > 0 && (
      <ul class="barbotine-piste mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto md:mt-16 md:gap-7" tabindex="0" aria-label="Avis des clients">
        {avis.map((t) => (
          <li class="barbotine-carte-jaune shrink-0 snap-center">
            <blockquote class="text-sm leading-relaxed md:text-base">«&nbsp;{t.text}&nbsp;»</blockquote>
            <p class="mt-8 font-display text-xl">{t.author}</p>
            <p class="mt-1 text-sm">{[t.city, t.source].filter(Boolean).join(', ')}</p>
          </li>
        ))}
      </ul>
    )}
    {google && (
      <div class="mt-10 text-center"><Button href={google.url} variant="ghost" size="sm" target="_blank" rel="noopener">Lire les avis sur Google</Button></div>
    )}
  </section>
)}

<style>
  .barbotine-contact { background: var(--sable); }
  .barbotine-carte-invit { background: var(--bg); border-radius: var(--radius-card); padding: clamp(2.5rem, 6vw, 5.5rem) clamp(1.1rem, 5vw, 5rem); }
  .barbotine-contact-titre { color: var(--accent); font-size: clamp(2.4rem, 1.6rem + 3vw, 4.1rem); line-height: 1.02; max-width: 16ch; text-wrap: balance; }
  .barbotine-tel { font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.6rem); color: var(--accent); text-decoration: none; }
  .barbotine-tel:hover { text-decoration: underline; text-underline-offset: 0.15em; text-decoration-thickness: 1px; }
  /* La rangée d'avis : cartes jaunes de 23 rem, bords de la rangée fondus dans le crème (masque), padding pour que la
     première et la dernière carte se centrent. */
  .barbotine-piste {
    padding-inline: max(1rem, calc(50vw - 36rem));
    scroll-padding-inline: max(1rem, calc(50vw - 36rem));
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-mask-image: linear-gradient(to right, transparent, black 9%, black 91%, transparent);
    mask-image: linear-gradient(to right, transparent, black 9%, black 91%, transparent);
  }
  .barbotine-piste::-webkit-scrollbar { display: none; }
  @media (max-width: 47.99rem) { .barbotine-piste { -webkit-mask-image: none; mask-image: none; } }
  .barbotine-carte-jaune { width: min(82vw, 25rem); background: var(--email-signal); color: var(--fg); border-radius: var(--radius-card); padding: 1.4rem 1.4rem 1.5rem; display: flex; flex-direction: column; }
  .barbotine-carte-jaune blockquote { flex: 1; }
</style>
