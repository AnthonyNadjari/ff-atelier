---
/**
 * Contact "cartouche" (style cartouche, relevé sur hotel-gilbert.at le 30 oct 2026, fiche docs/veille/styles/cartouche.md
 * § Construction, blocs 7 et 9, le pied de la source), sans formulaire, comme la source :
 * 1. LA BANDE COBALT : pleine largeur, le titre de contact (wording.contactTitle) en serif d'affiche en capitales, blanc,
 *    centré ; dessous, centrés en capitales étroites blanches, l'adresse, le téléphone et l'e-mail (liens).
 * 2. LE PIED EN GRILLE DE CASES FILETÉES (trois colonnes à l'ordinateur, filets cobalt entre les cases et entre les rangées,
 *    tout centré) : première rangée, les prestations (liens vers leurs pages) ; au milieu, la case de la porte (le libellé
 *    wording.devis en capitales étroites et le lien encadré vers la réservation en ligne du client, sinon l'e-mail, sinon
 *    le téléphone) ; les horaires. Deuxième rangée : les réseaux, le nom en serif d'affiche, les pages légales.
 * Rien d'inventé : chaque case disparaît sans sa donnée ; pas de logos de labels.
 */
import { site, tel, mailto, fullAddress } from '@/lib/site';

const adresse = site.contact.address ? fullAddress() : '';
const horaires = site.contact.hours;
const reseaux = Object.entries(site.social).filter(([, v]) => v) as [string, string][];
const noms: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', tiktok: 'TikTok', youtube: 'YouTube', pinterest: 'Pinterest' };
const porte = site.contact.bookingUrl ?? mailto() ?? tel();
---

<section id="contact" class="cartouche-contact" aria-labelledby="cartouche-contact-titre">
  <div class="cartouche-bleu px-5 py-14 text-center md:py-16">
    <h2 id="cartouche-contact-titre" class="cartouche-h2 font-display" set:html={site.wording.contactTitle} />
    <div class="cartouche-coord font-mono mt-8">
      {adresse && <p>{adresse}</p>}
      <p><a href={tel()} class="inline-block py-1 hover:underline underline-offset-4">Tél. {site.contact.phoneDisplay}</a></p>
      {site.contact.email && <p><a href={mailto()} class="inline-block break-all py-1 hover:underline underline-offset-4">{site.contact.email}</a></p>}
    </div>
  </div>
  <div class="cartouche-cases">
    <ul class="cartouche-case">
      {site.services.map((s) => <li><a href={`/services/${s.slug}`} class="cartouche-case-lien font-mono">{s.title}</a></li>)}
    </ul>
    <div class="cartouche-case">
      <p class="cartouche-case-titre font-mono">{site.wording.devis}</p>
      <a href={porte} class="cartouche-lien mt-5">{site.contact.bookingUrl ? 'Réserver' : site.contact.email ? 'Écrire' : 'Appeler'}</a>
    </div>
    {horaires.length > 0 ? (
      <div class="cartouche-case">
        <p class="cartouche-case-titre font-mono">Horaires</p>
        <dl class="mt-3 text-sm">
          {horaires.map((h) => (<><dt class="text-fg">{h.days}</dt><dd class="mb-2">{h.hours}</dd></>))}
        </dl>
      </div>
    ) : <div class="cartouche-case" aria-hidden="true"></div>}
    <ul class="cartouche-case">
      {reseaux.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener" class="cartouche-case-lien font-mono">{noms[k] ?? k}</a></li>)}
    </ul>
    <div class="cartouche-case">
      <p class="cartouche-nom-pied font-[family-name:var(--font-display)]">{site.business.name}</p>
    </div>
    <ul class="cartouche-case">
      <li><a href="/mentions-legales" class="cartouche-case-lien font-mono">Mentions légales</a></li>
      <li><a href="/confidentialite" class="cartouche-case-lien font-mono">Confidentialité</a></li>
    </ul>
  </div>
</section>

<style>
  .cartouche-h2 { font-size: clamp(2.2rem, 1.4rem + 3vw, 4.25rem); line-height: 1; }
  .cartouche-bleu { background: var(--ink); color: var(--on-ink); }
  .cartouche-bleu .cartouche-h2 { color: var(--on-ink); }
  .cartouche-coord { font-size: 1.25rem; line-height: 1.3; text-transform: uppercase; }
  /* La grille de cases filetées de la source : filets cobalt entre les cases et entre les rangées. */
  .cartouche-cases { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
  .cartouche-case { display: flex; min-height: 9rem; flex-direction: column; align-items: center; justify-content: center; gap: 0.25rem; padding: 1.75rem 1rem; border-top: 1px solid var(--line); text-align: center; }
  .cartouche-case:nth-child(odd) { border-right: 1px solid var(--line); }
  .cartouche-case:empty { display: none; }
  @media (min-width: 48rem) {
    .cartouche-cases { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .cartouche-case { border-right: 1px solid var(--line); min-height: 12rem; }
    .cartouche-case:nth-child(3n) { border-right: 0; }
    .cartouche-case:empty { display: flex; }
  }
  .cartouche-case-titre { font-size: 1.375rem; line-height: 1; text-transform: uppercase; color: var(--fg); }
  .cartouche-case-lien { display: inline-block; padding-block: 0.3rem; font-size: 1.0625rem; text-transform: uppercase; color: var(--fg); }
  .cartouche-case-lien:hover { text-decoration: underline; text-underline-offset: 4px; }
  .cartouche-nom-pied { font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem); line-height: 1; color: var(--fg); }
  .cartouche-lien {
    display: inline-flex; align-items: center; gap: 1rem; white-space: nowrap;
    border: 1px solid var(--line); background: var(--surface); color: var(--fg);
    padding: 0.6rem 1rem; font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.02em;
  }
  .cartouche-lien::after { content: ''; width: 2.25rem; height: 1px; background: currentColor; transition: width var(--motion-ui) var(--ease-brand); }
  .cartouche-lien:hover::after, .cartouche-lien:focus-visible::after { width: 3.25rem; }
</style>
