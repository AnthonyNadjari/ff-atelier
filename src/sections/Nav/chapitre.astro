---
/**
 * Nav "chapitre" (style chapitre, relevé sur 23gradicoffee.com le 29 oct 2026, fiche docs/veille/styles/chapitre.md
 * § Construction, bloc 1) : pas de barre, trois mots en chasse fixe et capitales posés en haut de la page, sur le fond :
 * « Menu » à gauche (details natif : la liste des chapitres et la porte Devis se déplient dessous, sans script), le nom
 * du client au centre en petit, le téléphone à droite (cliquable, visible sur téléphone et ordinateur : socle GOUT § 0).
 * Fixe, transparente ; un voile de la couleur de la page derrière, pour rester lisible sur les photos.
 */
import { site, navLinks, tel, hasContactDoor } from '@/lib/site';

const liens = navLinks();
---

<header data-nav class="ch-nav fixed inset-x-0 top-0 z-50 px-4 pt-4 pb-3 font-mono text-[0.72rem] uppercase md:px-5">
  <div class="grid grid-cols-3 items-start gap-2">
    <details class="ch-menu justify-self-start">
      <summary class="cursor-pointer list-none underline-offset-4 hover:underline">Menu</summary>
      <nav class="mt-3 flex flex-col gap-2 bg-bg p-3 pr-6" aria-label="Navigation principale">
        {liens.map((l) => <a href={l.href} class="underline-offset-4 hover:underline">{l.label}</a>)}
        {hasContactDoor(site) && !liens.some((l) => l.href === '/#contact') && <a href="/#contact" class="underline-offset-4 hover:underline">{site.wording.devis}</a>}
      </nav>
    </details>
    <a href="/" class="justify-self-center text-center">{site.business.name}</a>
    <a href={tel()} class="justify-self-end underline-offset-4 hover:underline" data-porte="call">{site.contact.phoneDisplay}</a>
  </div>
</header>

<style>
  .ch-nav { background: linear-gradient(to bottom, color-mix(in oklab, var(--bg) 85%, transparent), transparent); }
  .ch-menu summary::-webkit-details-marker { display: none; }
</style>

<script>
  import { onPage } from '@/scripts/page';
  // Un lien du menu choisi : le menu se replie.
  onPage(() => {
    document.querySelectorAll<HTMLDetailsElement>('.ch-menu').forEach((d) => d.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => d.removeAttribute('open'))));
  });
</script>
