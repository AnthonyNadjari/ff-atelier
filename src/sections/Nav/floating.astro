---
/**
 * Nav "floating" : barre flottante centree (desktop : liens + portes d'action). Mobile : barre nom + premiere porte + menu plein ecran.
 * Portes (actions()) : premiere en bouton plein, deuxieme en contour sur ordinateur, les suivantes en
 * liens texte ; sur telephone la premiere dans la barre, toutes en bas du menu plein ecran.
 */
import { site, navLinks, actions } from '@/lib/site';
import Porte from '@/components/Porte.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
const links = navLinks();
const portes = actions();
const [premiere, seconde] = portes;
// Ordinateur : liens texte apres les ancres (sans doublon : « Devis » saute si la nav a deja #contact).
const autres = portes.slice(2).filter((p) => !links.some((l) => l.href === p.href));
---

<header data-nav class="fixed inset-x-0 top-4 z-50">
  <div class="container-ff flex justify-center">
    <div class="w-full max-w-4xl mx-4 flex items-center justify-between gap-4 rounded-ui bg-surface px-5 py-3 shadow-card transition-shadow duration-500 [.is-scrolled_&]:shadow-lift">
      <a href="/" class="flex items-center gap-3 font-display text-base font-medium shrink-0">
        {site.images.logo ? <Img src={site.images.logo.src} alt={site.images.logo.alt} class="h-8 w-auto" sizes="200px" loading="eager" /> : <span>{site.business.name}</span>}
      </a>
      <nav class="hidden md:flex items-center gap-6 text-sm" aria-label="Navigation principale">
        {links.map((l) => <a href={l.href} class="text-muted hover:text-fg transition-colors">{l.label}</a>)}
        {autres.map((p) => <a href={p.href} class="text-muted hover:text-fg transition-colors" target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>{p.label}</a>)}
      </nav>
      <div class="hidden md:flex items-center gap-2 shrink-0">
        <Porte action={premiere} size="sm" />
        {seconde && <Porte action={seconde} size="sm" variant="ghost" />}
      </div>
      <div class="md:hidden flex items-center gap-2 shrink-0">
        <Porte action={premiere} size="sm" />
        <button class="p-1 -mr-1 shrink-0" aria-label="Menu" aria-expanded="false" data-floating-menu-toggle>
          <Icon name="Menu" size={22} />
        </button>
      </div>
    </div>
  </div>
</header>
<div class="h-[88px]" aria-hidden="true"></div>

<div class="md:hidden fixed inset-0 z-[60] hidden flex-col bg-bg" data-floating-menu>
  <div class="container-ff flex items-center justify-between py-6">
    <a href="/" class="flex items-center gap-3 font-display text-lg font-medium">
      {site.images.logo ? <Img src={site.images.logo.src} alt={site.images.logo.alt} class="h-9 w-auto" sizes="200px" loading="eager" /> : <span>{site.business.name}</span>}
    </a>
    <button class="p-2 -mr-2" aria-label="Fermer le menu" data-floating-menu-close>
      <Icon name="X" size={24} />
    </button>
  </div>
  <nav class="container-ff flex flex-col gap-2 py-6" aria-label="Navigation mobile" data-stagger="70">
    {links.map((l) => <a href={l.href} class="py-3 border-b border-line last:border-0 text-2xl font-display">{l.label}</a>)}
  </nav>
  <div class="container-ff mt-auto pb-10 grid gap-3">
    {portes.map((p, i) => <Porte action={p} size="lg" variant={i === 0 ? 'primary' : 'ghost'} class="w-full" />)}
  </div>
</div>

<script>
  import { onPage } from '@/scripts/page';

  // Rearme a chaque navigation ClientRouter (site.transitions) : voir src/scripts/page.ts.
  onPage(() => {
    const btn = document.querySelector<HTMLButtonElement>('[data-floating-menu-toggle]');
    const close = document.querySelector<HTMLButtonElement>('[data-floating-menu-close]');
    const menu = document.querySelector<HTMLElement>('[data-floating-menu]');
    const open = () => {
      menu?.classList.remove('hidden');
      menu?.classList.add('flex');
      btn?.setAttribute('aria-expanded', 'true');
    };
    const shut = () => {
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
      btn?.setAttribute('aria-expanded', 'false');
    };
    btn?.addEventListener('click', open);
    close?.addEventListener('click', shut);
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', shut));
  });
</script>
