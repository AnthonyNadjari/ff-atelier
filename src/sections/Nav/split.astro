---
/** Nav "split" : logo centre, liens repartis a gauche/droite (desktop), telephone en icone a droite. Filet bas permanent. */
import { site, tel, navLinks } from '@/lib/site';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
const links = navLinks();
const half = Math.ceil(links.length / 2);
const left = links.slice(0, half);
const right = links.slice(half);
---

<header data-nav class="fixed inset-x-0 top-0 z-50 border-b border-line transition-all duration-500 [&.is-scrolled]:bg-bg/85 [&.is-scrolled]:backdrop-blur-md">
  <div class="container-ff grid grid-cols-2 md:grid-cols-[1fr_auto_1fr] items-center py-4 [.is-scrolled_&]:py-3 transition-[padding] duration-500">
    <nav class="hidden md:flex items-center gap-6 text-sm justify-start" aria-label="Navigation principale, gauche">
      {left.map((l) => <a href={l.href} class="text-muted hover:text-fg transition-colors">{l.label}</a>)}
    </nav>
    <a href="/" class="flex items-center gap-3 font-display text-lg font-medium justify-self-start md:justify-self-center">
      {site.images.logo ? <Img src={site.images.logo.src} alt={site.images.logo.alt} class="h-9 w-auto" sizes="200px" loading="eager" /> : <span>{site.business.name}</span>}
    </a>
    <div class="flex items-center justify-end gap-4">
      <nav class="hidden md:flex items-center gap-6 text-sm" aria-label="Navigation principale, droite">
        {right.map((l) => <a href={l.href} class="text-muted hover:text-fg transition-colors">{l.label}</a>)}
      </nav>
      <a href={tel()} class="flex h-10 w-10 items-center justify-center rounded-ui border border-line hover:border-fg transition-colors" aria-label={`Appeler ${site.contact.phoneDisplay}`}>
        <Icon name="Phone" size={17} />
      </a>
      <button class="md:hidden p-2 -mr-2" aria-label="Menu" aria-expanded="false" data-split-menu-toggle>
        <Icon name="Menu" size={22} />
      </button>
    </div>
  </div>
  <div class="md:hidden hidden border-t border-line bg-bg" data-split-menu>
    <nav class="container-ff flex flex-col py-3" aria-label="Navigation mobile">
      {links.map((l) => <a href={l.href} class="py-3 border-b border-line last:border-0 text-base">{l.label}</a>)}
    </nav>
  </div>
</header>
<div class="h-[72px]" aria-hidden="true"></div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-split-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-split-menu]');
  btn?.addEventListener('click', () => {
    const open = menu!.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));
</script>
