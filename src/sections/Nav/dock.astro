---
/**
 * Nav "dock" : pas de barre. Nom fixe en haut a gauche, petit. Dock flottant bas-centre (jusqu'a
 * 4 liens icone+libelle + portes d'action) qui se masque au defilement vers le bas.
 * Portes (actions()) : la premiere en rond accent (icone, comme le telephone historique), la deuxieme
 * en contour sur ordinateur seulement. Le dock est deja une barre basse : Base.astro ignore
 * layout.actionBar avec cette nav, les portes suivantes restent dans la section contact.
 */
import { site, navLinks, actions } from '@/lib/site';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
const links = navLinks().slice(0, 4);
const iconFor: Record<string, string> = {
  services: 'Wrench',
  about: 'User',
  proof: 'Star',
  zones: 'MapPin',
  process: 'ListChecks',
  faq: 'HelpCircle',
  contact: 'Mail',
};
const [premiere, seconde] = actions();
const ext = (p: { external: boolean }) => (p.external ? { target: '_blank', rel: 'noopener' } : {});
const libelle = (p: { kind: string; label: string }) => (p.kind === 'call' ? `Appeler ${site.contact.phoneDisplay}` : p.label);
---

<a href="/" class="fixed top-4 left-4 sm:top-6 sm:left-6 z-50 flex items-center gap-2 font-display text-sm font-medium">
  {site.images.logo ? <Img src={site.images.logo.src} alt={site.images.logo.alt} class="h-7 w-auto" sizes="200px" loading="eager" /> : <span>{site.business.name}</span>}
</a>

<nav
  data-nav="hide-on-scroll"
  aria-label="Navigation principale"
  class="fixed inset-x-0 bottom-4 z-50 flex justify-center transition-[transform,opacity] duration-500 ease-out-quart [&.is-hidden]:translate-y-24 [&.is-hidden]:opacity-0"
>
  <div class="mx-4 flex max-w-full items-center gap-1 overflow-x-auto rounded-ui border border-line bg-surface/90 px-3 py-2 shadow-lift backdrop-blur-md">
    {links.map((l) => {
      const type = l.href.replace('#', '');
      return (
        <a href={l.href} class="flex shrink-0 flex-col items-center gap-1 rounded-ui px-3 py-1.5 text-muted transition-colors hover:bg-bg/60 hover:text-fg">
          <Icon name={iconFor[type] ?? 'Circle'} size={18} />
          <span class="text-xs">{l.label}</span>
        </a>
      );
    })}
    {seconde && (
      <a href={seconde.href} class="ml-1 hidden h-11 shrink-0 items-center rounded-ui border border-line px-3 text-sm font-medium text-fg transition-colors hover:border-fg md:flex" data-porte={seconde.kind} {...ext(seconde)}>{seconde.label}</a>
    )}
    <a href={premiere.href} aria-label={libelle(premiere)} title={libelle(premiere)} class="ml-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-accent text-on-accent" data-porte={premiere.kind} {...ext(premiere)}>
      <Icon name={premiere.icon} size={18} />
    </a>
  </div>
</nav>
