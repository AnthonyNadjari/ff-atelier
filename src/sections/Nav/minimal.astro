---
/**
 * Nav "minimal" : transparente, nom a gauche, portes d'action a droite, aucun lien. Se masque au scroll vers le bas.
 * Portes (actions()) : la premiere en bouton plein (seule visible sur telephone), la deuxieme en contour
 * sur ordinateur ; pas de menu, donc pas de troisieme porte ici (elle reste dans la section contact ou
 * la barre d'actions).
 */
import { site, actions } from '@/lib/site';
import Porte from '@/components/Porte.astro';
import Img from '@/components/Img.astro';
const [premiere, seconde] = actions();
---

<header data-nav="hide-on-scroll" class="fixed inset-x-0 top-0 z-50 transition-all duration-500 [&.is-hidden]:-translate-y-full [&.is-scrolled]:bg-bg/85 [&.is-scrolled]:backdrop-blur-md">
  <div class="container-ff flex items-center justify-between py-5 [.is-scrolled_&]:py-3 transition-[padding] duration-500">
    <a href="/" class="flex items-center gap-3 font-display text-lg font-medium">
      {site.images.logo ? <Img src={site.images.logo.src} alt={site.images.logo.alt} class="h-9 w-auto" sizes="200px" loading="eager" /> : <span>{site.business.name}</span>}
    </a>
    <div class="flex items-center gap-3">
      <Porte action={premiere} size="sm" />
      {seconde && <span class="hidden md:inline-flex"><Porte action={seconde} size="sm" variant="ghost" /></span>}
    </div>
  </div>
</header>
<div class="h-[76px]" aria-hidden="true"></div>
