---
/**
 * Nav "burger" : pas de barre. Nom fixe en haut a gauche, bouton rond (burger -> X) fixe en
 * haut a droite. L'ouverture revele un plein ecran (bg-ink) qui glisse depuis le haut, liens
 * numerotes en gros, coordonnees + reseaux en bas. Identique desktop/mobile.
 */
import { site, tel, mailto, fullAddress, navLinks } from '@/lib/site';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
const links = navLinks();
const socials = Object.entries(site.social).filter(([, v]) => v) as [string, string][];
const iconFor: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'Linkedin', tiktok: 'Music2' };
---

<header data-nav class="contents">
  <a href="/" class="fixed top-4 left-4 sm:top-6 sm:left-6 z-50 flex items-center gap-2 font-display text-sm font-medium">
    {site.images.logo ? <Img src={site.images.logo.src} alt={site.images.logo.alt} class="h-7 w-auto" sizes="200px" loading="eager" /> : <span>{site.business.name}</span>}
  </a>

  <button
    type="button"
    class="fixed top-4 right-4 sm:top-6 sm:right-6 z-[70] inline-flex h-12 w-12 items-center justify-center rounded-full bg-fg text-bg transition-colors duration-300 [&.is-open]:bg-on-ink [&.is-open]:text-ink"
    aria-label="Menu"
    aria-expanded="false"
    aria-controls="burger-panel"
    data-burger-toggle
  >
    <span class="relative block h-4 w-5" aria-hidden="true">
      <span class="absolute inset-x-0 top-0 h-[2px] bg-current transition-transform duration-300 ease-out-quart [.is-open_&]:translate-y-[7px] [.is-open_&]:rotate-45"></span>
      <span class="absolute inset-x-0 bottom-0 h-[2px] bg-current transition-transform duration-300 ease-out-quart [.is-open_&]:-translate-y-[7px] [.is-open_&]:-rotate-45"></span>
    </span>
  </button>
</header>

<div
  id="burger-panel"
  class="fixed inset-0 z-[60] flex flex-col overflow-y-auto bg-ink text-on-ink -translate-y-full opacity-0 pointer-events-none transition-[transform,opacity] duration-500 ease-out-quart [&.is-open]:translate-y-0 [&.is-open]:opacity-100 [&.is-open]:pointer-events-auto"
  aria-hidden="true"
  data-burger-panel
>
  <nav class="container-ff flex-1 flex flex-col justify-center gap-1 py-24" aria-label="Navigation principale" data-stagger="60">
    {links.map((l, i) => (
      <a href={l.href} class="group flex items-baseline gap-4 py-2 text-display-lg font-display" data-burger-link>
        <span class="font-mono text-sm text-on-ink/50">{String(i + 1).padStart(2, '0')}</span>
        <span class="transition-opacity group-hover:opacity-70">{l.label}</span>
      </a>
    ))}
  </nav>
  <div class="container-ff flex flex-wrap items-center justify-between gap-6 border-t border-on-ink/15 pb-10 pt-6 text-sm text-on-ink/70">
    <div class="flex flex-col gap-1">
      <a href={tel()} class="hover:text-on-ink">{site.contact.phoneDisplay}</a>
      <a href={mailto()} class="break-all hover:text-on-ink">{site.contact.email}</a>
      <p>{fullAddress()}</p>
    </div>
    {socials.length > 0 && (
      <ul class="flex gap-3">
        {socials.map(([k, url]) => (
          <li><a href={url} target="_blank" rel="noopener" aria-label={k} class="inline-flex h-9 w-9 items-center justify-center rounded-ui border border-on-ink/20 hover:border-on-ink"><Icon name={iconFor[k]} size={16} /></a></li>
        ))}
      </ul>
    )}
  </div>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-burger-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-burger-panel]');

  const shut = () => {
    toggle?.classList.remove('is-open');
    panel?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    panel?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };
  const open = () => {
    toggle?.classList.add('is-open');
    panel?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    panel?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  toggle?.addEventListener('click', () => (panel?.classList.contains('is-open') ? shut() : open()));
  panel?.querySelectorAll<HTMLAnchorElement>('[data-burger-link]').forEach((a) => a.addEventListener('click', shut));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel?.classList.contains('is-open')) shut();
  });
</script>
