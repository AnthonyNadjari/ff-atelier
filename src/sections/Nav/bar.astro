---
/**
 * Nav "bar" : barre fixe, logo/nom a gauche, ancres, portes d'action. Se densifie au scroll (.is-scrolled).
 * Portes (actions(), src/lib/actions.ts : Réserver, Commander, Bon cadeau, Appeler, Devis) : sur
 * ordinateur la premiere en bouton plein et la deuxieme en contour, les suivantes en liens texte dans
 * la nav ; sur telephone un seul bouton dans la barre (la premiere), les autres dans le menu.
 */
import { site, navLinks, actions } from '@/lib/site';
import Porte from '@/components/Porte.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
const links = navLinks();
const portes = actions();
const [premiere, seconde] = portes;
// Ordinateur : liens texte apres les ancres (sans doublon : « Devis » saute si la nav a deja #contact).
const autres = portes.slice(2).filter((p) => !links.some((l) => l.href === p.href));
const menu = portes.slice(1); // telephone : dans le menu deroulant
---

<header data-nav class="fixed inset-x-0 top-0 z-50 transition-all duration-500 [&.is-scrolled]:bg-bg/85 [&.is-scrolled]:backdrop-blur-md [&.is-scrolled]:border-b [&.is-scrolled]:border-line">
  <div class="container-ff flex items-center justify-between py-4 [.is-scrolled_&]:py-3 transition-[padding] duration-500">
    <a href="/" class="flex items-center gap-3 font-display text-lg font-medium">
      {site.images.logo ? <Img src={site.images.logo.src} alt={site.images.logo.alt} class="h-9 w-auto" sizes="200px" loading="eager" /> : <span>{site.business.name}</span>}
    </a>
    <nav class="hidden md:flex items-center gap-7 text-sm" aria-label="Navigation principale">
      {links.map((l) => <a href={l.href} class="text-muted hover:text-fg transition-colors">{l.label}</a>)}
      {autres.map((p) => <a href={p.href} class="text-muted hover:text-fg transition-colors" target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>{p.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <Porte action={premiere} size="sm" />
      {/* Enveloppe : `hidden` sur <Button> perd contre le display de .btn (direction), donc on cache le conteneur. */}
      {seconde && <span class="hidden md:inline-flex"><Porte action={seconde} size="sm" variant="ghost" /></span>}
      <button class="md:hidden p-2 -mr-2" aria-label="Menu" aria-expanded="false" data-menu-toggle>
        <Icon name="Menu" size={22} />
      </button>
    </div>
  </div>
  <div class="md:hidden hidden border-t border-line bg-bg" data-menu>
    <nav class="container-ff flex flex-col py-3" aria-label="Navigation mobile">
      {links.map((l) => <a href={l.href} class="py-3 border-b border-line last:border-0 text-base">{l.label}</a>)}
      {menu.length > 0 && (
        <div class="flex flex-wrap gap-3 py-4">
          {menu.map((p) => <Porte action={p} size="sm" variant="ghost" numero={false} />)}
        </div>
      )}
    </nav>
  </div>
</header>
<div class="h-[72px]" aria-hidden="true"></div>

<script>
  import { onPage } from '@/scripts/page';

  // Rearme a chaque navigation ClientRouter (site.transitions) : voir src/scripts/page.ts.
  onPage(() => {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    btn?.addEventListener('click', () => {
      const open = menu!.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));
  });
</script>
