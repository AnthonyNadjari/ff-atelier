---
/** Zones "map" : texte + liste de villes a gauche, <Carte /> (OSM/facade Google/adresse) a droite. */
import { site, citySlug } from '@/lib/site';
import Icon from '@/components/Icon.astro';
import Carte from '@/components/Carte.astro';
const zones = site.zones;
const cities = zones.cities;
const linked = site.seo.cityPages;
---

{cities.length > 0 && (
  <section id="zones" class="section-y">
    <div class="container-ff grid lg:grid-cols-2 gap-12 items-center">
      <div data-stagger="110">
        <p class="eyebrow">Zones d’intervention</p>
        <h2 class="mt-4 text-display-md">{zones.label ?? 'Nous intervenons près de chez vous'}</h2>
        {zones.radiusKm && (
          <p class="mt-4 text-muted max-w-prose">Déplacement dans un rayon d'environ {zones.radiusKm}&nbsp;km autour de {site.contact.address.city}.</p>
        )}
        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
          {cities.map((city) => (
            <li class="flex items-center gap-2 text-fg">
              <Icon name="MapPin" size={16} class="text-accent shrink-0" />
              {linked ? <a href={`/zones/${citySlug(city)}`} class="hover:text-accent">{city}</a> : <span>{city}</span>}
            </li>
          ))}
        </ul>
      </div>

      <div data-reveal="right">
        <Carte />
      </div>
    </div>
  </section>
)}
