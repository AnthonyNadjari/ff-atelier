---
/** Process "timeline" : frise verticale en zigzag sur desktop (impair a gauche, pair a droite), ligne centrale. */
import { site } from '@/lib/site';
import SectionHeading from '@/components/SectionHeading.astro';
---

{site.process.length > 0 && (
  <section id="process" class="section-y bg-bg-2">
    <div class="container-ff">
      <SectionHeading eyebrow="Comment ça marche" title="Notre méthode" align="center" />
      <ol class="relative mt-16 flex flex-col gap-12 lg:gap-0">
        <div class="absolute inset-y-0 left-1/2 hidden w-px -translate-x-1/2 bg-line lg:block" aria-hidden="true"></div>
        {site.process.map((p, i) => (
          <li class="relative lg:grid lg:grid-cols-2 lg:gap-16 lg:py-10">
            <div
              class:list={[i % 2 === 0 ? 'lg:pr-16 lg:text-right' : 'lg:col-start-2 lg:pl-16']}
              data-reveal={i % 2 === 0 ? 'left' : 'right'}
            >
              <p class="text-sm tabular-nums text-muted">Étape {i + 1}</p>
              <h3 class="mt-2 text-display-sm">{p.title}</h3>
              <p class="mt-2 text-muted">{p.text}</p>
            </div>
            <span class="absolute left-1/2 top-11 hidden h-3 w-3 -translate-x-1/2 rounded-full bg-accent ring-4 ring-bg-2 lg:block"></span>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
