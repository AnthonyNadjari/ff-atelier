---
/** Process "numbered" : liste compacte, numero dans un cercle accent, fond bg-bg-2. */
import { site } from '@/lib/site';
import SectionHeading from '@/components/SectionHeading.astro';
---

{site.process.length > 0 && (
  <section id="process" class="section-y bg-bg-2">
    <div class="container-ff grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <SectionHeading eyebrow="Comment ça marche" title={site.wording.processTitle} />
      </div>
      <ol class="flex flex-col lg:col-span-8" data-stagger="80">
        {site.process.map((p, i) => (
          <li class="flex items-start gap-5 border-t border-line py-6 last:border-b">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent font-mono text-sm text-on-accent">
              {i + 1}
            </span>
            <div>
              <h3 class="font-display text-lg">{p.title}</h3>
              <p class="mt-1 text-muted">{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}
