---
/**
 * Coquille "split" : panneau lateral fixe (nom, metier, navigation, telephone, reseaux) sur la gauche,
 * contenu qui defile a droite dans une colonne plus etroite. Sur mobile, le panneau devient un bloc
 * d'en-tete et la nav mobile classique prend le relais.
 * Sommaire actif (data-scrollspy, src/scripts/scrollspy.ts) : liens numerotes, le lien de la section
 * visible passe en fg et un trait d'accent se deploie devant lui.
 *
 * Contact en tiroir (layout.contactDrawer) : le panneau EST la nav sur desktop, il porte donc le meme
 * CTA `wording.devis` que les cinq nav partagees (src/sections/Nav/*.astro) et que la coquille `index`
 * — sans lui, un site en tiroir et sans section contact n'avait aucun CTA au-dessus de 1024 px, seule
 * l'ancre #contact noyee dans le sommaire. Tokens uniquement, aucune section restylee (22 sept 2026).
 */
import Divider from '@/components/Divider.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { site, tel, navLinks } from '@/lib/site';
interface Props { Nav: any; Hero: any; Footer: any; sections: { type: string; variant: string; Component: any }[] }
const { Nav, Hero, Footer, sections } = Astro.props;
const divider = site.layout.divider;
const links = navLinks();
const socials = Object.entries(site.social).filter(([, v]) => v) as [string, string][];
const iconFor: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'Linkedin', tiktok: 'Music2' };
---

<div class="lg:hidden"><Nav /></div>
<div class="lg:grid lg:grid-cols-[minmax(19rem,24rem)_1fr] xl:grid-cols-[minmax(22rem,28rem)_1fr]">
  <aside class="hidden lg:flex lg:sticky lg:top-0 lg:h-screen flex-col justify-between border-r border-line bg-bg-2 p-10 xl:p-14">
    <div>
      <a href="/" class="block font-display text-display-md leading-tight">
        {site.images.logo ? <img src={site.images.logo.src} alt={site.images.logo.alt} class="h-12 w-auto" /> : site.business.name}
      </a>
      <p class="mt-3 text-sm text-muted">{site.business.trade} à {site.contact.address.city}</p>
      <nav class="mt-12 flex flex-col gap-3" aria-label="Navigation principale" data-scrollspy>
        {links.map((l, i) => (
          <a href={l.href} class="spy-link flex items-baseline gap-3 text-lg text-muted transition-colors hover:text-fg">
            <span class="spy-trait" aria-hidden="true"></span>
            <span class="font-mono text-xs text-muted tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            {l.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="space-y-5">
      {site.contact.hours[0] && <p class="text-sm text-muted">{site.contact.hours[0].days}, {site.contact.hours[0].hours}</p>}
      <Button href={tel()} size="lg" class="w-full" magnetic><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</Button>
      {site.layout.contactDrawer && <Button href="#contact" variant="ghost" size="lg" class="w-full">{site.wording.devis}</Button>}
      {socials.length > 0 && (
        <ul class="flex gap-3">{socials.map(([k, url]) => <li><a href={url} target="_blank" rel="noopener" aria-label={k} class="inline-flex h-9 w-9 items-center justify-center rounded-ui border border-line hover:border-fg"><Icon name={iconFor[k]} size={16} /></a></li>)}</ul>
      )}
    </div>
  </aside>
  <div class="min-w-0" style="--container: 58rem;">
    <main id="main">
      <Hero />
      {sections.map(({ Component, type }, i) => (
        <>
          {divider !== 'none' && type !== 'cta' && <Divider index={i} />}
          <Component />
        </>
      ))}
    </main>
    <Footer />
  </div>
</div>

<style>
  /* Sommaire actif : trait d'accent qui se deploie devant le lien courant (--motion-ui, --ease-out). */
  .spy-trait {
    display: inline-block;
    inline-size: 1.5rem;
    block-size: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-ui) var(--ease-out);
    align-self: center;
  }
  .spy-link.is-active { color: var(--fg); }
  .spy-link.is-active .spy-trait { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) {
    .spy-trait { transition: none; }
  }
</style>

<script>
  import { onPage } from '@/scripts/page';
  import { initScrollSpy } from '@/scripts/scrollspy';
  onPage(initScrollSpy);
</script>
