---
/**
 * Coquille "slides" : chaque section occupe au moins un ecran et le defilement s'aimante dessus
 * (scroll-snap proximity : jamais piegeant). Le hero et les sections sont centres verticalement.
 * Convient aux sites courts (4 a 6 sections) et aux directions marquees. Motion 'subtle' conseille.
 */
import Divider from '@/components/Divider.astro';
import { site } from '@/lib/site';
interface Props { Nav: any; Hero: any; Footer: any; sections: { type: string; variant: string; Component: any }[] }
const { Nav, Hero, Footer, sections } = Astro.props;
const divider = site.layout.divider;
---

<Nav />
<main id="main">
  <div class="slide"><Hero /></div>
  {sections.map(({ Component, type }, i) => (
    <>
      {divider !== 'none' && type !== 'cta' && <Divider index={i} />}
      <div class="slide"><Component /></div>
    </>
  ))}
</main>
<Footer />

<style is:global>
  [data-shell='slides'] { scroll-snap-type: y proximity; }
  [data-shell='slides'] .slide { scroll-snap-align: start; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; }
  [data-shell='slides'] .slide > section { width: 100%; }
  [data-shell='slides'] .slide > section:not([class*='bg-']) { background: var(--bg); }
  [data-shell='slides'] .slide:nth-of-type(even) > section:not([class*='bg-ink']):not([class*='bg-accent']) { background: var(--bg-2); }
  @media (prefers-reduced-motion: reduce) { [data-shell='slides'] { scroll-snap-type: none; } }
</style>
