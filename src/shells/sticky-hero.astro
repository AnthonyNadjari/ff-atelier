---
/**
 * Coquille "sticky-hero" : le hero reste epingle en fond, les sections glissent par-dessus comme
 * une feuille. Marche mieux avec un hero plein ecran (fullbleed, typographic, video) et une
 * premiere section sur fond opaque.
 */
import Divider from '@/components/Divider.astro';
import { site } from '@/lib/site';
interface Props { Nav: any; Hero: any; Footer: any; sections: { type: string; variant: string; Component: any }[] }
const { Nav, Hero, Footer, sections } = Astro.props;
const divider = site.layout.divider;
---

<Nav />
<main id="main">
  <div class="sticky top-0 z-0 min-h-svh flex flex-col justify-center"><Hero /></div>
  <div class="relative z-10 bg-bg shadow-[0_-30px_60px_-30px_rgb(0_0_0/0.35)] rounded-t-card">
    {sections.map(({ Component, type }, i) => (
      <>
        {divider !== 'none' && type !== 'cta' && <Divider index={i} />}
        <Component />
      </>
    ))}
    <Footer />
  </div>
</main>

<style is:global>
  [data-shell='sticky-hero'] main > div:first-child > section { width: 100%; }
</style>
