---
/**
 * Coquille "parcours" : architecture `parcours-atelier` (src/lib/architectures.ts ; source Turning Earth, ateliers de
 * céramique à Londres, docs/veille/architectures/parcours-atelier.md). Le site est une ÉCHELLE : on essaie, on apprend,
 * puis on pratique librement (« From course to studio member » de la source) ; le visiteur se situe, il ne parcourt pas.
 *   → en tête : le h1, le métier à la ville et l'ancienneté (socle docs/GOUT.md § 0 ; le téléphone est aussi dans la nav) ;
 *   → « Où en êtes-vous ? », id="parcours", dès le premier écran : les marches puis le téléphone et la note Google ; un onglet par barreau (son niveau dans les mots du client, « Je découvre »),
 *     posés par le script ; sous l'onglet, le barreau entier (parcours[]) : son nom, sa phrase, à qui il s'adresse, la
 *     photo du client, les formules et leurs prix, ce qui est compris et ce qui ne l'est pas, comment ça se passe, les
 *     prochaines dates, ses questions (les FAQ de chaque page de la source : « Is it worth it? », « What if I'm not good
 *     enough? »), la page du barreau, et « Et après » qui ouvre le barreau suivant. Sans script : l'échelle
 *     entière, un barreau sous l'autre ;
 *     Les avis de ceux qui y sont passés vont sous leur barreau (proof.testimonials[].barreau : « What our students say »
 *     sur la page des cours, « What our members say » sur celle de l'adhésion) ;
 *   → les autres avis (sans barreau), puis les sections du layout s'il y en a ;
 *   → l'adresse de l'atelier sur l'encre, id="contact" : adresse, état du jour, téléphone, e-mail ;
 *   → le pied. Le tiroir de contact (layout.contactDrawer) reste la porte « Écrire ».
 * Pages : /parcours/<slug> (une par barreau : formules, compris, déroulé, dates, questions, précédent et suivant ; JSON-LD
 * Service et ses offres), que la nav nomme en tête.
 *
 * `layout.hero` n'est pas rendu (la coquille fait le premier écran). Sans barreau : l'atelier seul, et le build dit ce qui
 * manque (donneesManquantes).
 * Signes de la source NON repris : capitales espacées des titres et des boutons, cartes « offres » en grille de quatre
 * façon tarifs de logiciel, carte Google chargée d'office, carrousel d'actualités.
 */
import Divider from '@/components/Divider.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import HorairesDuJour from '@/components/HorairesDuJour.astro';
import { site, tel, mailto, metierEtVille, fullAddress, donneesManquantes, prixDepuis, voisins, avisDuBarreau, avisGeneraux } from '@/lib/site';
interface Props { Nav: any; Hero: any; Footer: any; sections: { type: string; variant: string; Component: any }[] }
const { Nav, Footer, sections } = Astro.props;
const divider = site.layout.divider;
const google = site.proof.google;
const note = google ? google.rating.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) : '';
const barreaux = site.parcours;
const avis = site.proof.testimonials;
const autresAvis = avisGeneraux(avis, barreaux);
const manque = donneesManquantes('parcours-atelier', site);
if (manque.length > 0) console.warn(`[coquille parcours] ${site.slug} : ${manque.join(' ; ')}`);
---

<Nav />
<main id="main" class="pa-page">
  <section id="hero" class="container-ff pa-tete" aria-label="Accueil">
    <h1 class="pa-h1 font-display" set:html={site.business.tagline} />
    <p class="pa-metier">{metierEtVille()}{site.business.since ? ` Depuis ${site.business.since}.` : ''}</p>
    {barreaux.length === 0 && <p><a href={tel()} class="pa-tel tabular-nums"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a></p>}
  </section>
  {barreaux.length > 0 && (
    <section id="parcours" class="pa-echelle" aria-labelledby="pa-question">
      <div class="container-ff pa-echelle-tete">
        <h2 id="pa-question" class="pa-question font-display">{site.wording.parcours}</h2>
        {barreaux.length >= 2 && (
          <div class="pa-onglets" data-pa-onglets hidden>
            {barreaux.map((b) => (
              <button type="button" class="pa-onglet" id={`pa-onglet-${b.slug}`} data-pa-vers={b.slug}>
                <span class="pa-onglet-niveau">{b.niveau}</span>
                <span class="pa-onglet-titre">{b.titre}</span>
              </button>
            ))}
          </div>
        )}
        <p class="pa-portes">
          <a href={tel()} class="pa-tel tabular-nums"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a>
          {google && <a href={google.url} target="_blank" rel="noopener" class="pa-note">{note}&nbsp;sur 5, {google.count}&nbsp;avis Google<span class="sr-only"> (nouvel onglet)</span></a>}
        </p>
      </div>
      {barreaux.map((b, i) => {
        const { suivant } = voisins(barreaux, b.slug);
        const depuis = prixDepuis(b.formules);
        return (
          <article id={`barreau-${b.slug}`} class="pa-barreau" data-pa-barreau={b.slug} aria-labelledby={`pa-titre-${b.slug}`}>
            <div class="container-ff pa-barreau-grille">
              <div class="pa-barreau-tete">
                <p class="pa-niveau">{b.niveau}</p>
                <h3 id={`pa-titre-${b.slug}`} class="pa-titre font-display">{b.titre}</h3>
                {depuis && <p class="pa-depuis tabular-nums">{depuis.replace(/^./, (c) => c.toUpperCase())}</p>}
                {b.phrase && <p class="pa-phrase">{b.phrase}</p>}
                {b.pour && <p class="pa-pour">{b.pour}</p>}
                {b.photo && (
                  <div class="pa-photo"><Img src={b.photo.src} alt={b.photo.alt} priority={i === 0} sizes="(min-width: 64rem) 34vw, 92vw" class="h-full w-full object-cover" /></div>
                )}
              </div>
              <div class="pa-barreau-corps">
                {b.formules.length > 0 && (
                  <ul class="pa-formules">
                    {b.formules.map((f) => (
                      <li class="pa-formule">
                        <span class="pa-formule-nom">{f.nom}{f.detail && <span class="text-muted">{f.detail}</span>}</span>
                        {f.prix && <span class="pa-prix tabular-nums">{f.prix}</span>}
                      </li>
                    ))}
                  </ul>
                )}
                {(b.compris.length > 0 || b.nonCompris.length > 0) && (
                  <div class="pa-compris">
                    {b.compris.length > 0 && (
                      <div>
                        <h4 class="pa-sous-titre">Compris</h4>
                        <ul class="pa-liste">{b.compris.map((x) => <li>{x}</li>)}</ul>
                      </div>
                    )}
                    {b.nonCompris.length > 0 && (
                      <div>
                        <h4 class="pa-sous-titre">Pas compris</h4>
                        <ul class="pa-liste">{b.nonCompris.map((x) => <li>{x}</li>)}</ul>
                      </div>
                    )}
                  </div>
                )}
                {b.deroule.length > 0 && (
                  <div>
                    <h4 class="pa-sous-titre">Comment ça se passe</h4>
                    <ol class="pa-deroule">{b.deroule.map((x) => <li>{x}</li>)}</ol>
                  </div>
                )}
                {b.dates.length > 0 && (
                  <div>
                    <h4 class="pa-sous-titre">Prochaines dates</h4>
                    <ul class="pa-liste">{b.dates.map((x) => <li>{x}</li>)}</ul>
                  </div>
                )}
                {b.questions.length > 0 && (
                  <div class="pa-questions">
                    <h4 class="pa-sous-titre">Vos questions</h4>
                    {b.questions.slice(0, 4).map((q) => <details class="pa-faq"><summary>{q.q}</summary><p>{q.a}</p></details>)}
                  </div>
                )}
                {avisDuBarreau(avis, b.slug).length > 0 && (
                  <div class="pa-avis">
                    <h4 class="pa-sous-titre">Ils y sont passés</h4>
                    {avisDuBarreau(avis, b.slug).map((t) => (
                      <figure class="pa-avis-un">
                        <blockquote><p>{t.text}</p></blockquote>
                        <figcaption class="pa-avis-qui">{t.author}{t.source ? `, ${t.source}` : ''}</figcaption>
                      </figure>
                    ))}
                  </div>
                )}
                <p class="pa-actions">
                  <a href={`/parcours/${b.slug}`} class="pa-voir">Tout sur {b.titre.replace(/^./, (c) => c.toLowerCase())}<Icon name="ArrowRight" size={16} /></a>
                  {suivant && <a href={`#barreau-${suivant.slug}`} class="pa-suite" data-pa-suite={suivant.slug}>Et après : {suivant.niveau.replace(/^./, (c) => c.toLowerCase())}</a>}
                </p>
              </div>
            </div>
          </article>
        );
      })}
    </section>
  )}
  {sections.map(({ Component, type }, i) => (
    <>
      {divider !== 'none' && type !== 'cta' && <Divider index={i} />}
      <Component />
    </>
  ))}
  {autresAvis.length > 0 && (
    <section id="avis" class="container-ff pa-avis-generaux" aria-labelledby="pa-avis-titre">
      <h2 id="pa-avis-titre" class="pa-question font-display">Ce qu’ils en disent</h2>
      <div class="pa-avis-liste">
        {autresAvis.map((t) => (
          <figure class="pa-avis-un">
            <blockquote><p>{t.text}</p></blockquote>
            <figcaption class="pa-avis-qui">{t.author}{t.source ? `, ${t.source}` : ''}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}
  <section id="contact" class="pa-adresse bg-ink text-on-ink" aria-labelledby="pa-adresse-titre">
    <div class="container-ff pa-adresse-grille">
      <h2 id="pa-adresse-titre" class="pa-adresse-titre font-display">{site.business.name}</h2>
      <div class="pa-adresse-infos">
        <p>{fullAddress()}</p>
        {site.contact.mapsUrl && <p><a href={site.contact.mapsUrl} target="_blank" rel="noopener" class="pa-lien"><Icon name="MapPin" size={16} />Itinéraire<span class="sr-only"> (nouvel onglet)</span></a></p>}
        <HorairesDuJour />
      </div>
      <div class="pa-adresse-portes">
        <a href={tel()} class="pa-appel tabular-nums"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a>
        {site.contact.email && <a href={mailto()} class="pa-lien"><Icon name="Mail" size={16} />{site.contact.email}</a>}
      </div>
    </div>
  </section>
</main>
<Footer />

<style>
  .pa-tete { display: grid; gap: 1rem; padding-block: clamp(1.5rem, 5vh, 3rem) clamp(1.25rem, 4vh, 2rem); }
  .pa-h1 { font-size: clamp(2.2rem, 7.5vw, 5rem); line-height: 0.98; letter-spacing: -0.015em; text-wrap: balance; max-inline-size: 16ch; }
  .pa-metier { font-size: clamp(1.05rem, 1.6vw, 1.3rem); max-inline-size: 40ch; }
  .pa-portes { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; }
  .pa-tel { display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: 48px; padding-inline: 1.1rem; border-radius: var(--radius-ui, 6px); border: 1px solid currentColor; font-weight: 600; }
  .pa-tel:hover { color: var(--color-accent); }
  .pa-note, .pa-lien, .pa-voir, .pa-suite { display: inline-flex; align-items: center; gap: 0.35rem; min-block-size: 44px; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .pa-tel:focus-visible, .pa-note:focus-visible, .pa-lien:focus-visible, .pa-voir:focus-visible, .pa-suite:focus-visible, .pa-appel:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .pa-echelle { padding-block: 0 clamp(2.5rem, 8vh, 4.5rem); }
  .pa-echelle-tete { display: grid; gap: 1rem; padding-block-end: 1.5rem; }
  .pa-question { font-size: clamp(1.8rem, 4.5vw, 3rem); line-height: 1.05; }
  /* Les onglets en marches d'escalier (l'échelle de la source, en forme) : au téléphone, une marche par ligne, chacune
     décalée vers la droite ; à l'ordinateur, côte à côte, chacune plus haute que la précédente. */
  .pa-onglets { display: grid; gap: 0.35rem; }
  .pa-onglets[hidden] { display: none; }
  .pa-onglet { display: grid; gap: 0.1rem; align-content: center; text-align: start; min-block-size: 3.5rem; padding: 0.5rem 0.9rem; border: 1px solid var(--color-line); border-inline-start-width: 3px; border-radius: var(--radius-ui, 6px); background: var(--color-bg); cursor: pointer; }
  .pa-onglet:nth-child(2) { margin-inline-start: 12%; }
  .pa-onglet:nth-child(3) { margin-inline-start: 24%; }
  .pa-onglet:nth-child(4) { margin-inline-start: 36%; }
  .pa-onglet[aria-selected='true'] { background: var(--color-ink); color: var(--color-on-ink); border-color: var(--color-ink); }
  .pa-onglet:hover { border-block-end-color: var(--color-accent); }
  .pa-onglet:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .pa-onglet-niveau { font-weight: 600; font-size: 0.95rem; line-height: 1.2; }
  .pa-onglet-titre { font-size: 0.8rem; line-height: 1.25; }
  .pa-barreau { padding-block: clamp(1.5rem, 4vh, 2.5rem); }
  .pa-barreau + .pa-barreau { border-block-start: 1px solid var(--color-line); }
  .pa-barreau-grille { display: grid; gap: 1.75rem; }
  .pa-barreau-tete { display: grid; gap: 0.6rem; align-content: start; }
  .pa-niveau { font-weight: 600; }
  .pa-titre { font-size: clamp(2rem, 6vw, 3.75rem); line-height: 0.98; letter-spacing: -0.015em; }
  .pa-depuis { font-size: 1.2rem; font-weight: 600; }
  .pa-phrase { font-size: clamp(1.1rem, 1.8vw, 1.3rem); max-inline-size: 38ch; }
  .pa-pour { color: var(--color-muted); }
  .pa-photo { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-card); margin-block-start: 0.5rem; }
  .pa-photo > :global(picture) { display: block; block-size: 100%; }
  .pa-barreau-corps { display: grid; gap: 1.5rem; align-content: start; }
  .pa-formules { display: grid; border-block-start: 2px solid currentColor; }
  .pa-formule { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-block: 0.7rem; border-block-end: 1px solid var(--color-line); }
  .pa-formule-nom { display: grid; font-size: 1.1rem; }
  .pa-prix { font-weight: 600; font-size: 1.1rem; white-space: nowrap; }
  .pa-compris { display: grid; gap: 1.25rem; }
  .pa-sous-titre { font-weight: 600; margin-block-end: 0.35rem; }
  .pa-liste { display: grid; gap: 0.2rem; padding-inline-start: 1.1rem; list-style: disc; }
  .pa-deroule { display: grid; gap: 0.35rem; padding-inline-start: 1.3rem; list-style: decimal; }
  .pa-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1.5rem; }
  .pa-suite { font-weight: 600; }
  .pa-faq { border-block-end: 1px solid var(--color-line); }
  .pa-faq summary { display: flex; align-items: center; min-block-size: 44px; cursor: pointer; font: inherit; font-weight: 600; }
  .pa-faq summary:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .pa-faq p { padding-block-end: 0.75rem; }
  .pa-avis { display: grid; gap: 0.75rem; }
  .pa-avis-un { display: grid; gap: 0.35rem; padding-inline-start: 1rem; border-inline-start: 2px solid var(--color-accent); }
  .pa-avis-un blockquote { font-size: 1.1rem; line-height: 1.45; }
  .pa-avis-qui { font-size: 0.95rem; }
  .pa-avis-generaux { display: grid; gap: 1.25rem; padding-block: clamp(2.5rem, 7vh, 4rem); }
  .pa-avis-liste { display: grid; gap: 1.5rem; }
  .pa-adresse { padding-block: clamp(2.5rem, 8vh, 5rem); }
  .pa-adresse-grille { display: grid; gap: 1.5rem; }
  .pa-adresse-titre { font-size: clamp(1.8rem, 4.5vw, 3rem); line-height: 1.05; }
  .pa-adresse-infos, .pa-adresse-portes { display: grid; gap: 0.4rem; align-content: start; }
  .pa-appel { display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: 48px; font-size: 1.2rem; font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  @media (min-width: 40rem) { .pa-compris { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .pa-tete { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); column-gap: 3rem; align-items: end; padding-block: clamp(3.5rem, 9vh, 5.5rem) clamp(2rem, 5vh, 3rem); }
    .pa-echelle-tete { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); column-gap: 3rem; align-items: end; }
    .pa-echelle-tete .pa-portes { grid-column: 1 / -1; }
    .pa-onglets { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); align-items: end; }
    .pa-onglet { align-content: end; min-block-size: 4.5rem; margin-inline-start: 0; border-inline-start-width: 1px; border-block-end-width: 3px; border-end-start-radius: 0; border-end-end-radius: 0; }
    .pa-onglet:nth-child(2) { margin-inline-start: 0; min-block-size: 5.75rem; }
    .pa-onglet:nth-child(3) { margin-inline-start: 0; min-block-size: 7rem; }
    .pa-onglet:nth-child(4) { margin-inline-start: 0; min-block-size: 8.25rem; }
    .pa-onglet-niveau { font-size: 1.05rem; }
    .pa-barreau-grille { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); column-gap: 4rem; }
    .pa-avis-liste { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; }
    .pa-adresse-grille { grid-template-columns: minmax(0, 2fr) minmax(0, 2fr) minmax(0, 1fr); column-gap: 3rem; }
  }
</style>

<script>
  import { onPage } from '@/scripts/page';

  // « Où en êtes-vous ? » : les boutons deviennent des onglets, un seul barreau visible ; « Et après » ouvre le suivant.
  // Sans script : pas de rangée, l'échelle entière.
  onPage(() => {
    const rangee = document.querySelector<HTMLElement>('[data-pa-onglets]');
    if (!rangee) return;
    const onglets = [...rangee.querySelectorAll<HTMLButtonElement>('[data-pa-vers]')];
    const barreaux = [...document.querySelectorAll<HTMLElement>('[data-pa-barreau]')];
    if (onglets.length < 2 || barreaux.length !== onglets.length) return;
    rangee.setAttribute('role', 'tablist');
    const vertical = () => rangee.setAttribute('aria-orientation', matchMedia('(min-width: 64rem)').matches ? 'horizontal' : 'vertical');
    vertical();
    matchMedia('(min-width: 64rem)').addEventListener('change', vertical);
    rangee.setAttribute('aria-labelledby', 'pa-question');
    const choisir = (slug: string, focus = false) => {
      onglets.forEach((o) => { const sel = o.dataset.paVers === slug; o.setAttribute('aria-selected', String(sel)); o.tabIndex = sel ? 0 : -1; if (sel && focus) o.focus(); });
      barreaux.forEach((b) => { b.hidden = b.dataset.paBarreau !== slug; });
    };
    onglets.forEach((o, k) => {
      const b = barreaux[k];
      o.setAttribute('role', 'tab');
      o.setAttribute('aria-controls', b.id);
      b.setAttribute('role', 'tabpanel');
      b.setAttribute('aria-labelledby', o.id);
      b.tabIndex = 0;
      o.addEventListener('click', () => choisir(o.dataset.paVers!));
      o.addEventListener('keydown', (e) => {
        const apres = e.key === 'ArrowRight' || e.key === 'ArrowDown';
        const avant = e.key === 'ArrowLeft' || e.key === 'ArrowUp';
        const c = apres ? onglets[(k + 1) % onglets.length] : avant ? onglets[(k - 1 + onglets.length) % onglets.length] : undefined;
        if (c) { e.preventDefault(); choisir(c.dataset.paVers!, true); }
      });
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-pa-suite]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        choisir(a.dataset.paSuite!, true);
        rangee.scrollIntoView({ block: 'start', behavior: 'instant' });
      });
    });
    const depuisAncre = location.hash.startsWith('#barreau-') ? location.hash.slice(9) : '';
    rangee.hidden = false;
    choisir(onglets.some((o) => o.dataset.paVers === depuisAncre) ? depuisAncre : onglets[0].dataset.paVers!);
  });
</script>
