---
/**
 * Coquille "cartes-agenda" : architecture `cartes-empilees-agenda` (src/lib/architectures.ts ; source De Groene
 * Afslag, docs/veille/architectures/groene-afslag.md). Le lieu qui publie :
 *   en-tête fixe à droite : la porte « Agenda » (toujours en haut), le téléphone, le menu ; le nom à gauche ;
 *   → la photo du lieu, le nom posé dessus en étiquettes de couleur (un mot par étiquette) ;
 *   → le h1 et sa phrase « métier à ville », l'ancienneté, la note Google, le téléphone ;
 *   → les sections du layout : les activités en cartes de couleur qui se recouvrent (services/cartes-empilees),
 *     et, juste après les activités, les prochains rendez-vous en cartes datées (ProchainsRendezVous.astro, vers
 *     /agenda), puis les avis ;
 *   → les nouvelles (les trois derniers conseils), s'il y en a ;
 *   → le pied.
 * Les pages intérieures (activités, agenda, conseils) gardent la nav du site (`layout.nav`), où « Agenda » est en tête.
 *
 * Socle docs/GOUT.md § 0 : h1 + métier et ville sous la photo, téléphone cliquable dans l'en-tête (toutes tailles)
 * et sous le h1, note Google sous le h1 et avis en section, photos du client, plusieurs pages (activités, agenda).
 * Signes de la source NON repris (GOUT § 2) : couche de chargement, bannière qui couvre l'écran, mot en italique dans
 * chaque accroche, étiquettes en pilules, télé posée de travers, logo en lettres en désordre.
 */
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';
import ProchainsRendezVous from '@/components/ProchainsRendezVous.astro';
import { site, tel, metierEtVille, navLinks, agendaAVenir, conseilsTries, dateConseil, photosDuSite } from '@/lib/site';
import { heroSizesFor } from '@/lib/images';
interface Props { Nav: any; Hero: any; Footer: any; sections: { type: string; variant: string; Component: any }[] }
const { Footer, sections } = Astro.props;

const photo = site.images.hero ?? photosDuSite()[0];
const mots = site.business.name.split(/\s+/).filter(Boolean);
const TEINTES = ['ca-e-accent', 'ca-e-clair', 'ca-e-encre'];
const agenda = agendaAVenir(site.agenda).length > 0;
const liens = navLinks().filter((l) => l.href !== '/agenda');
const google = site.proof.google;
const note = google ? google.rating.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) : '';
const nouvelles = conseilsTries(site.conseils).slice(0, 3);
// Les rendez-vous viennent juste après les activités (la deuxième moitié du site devient un journal).
const iServices = sections.findIndex((s) => s.type === 'services');
---

<header class="ca-tete">
  <a href="/" class="ca-nom bg-bg text-fg font-display">{site.images.logo ? <img src={site.images.logo.src} alt={site.images.logo.alt} class="h-8 w-auto" /> : site.business.name}</a>
  <nav class="ca-portes" aria-label="Accès rapides">
    {agenda && <a href="/agenda" class="ca-porte ca-porte-agenda bg-ink text-on-ink">{site.wording.agenda}</a>}
    <a href={tel()} class="ca-porte bg-bg text-fg tabular-nums"><Icon name="Phone" size={16} /><span class="ca-tel-num">{site.contact.phoneDisplay}</span><span class="ca-tel-court">Appeler</span></a>
    <details class="ca-menu">
      <summary class="ca-porte bg-accent text-on-accent">Menu</summary>
      <div class="ca-menu-panneau bg-surface text-fg shadow-lift">
        <ul class="flex flex-col gap-3">
          {liens.map((l) => <li><a href={l.href} class="ca-menu-lien font-display">{l.label}</a></li>)}
          {site.servicePages && site.services.map((s) => <li><a href={`/services/${s.slug}`} class="ca-menu-lien font-display">{s.title}</a></li>)}
        </ul>
      </div>
    </details>
  </nav>
</header>

<main id="main">
  <section id="hero" class="ca-hero">
    <div class="ca-photo bg-ink">
      {photo && <Img src={photo.src} alt={photo.alt} priority sizes={heroSizesFor(site.layout.hero)} class="h-full w-full object-cover" />}
      <p class="ca-etiquettes font-display" aria-hidden="true">
        {mots.map((m, i) => <span class:list={['ca-etiquette', TEINTES[i % TEINTES.length]]}>{m}</span>)}
      </p>
    </div>
    <div class="container-ff ca-intro">
      <h1 class="ca-h1 font-display" set:html={site.business.tagline} />
      <div class="ca-intro-cote">
        <p class="text-lg">{metierEtVille()}{site.business.since ? ` Depuis ${site.business.since}.` : ''}</p>
        <p class="mt-3"><a href={tel()} class="inline-flex items-center gap-2 text-lg tabular-nums underline underline-offset-4"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a></p>
        {google && <p class="mt-2 text-sm"><a href={google.url} target="_blank" rel="noopener" class="underline underline-offset-4">{note}&nbsp;sur 5, {google.count}&nbsp;avis Google</a></p>}
      </div>
    </div>
  </section>

  {sections.map(({ Component }, i) => (
    <>
      <Component />
      {i === iServices && <ProchainsRendezVous />}
    </>
  ))}
  {iServices === -1 && <ProchainsRendezVous />}

  {nouvelles.length > 0 && (
    <div class="ca-nouvelles section-y bg-bg-2" role="region" aria-labelledby="ca-nouvelles-titre">
      <h2 id="ca-nouvelles-titre" class="ca-nouvelles-titre text-display-md">{site.wording.conseils}</h2>
      {nouvelles.map((c) => (
        <article class="rounded-card bg-surface p-6 shadow-card">
          {c.image && <Img src={c.image.src} alt={c.image.alt} loading="lazy" class="mb-4 w-full rounded-card object-cover aspect-[4/3]" sizes="(min-width: 768px) 30vw, 100vw" />}
          <time datetime={c.date} class="text-sm">{dateConseil(c.date)}</time>
          <h3 class="mt-1 font-display text-xl"><a href={`/conseils/${c.slug}`} class="hover:underline">{c.title}</a></h3>
          <p class="mt-2">{c.summary}</p>
        </article>
      ))}
    </div>
  )}
</main>
<Footer />

<style>
  .ca-tete { position: fixed; inset-block-start: 0; inset-inline: 0; z-index: 50; display: flex; justify-content: space-between; align-items: flex-start; gap: 0.75rem; padding: 0.75rem; pointer-events: none; }
  .ca-tete > * { pointer-events: auto; }
  .ca-nom { padding: 0.5rem 0.75rem; border-radius: var(--radius, 6px); font-size: 1.1rem; line-height: 1.2; max-inline-size: 44vw; }
  .ca-portes { display: flex; align-items: flex-start; gap: 0.4rem; }
  .ca-porte { display: inline-flex; align-items: center; gap: 0.4rem; min-block-size: 2.75rem; padding: 0.5rem 0.8rem; border-radius: var(--radius, 6px); font-weight: 600; cursor: pointer; list-style: none; }
  .ca-porte::-webkit-details-marker { display: none; }
  .ca-porte:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .ca-tel-num { display: none; }
  .ca-menu { position: relative; }
  .ca-menu-panneau { position: absolute; inset-inline-end: 0; inset-block-start: calc(100% + 0.5rem); inline-size: min(22rem, 86vw); padding: 1.5rem; border-radius: var(--radius-card, 14px); }
  .ca-menu-lien { font-size: 1.4rem; line-height: 1.2; }
  .ca-menu-lien:hover { text-decoration: underline; text-underline-offset: 0.15em; }
  .ca-photo { position: relative; block-size: 42svh; overflow: hidden; }
  .ca-etiquettes { position: absolute; inset-inline-start: 1rem; inset-block-end: 1rem; display: flex; flex-direction: column; align-items: flex-start; gap: 0.35rem; }
  .ca-etiquette { font-size: clamp(2rem, 8vw, 6rem); line-height: 1; padding: 0.12em 0.25em 0.1em; border-radius: var(--radius, 6px); }
  .ca-etiquette:nth-child(2) { margin-inline-start: 0.6em; }
  .ca-etiquette:nth-child(3) { margin-inline-start: 0.25em; }
  .ca-e-accent { background: var(--color-accent); color: var(--color-on-accent); }
  .ca-e-clair { background: var(--color-bg); color: var(--color-fg); }
  .ca-e-encre { background: var(--color-ink); color: var(--color-on-ink); }
  .ca-intro { display: grid; gap: 1.5rem; padding-block: 2.5rem 1rem; }
  .ca-h1 { font-size: clamp(1.9rem, 4.2vw, 3.6rem); line-height: 1.12; max-inline-size: 24ch; }
  /* Nouvelles : chaque article est un enfant direct de l'enveloppe (un bloc de la page), en grille à l'ordinateur. */
  .ca-nouvelles { display: grid; gap: 1.5rem; padding-inline: max(clamp(1.25rem, 4vw, 2.5rem), calc((100% - var(--container)) / 2 + clamp(1.25rem, 4vw, 2.5rem))); }
  .ca-nouvelles-titre { margin-block-end: 1rem; }
  @media (min-width: 48rem) {
    .ca-tel-num { display: inline; }
    .ca-nouvelles { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ca-nouvelles-titre { grid-column: 1 / -1; }
    .ca-tel-court { display: none; }
    .ca-tete { padding: 1rem 1.25rem; }
    .ca-photo { block-size: 78svh; }
    .ca-etiquettes { inset-inline-start: 2rem; inset-block-end: 2rem; }
    .ca-intro { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: end; gap: 3rem; padding-block: 4rem 2rem; }
  }
</style>
