---
/**
 * Image responsive AVIF/WebP + LQIP, a partir du manifeste `sites/<slug>/images.json`
 * genere par `ff images <slug>` (voir scripts/ff/images.mjs et docs/veille/rendu.md §4).
 *
 * Props :
 *   src      chemin public de l'image (ex: "/images/hero.webp"), comme aujourd'hui dans site.config.ts
 *   alt      texte alternatif (obligatoire, meme vide "" si decoratif)
 *   sizes    attribut sizes standard (defaut "100vw")
 *   class    classes Tailwind, transmises a la balise <img>
 *   loading  "eager" | "lazy" (defaut : "eager" si priority, sinon "lazy")
 *   priority image du premier ecran : loading="eager" + fetchpriority="high" par defaut
 *
 * Si `src` n'a pas d'entree dans le manifeste (image non passee par `ff images`, logo,
 * placeholder...), on retombe sur un <img> simple a l'identique de l'existant : aucune
 * regression pour les images non migrees.
 */
import { slugCourant } from '@/lib/site';
import { lookupImageEntry, splitImagePath, imageSrcsetFor } from '@/lib/images';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
  [key: string]: unknown;
}

// fetchpriority : sorti explicitement des props pour ne jamais etre pose autrement que via `priority`
// (voir docs/veille/performance.md §4.1) — sinon un appelant pourrait le glisser dans `...rest` et le
// faire gagner sur la valeur calculee juste en dessous (le spread `{...rest}` passe apres sur l'<img>).
const { src, alt, sizes = '100vw', class: cls = '', loading, priority = false, fetchpriority: _ignoredFetchpriority, ...rest } = Astro.props;

const { dir, name } = splitImagePath(src);
const entry = lookupImageEntry(slugCourant, src);
const maxWidth = entry ? Math.max(...entry.widths) : undefined;

function srcsetFor(ext: string) {
  return entry ? imageSrcsetFor(entry, dir, name, ext) : '';
}

const finalLoading = loading ?? (priority ? 'eager' : 'lazy');
const fetchpriority = priority ? 'high' : undefined;
const width = entry ? maxWidth : undefined;
const height = entry && maxWidth ? Math.round(maxWidth / entry.ratio) : undefined;
const lqipStyle = entry ? `background-image:url(${entry.lqip});background-size:cover;background-position:center;` : undefined;
---

{entry ? (
  <picture>
    <source type="image/avif" srcset={srcsetFor('avif')} sizes={sizes} />
    <source type="image/webp" srcset={srcsetFor('webp')} sizes={sizes} />
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={finalLoading}
      fetchpriority={fetchpriority}
      decoding="async"
      class={cls}
      style={lqipStyle}
      {...rest}
    />
  </picture>
) : (
  <img src={src} alt={alt} loading={finalLoading} fetchpriority={fetchpriority} decoding="async" class={cls} {...rest} />
)}
