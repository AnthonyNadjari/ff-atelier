---
/** En-tete de section : titre + texte optionnel. `align` = left | center.
 * `eyebrow` est accepte mais n'est plus affiche (6 oct 2026) : le petit surtitre en capitales au-dessus
 * d'un grand titre est le signe n°2 des pages faites par une IA (docs/veille, Impeccable). */
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  align?: 'left' | 'center';
  class?: string;
  level?: 'h2' | 'h3';
}
const { eyebrow, title, text, align = 'left', class: cls = '', level = 'h2' } = Astro.props;
const Tag = level;
---

<div class:list={['section-heading max-w-3xl', align === 'center' && 'mx-auto text-center', cls]} data-stagger="120">
  <Tag class="text-display-md" set:html={title} />
  {text && <p class="mt-5 text-lg text-muted max-w-prose" class:list={[align === 'center' && 'mx-auto']}>{text}</p>}
</div>
