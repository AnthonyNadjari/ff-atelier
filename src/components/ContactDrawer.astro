---
/**
 * Contact en tiroir (layout.contactDrawer, docs/CONVENTIONS.md § Coquilles) : un dialog natif qui
 * contient le formulaire partage (ContactForm.astro, tel quel) et les coordonnees, ouvert par tout
 * lien href="#contact" ou "/#contact" de la page (nav, CTA, bandeau, call-bar...). Rendu par
 * Base.astro sur TOUTES les pages du site quand le reglage est actif, en plus — jamais a la place —
 * de la section contact finale si le layout en a une.
 *
 * Accessibilite : dialog.showModal() piege le focus et gere Escape nativement ; le focus revient
 * sur le lien declencheur a la fermeture ; aria-labelledby sur le titre ; clic sur le fond = fermeture ;
 * defilement de la page bloque derriere (html.ff-drawer-open) ; data-lenis-prevent pour que le scroll
 * fluide (Lenis) laisse le tiroir defiler seul.
 * Animation : glisse depuis la droite (desktop) ou depuis le bas (mobile, plein ecran) sur --motion-ui
 * et --ease-out via @starting-style ; prefers-reduced-motion = aucune animation. Tokens uniquement.
 * Avec ClientRouter (site.transitions) : le dialog est remplace a chaque navigation, onPage() rearme.
 */
import { site, tel, mailto, whatsapp, fullAddress } from '@/lib/site';
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
const wa = whatsapp();
const hasForm = site.form.provider !== 'none';
---

<dialog id="contact-tiroir" data-contact-drawer aria-labelledby="contact-tiroir-titre" data-lenis-prevent>
  <div class="tiroir-corps bg-bg text-fg">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm text-muted">{site.business.name}</p>
        <h2 id="contact-tiroir-titre" class="font-display text-display-sm mt-1" set:html={site.wording.contactTitle} />
      </div>
      <button type="button" class="tiroir-fermer -mr-2 -mt-1 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-ui text-muted hover:text-fg" aria-label="Fermer" data-drawer-close>
        <Icon name="X" size={22} />
      </button>
    </div>
    <p class="mt-3 text-muted">{site.wording.contactText}</p>

    <ul class="mt-6 grid gap-3 text-sm" data-drawer-coordonnees>
      <li class="flex gap-3">
        <Icon name="Phone" size={18} class="text-accent shrink-0 mt-0.5" />
        <div>
          <a href={tel()} class="font-medium text-base text-fg">{site.contact.phoneDisplay}</a>
          {site.contact.emergency24h && <p class="text-muted">Urgences 24h/24, 7j/7</p>}
        </div>
      </li>
      {wa && (
        <li class="flex gap-3"><Icon name="MessageCircle" size={18} class="text-accent shrink-0 mt-0.5" /><a href={wa} class="font-medium" target="_blank" rel="noopener">Écrire sur WhatsApp</a></li>
      )}
      <li class="flex gap-3"><Icon name="Mail" size={18} class="text-accent shrink-0 mt-0.5" /><a href={mailto()} class="font-medium break-all">{site.contact.email}</a></li>
      <li class="flex gap-3"><Icon name="MapPin" size={18} class="text-accent shrink-0 mt-0.5" /><p class="text-muted">{fullAddress()}</p></li>
      {site.contact.hours.length > 0 && (
        <li class="flex gap-3">
          <Icon name="Clock" size={18} class="text-accent shrink-0 mt-0.5" />
          <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-0.5">{site.contact.hours.map((h) => <><dt class="text-muted">{h.days}</dt><dd>{h.hours}</dd></>)}</dl>
        </li>
      )}
    </ul>

    {hasForm && (
      <div class="mt-8 border-t border-line pt-8">
        <ContactForm compact idPrefix="tiroir" />
      </div>
    )}
  </div>
</dialog>

<style>
  /* Tiroir : panneau lateral droit (desktop), plein ecran depuis le bas (mobile). Tokens uniquement. */
  dialog[data-contact-drawer] {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    overflow: hidden;
    overscroll-behavior: contain;
  }
  dialog[data-contact-drawer]::backdrop {
    background: color-mix(in srgb, var(--ink) 55%, transparent);
    backdrop-filter: blur(2px);
  }
  .tiroir-corps {
    height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.5rem 1rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
    box-shadow: var(--shadow-lift);
  }
  @media (min-width: 48rem) {
    dialog[data-contact-drawer] {
      inset: 0 0 0 auto;
      width: min(100%, 32rem);
    }
    .tiroir-corps { padding: 2.5rem 2.5rem; }
  }

  /* Entree : translation sur --motion-ui / --ease-out (reponse a un geste, jamais --motion-duration).
     @starting-style anime l'ouverture ; `display`/`overlay` en allow-discrete animent la fermeture. */
  dialog[data-contact-drawer] {
    transform: translateY(100%);
    opacity: 0;
    transition:
      transform var(--motion-ui) var(--ease-out),
      opacity var(--motion-ui) var(--ease-out),
      overlay var(--motion-ui) allow-discrete,
      display var(--motion-ui) allow-discrete;
  }
  dialog[data-contact-drawer]::backdrop {
    opacity: 0;
    transition: opacity var(--motion-ui) var(--ease-out), overlay var(--motion-ui) allow-discrete, display var(--motion-ui) allow-discrete;
  }
  dialog[data-contact-drawer][open] { transform: none; opacity: 1; }
  dialog[data-contact-drawer][open]::backdrop { opacity: 1; }
  @starting-style {
    dialog[data-contact-drawer][open] { transform: translateY(100%); opacity: 0; }
    dialog[data-contact-drawer][open]::backdrop { opacity: 0; }
  }
  @media (min-width: 48rem) {
    dialog[data-contact-drawer] { transform: translateX(100%); }
    dialog[data-contact-drawer][open] { transform: none; }
    @starting-style {
      dialog[data-contact-drawer][open] { transform: translateX(100%); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    dialog[data-contact-drawer],
    dialog[data-contact-drawer]::backdrop { transition: none; }
  }
  /* Page bloquee derriere le tiroir (pose par le script sur <html>). */
  :global(html.ff-drawer-open) { overflow: hidden; }
</style>

<script>
  import { onPage } from '@/scripts/page';

  let trigger: HTMLElement | null = null;

  const unlock = () => document.documentElement.classList.remove('ff-drawer-open');

  onPage(() => {
    const dialog = document.querySelector<HTMLDialogElement>('dialog[data-contact-drawer]');
    if (!dialog || dialog.dataset.ready) return;
    dialog.dataset.ready = '1';
    unlock();

    const open = (from: HTMLElement | null) => {
      if (dialog.open) return;
      trigger = from;
      dialog.showModal();
      document.documentElement.classList.add('ff-drawer-open');
    };
    const close = () => dialog.close();

    dialog.addEventListener('close', () => {
      unlock();
      // Retour du focus au declencheur (les navigateurs le font deja pour showModal(), on le garantit).
      if (trigger && trigger.isConnected) trigger.focus({ preventScroll: true });
      trigger = null;
    });
    // Clic sur le fond : le <dialog> couvre tout l'ecran, son enfant .tiroir-corps est le panneau ;
    // un clic dont la cible est le dialog lui-meme tombe donc sur la zone hors panneau.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    dialog.querySelector<HTMLButtonElement>('[data-drawer-close]')?.addEventListener('click', close);

    // Tout lien #contact (ou /#contact depuis une page secondaire) de la page ouvre le tiroir.
    // Delegation sur le body (remplace a chaque navigation ClientRouter, donc jamais double).
    document.body.addEventListener('click', (e) => {
      const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[href="#contact"],a[href="/#contact"]');
      if (!a || a.closest('dialog') || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      e.preventDefault();
      open(a);
    });
  });
</script>
