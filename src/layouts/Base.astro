---
/**
 * Layout de base : charge la direction, pose les tokens, le SEO, le JSON-LD LocalBusiness,
 * le runtime d'animation. Toutes les pages passent par ici.
 */
import '@/styles/global.css';
import { site, fullAddress, slugCourant, schemaTypeForTrade } from '@/lib/site';
import { openingHoursSpecification } from '@/lib/jsonld';
import { fontFamilies, preloadFonts, themeColor, icons } from 'virtual:ff-look';
import { lookupImageEntry, splitImagePath, imageSrcsetFor, heroSizesFor } from '@/lib/images';
// ClientRouter (site.transitions, opt-in) : voir docs/ANIMATIONS.md § Transitions de page.
import { ClientRouter } from 'astro:transitions';
// Contact en tiroir (layout.contactDrawer, opt-in) : dialog natif rendu sur toutes les pages, voir
// src/components/ContactDrawer.astro et docs/CONVENTIONS.md § Coquilles.
import ContactDrawer from '@/components/ContactDrawer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Chemin canonique, ex: "/services/depannage" */
  path?: string;
  noindex?: boolean;
  /**
   * JSON-LD additionnels propres à la page (FAQPage sur l'accueil, Service sur /services/*).
   * Fusionnés dans le graphe JSON-LD unique du layout (localBusiness + ceux-ci).
   * Ne jamais passer un schéma pour du contenu qui n'est pas affiché sur la page.
   */
  jsonLd?: Record<string, unknown>[];
}
const { title, description, path = '/', noindex = false, jsonLd = [] } = Astro.props;

// Direction et polices : resolues au build par scripts/vite-ff-look.mjs (module virtuel), afin que
// seule la direction choisie et ses polices soient dans le graphe (Astro regroupe le CSS de tout
// module atteignable, meme charge paresseusement).
let fontStyle = '';
for (const [slot, family] of Object.entries(fontFamilies as Record<string, string>)) fontStyle += `--font-${slot}:${family};`;

const pageTitle = title ?? site.seo.title ?? `${site.business.name} | ${site.business.trade} à ${site.contact.address.city}`;
const pageDesc = description ?? site.seo.description ?? site.business.description.split(/\n/)[0].slice(0, 160);
const canonical = new URL(path, Astro.site).toString();
const og = site.images.og ?? site.images.hero?.src;
const ogUrl = og ? new URL(og, Astro.site).toString() : undefined;

const accentStyle = (site.accent ? `--accent-h:${site.accent.h};--accent-s:${site.accent.s}%;--accent-l:${site.accent.l}%;` : '') + fontStyle;

// Preload de l'image LCP (docs/veille/performance.md §4.1/§7 action 3) : seulement la page d'accueil
// (`path === '/'`) et seulement si `site.images.hero` existe. imagesrcset/imagesizes generes depuis le
// meme manifeste que <Img> (src/lib/images.ts) quand l'image est passee par `ff images` ; sinon simple
// href de repli sur le fichier tel quel (aucune regression pour une image non migree).
const isHome = path === '/';
const heroImg = isHome ? site.images.hero : undefined;
const heroEntry = heroImg ? lookupImageEntry(slugCourant, heroImg.src) : undefined;
// sizes du hero : HERO_SIZES (src/lib/images.ts), la meme table que le <Img> reel du Hero — sinon le
// preload et le <img> choisiraient deux candidats differents et le navigateur telechargerait les deux.
const heroSizes = heroSizesFor(site.layout.hero);
const heroPreload = heroImg
  ? (() => {
      if (!heroEntry) return { href: heroImg.src };
      const { dir, name } = splitImagePath(heroImg.src);
      return { href: heroImg.src, imagesrcset: imageSrcsetFor(heroEntry, dir, name, 'avif'), imagesizes: heroSizes };
    })()
  : undefined;

// Horaires : openingHoursSpecification (structure, opens/closes du config) prime ; sinon le
// texte libre `openingHours` historique. geo : seulement si contact.coordinates est renseigne.
// Tout le JSON-LD de la page est fusionne en UN SEUL script (@graph) : des balises script
// dynamiques (rendues par un .map()) faisaient occasionnellement echouer le scan de dependances
// de Vite en dev (« Unexpected "." », CSS non charge, fond blanc) — un seul script statique avec
// set:html, comme historiquement, est immunise. Ne jamais ecrire le nom de cette balise en
// chevrons dans un commentaire du frontmatter : le scan de Vite l'y prend pour une vraie balise.
const ohsSpec = openingHoursSpecification(site.contact.hours);
const localBusinessLd = {
  '@type': site.business.schemaType || schemaTypeForTrade(site.business.trade),
  name: site.business.name,
  description: pageDesc,
  url: Astro.site?.toString(),
  telephone: site.contact.phone,
  email: site.contact.email,
  image: ogUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.address.street,
    postalCode: site.contact.address.postalCode,
    addressLocality: site.contact.address.city,
    addressCountry: 'FR',
  },
  geo: site.contact.coordinates
    ? { '@type': 'GeoCoordinates', latitude: site.contact.coordinates.lat, longitude: site.contact.coordinates.lng }
    : undefined,
  areaServed: site.zones.cities.map((c) => ({ '@type': 'City', name: c })),
  openingHours: ohsSpec ? undefined : site.contact.hours.map((h) => `${h.days} ${h.hours}`),
  openingHoursSpecification: ohsSpec,
  sameAs: Object.values(site.social).filter(Boolean),
  foundingDate: site.business.since ? String(site.business.since) : undefined,
};
const ldJson = { '@context': 'https://schema.org', '@graph': [localBusinessLd, ...jsonLd] };
---

<!doctype html>
<html
  lang={site.lang}
  data-direction={site.direction}
  data-motion={site.motion}
  data-scale={site.scale}
  data-tone={site.layout.tone}
  data-shell={site.layout.shell}
  data-headings={site.layout.headings}
  data-site={slugCourant}
  data-smooth={site.motion === 'rich' && site.smoothScroll ? '1' : undefined}
  data-transitions={site.transitions ? '1' : undefined}
  style={accentStyle}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {/* Preload police display + image LCP (docs/veille/performance.md §1.5/§4.1) : decouverts au
        parsing du <head>, avant que le CSS externe (bloquant) ne soit lu et que l'<img> ne soit
        atteint dans le corps. */}
    {preloadFonts.map((url: string) => (
      <link rel="preload" as="font" type="font/woff2" href={url} crossorigin />
    ))}
    {heroPreload && (
      <link
        rel="preload"
        as="image"
        href={heroPreload.href}
        imagesrcset={heroPreload.imagesrcset}
        imagesizes={heroPreload.imagesizes}
        fetchpriority="high"
        type={heroPreload.imagesrcset ? 'image/avif' : undefined}
      />
    )}
    {noindex && <meta name="robots" content="noindex" />}
    {site.seo.keywords.length > 0 && <meta name="keywords" content={site.seo.keywords.join(', ')} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />
    {/* Pack d'icones genere au build depuis favicon.svg (scripts/astro-icons-integration.mjs) ;
        theme-color = token --bg de la direction (scripts/ff/icones.mjs). */}
    {icons.ico && <link rel="icon" href="/favicon.ico" sizes="32x32" />}
    {icons.svg && <link rel="icon" href="/favicon.svg" type="image/svg+xml" />}
    {icons.apple && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
    {icons.manifest && <link rel="manifest" href="/site.webmanifest" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={themeColor} />
    <script type="application/ld+json" set:html={JSON.stringify(ldJson)} />
    {site.analytics.plausible && <script defer data-domain={site.analytics.plausible} src="https://plausible.io/js/script.js"></script>}
    {site.analytics.umami && <script defer src={site.analytics.umami.src} data-website-id={site.analytics.umami.id}></script>}
    {site.analytics.cloudflare && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.analytics.cloudflare })}></script>}
    {site.transitions && <ClientRouter />}
    <slot name="head" />
  </head>
  <body>
    {/* data-duotone (CSS) : filtre SVG defini une fois, applique via filter: url(#ff-duotone) sur n'importe quel <img> (voir docs/veille/rendu.md §4.1). */}
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="ff-duotone" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0" />
      </filter>
    </svg>
    {site.motion === 'rich' && <div class="ff-curtain" aria-hidden="true"></div>}
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-accent focus:text-on-accent focus:px-4 focus:py-2 focus:rounded-ui">Aller au contenu</a>
    <slot />
    {site.layout.contactDrawer && <ContactDrawer />}
    <script>
      import { initMotion } from '@/scripts/motion';
      // site.transitions (ClientRouter) : 'astro:page-load' se declenche au chargement initial (sur `load`,
      // apres les modules) ET apres chaque navigation cote client — pas de double-init, initMotion() se
      // rearme sans doubler les observateurs (voir l'en-tete de motion.ts § Transitions de page). Sans
      // transitions, aucun ClientRouter n'est present donc l'evenement ne se declenche jamais : appel direct
      // (comportement historique). Meme regle pour tout script inline de src/ : onPage() (src/scripts/page.ts).
      if (document.documentElement.hasAttribute('data-transitions')) {
        document.addEventListener('astro:page-load', initMotion);
      } else {
        initMotion();
      }
    </script>
  </body>
</html>
