---
/**
 * Page d'une matière (/matieres/<slug>, site.matieres, src/lib/matieres.ts) : architecture `nuancier-matieres` (une fiche
 * d'essence de la Menuiserie Pipault : photo, aubier, grain, densité, dureté, durabilité, usages ; la fiche de Boud'bOis : usage
 * et prix moyen ; docs/veille/architectures/nuancier-matieres.md). Le nom, la photo en grand, la fiche à filets, la place sur
 * l'échelle avec les voisines du dessous et du dessus, les usages, le prix si le client le publie, ce qu'il en dit, l'appel.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import { site, tel, matieresCompletes, matieresSurEchelle, voisinesSurEchelle, lienMatieres } from '@/lib/site';
import { resolveSection } from '@/lib/sections';

export function getStaticPaths() {
  return matieresCompletes(site.matieres?.liste).map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const mt = site.matieres!;
const page = lienMatieres(mt.liste, site.wording.matieres);
const ech = mt.echelle;
const place = ech ? matieresSurEchelle(mt.liste).find((e) => e.matiere.slug === m.slug) : undefined;
const { dessous, dessus } = place ? voisinesSurEchelle(mt.liste, m.slug) : {};
const nombre = (v: number) => v.toLocaleString('fr-FR', { maximumFractionDigits: 2 });
const unite = ech?.unite ? ` ${ech.unite}` : '';
const autres = matieresCompletes(mt.liste).filter((x) => x.slug !== m.slug);
---

<Base title={`${m.nom} | ${site.business.name}`} description={`${m.nom}${m.origine ? `, ${m.origine}` : ''} : ${site.business.trade}, ${site.business.name}${m.usages.length ? `. ${m.usages.join(', ')}` : ''}.`} path={`/matieres/${m.slug}`}>
  <Nav />
  <main id="main" class="container-ff mf">
    <p><a href={page ? '/matieres' : '/#nuancier'} class="mf-lien"><Icon name="ArrowLeft" size={16} />{site.wording.matieres}</a></p>
    <div class="mf-haut">
      {m.photo && <Img src={m.photo.src} alt={m.photo.alt} class="mf-photo" sizes="(min-width: 64rem) 30rem, 100vw" priority />}
      <div class="mf-fiche">
        <h1 class="mf-titre font-display">{m.nom}</h1>
        {(m.autreNom || m.origine) && <p class="mf-sous">{[m.autreNom, m.origine].filter(Boolean).join(', ')}</p>}
        <dl class="mf-dl">
          {place && ech && <div class="mf-ligne"><dt>{ech.nom}</dt><dd class="tabular-nums">{nombre(m.valeur!)}{unite}</dd></div>}
          {m.caracteristiques.map((c) => <div class="mf-ligne"><dt>{c.nom}</dt><dd>{c.valeur}</dd></div>)}
          {m.usages.length > 0 && <div class="mf-ligne"><dt>Usages</dt><dd>{m.usages.join(', ')}</dd></div>}
          {m.prix && <div class="mf-ligne"><dt>Prix</dt><dd class="tabular-nums">{m.prix}</dd></div>}
        </dl>
        <p><a href={tel()} class="mf-tel tabular-nums"><Icon name="Phone" size={19} />{site.contact.phoneDisplay}</a></p>
      </div>
    </div>
    {m.texte && <p class="mf-texte">{m.texte}</p>}
    {place && ech && (
      <section aria-labelledby="mf-echelle">
        <h2 id="mf-echelle" class="mf-h2 font-display">{ech.nom}, à côté des autres</h2>
        <ol class="mf-voisines">
          {[dessous, m, dessus].filter(Boolean).map((x) => (
            <li class:list={['mf-v', x!.slug === m.slug && 'mf-ici']}>
              {x!.slug === m.slug ? <span class="mf-v-nom">{x!.nom}</span> : <a href={`/matieres/${x!.slug}`} class="mf-lien">{x!.nom}</a>}
              <span class="tabular-nums">{nombre(x!.valeur!)}{unite}</span>
            </li>
          ))}
        </ol>
      </section>
    )}
    {mt.echantillons && <p class="mf-muted">{mt.echantillons}</p>}
    {autres.length > 0 && (
      <nav aria-labelledby="mf-autres">
        <h2 id="mf-autres" class="mf-h2 font-display">Les autres matières</h2>
        <ul class="mf-autres">{autres.map((x) => <li><a href={`/matieres/${x.slug}`} class="mf-lien">{x.nom}</a></li>)}</ul>
      </nav>
    )}
  </main>
  <Footer />
</Base>

<style>
  .mf { display: grid; gap: clamp(1.25rem, 4vh, 2.5rem); padding-block: clamp(1.25rem, 4vh, 3rem); max-inline-size: 64rem; }
  .mf-haut { display: grid; gap: clamp(1.25rem, 3vw, 2.5rem); }
  .mf-photo { inline-size: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius-ui, 4px); box-shadow: var(--shadow-card); }
  .mf-fiche { display: grid; gap: 0.75rem; align-content: start; }
  .mf-titre { font-size: clamp(2.4rem, 8vw, 5rem); line-height: 0.98; letter-spacing: -0.02em; }
  .mf-sous { color: var(--color-muted); font-size: 1.1rem; }
  .mf-dl { display: grid; border-block-start: 2px solid var(--color-fg); }
  .mf-ligne { display: grid; grid-template-columns: minmax(7rem, 40%) minmax(0, 1fr); column-gap: 1rem; padding-block: 0.45rem; border-block-end: 1px solid var(--color-line); }
  .mf-ligne dt { color: var(--color-muted); }
  .mf-ligne dd { font-weight: 600; }
  .mf-texte { max-inline-size: 62ch; font-size: 1.1rem; }
  .mf-muted { color: var(--color-muted); }
  .mf-h2 { font-size: clamp(1.35rem, 3vw, 1.9rem); line-height: 1.08; }
  .mf-voisines { display: grid; }
  .mf-v { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-block-size: 44px; border-block-end: 1px solid var(--color-line); }
  .mf-ici { font-weight: 700; border-inline-start: 4px solid var(--color-accent); padding-inline-start: 0.6rem; }
  .mf-tel { display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: 52px; padding-inline: 1.1rem; border-radius: var(--radius-ui, 6px); background: var(--color-accent); color: var(--color-on-accent); font-weight: 700; font-size: 1.2rem; }
  .mf-lien { display: inline-flex; align-items: center; gap: 0.35rem; min-block-size: 44px; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .mf-tel:focus-visible, .mf-lien:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .mf-autres { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  @media (min-width: 48rem) { .mf-haut { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: start; } }
</style>
