---
/**
 * Page /matieres (site.matieres, src/lib/matieres.ts) : architecture `nuancier-matieres` (la page « Essence bois » de la
 * Menuiserie Pipault : chaque essence avec ses caractéristiques côte à côte ; docs/veille/architectures/nuancier-matieres.md). Le
 * tableau comparé : une rangée par matière, une colonne par caractéristique que deux matières au moins partagent, la valeur sur
 * l'échelle du client, les usages ; au téléphone, une fiche à filets par matière. Puis les questions. Générée dès 3 matières.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site, tel, metierEtVille, matieresCompletes, colonnesDesMatieres, valeurDeMatiere, lienMatieres } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import { faqPageLd } from '@/lib/jsonld';

export function getStaticPaths() {
  return lienMatieres(site.matieres?.liste, site.wording.matieres) ? [{ params: { index: undefined } }] : [];
}
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const mt = site.matieres!;
const toutes = matieresCompletes(mt.liste);
const cols = colonnesDesMatieres(toutes);
const ech = mt.echelle && toutes.some((m) => m.valeur) ? mt.echelle : undefined;
const avecUsages = toutes.some((m) => m.usages.length > 0);
const avecPrix = toutes.some((m) => m.prix);
const nombre = (v: number) => v.toLocaleString('fr-FR', { maximumFractionDigits: 2 });
const titre = site.wording.matieres;
---

<Base title={`${titre} | ${site.business.name}`} description={`${site.business.trade} : ${toutes.length} matières comparées, ${toutes.map((m) => m.nom).slice(0, 6).join(', ')}.`} path="/matieres" jsonLd={site.faq.length > 0 ? [faqPageLd(site.faq)!] : []}>
  <Nav />
  <main id="main" class="container-ff ma">
    <header class="ma-tete">
      <h1 class="ma-titre font-display">{titre}</h1>
      <p>{metierEtVille()}</p>
      {mt.intro && <p class="ma-muted">{mt.intro}</p>}
    </header>
    <div class="ma-cadre">
      <table class="ma-table">
        <caption class="sr-only">Les matières comparées</caption>
        <thead>
          <tr>
            <th scope="col">Matière</th>
            {ech && <th scope="col">{ech.nom}{ech.unite ? ` (${ech.unite})` : ''}</th>}
            {cols.map((c) => <th scope="col">{c}</th>)}
            {avecUsages && <th scope="col">Usages</th>}
            {avecPrix && <th scope="col">Prix</th>}
          </tr>
        </thead>
        <tbody>
          {toutes.map((m) => (
            <tr>
              <th scope="row"><a href={`/matieres/${m.slug}`} class="ma-lien">{m.nom}</a></th>
              {ech && <td class="tabular-nums" data-libelle={ech.nom}>{m.valeur ? nombre(m.valeur) : ''}</td>}
              {cols.map((c) => <td data-libelle={c}>{valeurDeMatiere(m, c)}</td>)}
              {avecUsages && <td data-libelle="Usages">{m.usages.join(', ')}</td>}
              {avecPrix && <td data-libelle="Prix" class="tabular-nums">{m.prix ?? ''}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {mt.echantillons && <p class="ma-appel">{mt.echantillons}</p>}
    <p class="ma-appel"><a href={tel()} class="ma-lien tabular-nums"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a></p>
    {site.faq.length > 0 && (
      <section id="faq" aria-labelledby="ma-faq" class="ma-faq">
        <h2 id="ma-faq" class="ma-h2 font-display">{site.wording.faqTitle ?? 'Vos questions'}</h2>
        {site.faq.map((q) => <details><summary>{q.q}</summary><p>{q.a}</p></details>)}
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .ma { display: grid; gap: clamp(1.75rem, 5vh, 3rem); padding-block: clamp(1.5rem, 5vh, 4rem); max-inline-size: 72rem; }
  .ma-tete { display: grid; gap: 0.5rem; }
  .ma-titre { font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1; letter-spacing: -0.015em; }
  .ma-muted { color: var(--color-muted); }
  .ma-table { inline-size: 100%; border-collapse: collapse; }
  .ma-table th, .ma-table td { text-align: start; vertical-align: baseline; padding: 0.4rem 1rem 0.4rem 0; border-block-end: 1px solid var(--color-line); }
  .ma-table thead th { font-weight: 600; color: var(--color-muted); border-block-end: 2px solid var(--color-fg); }
  .ma-table tbody th { font-weight: 700; }
  .ma-lien { display: inline-flex; align-items: center; gap: 0.35rem; min-block-size: 44px; font-weight: 700; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .ma-lien:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .ma-appel { font-weight: 600; }
  /* Au téléphone, chaque rangée devient une fiche à filets : le libellé de la colonne devant chaque valeur. */
  @media (max-width: 47.99rem) {
    .ma-table thead { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .ma-table tr { display: grid; padding-block: 0.6rem; border-block-end: 2px solid var(--color-fg); }
    .ma-table th, .ma-table td { display: block; border: 0; padding: 0.1rem 0; }
    .ma-table td:empty { display: none; }
    .ma-table td::before { content: attr(data-libelle) '\00a0: '; color: var(--color-muted); }
  }
  .ma-h2 { font-size: clamp(1.4rem, 3.2vw, 2rem); }
  .ma-faq { display: grid; gap: 0.25rem; }
  .ma-faq details { border-block-end: 1px solid var(--color-line); }
  .ma-faq summary { display: flex; align-items: center; min-block-size: 48px; font-weight: 600; cursor: pointer; }
  .ma-faq summary:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .ma-faq p { padding-block-end: 0.85rem; color: var(--color-muted); }
</style>
