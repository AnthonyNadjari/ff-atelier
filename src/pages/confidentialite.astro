---
/**
 * Politique de confidentialite : generee depuis site.config.ts (RGPD, formulaire de contact).
 * Voir docs/veille/seo-conversion.md § 3.3-3.4. Jamais de donnee inventee : le destinataire des
 * donnees depend de form.provider, la mention carte depend de contact.mapsProvider.
 */
import Base from '@/layouts/Base.astro';
import { site, fullAddress } from '@/lib/site';
import { getSection, resolveSection } from '@/lib/sections';
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const b = site.business;
const owner = site.legal.owner ?? b.name;
// Texte sur mesure d'un site (sites/<slug>/legal/Confidentialite.astro), quand la page générée ne suffit pas
// (ex. finck-fisch : société pas encore immatriculée, formulaire d'audit propre). Rend le <main> entier.
const SurMesure = Object.entries(import.meta.glob<{ default: any }>('/sites/*/legal/Confidentialite.astro', { eager: true }))
  .find(([k]) => k.startsWith(`/sites/${site.slug}/`))?.[1].default;

const provider = site.form.provider;
const destinataire: Record<string, string> = {
  mailto: `la messagerie de ${b.name} (aucun serveur intermédiaire : votre message ouvre directement le logiciel de messagerie de l’entreprise)`,
  web3forms: 'Web3Forms (États-Unis), le prestataire technique qui relaie le message par e-mail à ' + b.name,
  cloudflare: `Cloudflare, Inc. : le formulaire est traité par un programme (Worker) hébergé sur l'infrastructure Cloudflare, qui transmet ensuite le message par e-mail à ${b.name}. Le traitement peut avoir lieu dans l'Union européenne via la Data Localization Suite de Cloudflare selon la configuration retenue pour ce site (voir la politique de confidentialité de Cloudflare, cloudflare.com/trust-hub/gdpr)`,
};
const destinataireTexte = destinataire[provider];

const hasAudience = Boolean(site.analytics.plausible || site.analytics.umami || site.analytics.cloudflare);
const mapsProvider = site.contact.mapsProvider;
// <Carte /> n'est rendu que par zones/map et contact/full, et n'affiche une carte reelle que si
// les donnees necessaires au provider choisi sont presentes (sinon repli sur l'adresse seule, voir
// src/components/Carte.astro) : ne mentionner la carte dans les cookies que si une carte reelle
// s'affichera effectivement sur ce site.
const usesCarteSection = site.layout.sections.some((s) => (s.type === 'zones' && s.variant === 'map') || (s.type === 'contact' && s.variant === 'full'));
const showsOsmMap = usesCarteSection && mapsProvider === 'osm' && Boolean(site.contact.coordinates);
const showsGoogleFacade = usesCarteSection && mapsProvider === 'google' && Boolean(site.contact.mapsEmbed);
---

<Base title={`Politique de confidentialité | ${b.name}`} description={`Politique de confidentialité et données personnelles de ${b.name}.`} path="/confidentialite" noindex>
  <Nav />
  {SurMesure ? <SurMesure /> : (
  <main id="main" class="section-y">
    <div class="container-ff max-w-3xl space-y-10 text-[0.95rem] leading-relaxed">
      <h1 class="text-display-md">Politique de confidentialité</h1>
      <p class="text-muted">Cette page explique quelles données personnelles {b.name} collecte via ce site, pourquoi, combien de temps, et comment les faire modifier ou supprimer.</p>

      <section>
        <h2 class="text-display-sm mb-3">Responsable du traitement</h2>
        <p>{owner}{b.legalForm && `, ${b.legalForm}`}<br />{fullAddress()}<br />E-mail : {site.contact.email}<br />Téléphone : {site.contact.phoneDisplay}</p>
      </section>

      {provider !== 'none' && (
        <section>
          <h2 class="text-display-sm mb-3">Données collectées par le formulaire de contact</h2>
          <p>Quand vous utilisez le formulaire de contact de ce site, les données suivantes sont collectées : nom, téléphone, e-mail (facultatif), et le contenu de votre message.</p>

          <h3 class="mt-5 font-medium">Finalité</h3>
          <p>Ces données servent uniquement à répondre à votre demande de contact ou de devis, et à vous recontacter par téléphone ou e-mail.</p>

          <h3 class="mt-5 font-medium">Base légale</h3>
          <p>Le traitement repose sur l’intérêt légitime de {owner} à répondre aux demandes qui lui sont adressées, ou sur les mesures précontractuelles nécessaires à l’établissement d’un devis (article 6.1.b du RGPD), lorsque votre demande vise la conclusion d’un contrat.</p>

          <h3 class="mt-5 font-medium">Durée de conservation</h3>
          <p>Vos données sont conservées 12 mois maximum à compter de votre dernier contact, sauf suite donnée nécessitant une conservation plus longue (devis signé, facturation), auquel cas les règles comptables et fiscales applicables s’appliquent.</p>

          {destinataireTexte && (
            <>
              <h3 class="mt-5 font-medium">Destinataire</h3>
              <p>Les données transmises via le formulaire sont reçues par {destinataireTexte}. Elles ne sont ni cédées ni revendues à un tiers, et ne servent à aucune prospection commerciale ou newsletter non sollicitée.</p>
            </>
          )}
        </section>
      )}

      <section>
        <h2 class="text-display-sm mb-3">Vos droits</h2>
        <p>Conformément au Règlement général sur la protection des données (RGPD) et à la loi Informatique et Libertés, vous disposez d’un droit d’accès, de rectification, d’effacement et d’opposition sur vos données personnelles. Vous pouvez exercer ces droits en écrivant à {site.contact.email} ou par courrier à l’adresse ci-dessus. Vous disposez également du droit d’introduire une réclamation auprès de la CNIL (<a href="https://www.cnil.fr" target="_blank" rel="noopener" class="underline">cnil.fr</a>).</p>
      </section>

      <section>
        <h2 class="text-display-sm mb-3">Cookies et traceurs</h2>
        <p>Ce site n’utilise aucun cookie publicitaire ni traceur de suivi entre sites.</p>
        {hasAudience && (
          <p class="mt-3">La mesure d'audience de ce site est réalisée sans cookie et sans donnée personnelle identifiante{site.analytics.plausible ? ' (Plausible)' : site.analytics.umami ? ' (Umami)' : site.analytics.cloudflare ? ' (Cloudflare Web Analytics)' : ''}, et ne nécessite donc pas de consentement préalable (exemption prévue par la CNIL pour la mesure d'audience, voir <a href="https://www.cnil.fr/fr/cookies-et-autres-traceurs/regles/exemptions" target="_blank" rel="noopener" class="underline">cnil.fr</a>).</p>
        )}
        {showsOsmMap && (
          <p class="mt-3">La carte affichée sur ce site utilise des images cartographiques statiques d'OpenStreetMap, sans cookie ni script de suivi.</p>
        )}
        {showsGoogleFacade && (
          <p class="mt-3">Une carte Google Maps peut être affichée à votre demande, après un clic explicite sur le bouton prévu à cet effet — elle n'est jamais chargée automatiquement. Son affichage entraîne alors un dépôt de cookies par Google : voir la <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" class="underline">politique de confidentialité de Google</a>.</p>
        )}
      </section>

      <section>
        <h2 class="text-display-sm mb-3">Hébergement</h2>
        <p>{site.legal.host}</p>
      </section>

      <section>
        <p class="text-muted">Pour toute question sur cette politique, écrivez à {site.contact.email}. Voir aussi les <a href="/mentions-legales" class="underline hover:text-fg">mentions légales</a>.</p>
      </section>
    </div>
  </main>
  )}
  <Footer />
</Base>
