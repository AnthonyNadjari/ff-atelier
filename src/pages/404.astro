---
/** Page 404 : Cloudflare Pages sert 404.html automatiquement. */
import Base from '@/layouts/Base.astro';
import { site, tel } from '@/lib/site';
import { getSection } from '@/lib/sections';
import Button from '@/components/Button.astro';
const Nav = getSection('nav', site.layout.nav);
const Footer = getSection('footer', site.layout.footer);
---

<Base title={`Page introuvable — ${site.business.name}`} path="/404" noindex>
  <Nav />
  <main id="main" class="section-y min-h-[60vh] flex items-center">
    <div class="container-ff text-center" data-stagger="120">
      <p class="eyebrow">Erreur 404</p>
      <h1 class="text-display-lg mt-4">Cette page n'existe pas.</h1>
      <p class="mt-5 text-lg text-muted max-w-xl mx-auto">Le lien est peut-être ancien. Le plus simple&nbsp;: revenir à l'accueil ou nous appeler.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <Button href="/" size="lg">Retour à l'accueil</Button>
        <Button href={tel()} variant="ghost" size="lg">{site.contact.phoneDisplay}</Button>
      </div>
    </div>
  </main>
  <Footer />
</Base>
