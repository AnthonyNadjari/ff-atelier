---
/**
 * Page d'un matériel (/materiel/<slug>, site.location, src/lib/location.ts) : architecture `catalogue-location` (source
 * Location Service, Mulhouse ; docs/veille/architectures/catalogue-location.md). Le nom, la photo du parc si le client
 * l'a donnée, les prix par durée (particulier TTC, professionnel HT s'il est donné), la caution, ce qu'il faut savoir,
 * les créneaux qui comptent moins, Appeler pour le réserver, le magasin. Une page par matériel à prix ; sinon aucune.
 */
import Base from '@/layouts/Base.astro';
import { site, tel, mailto, fullAddress, materielsComplets, prixDuMateriel, aPrixPro } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';

export function getStaticPaths() {
  return materielsComplets(site.location).map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const l = site.location!;
const prix = prixDuMateriel(m, l.durees);
const pro = aPrixPro(l) && prix.some((x) => x.pro);
const autres = materielsComplets(l).filter((x) => x.slug !== m.slug && x.categorie === m.categorie).slice(0, 6);
const sujet = encodeURIComponent(`Location : ${m.nom}`);
---

<Base title={`Location ${m.nom} à ${site.contact.address.city} | ${site.business.name}`} description={`${m.nom} à louer chez ${site.business.name} (${site.contact.address.city}) : ${prix.map((x) => `${x.duree.toLowerCase()} ${x.prix}`).join(', ')}${m.caution ? `, caution ${m.caution}` : ''}.`} path={`/materiel/${m.slug}`}>
  <Nav />
  <main id="main" class="container-ff mf">
    <p><a href="/materiel" class="mf-lien"><Icon name="ArrowLeft" size={16} />{site.wording.materiel}</a></p>
    <div class="mf-grille">
      <div class="mf-texte">
        {m.categorie && <p class="mf-cat">{m.categorie}</p>}
        <h1 class="mf-titre font-display">{m.nom}</h1>
        {m.detail && <p class="mf-detail">{m.detail}</p>}
        <table class="mf-prix">
          <caption class="sr-only">Prix de location</caption>
          <thead><tr><th scope="col">Durée</th><th scope="col">{pro ? 'Particulier, TTC' : 'Prix'}</th>{pro && <th scope="col">Professionnel, HT</th>}</tr></thead>
          <tbody>{prix.map((x) => <tr><th scope="row">{x.duree}</th><td class="tabular-nums">{x.prix}</td>{pro && <td class="tabular-nums">{x.pro ?? ''}</td>}</tr>)}</tbody>
        </table>
        {m.caution && <p class="mf-caution">Caution&nbsp;: {m.caution}</p>}
        {m.note && <p>{m.note}</p>}
        <p class="mf-portes">
          <a href={tel()} class="mf-porte tabular-nums"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a>
          {site.contact.email && <a href={`${mailto()}?subject=${sujet}`} class="mf-lien"><Icon name="Mail" size={16} />Demander ce matériel</a>}
        </p>
      </div>
      {m.photo && <Img src={m.photo.src} alt={m.photo.alt} class="mf-photo rounded-card w-full object-cover" sizes="(min-width: 1024px) 40vw, 100vw" />}
    </div>
    {l.creneaux.length > 0 && (
      <section aria-labelledby="mf-creneaux" class="mf-bloc">
        <h2 id="mf-creneaux" class="mf-h2 font-display">Le bon créneau</h2>
        <ul class="mf-cr">{l.creneaux.map((c) => <li><strong>{c.nom}</strong>, {c.retrait}, rendu {c.retour.charAt(0).toLowerCase() + c.retour.slice(1)}&nbsp;: {c.compte.charAt(0).toLowerCase() + c.compte.slice(1)}</li>)}</ul>
      </section>
    )}
    <section aria-labelledby="mf-magasin" class="mf-bloc">
      <h2 id="mf-magasin" class="mf-h2 font-display">Au magasin</h2>
      <p>{site.business.name}, {fullAddress()}</p>
      {l.conditions.length > 0 && <ul class="mf-conditions">{l.conditions.map((x) => <li>{x}</li>)}</ul>}
    </section>
    {autres.length > 0 && (
      <nav aria-labelledby="mf-autres" class="mf-bloc">
        <h2 id="mf-autres" class="mf-h2 font-display">Dans la même catégorie</h2>
        <ul class="mf-liste">{autres.map((x) => <li><a href={`/materiel/${x.slug}`} class="mf-autre">{x.nom}<Icon name="ArrowRight" size={16} /></a></li>)}</ul>
      </nav>
    )}
  </main>
  <Footer />
</Base>

<style>
  .mf { display: grid; gap: 2rem; padding-block: clamp(1.5rem, 5vh, 3.5rem); }
  .mf-grille { display: grid; gap: 1.5rem; }
  .mf-texte { display: grid; gap: 0.9rem; align-content: start; }
  .mf-cat { color: var(--color-muted); }
  .mf-titre { font-size: clamp(2rem, 5.5vw, 3.6rem); line-height: 1.02; letter-spacing: -0.01em; text-wrap: balance; }
  .mf-detail { font-size: 1.1rem; }
  .mf-prix { border-collapse: collapse; max-inline-size: 32rem; }
  .mf-prix th, .mf-prix td { padding: 0.55rem 1rem 0.55rem 0; text-align: start; border-block-end: 1px solid var(--color-line); }
  .mf-prix thead th { font-size: 0.9rem; color: var(--color-muted); }
  .mf-prix tbody th { font-weight: 400; }
  .mf-prix td { font-weight: 700; font-size: 1.1rem; }
  .mf-caution { font-weight: 600; }
  .mf-portes { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; }
  .mf-porte { display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: 48px; padding-inline: 1.1rem; border-radius: var(--radius-ui, 6px); background: var(--color-accent); color: var(--color-on-accent); font-weight: 600; }
  .mf-lien { display: inline-flex; align-items: center; gap: 0.4rem; min-block-size: 44px; text-decoration: underline; text-underline-offset: 0.2em; }
  .mf-porte:focus-visible, .mf-lien:focus-visible, .mf-autre:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .mf-photo { aspect-ratio: 4 / 3; }
  .mf-bloc { display: grid; gap: 0.6rem; max-inline-size: 60ch; }
  .mf-h2 { font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1.1; }
  .mf-cr, .mf-conditions { display: grid; gap: 0.3rem; padding-inline-start: 1.1rem; list-style: disc; }
  .mf-liste { display: grid; }
  .mf-autre { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-block-size: 48px; border-block-end: 1px solid var(--color-line); }
  @media (min-width: 64rem) { .mf-grille { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); column-gap: 4rem; } }
</style>
