---
/**
 * Page /professionnels (site.pros) : architecture `pages-adresses` (Ten Belles, docs/veille/architectures/pages-adresses.md,
 * « Vente aux pros ») : le chemin des professionnels, à part du site public mais dans le même site (jamais un
 * sous-domaine). Titre et texte du client, ses offres en lignes à filets, l'e-mail et le téléphone dédiés (repli :
 * ceux du site), les adresses s'il y en a. Générée seulement si site.pros est renseigné ; sinon ni page ni lien.
 */
import Base from '@/layouts/Base.astro';
import { site, paragraphs, telDuLieu, adresseDuLieu } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import Icon from '@/components/Icon.astro';

export function getStaticPaths() {
  return site.pros ? [{ params: { index: undefined } }] : [];
}
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const pros = site.pros!;
const email = pros.email ?? site.contact.email;
const t = telDuLieu({ phone: pros.phone, phoneDisplay: pros.phoneDisplay }, site.contact);
---

<Base title={`${pros.titre} | ${site.business.name}`} description={paragraphs(pros.texte)[0] ?? pros.titre} path="/professionnels">
  <Nav />
  <main id="main">
    <div class="container-ff section-y pr">
      <div>
        <a href="/" class="inline-flex items-center gap-2 text-sm hover:underline"><Icon name="ArrowLeft" size={16} />Accueil</a>
        <h1 class="text-display-lg mt-6">{pros.titre}</h1>
        <p class="mt-3 text-lg text-muted">{site.business.name}, {site.business.trade.toLowerCase()} à {site.contact.address.city}.</p>
        <div class="mt-8 space-y-5 text-lg leading-relaxed max-w-prose">{paragraphs(pros.texte).map((p) => <p>{p}</p>)}</div>
      </div>
      <aside class="pr-contact">
        <h2 class="text-display-sm">Nous joindre</h2>
        <ul class="mt-4 space-y-2">
          <li><a href={t.href} class="pr-lien tabular-nums"><Icon name="Phone" size={16} />{t.affiche}</a></li>
          {email && <li><a href={`mailto:${email}`} class="pr-lien break-all"><Icon name="Mail" size={16} />{email}</a></li>}
        </ul>
        {site.lieux.length > 0 && (
          <ul class="mt-6 space-y-1 text-sm">
            {site.lieux.map((l) => <li><a href={`/adresses/${l.slug}`} class="underline underline-offset-4">{l.nom}</a>, {adresseDuLieu(l)}</li>)}
          </ul>
        )}
      </aside>
      {pros.offres.length > 0 && (
        <section class="pr-offres" aria-labelledby="pr-offres-titre">
          <h2 id="pr-offres-titre" class="text-display-sm">Ce que nous proposons</h2>
          <ul class="pr-filets">
            {pros.offres.map((o) => <li><span class="font-display text-xl">{o.nom}</span>{o.detail && <span class="text-muted">{o.detail}</span>}</li>)}
          </ul>
        </section>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .pr { display: grid; gap: clamp(2.5rem, 6vw, 4rem); }
  .pr-contact { padding-block-start: 1.5rem; border-block-start: 1px solid var(--color-line); align-self: start; }
  .pr-lien { display: inline-flex; align-items: center; gap: 0.45rem; min-block-size: 44px; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .pr-lien:hover { color: var(--color-accent); }
  .pr-filets { margin-block-start: 1.5rem; border-block-start: 1px solid var(--color-line); }
  .pr-filets > li { display: grid; gap: 0.25rem; padding-block: 1rem; border-block-end: 1px solid var(--color-line); }
  @media (min-width: 64rem) {
    .pr { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); }
    .pr-offres { grid-column: 1 / -1; }
  }
</style>
