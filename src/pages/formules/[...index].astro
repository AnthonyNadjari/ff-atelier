---
/**
 * Page /formules (site.formules, src/lib/formules.ts) : architecture `formules-comparees` (« Pricing » de GreenCraft ;
 * docs/veille/architectures/formules-comparees.md). La comparaison ligne à ligne : une colonne par formule (nom vers sa
 * page, prix, second prix, durée), une ligne par élément compris dans au moins une formule (reprises dépliées), la
 * réponse en mots (« Compris » / « Non »), jamais en coches (docs/GOUT.md § 2) ; ce qui est commun à toutes, les
 * conditions, la porte de chaque formule. Lisible sans script. Générée seulement avec 2 formules à prix (lienFormules).
 */
import Base from '@/layouts/Base.astro';
import { site, tel, metierEtVille, formulesCompletes, lignesComparees, lienFormules } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import Icon from '@/components/Icon.astro';

export function getStaticPaths() {
  return lienFormules(site.formules, site.wording.formules) ? [{ params: { index: undefined } }] : [];
}
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const f = site.formules!;
const formules = formulesCompletes(f);
const lignes = lignesComparees(formules);
const titre = site.wording.formules;
---

<Base title={`${titre} | ${site.business.name}`} description={`${titre} de ${site.business.name}, ${site.business.trade.toLowerCase()} à ${site.contact.address.city} : ${formules.map((x) => `${x.nom} ${x.prix}`).join(', ')}.`} path="/formules">
  <Nav />
  <main id="main" class="container-ff fp">
    <header class="fp-tete">
      <h1 class="fp-titre font-display">{titre}</h1>
      <p>{metierEtVille()}</p>
      <p><a href={tel()} class="fp-tel tabular-nums"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a></p>
    </header>
    <div class="fp-bord">
      <table class="fp-table">
        <caption class="sr-only">Comparaison des formules</caption>
        <thead>
          <tr>
            <td></td>
            {formules.map((x) => (
              <th scope="col">
                <a href={`/formules/${x.slug}`} class="fp-nom">{x.nom}</a>
                <span class="fp-prix tabular-nums">{x.prix}{x.rythme && ` ${x.rythme}`}</span>
                {x.prixAutre && <span class="fp-autre">{x.prixAutre}</span>}
                {x.duree && <span class="fp-autre">{x.duree}</span>}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {lignes.map((l) => (
            <tr>
              <th scope="row">{l.element}</th>
              {l.dans.map((d) => <td class:list={[!d && 'fp-non']}>{d ? 'Compris' : 'Non'}</td>)}
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <td></td>
            {formules.map((x) => <td><a href={`/formules/${x.slug}#demande`} class="fp-porte">{site.wording.disponibilite}<span class="sr-only"> : {x.nom}</span></a></td>)}
          </tr>
        </tfoot>
      </table>
    </div>
    {(f.communs.length > 0 || f.conditions.length > 0) && (
      <div class="fp-communs">
        {f.communs.length > 0 && (<><h2 class="fp-h2">Dans toutes les formules</h2><ul>{f.communs.map((x) => <li>{x}</li>)}</ul></>)}
        {f.conditions.length > 0 && (<><h2 class="fp-h2">Conditions</h2><ul>{f.conditions.map((x) => <li>{x}</li>)}</ul></>)}
      </div>
    )}
  </main>
  <Footer />
</Base>

<style>
  .fp { display: grid; gap: 2rem; padding-block: clamp(1.5rem, 5vh, 4rem); }
  .fp-tete { display: grid; gap: 0.75rem; }
  .fp-titre { font-size: clamp(2rem, 5.5vw, 3.6rem); line-height: 1.02; letter-spacing: -0.01em; }
  .fp-tel { display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: 48px; padding-inline: 1rem; border: 2px solid var(--color-fg); border-radius: var(--radius-ui, 6px); font-weight: 700; }
  .fp-tel:focus-visible, .fp-nom:focus-visible, .fp-porte:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .fp-bord { overflow-x: auto; }
  .fp-table { inline-size: 100%; min-inline-size: 34rem; border-collapse: collapse; }
  .fp-table th, .fp-table td { padding: 0.65rem 0.75rem; text-align: start; vertical-align: top; border-block-end: 1px solid var(--color-line); }
  .fp-table thead th { display: table-cell; }
  .fp-nom { display: block; font-size: 1.2rem; font-weight: 700; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .fp-prix { display: block; font-size: 1.35rem; font-weight: 700; margin-block-start: 0.25rem; }
  .fp-autre { display: block; font-size: 0.92rem; color: var(--color-muted); }
  .fp-table tbody th { font-weight: 400; }
  .fp-table tbody td { font-weight: 600; }
  .fp-table tbody td.fp-non { font-weight: 400; color: var(--color-muted); }
  .fp-porte { display: inline-flex; align-items: center; min-block-size: 44px; padding-inline: 0.85rem; border-radius: var(--radius-ui, 6px); background: var(--color-accent); color: var(--color-on-accent); font-weight: 600; }
  .fp-communs { display: grid; gap: 0.5rem; }
  .fp-h2 { font-weight: 600; font-size: 1.1rem; margin-block-start: 0.5rem; }
  .fp-communs ul { display: grid; gap: 0.3rem; padding-inline-start: 1.1rem; list-style: disc; }
</style>
