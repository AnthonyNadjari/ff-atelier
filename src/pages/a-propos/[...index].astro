---
/**
 * Page À propos et contact (layout.pageAPropos) : architecture `index-projets` (Mathilde De Chiara,
 * docs/veille/architectures/mathilde-de-chiara.md). Deux colonnes : à gauche le portrait du client et le contact
 * (téléphone, e-mail, adresse, réseaux, écrire), à droite le nom, le métier et la ville, l'histoire et les valeurs.
 * Tout vient de site.about et site.contact ; un champ absent n'est pas affiché. Générée seulement si
 * layout.pageAPropos est vrai.
 */
import Base from '@/layouts/Base.astro';
import { site, tel, mailto, fullAddress, paragraphs, metierEtVille, hasContactDoor } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';

export function getStaticPaths() {
  return site.layout.pageAPropos ? [{ params: { index: undefined } }] : [];
}
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const a = site.about;
const socials = Object.entries(site.social).filter(([, v]) => v) as [string, string][];
const noms: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', tiktok: 'TikTok' };
---

<Base title={`${a.title ?? 'À propos'} | ${site.business.name}`} description={metierEtVille()} path="/a-propos">
  <Nav />
  <main id="main">
    <section class="section-y">
      <div class="container-ff grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <a href="/" class="inline-flex items-center gap-2 text-sm text-muted hover:text-fg"><Icon name="ArrowLeft" size={16} />Retour</a>
          {a.portrait && <Img src={a.portrait.src} alt={a.portrait.alt} priority class="mt-8 w-full rounded-card object-cover aspect-[4/5]" sizes="(min-width: 1024px) 40vw, 100vw" />}
          <div class="mt-8 space-y-2">
            <p class="text-sm text-muted">Contact</p>
            <p><a href={tel()} class="text-xl tabular-nums underline-offset-4 hover:underline">{site.contact.phoneDisplay}</a></p>
            {site.contact.email && <p><a href={mailto()} class="underline underline-offset-4 break-all">{site.contact.email}</a></p>}
            <p class="text-muted">{fullAddress()}</p>
            {socials.length > 0 && <p class="flex flex-wrap gap-x-5">{socials.map(([k, url]) => <a href={url} target="_blank" rel="noopener" class="underline underline-offset-4">{noms[k] ?? k}</a>)}</p>}
            {hasContactDoor(site) && <Button href="/#contact" variant="ghost" class="mt-4">{site.wording.devis}</Button>}
          </div>
        </div>
        <div class="lg:col-span-7">
          <h1 class="text-display-lg">{site.business.name}</h1>
          <p class="mt-3 text-lg text-muted">{metierEtVille()}</p>
          {a.title && <h2 class="text-display-sm mt-12">{a.title}</h2>}
          <div class="mt-6 space-y-5 text-lg leading-relaxed max-w-prose">{paragraphs(a.story).map((p) => <p>{p}</p>)}</div>
          {a.values.length > 0 && (
            <dl class="mt-12 grid gap-6 sm:grid-cols-2">
              {a.values.map((v) => <div><dt class="font-display text-xl">{v.title}</dt><dd class="mt-1 text-muted">{v.text}</dd></div>)}
            </dl>
          )}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
