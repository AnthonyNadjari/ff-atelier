---
/** Page service : une par service, SEO local (metier + ville). */
import Base from '@/layouts/Base.astro';
import { site, tel, paragraphs } from '@/lib/site';
import { getSection, resolveSection } from '@/lib/sections';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';

export function getStaticPaths() {
  return site.services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const Cta = getSection('cta', site.layout.sections.find((s) => s.type === 'cta')?.variant ?? 'band');
const others = site.services.filter((s) => s.slug !== service.slug);
const title = `${service.title} à ${site.contact.address.city} — ${site.business.name}`;
const paras = paragraphs(service.description ?? service.short);
---

<Base title={title} description={service.short} path={`/services/${service.slug}`}>
  <Nav />
  <main id="main">
    <article class="section-y">
      <div class="container-ff grid lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7" data-stagger="110">
          <a href="/#services" class="inline-flex items-center gap-2 text-sm text-muted hover:text-fg"><Icon name="ArrowLeft" size={16} /> Tous les services</a>
          <p class="eyebrow mt-8">{site.business.trade} · {site.contact.address.city}</p>
          <h1 class="text-display-lg mt-4">{service.title}</h1>
          <p class="mt-6 text-xl text-muted">{service.short}</p>
          <div class="mt-8 space-y-5 text-lg leading-relaxed max-w-prose">{paras.map((p) => <p>{p}</p>)}</div>
          {service.bullets.length > 0 && (
            <ul class="mt-8 grid sm:grid-cols-2 gap-3">{service.bullets.map((b) => <li class="flex gap-3"><Icon name="Check" size={20} class="text-accent shrink-0 mt-0.5" /><span>{b}</span></li>)}</ul>
          )}
          {service.priceFrom && <p class="mt-8 inline-block rounded-ui border border-line px-4 py-2 font-medium tabular-nums">{service.priceFrom}</p>}
          <div class="mt-10 flex flex-wrap gap-4">
            <Button href={tel()} size="lg"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</Button>
            <Button href="/#contact" variant="ghost" size="lg">{site.wording.devis}</Button>
          </div>
        </div>
        <aside class="lg:col-span-5" data-reveal="right">
          {service.image && <img src={service.image.src} alt={service.image.alt} class="rounded-card shadow-card w-full object-cover aspect-[4/3]" />}
          {others.length > 0 && (
            <div class="card mt-6 rounded-card bg-surface p-6 shadow-card">
              <p class="eyebrow mb-4">Autres services</p>
              <ul class="space-y-3">{others.map((o) => <li><a href={`/services/${o.slug}`} class="flex items-center gap-3 hover:text-accent"><Icon name={o.icon} size={18} class="text-accent" />{o.title}</a></li>)}</ul>
            </div>
          )}
          {site.zones.cities.length > 0 && <p class="mt-6 text-sm text-muted">Intervention à {site.zones.cities.slice(0, 6).join(', ')}{site.zones.cities.length > 6 && ' et alentours'}.</p>}
        </aside>
      </div>
    </article>
    <Cta />
  </main>
  <Footer />
</Base>
