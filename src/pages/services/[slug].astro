---
/**
 * Page service : une par service, SEO local (metier + ville). Gabarit selon layout.servicePage : 'fiche' (defaut,
 * ci-dessous), 'porte' (src/components/ServicePorte.astro, architecture accueil-portes) ou 'livre'
 * (src/components/ServiceLivre.astro, architecture livre-ecrans).
 */
import Base from '@/layouts/Base.astro';
import { site, tel, paragraphs, hasContactDoor } from '@/lib/site';
import { getSection, resolveSection } from '@/lib/sections';
import { serviceLd } from '@/lib/jsonld';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import ServicePorte from '@/components/ServicePorte.astro';
import ServiceLivre from '@/components/ServiceLivre.astro';
import { styleTeinte } from '@/lib/couleur';
import SortiesFiltrables from '@/components/SortiesFiltrables.astro';
import ArdoiseDuJour from '@/components/ArdoiseDuJour.astro';
import { sortiesDuService } from '@/lib/sorties';
import CreneauxDuCours from '@/components/CreneauxDuCours.astro';
import { coursDuService } from '@/lib/planning';
import { lienEstimation } from '@/lib/estimation';
import { lienHonoraires } from '@/lib/honoraires';

export function getStaticPaths() {
  // site.servicePages: false -> aucune page service (voir src/lib/schema.ts).
  if (!site.servicePages) return [];
  return site.services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const Cta = getSection('cta', site.layout.sections.find((s) => s.type === 'cta')?.variant ?? 'band');
const others = site.services.filter((s) => s.slug !== service.slug);
const title = `${service.title} à ${site.contact.address.city} — ${site.business.name}`;
const paras = paragraphs(service.description ?? service.short);
const teinte = styleTeinte(service.couleur);
// 17 oct 2026 (relecture fromagerie) : un lien vers une ancre qui n'existe pas renvoie en haut de l'accueil.
const aSectionServices = site.layout.sections.some((s) => s.type === 'services');
const aPorteContact = hasContactDoor(site);
// Sorties de cette activité (site.sorties, architecture saisons-sorties) : liste filtrable par niveau, quel que soit le gabarit.
const sorties = sortiesDuService(site.sorties, service.slug);
// Créneaux de cette discipline (site.planning, architecture planning-semaine) : ses jours et heures, quel que soit le gabarit.
const creneaux = coursDuService(site.planning, service.slug).length > 0;
const blocCreneaux = `${service.title}\u00a0: les créneaux de la semaine`;
// Demande d'estimation (site.estimation, architecture estimation-etapes) : la porte de la page ouvre la demande réglée sur
// cette prestation (« Devis en ligne » de Rigoulet sur chaque page).
const estimation = lienEstimation(site.estimation, site.wording.estimation);
// Procédures à prix (architecture honoraires-domaines) : lues seulement quand le site déclare ses honoraires.
const procedures = site.honoraires ? service.lignes.filter((l) => l.nom.trim()) : [];
const serviceJsonLd = serviceLd(site, service, new URL(`/services/${service.slug}`, Astro.site).toString());
---

<Base title={title} description={service.short} path={`/services/${service.slug}`} jsonLd={[serviceJsonLd]}>
  <Nav />
  {site.layout.servicePage === 'porte' ? (
  <main id="main"><ServicePorte service={service} />{creneaux && <div class="container-ff section-y"><CreneauxDuCours service={service.slug} titre={blocCreneaux} /></div>}{sorties.length > 0 && <div class="container-ff"><SortiesFiltrables sorties={sorties} titre={`${service.title}\u00a0: les sorties`} /></div>}{service.programme.length > 0 && <section class="container-ff section-y" aria-labelledby="programme-titre"><h2 id="programme-titre" class="text-display-md">{service.title}\u00a0: le programme de la semaine</h2><ArdoiseDuJour mode="semaine" services={[service]} niveau="h3" class="mt-8" /></section>}</main>
  ) : site.layout.servicePage === 'livre' ? (
  <main id="main"><ServiceLivre service={service} />{sorties.length > 0 && <div class="container-ff"><SortiesFiltrables sorties={sorties} titre={`${service.title}\u00a0: les sorties`} /></div>}{service.programme.length > 0 && <section class="container-ff section-y" aria-labelledby="programme-titre"><h2 id="programme-titre" class="text-display-md">{service.title}\u00a0: le programme de la semaine</h2><ArdoiseDuJour mode="semaine" services={[service]} niveau="h3" class="mt-8" /></section>}</main>
  ) : (
  <main id="main">
    {/* Couleur de l'activité (services[].couleur, architecture cadre-couleur) : bandeau en tête de la page et pastille
        devant les autres activités, encre choisie par contraste (src/lib/couleur.ts). Sans couleur : rien ne change. */}
    <article class="section-y service-fiche" data-theme={teinte ? 'service' : undefined} style={teinte}>
      <div class="container-ff grid lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7" data-stagger="110">
          <a href={aSectionServices ? '/#services' : '/'} class="inline-flex items-center gap-2 text-sm text-muted hover:text-fg"><Icon name="ArrowLeft" size={16} />{aSectionServices ? ' Tous les services' : ' Accueil'}</a>
          {/* Pas de surtitre « métier, ville » au-dessus du h1 (signe IA, docs/GOUT.md § 2) : la ville est dans le <title> et le texte. */}
          <h1 class="text-display-lg mt-8">{service.title}</h1>
          <p class="mt-6 text-xl text-muted">{service.short}</p>
          <div class="mt-8 space-y-5 text-lg leading-relaxed max-w-prose">{paras.map((p) => <p>{p}</p>)}</div>
          {service.bullets.length > 0 && (
            <ul class="mt-8 grid sm:grid-cols-2 gap-x-6 gap-y-2 list-disc pl-5 marker:text-accent">{service.bullets.map((b) => <li>{b}</li>)}</ul>
          )}
          {service.priceFrom && <p class="service-prix mt-8 inline-block rounded-ui border border-line px-4 py-2 font-medium tabular-nums">{service.priceFrom}</p>}
          {/* Procédures à prix d'un domaine (architecture honoraires-domaines : les « à partir de » de Judisis) et le lien vers
              tous les honoraires ; seulement pour un site qui déclare ses honoraires (site.honoraires). */}
          {site.honoraires && procedures.length > 0 && (
            <section class="mt-10" aria-labelledby="procedures-titre">
              <h2 id="procedures-titre" class="text-xl font-semibold">Procédures et honoraires</h2>
              <dl class="mt-4 max-w-prose">{procedures.map((l) => <div class="flex justify-between gap-4 border-b border-line py-2"><dt>{l.nom}{l.detail && <span class="text-muted"> {l.detail}</span>}</dt><dd class="font-semibold tabular-nums text-right">{l.prix ?? 'sur devis'}</dd></div>)}</dl>
              {lienHonoraires(site.honoraires, site.wording.honoraires) && <p class="mt-4"><a href="/nos-honoraires" class="underline underline-offset-4">{site.wording.honoraires} du cabinet</a></p>}
            </section>
          )}
          <div class="mt-10 flex flex-wrap gap-4">
            <Button href={tel()} size="lg"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</Button>
            {estimation ? <Button href={`/estimation?projet=${service.slug}`} variant="ghost" size="lg">{site.wording.estimation}</Button> : aPorteContact && <Button href="/#contact" variant="ghost" size="lg">{site.wording.devis}</Button>}
          </div>
        </div>
        <aside class="lg:col-span-5" data-reveal="right">
          {service.image && <Img src={service.image.src} alt={service.image.alt} class="rounded-card shadow-card w-full object-cover aspect-[4/3]" sizes="(min-width: 1280px) 480px, (min-width: 1024px) 42vw, 100vw" />}
          {others.length > 0 && (
            <div class="card mt-6 rounded-card bg-surface p-6 shadow-card">
              <p class="eyebrow mb-4">Autres services</p>
              <ul class="space-y-3">{others.map((o) => <li><a href={`/services/${o.slug}`} class="flex items-center gap-3 hover:text-accent">{o.couleur ? <span class="service-pastille" style={styleTeinte(o.couleur)} aria-hidden="true"></span> : <Icon name={o.icon} size={18} class="text-accent" />}{o.title}</a></li>)}</ul>
            </div>
          )}
          {site.zones.cities.length > 0 && <p class="mt-6 text-sm text-muted">Intervention à {site.zones.cities.slice(0, 6).join(', ')}{site.zones.cities.length > 6 && ' et alentours'}.</p>}
        </aside>
      </div>
    </article>
    {creneaux && <div class="container-ff section-y"><CreneauxDuCours service={service.slug} titre={blocCreneaux} /></div>}
    {sorties.length > 0 && <div class="container-ff"><SortiesFiltrables sorties={sorties} titre={`${service.title}\u00a0: les sorties`} /></div>}{service.programme.length > 0 && <section class="container-ff section-y" aria-labelledby="programme-titre"><h2 id="programme-titre" class="text-display-md">{service.title}\u00a0: le programme de la semaine</h2><ArdoiseDuJour mode="semaine" services={[service]} niveau="h3" class="mt-8" /></section>}
    <Cta />
  </main>
  )}
  <Footer />
</Base>

<style>
  /* En-tête coloré de la page d'activité (data-theme="service") : un bandeau de la couleur du client au-dessus de
     l'article, et le prix dans cette couleur avec l'encre qui se lit dessus. */
  .service-fiche[data-theme='service'] { border-block-start: 0.75rem solid var(--teinte); }
  .service-fiche[data-theme='service'] :global(.service-prix) { background: var(--teinte); color: var(--teinte-encre); border-color: transparent; }
  .service-pastille { display: inline-block; inline-size: 18px; block-size: 18px; border-radius: var(--radius, 6px); background: var(--teinte); }
</style>
