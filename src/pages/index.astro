---
/**
 * Page d'accueil : la coquille (layout.shell) decide de la disposition globale, les sections viennent
 * du layout. Tout vient de site.config.ts (+ look.json / FF_LOOK).
 */
import Base from '@/layouts/Base.astro';
import { site } from '@/lib/site';
import { getSection, resolveSection } from '@/lib/sections';
import { faqPageLd } from '@/lib/jsonld';
import { Shell as ShellDuSite } from 'virtual:ff-look';

// La coquille du site est importee seule par scripts/vite-ff-look.mjs (le CSS des 24 autres ne part plus dans la
// page). Aucun import.meta.glob ici : meme non execute, il mettrait toutes les coquilles dans le graphe.
const Shell = ShellDuSite;

const Nav = resolveSection('nav', site.layout.nav);
const Hero = resolveSection('hero', site.layout.hero);
const Footer = resolveSection('footer', site.layout.footer);
const sections = site.layout.sections.map((s) => ({ ...s, Component: getSection(s.type, s.variant) }));

// FAQPage JSON-LD : seulement si une section faq est affichee sur la page (jamais de schema
// pour du contenu invisible). Aide les moteurs de reponse IA a citer les vraies Q/R du site.
const faqLd = site.layout.sections.some((s) => s.type === 'faq') ? faqPageLd(site.faq) : undefined;
---

<Base path="/" jsonLd={faqLd ? [faqLd] : []}>
  <Shell Nav={Nav} Hero={Hero} Footer={Footer} sections={sections} />
</Base>
