---
/**
 * Page d'une adresse (site.lieux, src/lib/lieux.ts) : architecture `pages-adresses` (Ten Belles,
 * docs/veille/architectures/pages-adresses.md, page « Paris 10 »). Une fiche pratique qui répond en un écran : la photo
 * du lieu, son nom en h1, le métier à la ville, la phrase du lieu et l'année d'ouverture, puis à côté l'état du jour et
 * les horaires de CE lieu, son adresse, son téléphone en `tel:` (repli : le numéro principal), l'itinéraire, ses
 * règles (« sans réservation »). Ensuite les photos du lieu, ce qu'on y trouve (les savoir-faire, communs à toutes les
 * adresses, une page chacun), les autres adresses. JSON-LD : un LocalBusiness par lieu (lieuLd), en plus de la maison.
 * Générée seulement pour les lieux du client : aucun = aucune page.
 * Signes de la source NON repris : noms en capitales seules, téléphone sans lien, aucun avis (la note Google suit).
 */
import Base from '@/layouts/Base.astro';
import { site, telDuLieu, adresseDuLieu, autresLieux, metierEtVille, hasContactDoor } from '@/lib/site';
import { lieuLd } from '@/lib/jsonld';
import { resolveSection } from '@/lib/sections';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import Horaires from '@/components/Horaires.astro';

export function getStaticPaths() {
  return site.lieux.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props;
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const t = telDuLieu(l, site.contact);
const autres = autresLieux(site.lieux, l.slug);
const google = site.proof.google;
const pageUrl = new URL(`/adresses/${l.slug}`, Astro.site).toString();
// Données de test (mêmes repères que Base.astro) : jamais envoyées à Google.
const telTest = /^(\+33|0)6(0{8})$/.test((l.phone ?? site.contact.phone).replace(/\s/g, ''));
const adresseTest = String(l.address.postalCode).trim() === '75000';
const ld = lieuLd(site, l, pageUrl, l.photo ? new URL(l.photo.src, Astro.site).toString() : undefined, { tel: telTest, adresse: adresseTest });
const description = l.texte ?? `${site.business.name}, ${l.nom} : ${adresseDuLieu(l)}. Horaires, téléphone et itinéraire.`;
---

<Base title={`${l.nom} | ${site.business.name}`} description={description} path={`/adresses/${l.slug}`} jsonLd={[ld]}>
  <Nav />
  <main id="main" class="lp">
    <article>
      <div class="container-ff lp-retour">
        <a href={site.lieux.length > 2 ? '/adresses' : '/'} class="inline-flex items-center gap-2 text-sm hover:underline"><Icon name="ArrowLeft" size={16} />{site.lieux.length > 2 ? site.wording.lieux : 'Accueil'}</a>
      </div>
      <div class:list={['container-ff lp-grille', l.photo && 'lp-avec-photo']}>
        {l.photo && (
          <div class="lp-photo">
            <Img src={l.photo.src} alt={l.photo.alt} priority class="h-full w-full object-cover" sizes="(min-width: 1024px) 45vw, 100vw" />
          </div>
        )}
        <div class="lp-texte">
          <h1 class="text-display-lg">{l.nom}</h1>
          <p class="mt-3 text-lg text-muted">{site.business.name}, {metierEtVille().replace(/\.$/, '')}{site.lieux.length > 1 ? `, l’une de nos ${site.lieux.length} adresses.` : '.'}</p>
          {l.texte && <p class="lp-phrase mt-6">{l.texte}</p>}
          {l.since && <p class="mt-3 text-muted">Ouvert en {l.since}.</p>}
          <dl class="lp-pratique">
            <div>
              <dt class="lp-rubrique">Adresse</dt>
              <dd>{adresseDuLieu(l)}</dd>
              {l.mapsUrl && <dd><a href={l.mapsUrl} target="_blank" rel="noopener" class="lp-lien"><Icon name="MapPin" size={16} />Itinéraire<span class="sr-only"> (nouvel onglet)</span></a></dd>}
            </div>
            <div>
              <dt class="lp-rubrique">Téléphone</dt>
              <dd><a href={t.href} class="lp-tel tabular-nums">{t.affiche}</a></dd>
            </div>
            {l.hours.length > 0 && (
              <div class="lp-heures">
                <dt class="lp-rubrique">Horaires</dt>
                <dd><Horaires hours={l.hours} /></dd>
              </div>
            )}
            {l.regles.length > 0 && (
              <div>
                <dt class="lp-rubrique">Bon à savoir</dt>
                <dd><ul class="lp-regles">{l.regles.map((r) => <li>{r}</li>)}</ul></dd>
              </div>
            )}
          </dl>
          <div class="mt-8 flex flex-wrap gap-4">
            <Button href={t.href} size="lg"><Icon name="Phone" size={18} />Appeler {l.nom}</Button>
            {hasContactDoor(site) && <Button href="/adresses#ecrire" variant="ghost" size="lg">Écrire</Button>}
          </div>
          {google && <p class="mt-6 text-sm"><a href={google.url} target="_blank" rel="noopener" class="lp-lien">{google.rating.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} sur 5 sur Google, {google.count} avis<span class="sr-only"> (nouvel onglet)</span></a></p>}
        </div>
      </div>

      {l.photos.length > 0 && (
        <ul class="container-ff lp-photos" aria-label={`${l.nom} en photos`}>
          {l.photos.map((p) => (
            <li><figure><Img src={p.src} alt={p.alt} loading="lazy" class="h-full w-full object-cover" sizes="(min-width: 1024px) 30vw, 50vw" />{p.caption && <figcaption class="mt-2 text-sm text-muted">{p.caption}</figcaption>}</figure></li>
          ))}
        </ul>
      )}

      {site.servicePages && site.services.length > 0 && (
        <section class="container-ff lp-bloc" aria-labelledby="lp-trouve">
          <h2 id="lp-trouve" class="text-display-sm">Ce qu’on y trouve</h2>
          <ul class="lp-filets">
            {site.services.map((s) => (
              <li><a href={`/services/${s.slug}`} class="lp-filet"><span class="font-display text-xl">{s.title}</span><span class="text-muted">{s.short}</span></a></li>
            ))}
          </ul>
        </section>
      )}

      {autres.length > 0 && (
        <section class="lp-autres bg-bg-2" aria-labelledby="lp-autres-titre">
          <div class="container-ff">
            <h2 id="lp-autres-titre" class="text-display-sm">{autres.length === 1 ? 'Notre autre adresse' : 'Nos autres adresses'}</h2>
            <ul class="lp-filets">
              {autres.map((a) => {
                const ta = telDuLieu(a, site.contact);
                return (
                  <li class="lp-autre">
                    <a href={`/adresses/${a.slug}`} class="font-display text-2xl lp-lien">{a.nom}<Icon name="ArrowRight" size={18} /></a>
                    <span>{adresseDuLieu(a)}</span>
                    <a href={ta.href} class="tabular-nums lp-lien">{ta.affiche}</a>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      )}
    </article>
  </main>
  <Footer />
</Base>

<style>
  .lp-retour { padding-block: clamp(5.5rem, 12vh, 8rem) 0; }
  .lp-grille { display: grid; gap: clamp(2rem, 5vw, 4rem); padding-block: 2rem clamp(3rem, 8vh, 5rem); }
  .lp-photo { aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius-card); max-block-size: 80svh; }
  .lp-photo > :global(picture) { display: block; block-size: 100%; }
  .lp-phrase { font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.45; max-inline-size: 40ch; }
  .lp-pratique { display: grid; gap: 1.5rem; margin-block-start: 2.5rem; padding-block-start: 1.5rem; border-block-start: 1px solid var(--color-line); }
  .lp-rubrique { font-weight: 600; margin-block-end: 0.35rem; }
  .lp-tel { font-size: clamp(1.4rem, 2.6vw, 2rem); font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .lp-lien { display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .lp-lien:hover, .lp-tel:hover { color: var(--color-accent); }
  .lp-regles { display: grid; gap: 0.25rem; list-style: disc; padding-inline-start: 1.25rem; }
  .lp-photos { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); padding-block-end: clamp(3rem, 8vh, 5rem); }
  .lp-photos figure { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-card); }
  .lp-photos figure > :global(picture) { display: block; block-size: 100%; }
  .lp-bloc { padding-block: clamp(2rem, 6vh, 4rem); }
  .lp-filets { margin-block-start: 1.5rem; border-block-start: 1px solid var(--color-line); }
  .lp-filets > li { border-block-end: 1px solid var(--color-line); }
  .lp-filet { display: grid; gap: 0.25rem; padding-block: 1rem; }
  .lp-filet:hover .font-display { color: var(--color-accent); }
  .lp-autres { padding-block: clamp(3rem, 8vh, 5rem); }
  .lp-autre { display: grid; gap: 0.35rem; padding-block: 1.1rem; }
  @media (min-width: 48rem) {
    .lp-pratique { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lp-heures { grid-row: span 2; }
    .lp-photos { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lp-autre { grid-template-columns: minmax(0, 2fr) minmax(0, 2fr) minmax(0, 1fr); align-items: center; }
  }
  @media (min-width: 64rem) {
    .lp-avec-photo { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; }
    .lp-photo { position: sticky; top: 6rem; }
  }
</style>
