---
/**
 * Page /adresses : toutes les adresses du client (site.lieux) et le formulaire. Architecture `pages-adresses` (Ten
 * Belles, docs/veille/architectures/pages-adresses.md, page « Contact » : les adresses en liste, l'e-mail, un formulaire
 * court). Chaque lieu : nom vers sa page, adresse, état du jour et journée (HorairesDuJour), téléphone du lieu en
 * `tel:`. Puis « Écrire » (id="ecrire") : e-mail, numéro principal, formulaire partagé. La nav y mène dès trois
 * adresses ; les pages de lieu y renvoient pour écrire. Générée dès qu'un lieu est déclaré ; aucun = aucune page.
 */
import Base from '@/layouts/Base.astro';
import { site, tel, mailto, telDuLieu, adresseDuLieu, metierEtVille } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import HorairesDuJour from '@/components/HorairesDuJour.astro';
import ContactForm from '@/components/ContactForm.astro';

export function getStaticPaths() {
  return site.lieux.length > 0 ? [{ params: { index: undefined } }] : [];
}
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const lieux = site.lieux;
const titre = site.wording.lieux;
---

<Base title={`${titre} | ${site.business.name}`} description={`${titre} de ${site.business.name} : ${lieux.map((l) => l.nom).join(', ')}. Horaires, téléphones et itinéraires.`} path="/adresses">
  <Nav />
  <main id="main">
    <div class="container-ff section-y">
      <a href="/" class="inline-flex items-center gap-2 text-sm hover:underline"><Icon name="ArrowLeft" size={16} />Accueil</a>
      <h1 class="text-display-lg mt-6">{titre}</h1>
      <p class="mt-4 max-w-prose text-lg">{metierEtVille()} {lieux.length === 1 ? 'Une adresse' : `${lieux.length} adresses`}, chacune avec ses horaires et son numéro.</p>
      <ul class="al-liste">
        {lieux.map((l, i) => {
          const t = telDuLieu(l, site.contact);
          return (
            <li class="al-lieu">
              {l.photo && <a href={`/adresses/${l.slug}`} class="al-photo" tabindex="-1" aria-hidden="true"><Img src={l.photo.src} alt="" loading={i < 2 ? 'eager' : 'lazy'} class="h-full w-full object-cover" sizes="(min-width: 1024px) 30vw, 100vw" /></a>}
              <h2 class="text-display-sm"><a href={`/adresses/${l.slug}`} class="al-lien">{l.nom}</a></h2>
              <p>{adresseDuLieu(l)}</p>
              {l.hours.length > 0 && <HorairesDuJour hours={l.hours} class="text-sm" />}
              <p><a href={t.href} class="al-lien al-tel tabular-nums"><Icon name="Phone" size={16} />{t.affiche}</a></p>
            </li>
          );
        })}
      </ul>
      <section id="ecrire" class="al-ecrire" aria-labelledby="al-ecrire-titre">
        <div>
          <h2 id="al-ecrire-titre" class="text-display-md">Écrire</h2>
          <p class="mt-4 max-w-prose">{site.wording.contactText}</p>
          <ul class="mt-6 space-y-2">
            <li><a href={tel()} class="al-lien tabular-nums"><Icon name="Phone" size={16} />{site.contact.phoneDisplay}</a></li>
            {site.contact.email && <li><a href={mailto()} class="al-lien break-all"><Icon name="Mail" size={16} />{site.contact.email}</a></li>}
          </ul>
        </div>
        <ContactForm idPrefix="adresses" />
      </section>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .al-liste { display: grid; gap: 2.5rem 2rem; margin-block-start: clamp(2.5rem, 6vh, 4rem); }
  .al-lieu { display: grid; gap: 0.6rem; align-content: start; padding-block-start: 1.25rem; border-block-start: 1px solid var(--color-line); }
  .al-photo { display: block; aspect-ratio: 3 / 2; overflow: hidden; border-radius: var(--radius-card); margin-block-end: 0.5rem; }
  .al-photo > :global(picture) { display: block; block-size: 100%; }
  .al-lien { display: inline-flex; align-items: center; gap: 0.45rem; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .al-lien:hover { color: var(--color-accent); }
  .al-tel { font-weight: 600; min-block-size: 44px; }
  .al-ecrire { display: grid; gap: 2.5rem; margin-block-start: clamp(4rem, 10vh, 7rem); padding-block-start: 2.5rem; border-block-start: 1px solid var(--color-line); }
  @media (min-width: 48rem) { .al-liste { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .al-liste { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .al-ecrire { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }
</style>
