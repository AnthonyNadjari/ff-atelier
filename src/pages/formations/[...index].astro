---
/**
 * Page /formations (site.formations, src/lib/sessions.ts) : architecture `sessions-places` (la vitrine des formations d'une
 * agence MAP, chacune à prix ; docs/veille/architectures/sessions-places.md). Toutes les formations par catégorie, chacune
 * avec son prix, sa durée, ce qu'il faut avant et sa prochaine session ; le centre d'examen ; les questions. Générée seulement
 * dès 3 formations (lienFormations).
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site, tel, metierEtVille, formationsParCategorie, sessionsDe, dateDeSession, placesEnMots, lienFormations } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import { faqPageLd } from '@/lib/jsonld';

export function getStaticPaths() {
  return lienFormations(site.formations?.liste, site.wording.formations) ? [{ params: { index: undefined } }] : [];
}
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const fo = site.formations!;
const groupes = formationsParCategorie(fo.liste);
const titre = site.wording.formations;
const ancre = (t: string) => `fl-${t}`.toLowerCase().normalize('NFD').replace(/[^a-z0-9-]/g, '-');
---

<Base title={`${titre} | ${site.business.name}`} description={`${site.business.trade} : les formations, leurs prix et les prochaines sessions.`} path="/formations" jsonLd={site.faq.length > 0 ? [faqPageLd(site.faq)!] : []}>
  <Nav />
  <main id="main" class="container-ff fl">
    <header class="fl-tete">
      <h1 class="fl-titre font-display">{titre}</h1>
      <p>{metierEtVille()}.</p>
      {fo.intro && <p class="fl-muted">{fo.intro}</p>}
    </header>
    {groupes.map((g) => (
      <section class="fl-groupe" aria-labelledby={ancre(g.categorie)}>
        <h2 id={ancre(g.categorie)} class="fl-h2 font-display">{g.categorie}</h2>
        <ul class="fl-liste">
          {g.formations.map((f) => {
            const s = sessionsDe(f)[0];
            return (
              <li class="fl-ligne">
                <a href={`/formations/${f.slug}`} class="fl-nom">{f.nom}</a>
                <p class="fl-muted">{[f.duree, f.prerequis.join(', ')].filter(Boolean).join('. ')}</p>
                <p class="fl-prix tabular-nums">{f.prix ?? 'Prix sur demande'}</p>
                <p class="fl-quand">{s ? `Prochaine session : ${dateDeSession(s).court}${placesEnMots(s.places) ? `, ${placesEnMots(s.places).toLowerCase()}` : ''}` : 'Toute l’année'}</p>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
    {fo.examen && <p class="fl-muted">Centre d’examen&nbsp;: {fo.examen}</p>}
    <p class="fl-appel">Une question sur votre formation&nbsp;? <a href={tel()} class="fl-lien tabular-nums"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a></p>
    {site.faq.length > 0 && (
      <section id="faq" aria-labelledby="fl-faq" class="fl-faq">
        <h2 id="fl-faq" class="fl-h2 font-display">{site.wording.faqTitle ?? 'Vos questions'}</h2>
        {site.faq.map((q) => <details><summary>{q.q}</summary><p>{q.a}</p></details>)}
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .fl { display: grid; gap: clamp(1.75rem, 5vh, 3rem); padding-block: clamp(1.5rem, 5vh, 4rem); max-inline-size: 64rem; }
  .fl-tete { display: grid; gap: 0.5rem; }
  .fl-titre { font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1; letter-spacing: -0.015em; }
  .fl-muted { color: var(--color-muted); }
  .fl-groupe { display: grid; gap: 0.5rem; }
  .fl-h2 { font-size: clamp(1.4rem, 3.2vw, 2rem); line-height: 1.05; }
  .fl-liste { display: grid; }
  .fl-ligne { display: grid; gap: 0.15rem; padding-block: 0.8rem; border-block-start: 1px solid var(--color-line); }
  .fl-nom { display: inline-flex; align-items: center; min-block-size: 44px; font-size: clamp(1.15rem, 2.2vw, 1.4rem); font-weight: 700; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .fl-prix, .fl-quand { font-weight: 700; }
  .fl-lien { display: inline-flex; align-items: center; gap: 0.35rem; min-block-size: 44px; font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .fl-nom:focus-visible, .fl-lien:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .fl-appel { font-weight: 600; }
  .fl-faq { display: grid; gap: 0.25rem; }
  .fl-faq details { border-block-end: 1px solid var(--color-line); }
  .fl-faq summary { display: flex; align-items: center; min-block-size: 48px; font-weight: 600; cursor: pointer; }
  .fl-faq summary:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .fl-faq p { padding-block-end: 0.85rem; color: var(--color-muted); }
  @media (min-width: 48rem) {
    .fl-ligne { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1.6fr) minmax(0, 0.8fr) minmax(0, 1.2fr); column-gap: 1.25rem; align-items: center; }
  }
</style>
