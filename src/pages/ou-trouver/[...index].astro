---
/**
 * Page /ou-trouver (site.revendeurs, src/lib/revendeurs.ts) : architecture `revendeurs-secteurs` (« Points de vente » de
 * la Brasserie des Garrigues, « Où rapporter les bouteilles ? » de Bendorf ; docs/veille/architectures/revendeurs-secteurs.md).
 * Tous les secteurs l'un sous l'autre, chacun avec ses communes de A à Z et ses revendeurs, puis la vente sur place.
 * Lisible sans script. Générée seulement avec 6 revendeurs lisibles (lienRevendeurs).
 */
import Base from '@/layouts/Base.astro';
import { site, tel, fullAddress, metierEtVille, secteursDe, phraseSecteur, revendeursComplets, lienRevendeurs } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import Icon from '@/components/Icon.astro';

export function getStaticPaths() {
  return lienRevendeurs(site.revendeurs, site.wording.revendeurs) ? [{ params: { index: undefined } }] : [];
}
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const x = site.revendeurs!;
const secteurs = secteursDe(x);
const titre = site.wording.revendeurs;
const n = revendeursComplets(x).length;
---

<Base title={`${titre} | ${site.business.name}`} description={`${titre} de ${site.business.name}, ${site.business.trade.toLowerCase()} à ${site.contact.address.city} : ${n} adresses, ${secteurs.map((s) => s.nom).join(', ')}.`} path="/ou-trouver">
  <Nav />
  <main id="main" class="container-ff pot">
    <header class="pot-tete">
      <h1 class="pot-titre font-display">{titre}</h1>
      <p>{metierEtVille()}</p>
      <p><a href={tel()} class="pot-tel tabular-nums"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a></p>
      {secteurs.length >= 2 && (
        <nav aria-label="Les secteurs" class="pot-sommaire">
          <ul>{secteurs.map((s) => <li><a href={`/ou-trouver/${s.slug}`} class="pot-lien">{s.nom}</a> <span class="pot-muted tabular-nums">({phraseSecteur(s)})</span></li>)}</ul>
        </nav>
      )}
    </header>
    {secteurs.map((s) => (
      <section aria-labelledby={`pot-${s.slug}`} class="pot-secteur">
        <h2 id={`pot-${s.slug}`} class="pot-h2 font-display">{s.nom}</h2>
        <div class="pot-communes">
          {s.communes.map((c) => (
            <div class="pot-commune">
              <h3 class="pot-h3">{c.nom}</h3>
              <ul>{c.revendeurs.map((r) => <li><span class="pot-nom">{r.nom}</span>{r.type && <span class="pot-muted">, {r.type}</span>}{r.adresse && <span class="pot-muted">, {r.adresse}</span>}{r.pression && <span class="pot-muted">, à la pression</span>}{r.consigne && <span class="pot-muted">, reprend la consigne</span>}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>
    ))}
    <section aria-labelledby="pot-place" class="pot-place">
      <h2 id="pot-place" class="pot-h2 font-display">Chez {site.business.name}</h2>
      {x.surPlace && <p class="pot-fort">{x.surPlace}</p>}
      <p>{fullAddress()}</p>
      {x.consigne && <p>{x.consigne}</p>}
    </section>
  </main>
  <Footer />
</Base>

<style>
  .pot { display: grid; gap: 2.25rem; padding-block: clamp(1.5rem, 5vh, 4rem); }
  .pot-tete { display: grid; gap: 0.6rem; }
  .pot-titre { font-size: clamp(2rem, 5.5vw, 3.6rem); line-height: 1.02; letter-spacing: -0.01em; }
  .pot-tel { display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: 48px; padding-inline: 1rem; border: 2px solid var(--color-fg); border-radius: var(--radius-ui, 6px); font-weight: 700; }
  .pot-lien { display: inline-flex; align-items: center; min-block-size: 44px; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; font-weight: 600; }
  .pot-tel:focus-visible, .pot-lien:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .pot-muted { color: var(--color-muted); }
  .pot-fort, .pot-nom { font-weight: 600; }
  .pot-secteur, .pot-place { display: grid; gap: 1rem; }
  .pot-h2 { font-size: clamp(1.5rem, 3.4vw, 2.3rem); line-height: 1.06; }
  .pot-communes { display: grid; gap: 1.25rem 2rem; }
  .pot-commune { display: grid; gap: 0.35rem; padding-block-start: 0.6rem; border-block-start: 2px solid var(--color-fg); }
  .pot-h3 { font-weight: 700; font-size: 1.1rem; }
  .pot-commune ul { display: grid; gap: 0.3rem; }
  @media (min-width: 48rem) { .pot-communes { grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); } }
</style>
