---
/**
 * Page /producteurs (site.producteurs, src/lib/producteurs.ts) : architecture `mur-producteurs` (« Les producteurs » du
 * Comboire Paysan, « Nos producteurs » de Dose Épicerie ; docs/veille/architectures/mur-producteurs.md). Tous les
 * producteurs du plus proche au plus loin, la distance en barre à sa vraie valeur (rapportée au plus loin), ceux sans
 * distance ensuite ; les questions. Générée seulement dès 4 producteurs (lienProducteurs).
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site, tel, metierEtVille, producteursParDistance, distanceDuProducteur, producteurLePlusLoin, lienProducteurs } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import { faqPageLd } from '@/lib/jsonld';

export function getStaticPaths() {
  return lienProducteurs(site.producteurs?.liste, site.wording.producteurs) ? [{ params: { index: undefined } }] : [];
}
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const p = site.producteurs!;
const liste = producteursParDistance(p.liste);
const loin = producteurLePlusLoin(liste);
const titre = site.wording.producteurs;
const part = (km: number | undefined) => (km && loin ? Math.max(3, Math.round((km / loin) * 100)) : 0);
---

<Base title={`${titre} | ${site.business.name}`} description={`${site.business.trade} : ${liste.length} producteurs, du plus proche au plus loin.`} path="/producteurs" jsonLd={site.faq.length > 0 ? [faqPageLd(site.faq)!] : []}>
  <Nav />
  <main id="main" class="container-ff pl">
    <header class="pl-tete">
      <h1 class="pl-titre font-display">{titre}</h1>
      <p>{metierEtVille()}</p>
      {p.intro && <p class="pl-muted">{p.intro}</p>}
    </header>
    <ol class="pl-liste">
      {liste.map((x) => (
        <li class="pl-ligne">
          <a href={`/producteurs/${x.slug}`} class="pl-nom font-display">{x.nom}</a>
          <p class="pl-ou">{x.commune}{x.rayon ? `, ${x.rayon.toLowerCase()}` : ''}</p>
          {x.km ? (
            <p class="pl-km tabular-nums"><span class="pl-barre" aria-hidden="true"><span style={`inline-size: ${part(x.km)}%`}></span></span>{distanceDuProducteur(x.km)}</p>
          ) : <p class="pl-km pl-muted">distance non donnée</p>}
        </li>
      ))}
    </ol>
    <p class="pl-appel"><a href={tel()} class="pl-lien tabular-nums"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a></p>
    {site.faq.length > 0 && (
      <section id="faq" aria-labelledby="pl-faq" class="pl-faq">
        <h2 id="pl-faq" class="pl-h2 font-display">{site.wording.faqTitle ?? 'Vos questions'}</h2>
        {site.faq.map((q) => <details><summary>{q.q}</summary><p>{q.a}</p></details>)}
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .pl { display: grid; gap: clamp(1.75rem, 5vh, 3rem); padding-block: clamp(1.5rem, 5vh, 4rem); max-inline-size: 64rem; }
  .pl-tete { display: grid; gap: 0.5rem; }
  .pl-titre { font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1; letter-spacing: -0.015em; }
  .pl-muted { color: var(--color-muted); }
  .pl-liste { display: grid; }
  .pl-ligne { display: grid; gap: 0.2rem; padding-block: 0.9rem; border-block-start: 1px solid var(--color-line); }
  .pl-nom { display: inline-flex; align-items: center; min-block-size: 44px; font-size: clamp(1.25rem, 2.6vw, 1.6rem); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .pl-ou { color: var(--color-muted); }
  .pl-km { display: flex; align-items: center; gap: 0.75rem; font-weight: 600; }
  .pl-barre { flex: 1 1 auto; max-inline-size: 16rem; block-size: 0.5rem; background: var(--color-line); border-radius: var(--radius-ui, 4px); overflow: hidden; }
  .pl-barre > span { display: block; block-size: 100%; background: var(--color-accent); }
  .pl-lien { display: inline-flex; align-items: center; gap: 0.35rem; min-block-size: 44px; font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .pl-nom:focus-visible, .pl-lien:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .pl-h2 { font-size: clamp(1.4rem, 3.2vw, 2rem); line-height: 1.05; }
  .pl-faq { display: grid; gap: 0.25rem; }
  .pl-faq details { border-block-end: 1px solid var(--color-line); }
  .pl-faq summary { display: flex; align-items: center; min-block-size: 48px; font-weight: 600; cursor: pointer; }
  .pl-faq summary:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .pl-faq p { padding-block-end: 0.85rem; color: var(--color-muted); }
  @media (min-width: 48rem) {
    .pl-ligne { grid-template-columns: minmax(0, 2fr) minmax(0, 1.4fr) minmax(0, 1.6fr); column-gap: 1.5rem; align-items: center; }
  }
</style>
