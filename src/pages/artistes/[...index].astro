---
/**
 * Page /artistes (site.artistes, src/lib/artistes.ts) : architecture `artistes-residents` (source Mystery Tattoo Club,
 * « Artistes résidents », docs/veille/architectures/artistes-residents.md). Le titre, le métier à la ville, le
 * téléphone ; puis le mur des artistes (MurArtistes : filtre par style sans script, un portrait par artiste vers sa
 * page, les invités après les résidents) ; puis les styles un par un, chacun avec les artistes qui le pratiquent
 * (la question « qui fait du japonais ? » de la source, sans fenêtre surgissante). Générée seulement s'il y a un
 * artiste ; aucun = aucune page.
 */
import Base from '@/layouts/Base.astro';
import { site, tel, metierEtVille, stylesDe, artistesDuStyle } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import Icon from '@/components/Icon.astro';
import MurArtistes from '@/components/MurArtistes.astro';

export function getStaticPaths() {
  return site.artistes.length > 0 ? [{ params: { index: undefined } }] : [];
}
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const titre = site.wording.artistes;
const styles = stylesDe(site.artistes);
---

<Base title={`${titre} | ${site.business.name}`} description={`${titre} de ${site.business.name}, ${site.business.trade.toLowerCase()} à ${site.contact.address.city} : chacun, ses styles, son travail et comment le joindre.`} path="/artistes">
  <Nav />
  <main id="main" class="al">
    <header class="container-ff al-tete">
      <h1 class="text-display-lg">{titre}</h1>
      <p class="mt-4 max-w-prose text-lg">{metierEtVille()}</p>
      <p class="mt-4"><a href={tel()} class="inline-flex items-center gap-2 tabular-nums underline underline-offset-4"><Icon name="Phone" size={16} />{site.contact.phoneDisplay}</a></p>
    </header>
    <section class="container-ff al-mur" aria-label={titre}>
      <MurArtistes id="page" niveau="h2" />
    </section>
    {styles.length >= 2 && (
      <section class="container-ff al-styles" aria-labelledby="al-styles-titre">
        <h2 id="al-styles-titre" class="text-display-md">Style par style</h2>
        <dl class="al-liste">
          {styles.map((s) => (
            <div class="al-style">
              <dt class="font-display">{s.nom}</dt>
              <dd>{artistesDuStyle(site.artistes, s.slug).map((a, i, xs) => <><a href={`/artistes/${a.slug}`} class="al-lien">{a.nom}</a>{i < xs.length - 1 ? ', ' : ''}</>)}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .al-tete { padding-block: clamp(2.5rem, 8vh, 5rem) clamp(1.5rem, 4vh, 2.5rem); }
  .al-mur { padding-block: 0 clamp(3rem, 8vh, 5rem); }
  .al-styles { display: grid; gap: 1.5rem; padding-block: 0 clamp(3rem, 8vh, 5rem); }
  .al-liste { display: grid; gap: 0 2.5rem; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); }
  .al-style { display: grid; gap: 0.2rem; padding-block: 0.9rem; border-block-start: 1px solid var(--color-line); }
  .al-style dt { font-size: 1.35rem; }
  .al-lien { display: inline-flex; min-block-size: 32px; align-items: center; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .al-lien:hover { color: var(--color-accent); }
  .al-lien:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
</style>
