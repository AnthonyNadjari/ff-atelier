---
/**
 * Page d'une réalisation (site.realisations, src/lib/schema.ts) : architecture `index-projets` (House of Honey,
 * docs/veille/architectures/projets-fiches.md). Retour à l'index, lieu, type, mesure, année, nom du chantier (h1),
 * quelques lignes du client, crédit du photographe s'il est donné, puis la série de photos ; chaque photo a son ancre
 * (#photo-1…), adressable sans bibliothèque. Puis les portes (téléphone, écrire) et la réalisation suivante.
 * Générée seulement pour les réalisations du client : aucune réalisation = aucune page.
 */
import Base from '@/layouts/Base.astro';
import { site, tel, paragraphs, hasContactDoor, metaDeRealisation, SEPARATEUR_META } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';

export function getStaticPaths() {
  return site.realisations.map((r, i) => ({ params: { slug: r.slug }, props: { r, suivante: site.realisations[(i + 1) % site.realisations.length] } }));
}
const { r, suivante } = Astro.props;
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const meta = [...metaDeRealisation(r), r.year].filter(Boolean) as string[];
const description = `${r.title}${r.place ? `, ${r.place}` : ''} : une réalisation de ${site.business.name}, ${site.business.trade.toLowerCase()} à ${site.contact.address.city}.`;
---

<Base title={`${r.title} | ${site.business.name}`} description={description} path={`/realisations/${r.slug}`}>
  <Nav />
  <main id="main">
    <article class="section-y">
      <div class="container-ff max-w-4xl">
        <a href="/" class="inline-flex items-center gap-2 text-sm text-muted hover:text-fg"><Icon name="ArrowLeft" size={16} />Toutes les réalisations</a>
        {meta.length > 0 && (
          <p class="mt-8 text-sm text-muted">
            {meta.map((m, j) => <>{j > 0 && <span aria-hidden="true">{SEPARATEUR_META}</span>}<span>{m}</span></>)}
          </p>
        )}
        <h1 class="text-display-lg mt-3">{r.title}</h1>
        {r.text && <div class="mt-8 space-y-5 text-lg leading-relaxed max-w-prose">{paragraphs(r.text).map((p) => <p>{p}</p>)}</div>}
        {r.credit && <p class="mt-4 text-sm text-muted">Photos : {r.credit}</p>}
        <div class="mt-12 flex flex-col gap-6 md:gap-10">
          {r.photos.map((p, i) => (
            <figure id={`photo-${i + 1}`}>
              <Img src={p.src} alt={p.alt} priority={i === 0} loading={i === 0 ? 'eager' : 'lazy'} class="w-full rounded-card object-cover" sizes="(min-width: 1024px) 896px, 100vw" />
              {p.caption && <figcaption class="mt-2 text-sm text-muted">{p.caption}</figcaption>}
            </figure>
          ))}
        </div>
        <div class="mt-14 flex flex-wrap gap-4">
          <Button href={tel()} size="lg"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</Button>
          {hasContactDoor(site) && <Button href="/#contact" variant="ghost" size="lg">{site.wording.devis}</Button>}
        </div>
        {suivante && suivante.slug !== r.slug && (
          <p class="mt-16 border-t border-line pt-8">
            <a href={`/realisations/${suivante.slug}`} class="inline-flex items-center gap-2 text-lg underline-offset-4 hover:underline">{suivante.title}<Icon name="ArrowRight" size={18} /></a>
          </p>
        )}
      </div>
    </article>
  </main>
  <Footer />
</Base>
