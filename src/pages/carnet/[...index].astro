---
/**
 * Page /carnet (site.interventions, src/lib/journal.ts) : architecture `carnet-interventions` (le blog de Monsieur Boris, 25 récits
 * datés et situés ; docs/veille/architectures/carnet-interventions.md). Tout le carnet, du plus récent au plus ancien, rangé par
 * mois ; puis les lieux, chacun avec ses interventions. Lisible sans script. Générée seulement dès 3 interventions complètes
 * (lienCarnet).
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { site, tel, metierEtVille, interventionsCompletes, parMois, lieuxDuCarnet, slugLieu, dateDuCarnet, lienCarnet } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import { faqPageLd } from '@/lib/jsonld';

export function getStaticPaths() {
  return lienCarnet(site.interventions, site.wording.carnet) ? [{ params: { index: undefined } }] : [];
}
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const toutes = interventionsCompletes(site.interventions);
const mois = parMois(toutes);
const lieux = lieuxDuCarnet(toutes);
const titre = site.wording.carnet;
---

<Base title={`${titre} | ${site.business.name}`} description={`${site.business.trade} à ${site.contact.address.city} : ${toutes.length} interventions datées et situées, de la plus récente à la plus ancienne.`} path="/carnet" jsonLd={site.faq.length > 0 ? [faqPageLd(site.faq)!] : []}>
  <Nav />
  <main id="main" class="container-ff cn">
    <header class="cn-tete">
      <h1 class="cn-titre font-display">{titre}</h1>
      <p>{metierEtVille()} {toutes.length} interventions, de la plus récente à la plus ancienne.</p>
      <p><a href={tel()} class="cn-lien tabular-nums"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a></p>
    </header>
    {mois.map((m) => (
      <section class="cn-mois" aria-labelledby={`cn-${m.cle}`}>
        <h2 id={`cn-${m.cle}`} class="cn-mois-t font-display">{m.libelle}</h2>
        <ol class="cn-liste">
          {m.interventions.map((x) => (
            <li class="cn-li">
              <time datetime={x.date} class="cn-date tabular-nums">{dateDuCarnet(x.date)}</time>
              <a href={`/carnet/${x.slug}`} class="cn-lien cn-titre-li">{x.titre}</a>
              <span class="cn-muted">{x.lieu}{x.duree ? `, ${x.duree}` : ''}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
    {lieux.length > 1 && (
      <section aria-labelledby="cn-lieux" class="cn-mois">
        <h2 id="cn-lieux" class="cn-mois-t font-display">Par lieu</h2>
        <div class="cn-lieux">
          {lieux.map((l) => (
            <div id={`lieu-${l.slug}`} class="cn-lieu">
              <h3 class="cn-h3">{l.lieu}, {l.n} fois</h3>
              <ul>{toutes.filter((x) => slugLieu(x.lieu) === l.slug).map((x) => <li><a href={`/carnet/${x.slug}`} class="cn-lien">{x.titre}</a></li>)}</ul>
            </div>
          ))}
        </div>
      </section>
    )}
    {site.faq.length > 0 && (
      <section id="faq" aria-labelledby="cn-faq" class="cn-faq">
        <h2 id="cn-faq" class="cn-faq-t font-display">{site.wording.faqTitle ?? 'Vos questions'}</h2>
        {site.faq.map((q) => <details><summary>{q.q}</summary><p>{q.a}</p></details>)}
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .cn { display: grid; gap: clamp(2rem, 5vh, 3rem); padding-block: clamp(1.5rem, 5vh, 4rem); max-inline-size: 64rem; }
  .cn-tete { display: grid; gap: 0.5rem; }
  .cn-titre { font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1; letter-spacing: -0.015em; }
  .cn-mois { display: grid; gap: 0.75rem; }
  .cn-mois-t { font-size: clamp(1.5rem, 3.4vw, 2.2rem); line-height: 1.05; padding-block-end: 0.4rem; border-block-end: 2px solid var(--color-fg); }
  .cn-li { display: grid; gap: 0.1rem 1.5rem; padding-block: 0.75rem; border-block-end: 1px solid var(--color-line); }
  .cn-date { font-weight: 600; color: var(--color-muted); }
  .cn-lien { display: inline-flex; align-items: center; gap: 0.35rem; min-block-size: 44px; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .cn-lien:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .cn-titre-li { font-weight: 700; font-size: 1.12rem; }
  .cn-muted { color: var(--color-muted); }
  .cn-lieux { display: grid; gap: 1.5rem; }
  .cn-h3 { font-weight: 700; font-size: 1.15rem; }
  @media (min-width: 48rem) {
    .cn-li { grid-template-columns: 11rem minmax(0, 1fr) 14rem; align-items: baseline; }
    .cn-lieux { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; }
  }
  .cn-faq { display: grid; gap: 0.25rem; }
  .cn-faq-t { font-size: clamp(1.4rem, 3.2vw, 2rem); padding-block-end: 0.4rem; }
  .cn-faq details { border-block-end: 1px solid var(--color-line); }
  .cn-faq summary { display: flex; align-items: center; min-block-size: 48px; font-weight: 600; cursor: pointer; }
  .cn-faq summary:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .cn-faq p { padding-block-end: 0.85rem; color: var(--color-muted); }
</style>
