---
/**
 * Page d'une intervention (/carnet/<slug>, site.interventions, src/lib/journal.ts) : architecture `carnet-interventions` (un
 * récit de Monsieur Boris : la clé cassée dans le cylindre, le démontage, la reproduction à l'atelier, le remontage et les
 * essais ; docs/veille/architectures/carnet-interventions.md). Le jour et le lieu, l'appel, les temps numérotés, la durée et le
 * prix s'ils sont donnés, la photo, le service dont elle relève, l'appel ; puis la plus récente et la plus ancienne autour
 * d'elle (on se promène dans le temps) et les autres interventions au même lieu. Une page par intervention complète.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import { site, tel, interventionsCompletes, voisinesDuCarnet, slugLieu, dateDuCarnet, lienCarnet } from '@/lib/site';
import { resolveSection } from '@/lib/sections';

export function getStaticPaths() {
  return interventionsCompletes(site.interventions).map((x) => ({ params: { slug: x.slug }, props: { x } }));
}
const { x } = Astro.props;
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const { plusRecente, plusAncienne } = voisinesDuCarnet(site.interventions, x.slug);
const memeLieu = interventionsCompletes(site.interventions).filter((y) => y.slug !== x.slug && slugLieu(y.lieu) === slugLieu(x.lieu)).slice(0, 4);
const service = x.service ? site.services.find((s) => s.slug === x.service) : undefined;
const carnet = lienCarnet(site.interventions, site.wording.carnet);
const article = {
  '@type': 'Article',
  headline: x.titre,
  datePublished: x.date,
  contentLocation: { '@type': 'Place', name: x.lieu },
  author: { '@type': 'Organization', name: site.business.name },
};
---

<Base title={`${x.titre} | ${site.business.name}`} description={`${site.business.trade}, ${x.lieu}, le ${dateDuCarnet(x.date)} : ${x.titre}.`} path={`/carnet/${x.slug}`} jsonLd={[article]}>
  <Nav />
  <main id="main" class="container-ff ci">
    <p><a href={carnet ? '/carnet' : '/'} class="ci-lien"><Icon name="ArrowLeft" size={16} />{carnet ? site.wording.carnet : 'Accueil'}</a></p>
    <article class="ci-grille">
      <div class="ci-texte">
        <p class="ci-quand tabular-nums"><time datetime={x.date}>{dateDuCarnet(x.date)}</time>, {x.lieu}</p>
        <h1 class="ci-titre font-display">{x.titre}</h1>
        <p class="ci-muted">{site.business.trade} à {site.contact.address.city}</p>
        {x.situation && (<><h2 class="ci-h2">L’appel</h2><p>{x.situation}</p></>)}
        {x.etapes.length > 0 && (<><h2 class="ci-h2">Ce que nous avons fait</h2><ol class="ci-etapes">{x.etapes.map((e) => <li>{e}</li>)}</ol></>)}
        {(x.duree || x.prix) && (
          <dl class="ci-faits">
            {x.duree && <div><dt>Durée</dt><dd>{x.duree}</dd></div>}
            {x.prix && <div><dt>Prix</dt><dd class="tabular-nums">{x.prix}</dd></div>}
          </dl>
        )}
        <p class="ci-portes">
          <a href={tel()} class="ci-tel tabular-nums"><Icon name="Phone" size={19} />{site.contact.phoneDisplay}</a>
          {service && site.servicePages && <a href={`/services/${service.slug}`} class="ci-lien">{service.title}<Icon name="ArrowRight" size={16} /></a>}
        </p>
      </div>
      {x.photo && <Img src={x.photo.src} alt={x.photo.alt} class="ci-photo" sizes="(min-width: 1024px) 45vw, 100vw" priority />}
    </article>
    {(plusRecente || plusAncienne) && (
      <nav class="ci-temps" aria-label="Dans le carnet">
        {plusRecente ? <a href={`/carnet/${plusRecente.slug}`} class="ci-voisine"><span class="ci-muted">Plus récente, {dateDuCarnet(plusRecente.date)}</span><span class="ci-voisine-t">{plusRecente.titre}</span></a> : <span />}
        {plusAncienne && <a href={`/carnet/${plusAncienne.slug}`} class="ci-voisine ci-voisine-fin"><span class="ci-muted">Plus ancienne, {dateDuCarnet(plusAncienne.date)}</span><span class="ci-voisine-t">{plusAncienne.titre}</span></a>}
      </nav>
    )}
    {memeLieu.length > 0 && (
      <section aria-labelledby="ci-lieu">
        <h2 id="ci-lieu" class="ci-h2">Aussi à {x.lieu}</h2>
        <ul>{memeLieu.map((y) => <li><a href={`/carnet/${y.slug}`} class="ci-lien">{y.titre}</a> <span class="ci-muted">{dateDuCarnet(y.date)}</span></li>)}</ul>
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .ci { display: grid; gap: clamp(1.5rem, 4vh, 2.5rem); padding-block: clamp(1.25rem, 4vh, 3rem); }
  .ci-grille { display: grid; gap: 2rem; }
  .ci-texte { display: grid; gap: 0.75rem; align-content: start; max-inline-size: 62ch; }
  .ci-quand { font-weight: 700; }
  .ci-titre { font-size: clamp(2rem, 5.6vw, 3.6rem); line-height: 1.02; letter-spacing: -0.015em; text-wrap: balance; }
  .ci-h2 { font-weight: 700; font-size: 1.2rem; margin-block-start: 0.5rem; }
  .ci-etapes { display: grid; gap: 0.5rem; list-style: decimal; padding-inline-start: 1.4rem; }
  .ci-faits { display: flex; flex-wrap: wrap; gap: 0.5rem 2.5rem; }
  .ci-faits dt { color: var(--color-muted); font-weight: 600; }
  .ci-faits dd { font-weight: 700; font-size: 1.2rem; }
  .ci-portes { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; }
  .ci-tel { display: inline-flex; align-items: center; gap: 0.5rem; min-block-size: 52px; padding-inline: 1.1rem; border-radius: var(--radius-ui, 6px); background: var(--color-accent); color: var(--color-on-accent); font-weight: 700; font-size: 1.2rem; }
  .ci-lien { display: inline-flex; align-items: center; gap: 0.35rem; min-block-size: 44px; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .ci-tel:focus-visible, .ci-lien:focus-visible, .ci-voisine:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .ci-muted { color: var(--color-muted); }
  .ci-photo { inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-card); box-shadow: var(--shadow-card); }
  .ci-temps { display: grid; gap: 1rem; padding-block: 1.25rem; border-block: 1px solid var(--color-line); }
  .ci-voisine { display: grid; gap: 0.2rem; }
  .ci-voisine-t { font-weight: 700; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  @media (min-width: 48rem) {
    .ci-temps { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 3rem; }
    .ci-voisine-fin { text-align: end; }
  }
  @media (min-width: 64rem) {
    .ci-grille { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 3rem; align-items: start; }
  }
</style>
