---
/** Mentions legales : obligatoires en France (LCEN art. 6). Generees depuis site.config.ts. */
import Base from '@/layouts/Base.astro';
import { site, fullAddress } from '@/lib/site';
import { getSection, resolveSection } from '@/lib/sections';
const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);
const b = site.business;
const owner = site.legal.owner ?? b.name;
// Texte sur mesure d'un site (sites/<slug>/legal/MentionsLegales.astro), quand la page générée ne suffit pas
// (ex. finck-fisch : société pas encore immatriculée, formulaire d'audit propre). Rend le <main> entier.
const SurMesure = Object.entries(import.meta.glob<{ default: any }>('/sites/*/legal/MentionsLegales.astro', { eager: true }))
  .find(([k]) => k.startsWith(`/sites/${site.slug}/`))?.[1].default;
---

<Base title={`Mentions légales | ${b.name}`} path="/mentions-legales" noindex>
  <Nav />
  {SurMesure ? <SurMesure /> : (
  <main id="main" class="section-y">
    <div class="container-ff max-w-3xl space-y-10 text-[0.95rem] leading-relaxed">
      <h1 class="text-display-md">Mentions légales</h1>
      <section>
        <h2 class="text-display-sm mb-3">Éditeur du site</h2>
        <p>{b.name}{b.legalForm && `, ${b.legalForm}`}<br />{fullAddress()}<br />Téléphone : {site.contact.phoneDisplay}{site.contact.email && <><br />E-mail : {site.contact.email}</>}</p>
        {b.siret && <p>SIRET : {b.siret}</p>}
        {b.tva && <p>TVA intracommunautaire : {b.tva}</p>}
        <p>Responsable de la publication : {owner}</p>
        {site.legal.demo && <p>Site de démonstration (voir le pied de page).</p>}
        {b.insurance && <p>Assurance professionnelle : {b.insurance}</p>}
      </section>
      <section>
        <h2 class="text-display-sm mb-3">Hébergement</h2>
        <p>{site.legal.host}</p>
      </section>
      <section>
        <h2 class="text-display-sm mb-3">Données personnelles</h2>
        <p>Les informations transmises via le formulaire de contact (nom, téléphone, e-mail, message) sont utilisées uniquement pour répondre à votre demande. Elles ne sont ni cédées ni revendues et sont conservées le temps nécessaire au traitement de la demande. Conformément au RGPD, vous pouvez demander l’accès, la rectification ou la suppression de vos données {site.contact.email ? `en écrivant à ${site.contact.email}` : `par téléphone au ${site.contact.phoneDisplay}`}.</p>
        <p class="mt-3">Ce site n’utilise pas de cookies publicitaires.{site.analytics.plausible || site.analytics.umami ? " La mesure d'audience est réalisée sans cookie et sans donnée personnelle." : ''}</p>
      </section>
      {site.legal.mediator && (
        <section>
          <h2 class="text-display-sm mb-3">Médiation de la consommation</h2>
          <p>{site.legal.mediator}</p>
        </section>
      )}
      <section>
        <h2 class="text-display-sm mb-3">Propriété intellectuelle</h2>
        <p>Le contenu de ce site (textes, photos, logo) est la propriété de {b.name}. Toute reproduction sans accord est interdite.</p>
        <p class="mt-3 text-muted">Conception et réalisation : <a href="https://finckfisch.fr" rel="noopener" class="underline">Finck &amp; Fisch</a>.</p>
      </section>
    </div>
  </main>
  )}
  <Footer />
</Base>
