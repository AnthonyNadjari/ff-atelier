---
/**
 * Les cinq familles du brief, chacune vers sa page (socle : une page par famille). Pas une grille de cartes égales :
 * les photos de la boutique en grand (pâtisserie, pièce montée, bûche), une plaque posée qui déborde du bas de
 * chaque photo ; le pain et les sandwichs, qui n'ont aucune photo, sur un panneau de faïence comme ceux de la
 * devanture, avec leurs vrais noms du catalogue (rien d'illustré, rien de banque d'images).
 */
import { site } from '@/lib/site';
import Img from '@/components/Img.astro';

const ORDRE = ['patisseries', 'pieces-montees', 'pains', 'fetes', 'sandwichs'];
const familles = ORDRE.map((slug) => site.services.find((s) => s.slug === slug)).filter((s): s is NonNullable<typeof s> => Boolean(s));
---

<section id="rayons" class="ray" aria-labelledby="ray-titre">
  <div class="ray-in">
    <div class="ray-tete">
      <h2 id="ray-titre" class="ray-titre">{site.wording.servicesTitle}</h2>
      <p class="ray-sous">Au catalogue de la boutique, 201 produits. Une page par rayon, et un numéro pour commander.</p>
    </div>
    <ul class="ray-grille">
      {familles.map((f) => (
        <li class={`ray-case ray-${f.slug}${f.image ? ' a-photo' : ' a-faience'}`}>
          <a href={`/services/${f.slug}`} class="ray-lien">
            {f.image ? (
              <div class="ray-photo">
                <Img src={f.image.src} alt={f.image.alt} class="ray-img object-cover" sizes="(min-width: 1024px) 55vw, 68vw" />
              </div>
            ) : (
              <div class="ray-faience" aria-hidden="true">
                <ul class="ray-noms">{f.bullets.slice(0, 6).map((b) => <li>{b}</li>)}</ul>
              </div>
            )}
            <div class="ray-plaque">
              <h3 class="ray-nom">{f.title}</h3>
              <p class="ray-court">{f.short}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style is:global>
  .ray { padding: clamp(2rem, 6vw, 4rem) 0 clamp(4rem, 9vw, 7rem); }
  .ray-in { max-width: 88rem; margin-inline: auto; padding-inline: clamp(1rem, 3vw, 2.5rem); }
  .ray-titre {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 6.5vw, 3.2rem);
    line-height: 1;
    color: var(--fg);
    max-width: 18ch;
  }
  .ray-sous { margin-top: 0.6rem; color: var(--muted); max-width: 36rem; }

  .ray-grille {
    margin-top: clamp(1.6rem, 4vw, 2.6rem);
    display: grid;
    gap: 3rem;
    list-style: none;
  }
  .ray-case { position: relative; min-width: 0; }
  .ray-lien { display: block; position: relative; color: inherit; text-decoration: none; }

  /* Photo en grand, sans rayon ; la plaque déborde du bas (deux plans). */
  .ray-photo {
    position: relative;
    width: 68%;
    height: clamp(15rem, 62vw, 22rem);
    overflow: hidden;
    background: var(--ink);
  }
  .ray-photo .ray-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease-out;
  }
  .ray-pieces-montees .ray-photo .ray-img { object-position: 50% 45%; }
  .ray-fetes .ray-photo .ray-img { object-position: 50% 60%; }

  /* Téléphone : la photo à gauche, la plaque posée à droite par-dessus son bas (deux plans). */
  .ray-plaque {
    position: relative;
    z-index: 1;
    width: 78%;
    margin: -4.5rem 0 0 auto;
    padding: 1rem 1.15rem 1rem;
    background: var(--surface);
    border-radius: var(--radius);
    border-bottom: 4px solid var(--accent);
    box-shadow:
      0 3px 6px -3px color-mix(in oklab, var(--ink) 25%, transparent),
      0 22px 40px -18px color-mix(in oklab, var(--ink) 45%, transparent);
    transition: transform 0.18s ease-out;
  }
  .a-faience .ray-plaque { width: auto; margin: -2.6rem 0.9rem 0; }
  .ray-nom {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.45rem, 4.6vw, 1.75rem);
    line-height: 1.05;
    color: var(--fg);
  }
  .ray-court { margin-top: 0.35rem; font-size: 0.98rem; line-height: 1.45; color: var(--muted); }
  .ray-lien:active .ray-plaque { transform: translateY(2px); }
  @media (hover: hover) and (pointer: fine) {
    .ray-lien:hover .ray-plaque { transform: translateY(-4px); }
    .ray-lien:hover .ray-img { transform: scale(1.03); }
    .ray-lien:hover .ray-nom { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  }

  /* Panneau de faïence : carreaux tracés au filet, cadre couleur de store, les noms du catalogue peints dessus. */
  .ray-faience {
    position: relative;
    padding: 1.4rem 1.3rem 3.6rem;
    background-color: var(--bg-2);
    background-image:
      linear-gradient(to right, color-mix(in oklab, var(--line) 80%, var(--fg) 6%) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in oklab, var(--line) 80%, var(--fg) 6%) 1px, transparent 1px);
    background-size: 3.25rem 3.25rem;
    border: 6px solid color-mix(in oklab, var(--accent) 34%, var(--bg-2));
    outline: 1px solid color-mix(in oklab, var(--accent) 50%, var(--bg-2));
    outline-offset: -12px;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--surface) 70%, transparent);
  }
  .ray-noms { list-style: none; display: grid; gap: 0.15rem; }
  .ray-noms li {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.35rem, 5vw, 1.7rem);
    line-height: 1.12;
    color: var(--accent);
  }

  @media (min-width: 64rem) {
    .ray-grille {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: 4rem;
    }
    .ray-patisseries { grid-column: 1 / 8; grid-row: 1 / 3; }
    .ray-patisseries .ray-photo { height: clamp(34rem, 62vw, 46rem); }
    .ray-pieces-montees { grid-column: 8 / 13; grid-row: 1; }
    .ray-pains { grid-column: 8 / 13; grid-row: 2; align-self: end; }
    .ray-fetes { grid-column: 1 / 8; grid-row: 3; }
    .ray-fetes .ray-photo { height: 24rem; }
    .ray-sandwichs { grid-column: 8 / 13; grid-row: 3; align-self: end; }
    .ray-photo { width: auto; height: 20rem; }
    .ray-plaque { width: auto; margin: -3.2rem 1.4rem 0; padding: 1.2rem 1.4rem 1.15rem; max-width: 34rem; }
    .ray-patisseries .ray-plaque { margin-left: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ray-photo .ray-img, .ray-plaque { transition: none; }
  }
</style>
