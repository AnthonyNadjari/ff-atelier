---
/**
 * Venir (la porte « Venir » de l'enseigne, du premier écran et de la barre du téléphone). Le bas de la devanture en
 * pleine largeur (les portes et la vitrine, un autre cadrage que le premier écran) et, posée dessus, la fiche de la
 * boutique : adresse, itinéraire Google, numéro, e-mail du brief, la semaine entière avec le jour d'aujourd'hui
 * marqué, la règle des jours fériés. Pas de formulaire : on appelle ou on vient.
 */
import { site, tel, mailto } from '@/lib/site';
import { semaine } from '@/lib/horaires';
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';

const hero = site.images.hero;
const sem = semaine(site.contact.hours) ?? [];
const ad = site.contact.address;
const reseaux = [
  site.social.instagram && { href: site.social.instagram, label: 'Instagram', icon: 'Instagram' },
  site.social.facebook && { href: site.social.facebook, label: 'Facebook', icon: 'Facebook' },
].filter(Boolean) as { href: string; label: string; icon: string }[];
---

<section id="venir" class="vnr" aria-labelledby="vnr-titre">
  <span id="contact" aria-hidden="true"></span>
  {hero && (
    <div class="vnr-photo">
      <Img src={hero.src} alt="" class="vnr-img" sizes="100vw" />
    </div>
  )}
  <div class="vnr-fiche">
    <div class="vnr-ou">
      <h2 id="vnr-titre" class="vnr-titre">{site.wording.contactTitle}</h2>
      <p class="vnr-ville">{ad.postalCode} {ad.city}</p>
      {site.contact.mapsUrl && (
        <a href={site.contact.mapsUrl} class="vnr-lien" target="_blank" rel="noopener"><Icon name="MapPin" size={18} />Itinéraire sur Google Maps</a>
      )}
      <a href={tel()} class="vnr-tel"><Icon name="Phone" size={22} />{site.contact.phoneDisplay}</a>
      {site.contact.email && <a href={mailto()} class="vnr-mail">{site.contact.email}</a>}
      {reseaux.length > 0 && (
        <ul class="vnr-reseaux">
          {reseaux.map((r) => <li><a href={r.href} target="_blank" rel="noopener" class="vnr-lien">{r.label}</a></li>)}
        </ul>
      )}
    </div>
    <div class="vnr-quand">
      <h3 class="vnr-sous">Les horaires</h3>
      <table class="vnr-semaine">
        <caption class="sr-only">Horaires de la semaine</caption>
        <tbody>
          {sem.map((j) => (
            <tr data-vnr-jour={j.index}>
              <th scope="row">{j.jour}</th>
              <td>{j.ferme ? 'Fermé' : j.libelles.map((l) => <span class="vnr-plage">{l}</span>)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="vnr-note">{site.wording.contactText}</p>
    </div>
  </div>
</section>

<style is:global>
  .vnr { position: relative; display: grid; padding-bottom: clamp(3rem, 8vw, 5rem); }
  .vnr-photo {
    grid-area: 1 / 1;
    height: clamp(14rem, 50vw, 30rem);
    overflow: hidden;
    background: var(--ink);
  }
  .vnr-photo .vnr-img { width: 100%; height: 100%; object-fit: cover; object-position: 62% 82%; }
  .vnr-fiche {
    grid-area: 1 / 1 / span 2 / 1;
    align-self: start;
    position: relative;
    z-index: 1;
    margin: clamp(10rem, 40vw, 22rem) 0.75rem 0;
    padding: 1.5rem 1.25rem;
    display: grid;
    gap: 1.8rem;
    background: linear-gradient(to bottom, var(--surface), color-mix(in oklab, var(--surface) 80%, var(--bg-2)));
    border-radius: var(--radius);
    border-bottom: 6px solid var(--accent);
    box-shadow:
      0 4px 8px -3px color-mix(in oklab, var(--ink) 24%, transparent),
      0 30px 60px -22px color-mix(in oklab, var(--ink) 50%, transparent);
  }
  @media (min-width: 64rem) {
    .vnr-fiche {
      width: min(100% - 5rem, 62rem);
      justify-self: center;
      margin-top: 20rem;
      padding: 2.4rem 2.8rem;
      grid-template-columns: 1fr 1.15fr;
      column-gap: 3.5rem;
    }
  }
  .vnr-titre {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 6.5vw, 2.8rem);
    line-height: 1;
    color: var(--fg);
  }
  .vnr-ville { margin-top: 0.3rem; font-size: 1.1rem; color: var(--muted); }
  .vnr-tel {
    margin-top: 1.1rem;
    display: flex;
    width: fit-content;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 7vw, 2.3rem);
    line-height: 1;
    color: var(--accent);
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .vnr-mail { display: inline-block; margin-top: 0.6rem; color: var(--fg); overflow-wrap: anywhere; }
  .vnr-lien {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.8rem;
    padding-block: 0.2rem;
    font-weight: 600;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .vnr-reseaux { display: flex; flex-wrap: wrap; gap: 0 1.4rem; list-style: none; }
  .vnr-sous { font-weight: 700; font-size: 1.05rem; color: var(--fg); }
  .vnr-semaine { margin-top: 0.6rem; width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .vnr-semaine th, .vnr-semaine td { padding: 0.5rem 0; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .vnr-semaine th { font-weight: 500; color: var(--muted); padding-right: 1rem; white-space: nowrap; }
  .vnr-semaine td { color: var(--fg); }
  .vnr-plage { display: block; white-space: nowrap; }
  .vnr-semaine tr.is-auj th, .vnr-semaine tr.is-auj td { color: var(--fg); font-weight: 700; }
  .vnr-semaine tr.is-auj th::after { content: ' (aujourd’hui)'; font-weight: 400; color: var(--muted); }
  .vnr-note { margin-top: 0.9rem; color: var(--muted); font-size: 0.98rem; line-height: 1.45; }
</style>

<script>
  import { onPage } from '@/scripts/page';
  import { maintenant } from '@/lib/horaires';

  onPage(() => {
    const { jour } = maintenant(new Date());
    document.querySelector(`[data-vnr-jour="${jour}"]`)?.classList.add('is-auj');
  });
</script>
