---
/**
 * Nav sur mesure pour Toits & Cie : une barre noire pleine largeur, le numéro de téléphone en
 * énorme, un point qui clignote "24h/24", et un petit burger à droite qui ouvre une liste simple.
 * Aucun logo, aucun libellé : sur ce site, le seul texte qui compte au-dessus du pli, c'est le numéro.
 */
import { site, tel, navLinks } from '@/lib/site';
const links = navLinks();
// Contact en tiroir (layout.contactDrawer) : un bouton "Écrire" jaune a cote du burger ouvre le
// dialog de src/components/ContactDrawer.astro (formulaire + coordonnees) sans quitter le pli.
const drawer = site.layout.contactDrawer;
---

<header data-nav class="sticky top-0 z-50 border-b-[3px] border-accent bg-ink text-on-ink">
  <div class="container-ff flex items-center justify-between gap-4 py-3 md:py-4">
    <a href={tel()} class="font-display text-display-md leading-none tracking-tight transition-colors hover:text-accent" data-magnetic="0.12">
      {site.contact.phoneDisplay}
    </a>
    <div class="flex items-center gap-4 md:gap-8">
      {site.contact.emergency24h && (
        <span class="hidden items-center gap-2 font-mono text-xs uppercase tracking-[0.22em] text-on-ink/80 sm:flex">
          <span class="blink-dot h-2.5 w-2.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          24h/24
        </span>
      )}
      {drawer && (
        <a href="#contact" class="hidden items-center gap-2 rounded-ui bg-accent px-4 py-2 font-display text-sm uppercase tracking-wide text-on-accent transition-colors hover:bg-accent-2 sm:inline-flex">
          Écrire
        </a>
      )}
      <button class="flex flex-col gap-1.5 p-2" aria-label="Menu" aria-expanded="false" data-menu-toggle>
        <span class="block h-[3px] w-6 bg-on-ink"></span>
        <span class="block h-[3px] w-6 bg-on-ink"></span>
        <span class="block h-[3px] w-4 bg-on-ink"></span>
      </button>
    </div>
  </div>
  <div class="hidden border-t-[3px] border-accent bg-ink" data-menu>
    <nav class="container-ff flex flex-col py-2" aria-label="Navigation">
      {links.map((l) => <a href={l.href} class="border-b border-on-ink/15 py-4 font-display text-2xl uppercase last:border-0">{l.label}</a>)}
      <a href={tel()} class="py-4 font-display text-2xl uppercase text-accent">{site.contact.phoneDisplay}</a>
    </nav>
  </div>
</header>

<style>
  .blink-dot { animation: blink 1.1s steps(1, jump-none) infinite; }
  @keyframes blink { 50% { opacity: 0.15; } }
  @media (prefers-reduced-motion: reduce) { .blink-dot { animation: none; } }
</style>

<script>
  import { onPage } from '@/scripts/page';

  // Rearme a chaque navigation ClientRouter (site.transitions) : voir src/scripts/page.ts.
  onPage(() => {
    const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    btn?.addEventListener('click', () => {
      const open = menu!.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });
    menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));
  });
</script>
