---
/**
 * « Sur l'établi » (démo, 29 oct 2026) : les photos de proof.gallery posées en plans qui se recouvrent, une grande et
 * trois décalées par-dessus avec une ombre portée réelle (GOUT § 0 : de la profondeur, l'image en grand). Le texte
 * vient de business.description (son dernier paragraphe : où se fait la réparation). Aucune donnée ajoutée ; sans
 * photo, rien.
 */
import { site, paragraphs } from '@/lib/site';
import Img from '@/components/Img.astro';

const photos = site.proof.gallery.slice(0, 4);
const paras = paragraphs(site.business.description);
const phrase = paras[paras.length - 1];
---

{photos.length > 0 && (
  <section id="photos" class="eb" aria-labelledby="eb-titre">
    <div class="container-ff eb-grille">
      <div class="eb-texte">
        <h2 id="eb-titre" class="eb-titre font-display">Sur l’établi</h2>
        {phrase && <p class="eb-phrase">{phrase}</p>}
        {site.layout.pageAPropos && <a href="/a-propos" class="eb-lien">Qui répare<span aria-hidden="true"> →</span></a>}
      </div>
      <div class="eb-pile">
        {photos.map((p, i) => (
          <figure class={`eb-plan eb-plan-${i + 1}`} data-reveal>
            <Img src={p.src} alt={p.alt} sizes={i === 0 ? '(min-width: 1024px) 50vw, 92vw' : '(min-width: 1024px) 22vw, 48vw'} class="eb-img" />
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .eb { overflow: hidden; padding-block: clamp(1.5rem, 4vh, 4.5rem) clamp(1.75rem, 5vh, 5.5rem); }
  .eb-grille { display: grid; gap: 1.25rem; }
  .eb-texte { display: grid; gap: 0.9rem; align-content: start; }
  .eb-titre { font-size: clamp(2rem, 6vw, 3.6rem); line-height: 1; }
  .eb-phrase { max-inline-size: 34ch; font-size: clamp(1.05rem, 1.6vw, 1.25rem); color: var(--color-muted); }
  .eb-lien { justify-self: start; display: inline-flex; align-items: center; min-block-size: 44px; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
  .eb-lien:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  /* La pile : une grande photo, les autres posées par-dessus en quinconce, chacune avec son ombre. */
  .eb-pile { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: minmax(0, auto); }
  .eb-plan { margin: 0; border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--shadow-lift); border: 1px solid var(--color-line); background: var(--color-bg-2); }
  .eb-plan :global(.eb-img) { display: block; inline-size: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  /* Téléphone : les quatre plans en éventail sur une rangée, chacun recouvre le précédent. */
  .eb-plan { position: relative; grid-row: 1; }
  .eb-plan-1 { grid-column: 1 / 7; z-index: 1; rotate: -4deg; }
  .eb-plan-2 { grid-column: 3 / 9; margin-block-start: 8%; z-index: 2; rotate: 2deg; }
  .eb-plan-3 { grid-column: 5 / 11; margin-block-start: -2%; z-index: 3; rotate: -1.5deg; }
  .eb-plan-4 { grid-column: 7 / 13; margin-block-start: 10%; z-index: 4; rotate: 3deg; }
  @media (min-width: 64rem) {
    .eb-grille { grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); column-gap: clamp(2rem, 4vw, 4rem); align-items: center; }
    .eb-pile { grid-template-columns: repeat(16, minmax(0, 1fr)); }
    .eb-plan-1 { grid-column: 1 / 7; grid-row: 1; }
    .eb-plan-2 { grid-column: 5 / 10; grid-row: 1; margin-block-start: 18%; }
    .eb-plan-3 { grid-column: 9 / 14; grid-row: 1; margin-block-start: -2%; }
    .eb-plan-4 { grid-column: 12 / 17; grid-row: 1; margin-block-start: 24%; }
  }
</style>
