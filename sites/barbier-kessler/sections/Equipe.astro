---
/**
 * "Équipe" : les trois barbiers en panneaux plein écran qui s'épinglent puis se tassent au scroll
 * (data-stack), plutôt qu'une grille de portraits — pas de photo individuelle réelle, la
 * typographie fait le portrait. Propre à ce site.
 */
import { site } from '@/lib/site';
const team = site.about.team;
const tones = ['bg-surface text-fg', 'bg-ink text-on-ink', 'bg-accent text-on-accent'];
// Le role (m.role) est attenue par rapport au nom, mais opacity-70 uniforme echoue le contraste
// (audit lighthouse --detail) sur la troisieme carte : l'accent surcharge de ce site est un vert
// fonce (voir sites/barbier-kessler/site.config.ts, accent h150/s45/l34 sur la direction atelier),
// donc on-accent/bg-accent n'a que ~4.76:1 de marge a pleine opacite (verifie par script) — une
// teinte de moins passe sous 4.5:1. Un opacity par carte, calcule sur les tokens reels de chaque
// fond (surface/fg, ink/on-ink, accent/on-accent) :
const roleOpacity = ['text-fg/80', 'text-on-ink/70', 'text-on-accent'];
---

<section id="equipe" class="pt-[var(--section-y)]">
  <div class="container-ff">
    <p class="eyebrow">Équipe</p>
    <h2 class="mt-4 max-w-xl font-display text-display-lg uppercase leading-[0.92]" data-reveal>Trois fauteuils, trois barbiers</h2>
  </div>

  <div class="mt-10" data-stack>
    {team.map((m, i) => (
      <div class:list={['flex h-[68vh] flex-col items-center justify-center gap-4 border-t border-line', tones[i % tones.length]]}>
        <span class="team-tick" aria-hidden="true"></span>
        <p class="font-display uppercase leading-none" style="font-size: clamp(2.5rem, 9vw, 6rem);">{m.name}</p>
        <p class:list={['font-mono text-sm uppercase tracking-[0.2em]', roleOpacity[i % roleOpacity.length]]}>{m.role}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .team-tick {
    display: block;
    width: 3rem;
    height: 4px;
    background: currentColor;
    opacity: 0.5;
    border-radius: 999px;
  }
</style>
