---
/**
 * "Équipe" : les trois barbiers en panneaux plein écran qui s'épinglent puis se tassent au scroll
 * (data-stack), plutôt qu'une grille de portraits — pas de photo individuelle réelle, la
 * typographie fait le portrait. Propre à ce site.
 */
import { site } from '@/lib/site';
const team = site.about.team;
const tones = ['bg-surface text-fg', 'bg-ink text-on-ink', 'bg-accent text-on-accent'];
---

<section id="equipe" class="pt-[var(--section-y)]">
  <div class="container-ff">
    <p class="eyebrow" data-reveal>Équipe</p>
    <h2 class="mt-4 max-w-xl font-display text-display-lg uppercase leading-[0.92]" data-reveal>Trois fauteuils, trois barbiers</h2>
  </div>

  <div class="mt-10" data-stack>
    {team.map((m, i) => (
      <div class:list={['flex h-[68vh] flex-col items-center justify-center gap-4 border-t border-line', tones[i % tones.length]]}>
        <span class="team-tick" aria-hidden="true"></span>
        <p class="font-display uppercase leading-none" style="font-size: clamp(2.5rem, 9vw, 6rem);">{m.name}</p>
        <p class="font-mono text-sm uppercase tracking-[0.2em] opacity-70">{m.role}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .team-tick {
    display: block;
    width: 3rem;
    height: 4px;
    background: currentColor;
    opacity: 0.5;
    border-radius: 999px;
  }
</style>
