---
/**
 * Nav dessinée pour Barbier Kessler : le nom de l'enseigne se révèle caractère par caractère
 * (data-split="chars"), une petite pastille façon enseigne de barbier tourne à côté (CSS pur,
 * rayures dérivées des tokens), et la barre porte l'unique data-scroll-progress de la page (fil de
 * lecture, en pied de nav). Transparente sur le hero sombre, opaque une fois qu'on a défilé.
 * Composition propre à ce site.
 */
import { site, tel, navLinks } from '@/lib/site';
import Icon from '@/components/Icon.astro';
const links = navLinks();
---

<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 bg-ink/20 text-on-ink backdrop-blur-sm transition-colors duration-500 [&.is-scrolled]:border-b [&.is-scrolled]:border-line [&.is-scrolled]:bg-bg/95 [&.is-scrolled]:text-fg [&.is-scrolled]:backdrop-blur-md"
>
  <div class="container-ff flex items-center justify-between gap-4 py-4">
    <a href="/" class="order-1 flex items-center gap-3">
      <span class="pole-mark" aria-hidden="true"></span>
      <span class="font-display text-lg uppercase tracking-wide sm:text-xl" data-split="chars">{site.business.name}</span>
    </a>

    <!-- tel: place tot dans le DOM (verifier : lien tel: attendu dans les 1500 premiers caracteres du
         corps), replace visuellement a droite par order-3. -->
    <a
      href={tel()}
      class="btn btn-primary order-3 inline-flex items-center gap-2 rounded-ui bg-accent px-4 py-2.5 font-display text-sm text-on-accent shadow-card sm:px-5"
      data-magnetic="0.15"
    >
      <Icon name="Phone" size={16} />
      <span class="hidden sm:inline">{site.contact.phoneDisplay}</span>
    </a>

    <nav class="order-2 hidden items-center gap-7 lg:flex" aria-label="Navigation principale">
      {links.map((l) => (
        <a href={l.href} class="font-mono text-xs uppercase tracking-[0.16em] opacity-70 transition-opacity hover:opacity-100">{l.label}</a>
      ))}
    </nav>
  </div>
  <div data-scroll-progress aria-hidden="true"></div>
</header>
<div class="h-[64px] sm:h-[72px]" aria-hidden="true"></div>

<style>
  /* Signature "enseigne de barbier" : rayures diagonales derivees des tokens (accent/bg), qui defilent. */
  .pole-mark {
    display: block;
    width: 0.6rem;
    height: 1.6rem;
    flex-shrink: 0;
    border-radius: 999px;
    overflow: hidden;
    background-image: repeating-linear-gradient(
      -45deg,
      var(--accent) 0 6px,
      var(--bg) 6px 9px,
      color-mix(in oklch, var(--accent) 45%, var(--bg) 55%) 9px 15px
    );
    animation: pole-move 1.4s linear infinite;
  }
  @keyframes pole-move {
    to { background-position-y: 15px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pole-mark { animation: none; }
  }
</style>
