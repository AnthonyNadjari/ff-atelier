---
/**
 * Hero dessiné pour Barbier Kessler : fond sombre (bg-ink), nom de l'enseigne géant découpé en
 * caractères (data-split="chars"), une bande "pole" verticale rayée en fond (CSS pur, tokens
 * accent/on-ink), chiffres réels (fauteuils, barbiers, année) en data-counter, puis une bande
 * data-marquee-velocity qui porte "sans rendez-vous le samedi". Composition propre à ce site.
 */
import { site, tel, yearsSince } from '@/lib/site';
import Icon from '@/components/Icon.astro';
const since = site.business.since;
const years = yearsSince();
const firstLine = site.business.description.split(/\n/)[0];
const teamCount = site.about.team.length;
---

<section id="hero" class="relative overflow-hidden bg-ink text-on-ink">
  <div class="pole-stripe absolute inset-y-0 left-0 w-2 sm:w-3" aria-hidden="true"></div>
  <div class="pole-stripe absolute inset-y-0 right-0 w-2 sm:w-3" aria-hidden="true"></div>

  <div class="container-ff relative z-[2] flex min-h-[82svh] flex-col justify-center gap-8 py-28 sm:py-32">
    <p class="eyebrow flex items-center gap-3 text-on-ink/70">
      <span class="inline-block h-px w-10 bg-on-ink/40" aria-hidden="true"></span>
      {site.business.trade} · Krutenau, {site.contact.address.city}{years !== undefined && ` · depuis ${since}`}
    </p>

    <h1
      class="font-display uppercase leading-[0.86]"
      style="font-size: clamp(2.75rem, 10vw, 8rem);"
      data-split="chars"
    >{site.business.name}</h1>

    <p class="max-w-xl text-lg text-on-ink/80" set:html={site.business.tagline} />
    <p class="max-w-lg text-on-ink/60">{firstLine}</p>

    <div class="mt-2 flex flex-wrap items-center gap-5">
      <a
        href="#contact"
        class="btn btn-primary inline-flex items-center gap-2 rounded-ui bg-accent px-7 py-4 font-display text-lg text-on-accent shadow-card"
        data-magnetic="0.25"
      >
        {site.wording.devis}
      </a>
      <a href={tel()} class="inline-flex items-center gap-2 border-b-2 border-on-ink/30 pb-1 font-display text-lg text-on-ink hover:border-accent hover:text-accent">
        <Icon name="Phone" size={18} />{site.contact.phoneDisplay}
      </a>
    </div>

    <div class="mt-4 flex flex-wrap items-baseline gap-x-8 gap-y-3 font-mono text-xs uppercase tracking-[0.18em] text-on-ink/60" data-stagger="90">
      <span class="flex items-baseline gap-2"><span class="font-display text-2xl text-on-ink" data-counter="3">0</span>fauteuils</span>
      <span class="flex items-baseline gap-2"><span class="font-display text-2xl text-on-ink" data-counter={teamCount}>0</span>barbiers</span>
      <span>Depuis {since}</span>
    </div>
  </div>

  <div class="relative z-[2] border-t border-on-ink/15 bg-ink/70 py-4" data-marquee="24s" data-marquee-velocity="24">
    <div class="marquee-track font-display uppercase text-display-sm tracking-wide text-on-ink/85">
      <span>Sans rendez-vous le samedi</span>
      <span class="text-accent" aria-hidden="true">✂</span>
      <span>Réservez en ligne du mardi au vendredi</span>
      <span class="text-accent" aria-hidden="true">✂</span>
    </div>
  </div>
</section>

<style>
  /* Signature "pole" : rayures diagonales derivees des tokens, en bordure du hero. */
  .pole-stripe {
    background-image: repeating-linear-gradient(
      45deg,
      var(--accent) 0 14px,
      var(--on-ink) 14px 24px,
      color-mix(in oklch, var(--accent) 45%, var(--on-ink) 55%) 24px 34px
    );
    opacity: 0.9;
    animation: pole-scroll 3.6s linear infinite;
  }
  @keyframes pole-scroll {
    to { background-position-y: 34px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pole-stripe { animation: none; }
  }
</style>
