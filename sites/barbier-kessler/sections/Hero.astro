---
/**
 * Premier écran « la note » — propre à Barbier Kessler.
 * Idée : chez un barbier, ce qu'on cherche en premier c'est le prix d'une coupe. Les prestations et
 * leurs tarifs sont composés en un seul bloc de texte display qui remplit l'écran, sous l'enseigne.
 * Ni eyebrow, ni sous-titre, ni bouton, ni compteur : la carte parle, le téléphone suffit.
 */
import { site, tel } from '@/lib/site';

const tarifs = site.services.filter((s) => s.priceFrom);
---

<section id="hero" class="bg-ink text-on-ink">
  <div class="container-ff relative z-[1] flex min-h-[84svh] flex-col justify-center gap-10 pb-16 pt-32 md:pt-40">
    <h1 class="font-display text-display-sm uppercase tracking-tight" data-reveal>{site.business.name}</h1>

    <p
      class="font-display leading-[1.2] text-on-ink"
      style="font-size: clamp(1.55rem, 4.8vw, 3.4rem);"
      data-stagger="70"
    >
      {tarifs.map((s, i) => (
        <span class="inline-block pr-[0.4em]">
          {s.title}&nbsp;<span class="text-on-ink/55">{s.priceFrom}</span>{i < tarifs.length - 1 && (
            <span class="text-on-ink/25" aria-hidden="true">&nbsp;/</span>
          )}
        </span>
      ))}
    </p>

    <p class="flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm text-on-ink/65">
      <a href={tel()} class="font-display text-base text-on-ink underline-offset-4 hover:underline">
        {site.contact.phoneDisplay}
      </a>
      <span>{site.contact.address.street}, {site.contact.address.city}</span>
    </p>
  </div>
</section>
