---
/**
 * Premier écran « le numéro » — propre à Dubois Plomberie.
 * Idée : pour une fuite à 23 h, la seule information utile est un numéro qu'on peut toucher. Il
 * occupe l'écran en chiffres géants et cliquables ; le titre le précède, une ligne le suit.
 * Ni eyebrow, ni sous-titre, ni second bouton, ni carte de données.
 */
import { site, tel } from '@/lib/site';
---

<section id="hero" class="bg-accent text-on-accent">
  <div class="container-ff flex min-h-[82svh] flex-col justify-center gap-10 pb-16 pt-32 md:pt-40">
    <h1
      class="max-w-3xl font-display text-display-md leading-[1.02]"
      data-reveal
      set:html={site.business.tagline}
    />

    <a
      href={tel()}
      class="block font-display leading-[0.9] tracking-tight tabular-nums text-on-accent underline-offset-[0.1em] hover:underline"
      style="font-size: clamp(2.3rem, 9.5vw, 7rem);"
      aria-label={`Appeler ${site.business.name} au ${site.contact.phoneDisplay}`}
    >{site.contact.phoneDisplay}</a>

    <p class="flex flex-wrap items-baseline gap-x-6 gap-y-2 text-on-accent/80">
      {site.contact.emergency24h && <span class="font-display text-xl text-on-accent">24h/24, 7j/7</span>}
      {site.zones?.label && <span>{site.zones.label}</span>}
    </p>
  </div>
</section>
