---
/**
 * Domaines sur mesure — index typographique à deux colonnes : un numéro, un intitulé, une ligne.
 * Chaque ligne s'ouvre en accordéon (data-accordion="single", GSAP Flip — un seul domaine ouvert à
 * la fois) pour révéler trois situations typiques (site.services[].bullets, aucune donnée
 * inventée). Jamais une grille de cartes à icônes comme src/sections/Services/*, jamais une image
 * qui flotte au survol (mandat : ton sobre pour une profession réglementée, docs/veille/
 * redaction-images.md §1.3 — pas de survol spectaculaire). Numéro en `data-blur-scrub` : net une
 * fois la ligne dans le champ de lecture, plutôt qu'un simple fade.
 */
import { site } from '@/lib/site';
import Icon from '@/components/Icon.astro';
const services = site.services;
---

<section id="domaines" class="section-y">
  <div class="container-ff">
    <p class="eyebrow">Domaines d’intervention</p>
    <h2 class="mt-4 max-w-2xl text-display-md" data-reveal>Quatre domaines, une même manière de suivre un dossier.</h2>
    <p class="measure mt-5 text-muted">Une ligne par domaine ; ouvrez-la pour voir les situations les plus courantes.</p>

    <div class="mt-14 grid gap-x-16 sm:grid-cols-2" data-accordion="single">
      {services.map((s, i) => (
        <details class="group border-b border-line py-6 first:border-t sm:first:border-t sm:[&:nth-child(2)]:border-t">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6">
            <span class="flex items-baseline gap-5">
              <span class="font-mono text-sm text-muted" data-blur-scrub="6" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-display text-display-sm">{s.title}</span>
            </span>
            <Icon name="Plus" size={18} class="mt-1 shrink-0 text-accent transition-transform duration-300 group-open:rotate-45" strokeWidth={1.5} />
          </summary>
          <div class="mt-4 pl-[3.15rem]">
            <p class="measure text-muted">{s.short}</p>
            {s.bullets.length > 0 && (
              <ul class="mt-4 grid gap-2 text-sm">
                {s.bullets.map((b) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
