---
/**
 * Premier écran « la page de titre » — propre au cabinet Lemaire.
 * Idée : une profession réglementée ne vend rien au premier écran. Une seule phrase, un filet, puis
 * trois mentions nues : depuis quand, quand le cabinet reçoit, où il intervient. Rien d'autre.
 * Ni eyebrow, ni sous-titre, ni bouton — le fond animé de la direction porte seul la matière.
 */
import { site, tel } from '@/lib/site';

const heures = site.contact.hours[0];
const mentions = [
  ...(site.business.since ? [`Depuis ${site.business.since}`] : []),
  ...(heures ? [`${heures.days}, ${heures.hours}`] : []),
  ...(site.zones?.label ? [site.zones.label] : []),
];
---

<section
  id="hero"
  class="relative overflow-hidden"
  data-shader="mesh"
  data-shader-speed="0.8"
  data-shader-pointer="1"
>
  <div class="container-ff relative">
    <div class="flex min-h-[80svh] max-w-3xl flex-col justify-center gap-10 pb-16 pt-32 md:pt-40">
      <h1 class="text-display-lg leading-[1.12]" data-reveal>{site.business.tagline}</h1>

      <div class="h-px w-full bg-line" aria-hidden="true"></div>

      <ul class="flex flex-wrap gap-x-10 gap-y-3 font-mono text-xs tracking-[0.12em] text-muted">
        {mentions.map((m) => <li>{m}</li>)}
      </ul>

      <p>
        <a href={tel()} class="font-display text-lg text-fg underline-offset-4 hover:underline">
          {site.contact.phoneDisplay}
        </a>
      </p>
    </div>
  </div>
</section>
