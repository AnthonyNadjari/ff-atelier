---
/**
 * Contact sur mesure — reprend ContactForm/Carte partagés tels quels (aucune logique dupliquée),
 * mais le panneau de coordonnées est sombre avec un halo qui suit le curseur (data-spotlight),
 * comme le mandat le demande explicitement pour la carte de contact — composition proche dans
 * l'esprit de studio-ambre/Contact.astro et dubois-plomberie/Tarifs.astro (déjà les deux usages
 * existants de data-spotlight), mais posée ici sur le panneau de contact plutôt que sur un tarif ou
 * un bloc horaires : premier usage de data-spotlight sur une carte de contact.
 */
import { site, tel, mailto } from '@/lib/site';
import SectionHeading from '@/components/SectionHeading.astro';
import ContactForm from '@/components/ContactForm.astro';
import Icon from '@/components/Icon.astro';
import Carte from '@/components/Carte.astro';
---

<section id="contact" class="section-y bg-bg-2">
  <div class="container-ff">
    <SectionHeading eyebrow="Contact" title={site.wording.contactTitle} text={site.wording.contactText} />

    <div class="mt-12 grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7" data-reveal="left">
        <div class="card rounded-card bg-surface p-6 shadow-card md:p-8">
          <ContactForm />
        </div>
      </div>

      <div class="flex flex-col gap-6 lg:col-span-5" data-reveal="right">
        <div class="relative overflow-hidden rounded-card bg-ink p-8 text-on-ink md:p-10" data-spotlight>
          <p class="eyebrow relative z-[2]">Le cabinet</p>
          <p class="relative z-[2] mt-4 flex items-center gap-3">
            <Icon name="Phone" size={18} class="shrink-0 text-accent" />
            <a href={tel()} class="font-medium hover:text-accent">{site.contact.phoneDisplay}</a>
          </p>
          <p class="relative z-[2] mt-3 flex items-center gap-3">
            <Icon name="Mail" size={18} class="shrink-0 text-accent" />
            <a href={mailto()} class="break-all font-medium hover:text-accent">{site.contact.email}</a>
          </p>
          {site.contact.hours.length > 0 && (
            <p class="relative z-[2] mt-3 flex items-start gap-3">
              <Icon name="Clock" size={18} class="mt-0.5 shrink-0 text-accent" />
              <span>{site.contact.hours.map((h) => `${h.days} : ${h.hours}`).join(' — ')}</span>
            </p>
          )}
        </div>

        <Carte />
      </div>
    </div>
  </div>
</section>
