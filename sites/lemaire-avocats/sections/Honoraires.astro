---
/**
 * Honoraires sur mesure — trois modes de rémunération expliqués sans chiffre (la profession ne
 * publie jamais de grille tarifaire fixe : chaque dossier est différent), sauf la première
 * consultation dont le tarif est connu et marqué « à titre indicatif » comme l'exige le mandat.
 * Composition sobre : trois blocs texte égaux, aucune carte « à partir de X € » façon
 * dubois-plomberie/Tarifs.astro ou maison-roux/Carte.astro (mandat : jamais de comparaison, jamais
 * de promesse — un tableau de prix aurait mal traduit une réalité qui varie par dossier). La citation
 * finale (convention d'honoraires) passe du flou au net en scrollant (data-blur-scrub).
 */
import Icon from '@/components/Icon.astro';

const modes = [
  {
    icon: 'FileCheck',
    title: 'Le forfait',
    text: 'Un montant convenu à l’avance pour une prestation définie : la rédaction d’un contrat ou le dépôt d’un dossier de rupture conventionnelle, par exemple.',
  },
  {
    icon: 'Clock',
    title: 'Le taux horaire',
    text: 'Un tarif horaire pour les dossiers dont la durée ne peut pas être fixée à l’avance, avec un point régulier sur le temps déjà passé.',
  },
  {
    icon: 'TrendingUp',
    title: 'Le résultat, en complément',
    text: 'Un honoraire complémentaire peut s’ajouter à un forfait ou à un taux horaire, jamais comme seul mode de rémunération, conformément à la réglementation de la profession.',
  },
];
---

<section id="honoraires" class="section-y">
  <div class="container-ff">
    <p class="eyebrow">Honoraires</p>
    <h2 class="mt-4 max-w-2xl text-display-md" data-reveal>Trois manières d’être rémunérées, toujours écrites.</h2>
    <p class="measure mt-5 text-muted">Aucun tarif fixe n’est publié ici : chaque dossier diffère. Le mode retenu est toujours indiqué avant toute intervention.</p>

    <div class="mt-14 grid gap-10 sm:grid-cols-3" data-stagger="120">
      {modes.map((m) => (
        <div>
          <Icon name={m.icon} size={22} class="text-accent" strokeWidth={1.5} />
          <h3 class="mt-5 font-display text-display-sm">{m.title}</h3>
          <p class="measure mt-3 text-sm text-muted">{m.text}</p>
        </div>
      ))}
    </div>

    {/*
      blur=10 restait tres illisible dans l'etat "avant scroll" de la capture pleine page
      (scripts/captures.mjs remonte a scrollY=0 avant la capture ; un data-scrub/data-blur-scrub,
      pilote en continu par le scroll, retombe alors a son etat de depart flou) — meme constat que
      studio-ambre/site.config.ts (essai a 14 illisible, retenu a 5) : baisse a 4, assez pour un
      effet perceptible au scroll reel sans jamais rendre ce texte (convention d'honoraires,
      information importante) illisible au repos.
    */}
    <p class="measure mx-auto mt-16 max-w-2xl border-t border-line pt-10 text-center font-display text-display-sm text-fg" data-blur-scrub="4">
      Toute mission fait l’objet d’une convention d’honoraires écrite, signée avant intervention. La première consultation, d’une durée de 45 minutes, est facturée 90 € TTC, à titre indicatif.
    </p>
  </div>
</section>
