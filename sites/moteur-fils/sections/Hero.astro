---
/**
 * Premier écran « 1994 » — propre au Garage Moteur & Fils.
 * Idée : dans un garage indépendant, le premier argument n'est pas une phrase, c'est une date. Le
 * millésime d'ouverture ouvre l'écran en chiffres à pleine largeur, le titre se pose dessous.
 * Ni eyebrow, ni sous-titre, ni second bouton, ni badge, ni bande de services.
 */
import { site, tel } from '@/lib/site';

const since = site.business.since;
---

<section id="hero" class="overflow-hidden bg-bg">
  <div class="container-ff flex min-h-[80svh] flex-col justify-end pb-14 pt-32 md:pt-40">
    {since && (
      <p
        class="font-display leading-[0.76] tracking-tight tabular-nums text-fg"
        style="font-size: clamp(5.5rem, 26vw, 19rem);"
        aria-hidden="true"
      >{since}</p>
    )}

    <h1
      class="mt-8 max-w-2xl font-display text-display-md leading-[0.98]"
      data-split
      set:html={site.business.tagline}
    />

    <p class="mt-8 flex flex-wrap items-baseline gap-x-6 gap-y-1">
      <a href={tel()} class="font-display text-xl text-fg underline-offset-4 hover:underline">
        {site.contact.phoneDisplay}
      </a>
      <span class="text-muted">{site.contact.address.street}, {site.contact.address.city}</span>
    </p>
  </div>
</section>
