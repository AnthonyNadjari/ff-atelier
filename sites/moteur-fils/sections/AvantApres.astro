---
/**
 * « Avant / après » : curseur de comparaison maison (input range + clip-path), légende façon
 * mot griffonné, trois autocollants qui flottent autour de la photo. Composition propre à ce
 * site — pas la variante partagée proof/before-after.
 */
import SectionHeading from '@/components/SectionHeading.astro';

const avant = { src: '/images/avant.webp', alt: 'Aile avant cabossée et rayée, avant réparation' };
const apres = { src: '/images/apres.webp', alt: 'Même aile repeinte et redressée, comme neuve' };

const stickers = [
  { label: 'Devis gratuit', pos: '-top-5 -left-3 sm:-left-10 sm:-top-8', rot: '-rotate-6', bg: 'bg-surface text-fg' },
  { label: 'Véhicule de courtoisie', pos: '-bottom-6 -right-2 sm:-right-12 sm:-bottom-10', rot: 'rotate-4', bg: 'bg-accent text-on-accent' },
  { label: 'Pièces d’origine', pos: 'top-1/3 -right-3 sm:-right-16', rot: '-rotate-3', bg: 'bg-bg-2 text-fg' },
];
---

<section id="avantapres" class="section-y overflow-hidden bg-bg-2">
  <div class="container-ff">
    <SectionHeading
      eyebrow="Avant / après"
      title="Un choc léger, une carrosserie qui retrouve sa jeunesse"
      text="Faites glisser le curseur. C’est la même aile, à quelques jours d’écart."
      align="center"
    />

    <div class="relative mx-auto mt-16 max-w-2xl sm:mt-20">
      <div class="relative aspect-[4/3] select-none overflow-hidden rounded-card border-[3px] border-ink bg-surface shadow-lift" data-compare>
        <img src={avant.src} alt={avant.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0" data-compare-after style="clip-path: inset(0 50% 0 0)">
          <img src={apres.src} alt={apres.alt} loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
        </div>
        <div class="pointer-events-none absolute inset-y-0 w-1 bg-surface shadow-lift" data-compare-line style="left: 50%"></div>
        <p class="pointer-events-none absolute left-3 top-3 rounded-pill border-2 border-ink bg-ink/80 px-3 py-1 text-xs uppercase tracking-wide text-on-ink">Avant</p>
        <p class="pointer-events-none absolute right-3 top-3 rounded-pill border-2 border-ink bg-accent px-3 py-1 text-xs uppercase tracking-wide text-on-accent">Après</p>
        <input
          type="range"
          min="0"
          max="100"
          value="50"
          class="absolute inset-x-0 bottom-3 mx-auto w-[92%] accent-[var(--color-accent)]"
          aria-label="Comparer avant et après"
          data-compare-range
        />
      </div>

      <p class="caption-scribble mx-auto mt-8 max-w-xs text-center text-xl text-accent sm:-rotate-1">Même aile, huit jours plus tard.</p>

      {stickers.map((s) => (
        <div class:list={['pointer-events-none absolute z-10 hidden sm:block', s.pos]}>
          <span class:list={['inline-block rounded-pill border-[3px] border-ink px-4 py-2 text-sm font-medium shadow-card', s.bg, s.rot]}>{s.label}</span>
        </div>
      ))}
    </div>

    <ul class="mx-auto mt-8 flex max-w-md flex-wrap justify-center gap-3 sm:hidden">
      {stickers.map((s) => (
        <li class:list={['rounded-pill border-[3px] border-ink px-4 py-2 text-sm font-medium', s.bg]}>{s.label}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .caption-scribble {
    font-family: var(--font-display);
    font-style: italic;
    text-decoration: underline;
    text-decoration-style: wavy;
    text-decoration-color: var(--accent-2);
    text-underline-offset: 6px;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('[data-compare-range]');
    const after = root.querySelector<HTMLElement>('[data-compare-after]');
    const line = root.querySelector<HTMLElement>('[data-compare-line]');
    if (!range || !after || !line) return;
    const update = () => {
      const v = Number(range.value);
      after.style.clipPath = `inset(0 ${100 - v}% 0 0)`;
      line.style.left = `${v}%`;
    };
    range.addEventListener('input', update);
    update();
  });
</script>
