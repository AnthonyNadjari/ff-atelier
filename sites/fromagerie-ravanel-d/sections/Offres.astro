---
/**
 * Les offres de la piste D (tour 1, 17 oct 2026, « trop 2D ») : remplace services/list (une liste à plat, titre
 * « Nos services » imposé, surtitre). Une carte par offre, chacune mène à sa page (/services/<slug>) :
 * - une offre avec sa photo (cave, beaufort, raclette) : la photo, puis une plaque de texte qui DÉBORDE sur le bas
 *   de la photo, avec son ombre portée (deux plans) ;
 * - les plateaux (pas de photo au brief) : la planche dessinée, la même que le bloc « Le plateau » ;
 * - le comptoir (pas de photo) : l'étiquette du comptoir, ses produits écrits dessus (les points du brief).
 * Rien n'est inventé : titres, phrases et points viennent de site.services.
 * Téléphone : une rangée qu'on fait glisser au doigt (accroche CSS, rien ne défile tout seul, GOUT § 4) ;
 * ordinateur : deux rangées (deux grandes cartes, trois petites).
 * Mouvement : aucun à l'arrivée (rien ne se lève) ; au survol d'une souris la plaque se soulève de 4 px et son
 * ombre s'allonge (0,2 s, ease-out) ; au toucher, elle s'enfonce de 1 px.
 */
import { site } from '@/lib/site';
import Img from '@/components/Img.astro';

const offres = site.services;
// Mêmes parts que la planche du bloc « Le plateau » (classes pla-* de Plateau.astro, globales).
const parts = ['pointe', 'carre', 'tranche', 'pointe', 'tranche', 'carre'];
---

<section id="offres" class="off" aria-labelledby="off-titre">
  <h2 id="off-titre" class="off-tete text-display-md">{site.wording.servicesTitle}</h2>

  <ul class="off-rangee">
    {offres.map((s, i) => (
      <li class:list={['off-carte', i < 2 && 'off-grande']}>
        <a href={`/services/${s.slug}`} class="off-lien">
          <div class="off-visuel" aria-hidden={s.image ? undefined : 'true'}>
            {s.image ? (
              <Img src={s.image.src} alt={s.image.alt} class="off-img object-cover" sizes="(min-width: 1024px) 34vw, 80vw" />
            ) : s.slug === 'plateaux' ? (
              <div class="off-planche">
                {parts.map((f) => <span class={`pla-part pla-${f}`} data-pose></span>)}
              </div>
            ) : (
              <div class="off-etiquette">
                {s.bullets.slice(0, 4).map((b) => <span>{b}</span>)}
              </div>
            )}
          </div>
          <div class="off-plaque">
            <h3 class="off-nom">{s.title}</h3>
            <p class="off-court">{s.short}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style is:global>
  /* Global (tour 1) : classes préfixées propres à la section, sans attribut de portée Astro sur chaque élément
     et chaque sélecteur (budget HTML de ff perf, 140 Ko). Aucune classe Tailwind n'est redéfinie ici. */
  .off {
    --off-ombre:
      0 1px 0 color-mix(in oklab, var(--ink) 8%, transparent),
      0 2px 5px -1px color-mix(in oklab, var(--ink) 16%, transparent),
      0 18px 34px -14px color-mix(in oklab, var(--ink) 38%, transparent);
    --off-ombre-haute:
      0 1px 0 color-mix(in oklab, var(--ink) 8%, transparent),
      0 4px 8px -2px color-mix(in oklab, var(--ink) 18%, transparent),
      0 30px 50px -18px color-mix(in oklab, var(--ink) 44%, transparent);
    padding-block: clamp(4rem, 8vw, 8.5rem) 0.5rem;
  }
  @media (min-width: 64rem) {
    .off { padding-block: clamp(7rem, 10vw, 9rem) clamp(4rem, 6vw, 5rem); }
  }
  .off-tete {
    width: min(100% - 2rem, 58rem);
    margin-inline: auto;
  }
  @media (min-width: 64rem) {
    .off-tete { width: min(100% - 5rem, 58rem); }
  }

  /* Téléphone : rangée qu'on fait glisser ; marges hautes et basses pour que les ombres ne soient pas coupées. */
  .off-rangee {
    margin-top: 1.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 20rem);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    padding: 1rem 1rem 2.25rem;
    align-items: start;
    list-style: none;
    scrollbar-width: none;
  }
  .off-rangee::-webkit-scrollbar { display: none; }
  .off-carte { scroll-snap-align: start; min-width: 0; }

  @media (min-width: 64rem) {
    .off-rangee {
      width: min(100% - 5rem, 58rem);
      margin: 2.5rem auto 0;
      padding: 0;
      overflow: visible;
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      align-items: stretch;
      gap: 3rem 1.75rem;
    }
    .off-carte { grid-column: span 2; }
    .off-plaque { flex: 1; }
    .off-carte.off-grande { grid-column: span 3; }
  }

  .off-lien {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: var(--fg);
    text-decoration: none;
  }
  .off-visuel {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--ink);
    box-shadow: var(--off-ombre);
  }
  .off-grande .off-visuel { aspect-ratio: 3 / 2; }
  .off-visuel .off-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    transition: transform 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  /* La plaque : déborde sur le bas de la photo, posée par-dessus avec son ombre. */
  .off-plaque {
    position: relative;
    margin: -3.25rem 0.8rem 0;
    padding: 1.05rem 1.15rem 1.15rem;
    border-radius: var(--radius-card);
    background: var(--surface);
    border-bottom: 4px solid color-mix(in oklab, var(--accent-2) 70%, var(--fg));
    box-shadow: var(--off-ombre);
    transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
  }
  .off-nom {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.15;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.15s ease-out;
  }
  .off-grande .off-nom { font-size: clamp(1.3rem, 1.9vw, 1.6rem); }
  .off-court { margin-top: 0.45rem; font-size: 0.98rem; line-height: 1.45; color: var(--muted); }

  .off-lien:active .off-plaque { transform: translateY(1px); }
  .off-lien:focus-visible .off-nom { text-decoration-color: var(--accent); }
  @media (hover: hover) and (pointer: fine) {
    .off-lien:hover .off-plaque { transform: translateY(-4px); box-shadow: var(--off-ombre-haute); }
    .off-lien:hover .off-nom { text-decoration-color: var(--accent); }
    .off-lien:hover .off-img { transform: scale(1.03); }
  }

  /* Les plateaux : la planche de noyer, quelques parts posées dessus, vues d'un peu au-dessus. */
  .off-planche {
    --pla-tour: 0deg;
    position: absolute;
    inset: 12% 10% 26%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    justify-items: center;
    padding: 6% 7%;
    border-radius: var(--radius-card);
    background:
      repeating-linear-gradient(177deg, transparent 0 1.1rem, color-mix(in oklab, var(--ink) 16%, transparent) 1.1rem 1.18rem),
      linear-gradient(to bottom, var(--accent-2-text), color-mix(in oklab, var(--accent-2-text) 78%, var(--ink)));
    box-shadow:
      0 6px 0 color-mix(in oklab, var(--accent-2-text) 55%, var(--ink)),
      0 24px 30px -10px color-mix(in oklab, var(--ink) 80%, transparent);
    transform: perspective(700px) rotateX(28deg);
  }
  .off-visuel:has(.off-planche) { background: color-mix(in oklab, var(--bg-2) 70%, var(--accent-2)); }
  /* Le comptoir : l'étiquette de papier posée de biais sur le bois, les produits écrits dessus. */
  .off-visuel:has(.off-etiquette) {
    background:
      repeating-linear-gradient(92deg, transparent 0 2.2rem, color-mix(in oklab, var(--ink) 12%, transparent) 2.2rem 2.28rem),
      linear-gradient(to bottom, var(--accent-2-text), color-mix(in oklab, var(--accent-2-text) 72%, var(--ink)));
  }
  .off-etiquette {
    position: absolute;
    left: 14%;
    right: 14%;
    top: 12%;
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    border-radius: 2px;
    background: var(--surface);
    color: var(--fg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
    transform: rotate(-3deg);
    box-shadow: 0 14px 20px -8px color-mix(in oklab, var(--ink) 75%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .off-plaque, .off-visuel .off-img { transition: none; }
  }
</style>
