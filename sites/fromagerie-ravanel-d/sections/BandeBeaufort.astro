---
/** Bande pleine largeur : le beaufort sur sa planche, avant le bloc « Le plateau » dont la planche la chevauche. */
import { site } from '@/lib/site';
import Bande from './parts/Bande.astro';
const img = site.services.find((s) => s.slug === 'beaufort')?.image;
---

{img && (
  <section class="bde-sec">
    <Bande src={img.src} alt={img.alt} position="78% 55%" />
  </section>
)}

<script>
  import { onPage } from '@/scripts/page';
  import { initPlans } from './plans';
  onPage(initPlans);
</script>
