---
/**
 * Premier écran d’Encre Noire : le geste, en plein cadre (9 oct 2026).
 * La photo du dossier où l’artiste dessine dans son carnet (images.hero) couvre l’écran ; l’accroche
 * « Le dessin d’abord. L’aiguille ensuite. » est posée en bas à gauche, comme la légende d’une
 * planche, suivie d’une phrase qui dit qui, quoi, où, depuis quand, puis l’adresse et le téléphone.
 * Ni sous-titre marketing, ni bouton, ni trait qui se trace, ni invite à défiler. Le <em> de l’accroche
 * est retiré ici (titre d’un seul ton sur la photo ; `ff detect` lit un faux fond blanc sous l’em en
 * bloc encre). Marge basse large : le nom fixé en bas à gauche (Nav) ne recouvre pas les horaires. Avant : le nom du
 * studio en 20 vw sur fond noir, sans aucune image (et, depuis la coquille index, plus de hero du tout).
 */
import { site, tel } from '@/lib/site';
import Img from '@/components/Img.astro';

const hero = site.images.hero;
const artistes = site.about.team.map((t) => t.name).join(' et ');
const styles = site.services.map((s) => s.title.toLowerCase()).join(', ');
---

<section id="hero" class="relative flex min-h-svh flex-col justify-end overflow-hidden bg-ink text-on-ink">
  {hero && (
    <Img src={hero.src} alt={hero.alt} class="absolute inset-0 h-full w-full object-cover object-[48%_50%] md:object-[60%_40%]" sizes="100vw" loading="eager" fetchpriority="high" />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/45 to-ink/10" aria-hidden="true"></div>

  <div class="container-ff relative flex flex-col gap-8 pb-28 pt-40 md:gap-10 md:pb-24">
    <h1
      class="max-w-[12ch] font-display leading-[0.92]"
      style="font-size: clamp(2.75rem, 8.5vw, 7.5rem);"
      data-split
      set:html={site.business.tagline.replace(/<\/?em>/g, '')}
    />

    <p class="max-w-[36rem] text-lg leading-snug text-on-ink/85 sm:text-xl">
      {artistes}. {styles.charAt(0).toUpperCase() + styles.slice(1)}. Rue Gambetta, à Wazemmes, depuis {site.business.since}.
    </p>

    <p class="flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm text-on-ink/65">
      <span>{site.contact.address.street}, {site.contact.address.postalCode} {site.contact.address.city}</span>
      <a href={tel()} class="text-on-ink underline-offset-4 hover:underline">{site.contact.phoneDisplay}</a>
      {site.contact.hours.map((h) => <span>{h.days}, {h.hours}</span>)}
    </p>
  </div>
</section>

