---
/**
 * « Rendez-vous » : le temps fort de la page, un bloc encre. À gauche, la marche d’un
 * projet en trois lignes (acompte, dessin, séance) ; à droite, le téléphone, les heures et les soins
 * après la séance. Avant le 9 oct 2026 : trois étapes numérotées en escalier décalé, un numéro de
 * téléphone de 7 rem aimanté au curseur et trois surtitres. Ici tout tient sur un écran.
 */
import { site, tel } from '@/lib/site';

const marche = [
  'Vous écrivez ou vous appelez : la zone, la taille, les références que vous aimez.',
  'Un acompte réserve le créneau et le temps de dessin. Il est déduit du prix le jour de la séance.',
  'Le dessin vous est montré avant la séance. On le corrige ensemble ; rien n’est posé sans votre accord.',
  'La séance se fait en une fois, ou en plusieurs si la pièce est grande.',
];

const soins = [
  'Gardez le pansement posé par l’artiste jusqu’au temps indiqué.',
  'Lavez à l’eau tiède et au savon neutre, sans frotter.',
  'Hydratez avec une crème adaptée, sans excès.',
  'Pas de soleil direct, de piscine, de sauna ni de bain tant que la peau pèle.',
  'Ne grattez pas les croûtes : laissez-les tomber seules.',
];
---

<section id="rendezvous" class="section-y bg-ink text-on-ink">
  <div class="container-ff relative z-[1] grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <h2 class="font-display text-display-lg leading-none">{site.wording.devis}</h2>
      <p class="mt-6 max-w-[34rem] text-lg text-on-ink/80">Rien sans rendez-vous, et aucun motif à choisir sur place. Voilà comment ça se passe.</p>
      <ol class="mt-10 max-w-[36rem] space-y-4 text-on-ink/85">
        {marche.map((m, i) => (
          <li class="flex gap-4">
            <span class="shrink-0 pt-px font-mono text-sm tabular-nums text-on-ink">{i + 1}.</span>
            <span>{m}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="lg:col-span-5 lg:pt-4">
      <a href={tel()} class="block font-display leading-none text-on-ink underline-offset-8 hover:underline" style="font-size: clamp(2rem, 4.5vw, 3.5rem);">
        {site.contact.phoneDisplay}
      </a>
      <p class="mt-3 text-on-ink/70">{site.contact.hours.map((h) => `${h.days}, ${h.hours}`).join(' ; ')}. {site.contact.address.street}, {site.contact.address.city}.</p>

      <h3 class="mt-12 font-display text-2xl">Après la séance</h3>
      <ul class="mt-4 space-y-3 text-on-ink/75">
        {soins.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </div>
</section>
