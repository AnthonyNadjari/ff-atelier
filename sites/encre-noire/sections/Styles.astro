---
/**
 * « Styles » : quatre panneaux, un par style, texte + image. Le data-horizontal d'origine (piste
 * défilant sur la molette, un panneau plein écran par style) a été retiré le 21 sept 2026 : le bloc
 * vit désormais sous une entrée <details> de la coquille `index`, et un effet piloté par le scroll
 * se calcule sur un panneau fermé (comme anna-vidal/sections/Series.astro). Grille à deux colonnes
 * sur desktop, pile verticale sur mobile ; les images suivent le data-reveal générique de motion.ts.
 */
import { site } from '@/lib/site';
const styles = site.services;
---

<section id="styles" class="relative overflow-hidden bg-bg section-y">
  <div class="container-ff grid gap-16 lg:grid-cols-2 lg:gap-x-14 lg:gap-y-20" data-stagger="120">
    {styles.map((s, i) => (
      <article class="style-panel flex flex-col gap-8 sm:flex-row sm:items-center sm:gap-10">
        <div class="max-w-xl">
          <p class="eyebrow">{String(i + 1).padStart(2, '0')} / {String(styles.length).padStart(2, '0')}</p>
          <h2 class="mt-4 font-display uppercase leading-[0.85]" style="font-size: clamp(2.25rem, 5vw, 4rem);">{s.title}</h2>
          <p class="mt-6 max-w-md text-lg text-muted">{s.description}</p>
        </div>
        {s.image && (
          <figure class="aspect-[4/5] w-full overflow-hidden sm:w-56 sm:shrink-0" data-reveal="mask">
            <img src={s.image.src} alt={s.image.alt} class="h-full w-full object-cover" loading="lazy" />
          </figure>
        )}
      </article>
    ))}
  </div>
</section>

