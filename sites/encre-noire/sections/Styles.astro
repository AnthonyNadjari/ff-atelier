---
/**
 * « Styles » : les quatre styles du studio (site.services), chacun avec sa photo en 4:5, son titre
 * en Bodoni et deux paragraphes. Deux colonnes sur desktop, pile sur mobile. Le titre est un lien
 * vers la page du style. Sans numérotation « 01 / 04 » ni surtitre (9 oct 2026) : quatre mots suffisent.
 */
import { site, paragraphs } from '@/lib/site';
import Img from '@/components/Img.astro';
const styles = site.services;
---

<section id="styles" class="section-y bg-bg">
  <div class="container-ff">
    <div class="md:flex md:items-baseline md:gap-10">
      <h2 class="font-display text-display-lg leading-none">Quatre styles</h2>
      <p class="mt-4 max-w-md text-muted md:mt-0">Et rien au-delà. Si votre projet n’entre dans aucun des quatre, on vous dira à qui vous adresser.</p>
    </div>

    <ul class="mt-14 grid gap-x-10 gap-y-16 md:grid-cols-2" data-stagger="110">
      {styles.map((s) => (
        <li class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
          {s.image && (
            <a href={`/services/${s.slug}`} class="block w-full overflow-hidden sm:w-52 sm:shrink-0" tabindex="-1" aria-hidden="true">
              <Img src={s.image.src} alt="" class="aspect-[4/5] w-full object-cover" sizes="(min-width: 640px) 208px, 100vw" loading="lazy" />
            </a>
          )}
          <div class="min-w-0">
            <h3 class="font-display text-display-md leading-none">
              <a href={`/services/${s.slug}`} class="hover:text-accent-2">{s.title}</a>
            </h3>
            <div class="mt-4 max-w-[32rem] space-y-3 text-muted">
              {paragraphs(s.description ?? s.short).map((p) => <p>{p}</p>)}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
