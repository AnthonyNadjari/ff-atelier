---
/**
 * Premier écran d'Alain Ballay, famille `mosaique` (premiers-ecrans.md ; direction.md, PREMIER ÉCRAN). Un calepinage :
 * ses quinze photos de chantier posées comme des carreaux, joints clairs, qui remplissent l'écran ; le texte est
 * fait de carreaux du même calepinage, jamais posé sur une photo : le titre (carreau terre cuite, en haut), le
 * numéro (carreau encre, toute la largeur), la note Google (carreau bleu de la porte de sa terrasse), l'ancienneté
 * (carreau de chaux). Chaque photo est une porte vers la page du travail qu'elle montre.
 * Socle (GOUT § 0) : h1 « Maçon carreleur à Perpignan », numéro et « Estimation gratuite » sans défiler, 5,0 sur
 * Google (5 avis), « depuis septembre 2000 » en texte, monuments historiques, ses photos seulement.
 * Calepinage : téléphone 4 colonnes (11 rangs, les 8 premiers à l'écran), ordinateur 8 colonnes sur 5 rangs qui
 * tiennent l'écran. Coordonnées « rang / colonne / rang fin / colonne fin » : m = téléphone, d = ordinateur.
 * Images : mos-<photo> (images-derivees.cjs), 340 px, la taille affichée ; le barbecue garde ses largeurs.
 * Mouvement (direction.md, client calme) : les carreaux de texte sont là d'emblée ; les carreaux-photos se posent
 * dans l'ordre de pose, rang par rang depuis le coin (6 px, 0,45 s, ease-out sans rebond, 30 ms d'écart) ; la photo
 * du barbecue recule une fois de 1,04 à 1. Rien ne suit le défilement. Mouvement réduit : rien.
 */
import { site, tel, mailto } from '@/lib/site';
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';
import { PHOTOS, type NomPhoto, lienTravail, derivee } from './photos';

// Travail montré par chaque photo (PAR_TRAVAIL de photos.ts ; la chape et la terrasse en cours d'après leur alt).
const TRAVAIL: Record<NomPhoto, string> = {
  'accueil-01': 'carrelage', 'realisation-01': 'cuisines-d-ete', 'realisation-06': 'maconnerie', 'realisation-12': 'carrelage',
  'realisation-18': 'maconnerie', 'realisation-24': 'maconnerie', 'realisation-30': 'carrelage', 'realisation-36': 'carrelage',
  'realisation-42': 'carrelage', 'realisation-48': 'parement', 'realisation-54': 'carrelage', 'realisation-60': 'cuisines-d-ete',
  'realisation-66': 'maconnerie', 'realisation-72': 'carrelage', 'realisation-78': 'parement',
};
type Case = { nom: NomPhoto; m: string; d: string };
// Ordre = ordre de pose (rang par rang, depuis le coin haut gauche, au téléphone).
const PHOTOS_MOS: Case[] = [
  { nom: 'realisation-36', m: '1/4/2/5', d: '1/1/3/2' },
  { nom: 'realisation-48', m: '2/4/3/5', d: '1/5/2/6' },
  { nom: 'realisation-01', m: '3/1/5/4', d: '1/6/3/8' },
  { nom: 'realisation-78', m: '3/4/5/5', d: '1/8/3/9' },
  { nom: 'realisation-72', m: '6/1/8/2', d: '2/5/4/6' },
  { nom: 'realisation-66', m: '6/4/8/5', d: '3/1/5/2' },
  { nom: 'realisation-30', m: '8/1/10/2', d: '3/8/5/9' },
  { nom: 'realisation-24', m: '8/4/10/5', d: '4/6/6/7' },
  { nom: 'realisation-60', m: '9/2/10/3', d: '4/2/5/3' },
  { nom: 'realisation-54', m: '9/3/10/4', d: '4/5/6/6' },
  { nom: 'realisation-06', m: '10/1/11/2', d: '5/1/6/2' },
  { nom: 'realisation-12', m: '10/2/11/3', d: '5/2/6/3' },
  { nom: 'realisation-42', m: '10/3/11/4', d: '5/7/6/8' },
  { nom: 'realisation-18', m: '10/4/11/5', d: '5/8/6/9' },
  { nom: 'accueil-01', m: '11/1/12/2', d: '4/7/5/8' },
];
// Carreaux en hauteur (1:2) ; les autres sont carrés (images-derivees.cjs, MOS_HAUT / MOS_CARRE). Une seule
// largeur (340 px, la taille affichée) : un <picture> léger, sans aperçu flou (le joint encre le remplace).
const HAUT = new Set<NomPhoto>(['realisation-36', 'realisation-78', 'realisation-72', 'realisation-66', 'realisation-30', 'realisation-54', 'realisation-24']);
const titre = (slug: string) => site.services.find((s) => s.slug === slug)?.title ?? '';
const g = site.proof.google;
const estimation = mailto() ? `${mailto()}?subject=${encodeURIComponent('Demande d’estimation')}` : '#contact';
---

<section id="hero" class="mos" aria-labelledby="mos-titre">
  <div class="mos-grille">
    <div class="mos-c mos-titre-c" style="--m:1/1/3/4;--d:1/2/3/5">
      <h1 id="mos-titre" class="mos-titre">{site.business.tagline}</h1>
    </div>

    <div class="mos-c mos-tel-c" style="--m:5/1/6/5;--d:3/2/4/5" data-mos-tel>
      <a href={tel()} class="mos-tel" aria-label={`Appeler Alain Ballay au ${site.contact.phoneDisplay}`}>
        <Icon name="Phone" size={24} />
        <span>{site.contact.phoneDisplay}</span>
      </a>
      <p class="mos-tel-bas">
        <a href={estimation} class="mos-estim">Estimation gratuite</a>
        <span class="mos-heures">Lundi au vendredi, 8 h à 18 h</span>
      </p>
    </div>

    {g && (
      <a href="#avis" class="mos-c mos-note-c" style="--m:6/2/7/4;--d:3/6/4/8">
        <span class="mos-note-chiffre">{g.rating.toFixed(1).replace('.', ',')}<span class="sr-only"> sur 5</span></span>
        <span class="mos-note-txt">
          <span class="mos-etoiles" aria-hidden="true">★★★★★</span>
          <span>sur Google,</span>
          <span>{g.count} avis</span>
        </span>
      </a>
    )}

    <div class="mos-c mos-depuis-c" style="--m:7/2/9/4;--d:4/3/6/5">
      <p class="mos-depuis"><strong>À son compte depuis septembre {site.business.since}.</strong></p>
      <p class="mos-depuis-2">Ancien maître ouvrier dans les monuments historiques. La maçonnerie et le carrelage, par la même entreprise.</p>
    </div>

    {PHOTOS_MOS.map((c, i) => {
      const ph = PHOTOS[c.nom];
      const bbq = c.nom === 'realisation-01';
      return (
        <a
          href={lienTravail(TRAVAIL[c.nom])}
          class:list={['mos-c', 'mos-ph', bbq && 'is-bbq']}
          style={`--m:${c.m};--d:${c.d};--i:${i}`}
          aria-label={`${titre(TRAVAIL[c.nom])} : ${ph.alt}`}
        >
          {bbq ? (
            <Img src={ph.src} alt="" class="mos-img" sizes="(min-width: 48rem) 25vw, 75vw" priority />
          ) : (
            <picture>
              <source type="image/avif" srcset={derivee('mos', c.nom).replace('.webp', '.avif')} />
              <img src={derivee('mos', c.nom)} alt="" class="mos-img" width="340" height={HAUT.has(c.nom) ? 680 : 340} loading={i < 6 ? 'eager' : 'lazy'} decoding="async" />
            </picture>
          )}
          <span class="mos-legende" aria-hidden="true">{titre(TRAVAIL[c.nom])}</span>
        </a>
      );
    })}

    <a href={estimation} class="mos-c mos-estim-c" style="--m:11/2/12/5;--d:1/1/1/1">
      <Icon name="Mail" size={20} />
      <span>Écrire pour une estimation gratuite</span>
    </a>
  </div>
</section>

<style is:global>
  .mos {
    --mos-joint: 3px;
    --mos-cote: calc((100vw - 5 * var(--mos-joint)) / 4);
    background: color-mix(in oklab, var(--line) 70%, var(--surface));
  }
  .mos-grille {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: var(--mos-cote);
    gap: var(--mos-joint);
    padding: var(--mos-joint);
  }
  .mos-c { grid-area: var(--m); position: relative; min-width: 0; overflow: hidden; }

  /* Carreaux de texte : à plat, la couleur d'un matériau. */
  .mos-titre-c { display: flex; align-items: flex-end; padding: 0.8rem 0.85rem 0.85rem; background: var(--accent); color: var(--on-accent); }
  .mos-titre { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.05rem, 9.4vw, 2.45rem); line-height: 0.95; letter-spacing: -0.015em; }
  .mos-tel-c { display: flex; flex-direction: column; justify-content: center; gap: 0.35rem; padding: 0.6rem 0.85rem; background: var(--ink); color: var(--on-ink); }
  .mos-tel { display: inline-flex; align-items: center; gap: 0.55rem; align-self: flex-start; color: var(--on-ink); text-decoration: none; font-family: var(--font-display); font-weight: 800; font-size: clamp(1.75rem, 8.4vw, 2.15rem); line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .mos-tel-bas { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.15rem 0.9rem; font-size: 0.86rem; }
  .mos-estim { color: var(--on-ink); font-weight: 700; text-decoration: underline; text-decoration-color: color-mix(in oklab, var(--accent) 70%, var(--on-ink)); text-decoration-thickness: 2px; text-underline-offset: 0.25em; }
  .mos-heures { color: color-mix(in oklab, var(--on-ink) 76%, transparent); }
  .mos-note-c { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.75rem; background: var(--accent-2); color: var(--on-accent); text-decoration: none; }
  .mos-note-chiffre { font-family: var(--font-display); font-weight: 800; font-size: 2.3rem; line-height: 1; }
  .mos-note-txt { display: flex; flex-direction: column; gap: 0.1rem; font-size: 0.8rem; line-height: 1.2; }
  .mos-etoiles { letter-spacing: 0.08em; font-size: 0.95rem; line-height: 1; }
  .mos-depuis-c { display: flex; flex-direction: column; justify-content: flex-end; gap: 0.45rem; padding: 0.8rem; background: var(--surface); color: var(--fg); }
  .mos-depuis { font-family: var(--font-display); font-size: 1.02rem; line-height: 1.12; }
  .mos-depuis strong { font-weight: 800; }
  .mos-depuis-2 { font-size: 0.82rem; line-height: 1.35; color: var(--muted); }
  .mos-estim-c { display: flex; align-items: center; gap: 0.6rem; padding: 0 1rem; background: var(--bg-2); color: var(--fg); font-weight: 700; font-size: 0.95rem; line-height: 1.2; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.25em; }

  /* Carreaux-photos : une porte chacun. */
  .mos-ph { display: block; background: var(--ink); animation: mos-pose 0.45s ease-out calc(0.1s + var(--i) * 30ms) both; }
  .mos-ph picture { display: contents; }
  .mos-img { width: 100%; height: 100%; object-fit: cover; }
  .mos-ph.is-bbq .mos-img { animation: mos-recul 1.2s ease-out both; }
  @keyframes mos-pose { from { opacity: 0; transform: translate3d(0, 6px, 0); } to { opacity: 1; transform: none; } }
  @keyframes mos-recul { from { transform: scale(1.04); } to { transform: none; } }
  .mos-legende {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.35rem 0.5rem;
    background: var(--ink);
    color: var(--on-ink);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.2;
    transform: translateY(101%);
    transition: transform 0.15s ease-out;
  }
  .mos-ph:focus-visible .mos-legende { transform: none; }
  @media (hover: hover) and (pointer: fine) {
    .mos-ph:hover .mos-legende { transform: none; }
    .mos-tel:hover, .mos-estim:hover { color: color-mix(in oklab, var(--accent) 35%, var(--on-ink)); }
    .mos-estim-c:hover, .mos-note-c:hover { filter: brightness(1.06); }
  }
  .mos-ph:active { filter: brightness(0.92); }

  /* Ordinateur et tablette : 8 colonnes, 5 rangs qui tiennent l'écran sous la barre du haut. */
  @media (min-width: 48rem) {
    .mos { --mos-joint: 4px; }
    .mos-grille {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-auto-rows: clamp(7rem, calc((100svh - 4.4rem - 6 * var(--mos-joint)) / 5), 15rem);
    }
    .mos-c { grid-area: var(--d); }
    .mos-estim-c { display: none; }
    .mos-titre-c { padding: 1.4rem 1.6rem 1.5rem; }
    .mos-titre { font-size: clamp(2.6rem, 4.4vw, 4.6rem); max-width: 9ch; }
    .mos-tel-c { padding: 1rem 1.6rem; gap: 0.6rem; }
    .mos-tel { font-size: clamp(2rem, 3.3vw, 3.3rem); }
    .mos-tel-bas { font-size: 1rem; }
    .mos-note-c { padding: 1rem 1.4rem; gap: 1rem; }
    .mos-note-chiffre { font-size: clamp(2.6rem, 4vw, 4rem); }
    .mos-note-txt { font-size: 0.98rem; }
    .mos-etoiles { font-size: 1.15rem; }
    .mos-depuis-c { padding: 1.3rem 1.4rem; gap: 0.7rem; }
    .mos-depuis { font-size: clamp(1.2rem, 1.7vw, 1.7rem); }
    .mos-depuis-2 { font-size: 0.98rem; }
    .mos-legende { font-size: 0.86rem; padding: 0.45rem 0.65rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mos-ph, .mos-ph.is-bbq .mos-img { animation: none; }
  }
</style>
