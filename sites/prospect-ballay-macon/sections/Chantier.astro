---
/**
 * Premier écran d'Alain Ballay : sa meilleure photo, la seule en largeur (barbecue maçonné en pierre, 4 032 px),
 * en plein cadre ; une carte posée dessus, avec la tranche terre cuite d'un carreau (bord gauche épais) et une
 * ombre portée. Le texte est sur la carte, jamais sur la photo.
 * Socle (GOUT § 0) : métier + ville dans le h1, « depuis septembre 2000 » en texte, monuments historiques dès la
 * phrase, le numéro en très grand, « Estimation gratuite », la note Google réelle (5,0, 5 avis), quatre portes.
 * Mouvement (direction.md, client calme) : la carte se pose (10 px, 0,6 s, ease-out sans rebond) et la photo
 * recule de 1,04 à 1 une seule fois (1,2 s). Rien ne suit le défilement. Mouvement réduit : rien.
 */
import { site, tel } from '@/lib/site';
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';
import { PORTE, lienTravail } from './photos';

const hero = site.images.hero;
const g = site.proof.google;
const portes = ['carrelage', 'cuisines-d-ete', 'parement'];
---

<section id="hero" class="cha" aria-labelledby="cha-titre">
  {hero && (
    <div class="cha-photo">
      <Img src={hero.src} alt={hero.alt} class="cha-img" sizes="100vw" priority />
    </div>
  )}
  <div class="cha-carte">
    <h1 id="cha-titre" class="cha-titre">{site.business.tagline}</h1>
    <p class="cha-phrase">
      Alain Ballay, à son compte depuis septembre {site.business.since}. Ancien maître ouvrier dans les monuments
      historiques.
    </p>
    <a href={tel()} class="cha-tel" aria-label={`Appeler Alain Ballay au ${site.contact.phoneDisplay}`}>
      <Icon name="Phone" size={26} />
      <span>{site.contact.phoneDisplay}</span>
    </a>
    <p class="cha-gratuit"><strong>Estimation gratuite.</strong> Du lundi au vendredi, 8 h à 18 h.</p>
    {g && (
      <a href="#avis" class="cha-note">
        <span class="cha-etoiles" aria-hidden="true">★★★★★</span>
        <span><strong>{g.rating.toFixed(1).replace('.', ',')}</strong> sur Google, {g.count} avis</span>
      </a>
    )}
    <ul class="cha-portes" aria-label="Vos travaux">
      {portes.map((s) => <li><a href={lienTravail(s)} class="cha-porte">{PORTE[s]}</a></li>)}
      <li><a href="#travaux" class="cha-porte is-texte">Tous les travaux</a></li>
    </ul>
  </div>
</section>

<style is:global>
  .cha {
    --cha-ombre:
      0 1px 0 color-mix(in oklab, var(--ink) 12%, transparent),
      0 4px 8px -2px color-mix(in oklab, var(--ink) 24%, transparent),
      0 26px 50px -16px color-mix(in oklab, var(--ink) 50%, transparent),
      0 70px 120px -40px color-mix(in oklab, var(--ink) 55%, transparent);
    position: relative;
    z-index: 2;
    display: grid;
  }
  .cha-photo { grid-area: 1 / 1; height: clamp(17rem, 46svh, 26rem); overflow: hidden; background: var(--ink); }
  .cha-photo picture { display: contents; }
  .cha-img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; animation: cha-recul 1.2s ease-out both; }
  @keyframes cha-recul { from { transform: scale(1.04); } to { transform: none; } }

  .cha-carte {
    grid-area: 1 / 1 / span 2 / 1;
    align-self: start;
    position: relative;
    z-index: 1;
    margin: calc(clamp(17rem, 46svh, 26rem) - 3rem) 0.6rem 0;
    padding: 1.4rem 1.2rem 1.3rem 1.35rem;
    background: var(--surface);
    border-left: 0.6rem solid var(--accent);
    border-radius: 2px;
    box-shadow: var(--cha-ombre);
    animation: cha-pose 0.6s ease-out 0.15s both;
  }
  @keyframes cha-pose { from { opacity: 0; transform: translate3d(0, -10px, 0); } to { opacity: 1; transform: none; } }
  @media (max-width: 63.99rem) and (max-height: 700px) {
    .cha-photo { height: 13rem; }
    .cha-carte { margin-top: 10.5rem; }
  }

  .cha-titre { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.2rem, 10vw, 2.8rem); line-height: 0.98; letter-spacing: -0.01em; color: var(--fg); max-width: 12ch; }
  .cha-phrase { margin-top: 0.7rem; font-size: 1.02rem; line-height: 1.45; color: var(--muted); max-width: 32rem; }
  .cha-tel {
    margin-top: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.05rem, 3.8vw, 3.1rem);
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: color 0.15s ease-out;
  }
  .cha-tel:active { color: var(--fg); }
  .cha-gratuit { margin-top: 0.45rem; font-size: 0.98rem; color: var(--muted); }
  .cha-gratuit strong { color: var(--fg); font-weight: 700; }
  .cha-note { margin-top: 0.7rem; display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.98rem; color: var(--fg); text-decoration: none; }
  .cha-etoiles { color: var(--accent); letter-spacing: 0.08em; font-size: 1.05rem; line-height: 1; }
  .cha-portes { margin-top: 0.9rem; padding-top: 0.85rem; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; }
  .cha-porte {
    display: inline-block;
    padding: 0.6rem 0.8rem;
    background: var(--bg-2);
    border-radius: 2px;
    color: var(--fg);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: inset 0 -2px 0 color-mix(in oklab, var(--accent) 55%, var(--bg-2));
    transition: background-color 0.15s ease-out;
  }
  .cha-porte.is-texte { background: none; box-shadow: none; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  .cha-porte:active { background: var(--line); }
  @media (hover: hover) and (pointer: fine) {
    .cha-tel:hover { color: var(--fg); }
    .cha-porte:hover { background: var(--line); }
  }

  @media (min-width: 64rem) {
    .cha-photo { height: calc(100svh - 4.4rem); min-height: 38rem; max-height: 60rem; }
    .cha-carte {
      grid-area: 1 / 1;
      align-self: end;
      justify-self: start;
      width: min(100% - 6rem, 36rem);
      margin: 0 0 -4rem clamp(2rem, 5vw, 5rem);
      padding: 2rem 2.3rem 1.8rem 2.4rem;
      border-left-width: 0.8rem;
    }
    .cha-titre { font-size: clamp(3rem, 4.2vw, 4rem); }
  }
  @media (min-width: 64rem) and (max-height: 860px) {
    .cha-carte { padding-block: 1.5rem 1.4rem; margin-bottom: -3rem; }
    .cha-titre { font-size: clamp(2.6rem, 3.6vw, 3.3rem); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cha-img, .cha-carte { animation: none; }
  }
</style>
