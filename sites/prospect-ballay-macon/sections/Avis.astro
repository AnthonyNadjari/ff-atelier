---
/**
 * Les avis, juste sous la mosaïque (GOUT § 0, point 4). Note et nombre réels (5,0, 5 avis), et les deux avis
 * recopiés mot pour mot (brief § 7) : Julien D. ; Nonam Tattoo, nom du compte tel que Google l'affiche (un commerce,
 * pas une personne). L'avis de MARI Electricité, replié par Google, reste dehors (brief : à relire avant usage).
 * Après le calepinage serré du premier écran, une respiration : pas de carreaux ici, deux avis en grand sur la
 * chaux, séparés par un trait de joint terre cuite. Aucun mouvement.
 */
import { site } from '@/lib/site';
const g = site.proof.google;
const avis = site.proof.testimonials;
---

{g && (
  <section id="avis" class="mav" aria-labelledby="mav-titre">
    <div class="mav-in">
      <div class="mav-tete">
        <h2 id="mav-titre" class="mav-titre">Ce que disent ses clients</h2>
        <p class="mav-note">
          <strong>{g.rating.toFixed(1).replace('.', ',')} sur 5</strong> sur Google, {g.count} avis.
          <a href={g.url} class="mav-lien" target="_blank" rel="noopener">Lire les avis sur Google</a>
        </p>
      </div>
      <div class="mav-liste">
        {avis.map((a) => (
          <figure class="mav-avis">
            <blockquote class="mav-texte">« {a.text} »</blockquote>
            <figcaption class="mav-auteur"><strong>{a.author}</strong>, {a.source.replace(/^Avis/, 'avis')}{a.date && `, ${a.date}`}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style is:global>
  .mav { background: var(--bg); padding: clamp(3rem, 8vw, 6.5rem) 0 clamp(3rem, 7vw, 6rem); }
  .mav-in { width: min(100% - 2rem, 76rem); margin-inline: auto; }
  .mav-tete { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.6rem 2rem; }
  .mav-titre { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.9rem, 5vw, 2.8rem); line-height: 1.02; }
  .mav-note { font-size: 1rem; color: var(--muted); }
  .mav-note strong { color: var(--fg); font-weight: 700; }
  .mav-lien { margin-left: 0.3rem; color: var(--fg); font-weight: 700; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  .mav-liste { margin-top: clamp(1.6rem, 4vw, 3rem); display: grid; gap: 2rem; }
  .mav-avis { margin: 0; padding-left: 1.1rem; border-left: 4px solid var(--accent); }
  .mav-texte { font-size: clamp(1.2rem, 3.6vw, 1.65rem); line-height: 1.38; color: var(--fg); max-width: 34ch; }
  .mav-auteur { margin-top: 0.8rem; font-size: 0.92rem; color: var(--muted); }
  .mav-auteur strong { color: var(--fg); font-weight: 700; }
  @media (hover: hover) and (pointer: fine) {
    .mav-lien:hover { color: var(--accent); }
  }
  @media (min-width: 64rem) {
    .mav-in { width: min(100% - 10rem, 76rem); }
    .mav-liste { grid-template-columns: 1fr 1fr; gap: 4rem; }
    .mav-avis { padding-left: 1.6rem; }
  }
</style>
