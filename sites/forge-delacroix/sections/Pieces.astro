---
/**
 * « Pièces » : collage asymétrique sur 12 colonnes, une grande image et des petites, chacune à sa
 * hauteur. Légende sous la photo, en texte simple (ce que c'est, où c'est), plus de pastille floutée
 * posée sur l'image ni d'inclinaison au survol (9 oct 2026) : les photos se regardent comme des
 * tirages. Rien de commun avec la galerie partagée.
 */
const pieces = [
  { src: '/images/galerie-1.webp', alt: 'Portail à deux battants, volutes forgées', legende: 'Portail à deux battants', lieu: 'Balma', span: 'md:col-span-7 md:row-span-2', ratio: 'aspect-[4/5]' },
  { src: '/images/galerie-2.webp', alt: 'Garde-corps en plat d’acier, motif de vagues', legende: 'Garde-corps de fenêtre', lieu: 'Toulouse, quartier Saint-Cyprien', span: 'md:col-span-5', ratio: 'aspect-[4/3]' },
  { src: '/images/galerie-3.webp', alt: 'Escalier hélicoïdal, marches chêne', legende: 'Rampe d’escalier hélicoïdal', lieu: 'Colomiers', span: 'md:col-span-5', ratio: 'aspect-square' },
  { src: '/images/galerie-4.webp', alt: 'Table basse en fer forgé, plateau de marbre', legende: 'Console, plateau de marbre', lieu: 'Pièce d’atelier', span: 'md:col-span-4 md:col-start-2', ratio: 'aspect-[3/4]' },
  { src: '/images/galerie-5.webp', alt: 'Grille de fenêtre en fer forgé, volutes et jardinière', legende: 'Grille de fenêtre et jardinière', lieu: 'Toulouse', span: 'md:col-span-7', ratio: 'aspect-[16/9]' },
];
---

<section id="pieces" class="section-y bg-bg-2 overflow-hidden">
  <div class="container-ff">
    <div class="md:flex md:items-baseline md:gap-10">
      <h2 class="font-display text-display-xl leading-none">Pièces</h2>
      <p class="mt-4 max-w-md text-muted md:mt-0">Quelques réalisations. Chacune a été dessinée pour un lieu, aucune n’existe en deux exemplaires.</p>
    </div>
    <ul class="mt-14 grid grid-cols-1 gap-x-6 gap-y-10 md:grid-cols-12" data-stagger="130">
      {pieces.map((p) => (
        <li class:list={['relative', p.span]}>
          <figure class="group">
            <div class="overflow-hidden rounded-card">
              <img src={p.src} alt={p.alt} class:list={['w-full object-cover transition-transform duration-[1.4s] ease-out-expo group-hover:scale-[1.03]', p.ratio]} loading="lazy" />
            </div>
            <figcaption class="mt-3 flex flex-wrap justify-between gap-x-6 gap-y-1 text-sm">
              <span class="text-fg">{p.legende}</span>
              <span class="text-muted">{p.lieu}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
