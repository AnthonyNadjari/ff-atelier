---
/**
 * « Le feu en quatre temps » : bande horizontale de quatre étapes séparées par des filets
 * verticaux, gros numéros en accent, températures en marge. Composition propre à ce site.
 */
const temps = [
  { n: '01', titre: 'Le dessin', texte: 'Relevé sur place, puis dessin à l’échelle. Rien ne chauffe avant votre signature sur le plan.', note: 'à l’atelier' },
  { n: '02', titre: 'La chauffe', texte: 'L’acier passe au rouge cerise dans la forge à charbon. C’est là qu’il accepte la forme.', note: '≈ 1 000 °C' },
  { n: '03', titre: 'Le marteau', texte: 'Volutes, torsades, écrasements : chaque motif est frappé à la main, pièce après pièce.', note: 'marteau et presse' },
  { n: '04', titre: 'La pose', texte: 'Galvanisation ou patine, puis pose par nos soins. On revient régler si besoin.', note: 'chez vous' },
];
---

<section id="feu" class="section-y bg-bg">
  <div class="container-ff">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="font-display text-display-lg leading-none">Le feu en <em class="text-accent not-italic">quatre temps</em></h2>
      <p class="max-w-sm text-muted" data-text-fill>Comment une pièce naît ici, du papier au fer posé. Quatre temps, toujours dans cet ordre.</p>
    </div>
    <ol class="mt-16 grid gap-px bg-line md:grid-cols-4" data-stagger="150">
      {temps.map((t) => (
        <li class="group relative bg-bg p-8 md:p-10 md:min-h-[22rem] flex flex-col">
          <span class="font-display text-7xl leading-none text-accent">{t.n}</span>
          <h3 class="mt-8 font-display text-3xl">{t.titre}</h3>
          <p class="mt-4 text-muted">{t.texte}</p>
          <span class="mt-auto pt-8 font-mono text-xs uppercase tracking-[0.2em] text-muted/70">{t.note}</span>
          <span class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-accent transition-transform duration-700 ease-out-expo group-hover:scale-x-100"></span>
        </li>
      ))}
    </ol>
  </div>
</section>
