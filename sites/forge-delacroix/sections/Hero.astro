---
/**
 * Premier écran « l'image d'abord » — propre à Forge Delacroix.
 * Idée : ne rien écrire sur la photo. L'écran s'ouvre sur le fer chaud, plein cadre, sans voile ni
 * texte superposé ; le titre arrive dessous, sur l'encre nue, comme la légende d'une planche.
 * Ni eyebrow, ni sous-titre, ni bouton, ni bande défilante : la photo pose, le titre répond.
 */
import { site, tel } from '@/lib/site';

const hero = site.images.hero;
---

<section id="hero" class="bg-ink text-on-ink">
  <div class="relative h-[42svh] min-h-[14rem] w-full overflow-hidden md:h-[46svh]">
    {hero && (
      <img
        src={hero.src}
        alt={hero.alt}
        class="h-full w-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
    )}
  </div>

  <div class="container-ff flex min-h-[46svh] flex-col justify-between gap-10 pb-12 pt-10 md:pb-16" data-grain>
    <h1
      class="font-display leading-[0.84]"
      style="font-size: clamp(3rem, 12vw, 11rem);"
      data-split
      set:html={site.business.tagline}
    />

    <p class="flex flex-wrap items-baseline gap-x-6 gap-y-1 font-mono text-xs uppercase tracking-[0.18em] text-on-ink/65">
      <span>{site.contact.address.street}, {site.contact.address.city}</span>
      <a href={tel()} class="normal-case tracking-normal text-on-ink underline-offset-4 hover:underline">
        {site.contact.phoneDisplay}
      </a>
    </p>
  </div>
</section>
