---
/**
 * « Séries » — propre à ce site. Six photos de formats et de hauteurs différents, comme posées
 * sur une table. Bande horizontale au défilement sur desktop (data-horizontal + .h-track),
 * colonne verticale à alignement alterné sur mobile. Aucune réutilisation ailleurs.
 */
const photos = [
  { src: '/images/galerie-1.webp', alt: 'Les mains, avant la cérémonie', caption: 'Les mains, avant', ratio: 'aspect-[3/4]', w: 'md:w-[26vw]', offset: '', align: 'max-md:mr-[8%]' },
  { src: '/images/galerie-2.webp', alt: 'La robe dans l’escalier', caption: 'La robe, dans l’escalier', ratio: 'aspect-square', w: 'md:w-[30vw]', offset: 'md:mt-20', align: 'max-md:ml-[10%]' },
  { src: '/images/galerie-3.webp', alt: 'Le cortège, à pied', caption: 'Le cortège, à pied', ratio: 'aspect-[4/5]', w: 'md:w-[22vw]', offset: 'md:-mt-10', align: 'max-md:mr-[6%]' },
  { src: '/images/galerie-4.webp', alt: 'La table, au soleil couchant', caption: 'La table, au couchant', ratio: 'aspect-[16/10]', w: 'md:w-[34vw]', offset: 'md:mt-24', align: 'max-md:ml-[4%]' },
  { src: '/images/galerie-5.webp', alt: 'Le premier regard', caption: 'Le premier regard', ratio: 'aspect-[2/3]', w: 'md:w-[20vw]', offset: 'md:mt-4', align: 'max-md:mr-[12%]' },
  { src: '/images/galerie-6.webp', alt: 'La nuit, sur la piste', caption: 'La nuit, sur la piste', ratio: 'aspect-[5/4]', w: 'md:w-[30vw]', offset: 'md:-mt-16', align: 'max-md:ml-[6%]' },
];
---

<section id="series" class="section-y overflow-hidden">
  <div class="container-ff">
    <div class="max-w-xl">
      <p class="eyebrow">Séries</p>
      <h2 class="mt-4 text-display-md">Ce qui reste, une fois la journée passée</h2>
    </div>
  </div>

  <div class="relative mt-14 md:mt-20" data-horizontal>
    <ul class="h-track flex flex-col gap-16 px-6 md:flex-row md:items-start md:gap-12 md:px-[8vw]">
      {photos.map((p) => (
        <li class:list={['shrink-0 max-md:max-w-[82%]', p.align, p.w, p.offset]}>
          <figure data-reveal="scale">
            <div class="overflow-hidden rounded-card shadow-card" data-tilt="4">
              <img src={p.src} alt={p.alt} class:list={['w-full object-cover', p.ratio]} loading="lazy" />
            </div>
            <figcaption class="mt-3 font-mono text-xs uppercase tracking-[0.2em] text-muted">{p.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
