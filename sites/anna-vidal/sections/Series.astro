---
/**
 * « Galerie » (id `series`) — propre à ce site. Six photos de formats et de hauteurs différents,
 * comme posées sur une table : grille de trois colonnes aux décalages alternés sur desktop, colonne
 * à alignement alterné sur mobile. Un seul groupe animé (data-stagger sur la liste). Le
 * data-horizontal d'origine a été retiré le 21 sept 2026 : le bloc vit désormais sous une entrée
 * <details> de la coquille `index`, et un effet piloté par le scroll se calcule sur un panneau
 * fermé. Aucune réutilisation ailleurs.
 */
const photos = [
  { src: '/images/galerie-1.webp', alt: 'Les mains, avant la cérémonie', caption: 'Les mains, avant', ratio: 'aspect-[3/4]', offset: '', align: 'max-md:mr-[8%]' },
  { src: '/images/galerie-2.webp', alt: 'La robe dans l’escalier', caption: 'La robe, dans l’escalier', ratio: 'aspect-square', offset: 'md:mt-20', align: 'max-md:ml-[10%]' },
  { src: '/images/galerie-3.webp', alt: 'Le cortège, à pied', caption: 'Le cortège, à pied', ratio: 'aspect-[4/5]', offset: 'md:-mt-10', align: 'max-md:mr-[6%]' },
  { src: '/images/galerie-4.webp', alt: 'La table, au soleil couchant', caption: 'La table, au couchant', ratio: 'aspect-[16/10]', offset: 'md:mt-24', align: 'max-md:ml-[4%]' },
  { src: '/images/galerie-5.webp', alt: 'Le premier regard', caption: 'Le premier regard', ratio: 'aspect-[2/3]', offset: 'md:mt-4', align: 'max-md:mr-[12%]' },
  { src: '/images/galerie-6.webp', alt: 'La nuit, sur la piste', caption: 'La nuit, sur la piste', ratio: 'aspect-[5/4]', offset: 'md:-mt-16', align: 'max-md:ml-[6%]' },
];
---

<section id="series" class="section-y overflow-hidden">
  <div class="container-ff">
    <div class="max-w-xl">
      <p class="eyebrow">Séries</p>
      <h2 class="mt-4 text-display-md">Ce qui reste, une fois la journée passée</h2>
    </div>
  </div>

  <div class="container-ff relative mt-14 md:mt-20">
    <ul class="flex flex-col gap-16 md:grid md:grid-cols-3 md:items-start md:gap-x-10 md:gap-y-16" data-stagger="120">
      {photos.map((p) => (
        <li class:list={['max-md:max-w-[82%]', p.align, p.offset]}>
          <figure>
            <div class="overflow-hidden rounded-card shadow-card" data-tilt="4">
              <img src={p.src} alt={p.alt} class:list={['w-full object-cover', p.ratio]} loading="lazy" />
            </div>
            <figcaption class="mt-3 font-mono text-xs uppercase tracking-[0.2em] text-muted">{p.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
