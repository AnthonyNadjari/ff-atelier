---
/**
 * « Instants » — propre à ce site. Chaque prestation (site.services : mariage, élopement, famille,
 * portrait) porte déjà sa propre photo (services[].image) dans site.config.ts, mais elle n'était
 * affichée nulle part avant ce bloc — ni dans Series.astro (galerie-1..6, séparée), ni dans
 * Formules.astro (texte seul, sans image). Composition éditoriale en pleine largeur, alternée
 * gauche/droite, chaque photo en fondu masqué (data-reveal="mask", même correctif que
 * sites/borie-des-chenes/sections/Hotes.astro : la section — jamais clippée — porte l'observateur,
 * `.is-visible` posée à la main sur chaque figure). Aucune réutilisation ailleurs.
 */
import { site } from '@/lib/site';
import Img from '@/components/Img.astro';

const instants = site.services.filter((s) => s.image);
---

{instants.length > 0 && (
  <section id="instants" class="section-y overflow-hidden">
    <div class="container-ff">
      <p class="eyebrow">Quatre façons de raconter</p>
    </div>

    <div class="mt-12 flex flex-col gap-16 md:mt-16 md:gap-24">
      {instants.map((s, i) => (
        <div class="container-ff grid items-center gap-8 md:grid-cols-2 md:gap-14" data-instant-row>
          <figure
            class:list={['relative aspect-[4/5] overflow-hidden rounded-card bg-surface', i % 2 === 1 && 'md:order-2']}
            data-reveal="mask"
          >
            <Img src={s.image!.src} alt={s.image!.alt} class="h-full w-full object-cover" sizes="(min-width: 768px) 45vw, 90vw" loading="lazy" />
          </figure>
          <div class:list={[i % 2 === 1 && 'md:order-1']}>
            <p class="font-display text-display-sm">{s.title}</p>
            <p class="mt-4 max-w-md text-lg text-muted">{s.short}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<script>
  // Meme correctif que sites/borie-des-chenes/sections/Hotes.astro : on observe la ligne (jamais
  // clippee) plutot que la figure [data-reveal="mask"] elle-meme, et on pose .is-visible a la main.
  document.querySelectorAll<HTMLElement>('#instants [data-instant-row]').forEach((row) => {
    const mask = row.querySelector<HTMLElement>('[data-reveal="mask"]');
    if (!mask) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            mask.classList.add('is-visible');
            io.unobserve(row);
          }
        }
      },
      { threshold: 0.1 },
    );
    io.observe(row);
  });
</script>
