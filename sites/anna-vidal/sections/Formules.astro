---
/**
 * « Formules » — propre à ce site. Trois cartes hautes (mariage / élopement / famille), ce qui
 * est inclus en liste courte, aucun prix. Bascule au survol (data-tilt), celle du milieu décalée
 * vers le haut sur desktop. Une ligne de clôture reprend wording.ctaTitle. Aucune réutilisation ailleurs.
 */
import { site } from '@/lib/site';
import Icon from '@/components/Icon.astro';

const formules = ['mariage', 'elopement', 'famille'].map((slug) => site.services.find((s) => s.slug === slug)!);
---

<section id="formules" class="section-y bg-bg-2">
  <div class="container-ff">
    <div class="max-w-xl">
      <p class="eyebrow">Formules</p>
      <h2 class="mt-4 text-display-md">Trois façons de travailler ensemble</h2>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3 md:items-start" data-stagger="120">
      {formules.map((f, i) => (
        <div
          class:list={['card group flex h-full flex-col rounded-card border border-line bg-surface p-8 shadow-card transition-transform duration-500 ease-out-quart', i === 1 && 'md:-translate-y-10']}
          data-tilt="6"
         
        >
          <h3 class="font-display text-display-sm">{f.title}</h3>
          <p class="mt-3 text-muted">{f.short}</p>
          <ul class="mt-6 flex flex-1 flex-col gap-3">
            {f.bullets.map((b) => (
              <li class="flex gap-3 text-sm text-muted">
                <Icon name="Check" size={16} class="mt-0.5 shrink-0 text-accent" />
                <span>{b}</span>
              </li>
            ))}
          </ul>
          <p class="mt-8 border-t border-line pt-6 text-sm text-muted">Sur devis, selon la journée.</p>
        </div>
      ))}
    </div>

    <div class="mt-20 text-center">
      <a
        href="#contact"
        class="group inline-flex items-center gap-3 font-display text-display-sm [&_em]:not-italic [&_em]:text-accent"
        set:html={`${site.wording.ctaTitle}`}
      />
    </div>
  </div>
</section>
