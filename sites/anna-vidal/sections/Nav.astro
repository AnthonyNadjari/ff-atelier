---
/**
 * Nav "custom/nav" — propre à ce site. Rien qu'un nom et un lien, tous deux fixes,
 * en mix-blend-mode: difference pour rester lisibles sur n'importe quelle photo en dessous.
 * Pas d'arrière-plan, pas de menu : le site est fait pour être vu, pas pour être navigué. Le numéro
 * est le seul ajout (masqué sous 640px, où le lien « Me contacter » suffit) : sans lui, aucun moyen
 * d'appeler avant le bas de page — un mariage se cale souvent par téléphone.
 */
import { site, tel } from '@/lib/site';
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-50">
  <div class="container-ff flex items-center justify-between py-6 md:py-8">
    <a
      href="/"
      class="pointer-events-auto text-sm"
      style="font-variant-caps: small-caps; text-transform: lowercase; letter-spacing: 0.08em; mix-blend-mode: difference; color: var(--on-ink);"
    >
      {site.business.name}
    </a>
    <div class="flex items-center gap-5">
      <a
        href={tel()}
        class="pointer-events-auto hidden text-sm tabular-nums sm:inline"
        style="mix-blend-mode: difference; color: var(--on-ink);"
      >
        {site.contact.phoneDisplay}
      </a>
      <a
        href="#contact"
        class="pointer-events-auto text-sm underline underline-offset-4"
        style="mix-blend-mode: difference; color: var(--on-ink);"
      >
        Me contacter
      </a>
    </div>
  </div>
</header>
