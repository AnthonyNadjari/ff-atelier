---
/**
 * Vidéo d'une démo (Hero, Réalisations), pilotée par demo-video.ts.
 *
 * 10 oct 2026, bug iPhone (« les vidéos ne se montrent pas ») : l'ancienne version attendait
 * `canplay` après `load()` avant d'appeler play(). iOS Safari ne télécharge rien tant que play() n'est
 * pas demandé : canplay n'arrivait jamais, la vidéo restait sur un cadre noir (WebKit masque le poster
 * dès que `load()` est appelé). Le clip-path d'entrée posé sur la <video> elle-même ne se repeignait pas
 * non plus sous WebKit.
 *
 * Recette (10 oct 2026, soir — retour fondateur : « trop zoomé, on ne voit rien, coupé comme un moule,
 * flou ») : l'écran ENTIER de la démo, jamais recadré, en haute définition.
 * - ordinateur : enregistrement 1440 × 900 à dpr 2, réduit à 1600 × 1000 (16:10) ; cadre 16:10 ;
 * - téléphone (< 768 px) : enregistrement 390 × 844 à dpr 2, 780 × 1688 sans réduction ; cadre au format
 *   exact de l'écran d'iPhone (390:844) : rien n'est coupé ;
 * - une vraie image (première image de la vidéo) dessous, toujours visible ; la <video> par-dessus,
 *   transparente tant qu'elle n'a pas joué une image (« playing », classe .joue) : jamais de noir ;
 * - play() direct (pas de load()/canplay : iOS ne télécharge rien avant play()).
 * Fichiers : public/video/demos/<slug>.mp4|.webp|-800.webp, <slug>-mobile.mp4|.webp
 * (scratchpad record3.mjs). Le rapport d'aspect est posé ICI et seulement ici : une classe utilitaire
 * Tailwind ne peut pas le surcharger (style global hors couche, bug du 10 oct qui étirait tout en 4:5).
 */
interface Props {
  slug: string;
  /** Classes du conteneur (marges, coins). Le rapport d'aspect est fixé par ce composant. */
  class?: string;
  sizes: string;
  /** Révélation d'entrée au défilement (pas pour le hero). */
  revele?: boolean;
}
const { slug, class: cls = '', sizes, revele = false } = Astro.props;
---

<div class={`ff-demo ${cls}`} data-ff-image={revele ? '' : undefined}>
  <picture>
    <source media="(max-width: 767px)" srcset={`/video/demos/${slug}-mobile.webp`} width="780" height="1688" />
    <img
      src={`/video/demos/${slug}.webp`}
      srcset={`/video/demos/${slug}-800.webp 800w, /video/demos/${slug}.webp 1600w`}
      sizes={sizes}
      width="1600"
      height="1000"
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
    />
  </picture>
  {/* Repli économie d'énergie iPhone (demo-video.ts) : capture complète qui défile en CSS. */}
  <img class="ff-demo-long" data-src-long={`/video/demos/${slug}-long.webp`} alt="" aria-hidden="true" decoding="async" />
  <video
    data-demo
    data-src={`/video/demos/${slug}.mp4`}
    data-src-mobile={`/video/demos/${slug}-mobile.mp4`}
    muted
    loop
    playsinline
    preload="none"
    disablepictureinpicture
    disableremoteplayback
    aria-hidden="true"
    tabindex="-1"
  ></video>
</div>

<style is:global>
  .ff-demo {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    aspect-ratio: 16 / 10;
  }
  @media (max-width: 767px) {
    .ff-demo { aspect-ratio: 390 / 844; border-radius: 14px; }
  }
  .ff-demo > picture { display: contents; }
  .ff-demo img, .ff-demo video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: none;
  }
  .ff-demo video { opacity: 0; transition: opacity 0.4s ease; }
  /* Repli « défilement » : hauteur naturelle, glisse du haut vers le bas de la capture puis remonte. */
  @media (max-width: 767px) { .ff-demo { container-type: size; } }
  .ff-demo img.ff-demo-long { display: none; inset: 0 0 auto; height: auto; object-fit: initial; will-change: transform; }
  .ff-demo.defile img.ff-demo-long {
    display: block;
    animation: ff-demo-defile 16s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate both paused;
  }
  .ff-demo.defile.en-vue img.ff-demo-long { animation-play-state: running; }
  @keyframes ff-demo-defile {
    0%, 8% { transform: translateY(0); }
    92%, 100% { transform: translateY(calc(-100% + 100cqh)); }
  }
  .ff-demo.joue video { opacity: 1; }
</style>
