---
/**
 * Hero du site du studio (plan-site-ff.html v2, S1 « Monogramme tracé + titre révélé par lignes »).
 *
 * Un écran qui vend (Trueform) : le monogramme, le titre, la ligne d'offre (prix + délai), un seul
 * bouton plein (« Réserver mon audit gratuit » → /audit), un lien texte vers les exemples, et une
 * ligne de présence (e-mail en clair + heure de Paris en direct). À droite, le mur de démos en 3D.
 *
 * S1 est en CSS PUR (@keyframes dans le CSS inliné au build, aucun script, aucune hydratation) : il
 * démarre au premier rendu, indépendamment du chargement des scripts.
 * - Monogramme : 6 sous-tracés SVG (mono-subpaths.ts), stroke-dashoffset 1000 → 0, 0,8 s chacun,
 *   cubic-bezier(0.4, 0, 0.2, 1), décalage 0,26 s ; remplissage crème 0,9 s à partir de 2,1 s (fin du
 *   dernier trait) ; le trait cuivre s'efface à 2,5 s.
 * - Titre (élément LCP) : chaque ligne dans un masque, translateY 55 % → 0, 0,6 s power3.out
 *   (cubic-bezier(0.165, 0.84, 0.44, 1)), décalage 0,09 s, départ 0,15 s. Départ à 55 % et non 100 % :
 *   la ligne est déjà à moitié peinte au premier rendu, Chrome enregistre le LCP à la première
 *   peinture au lieu d'attendre la fin du geste (~0,9 s gagnées).
 * - Phrase, boutons, présence : translateY 12 px → 0 + opacité, 0,4 s power2.out, à +0,35 s.
 * - Mouvement réduit : tout est posé, aucune animation.
 *
 * Les lignes du titre sont écrites ici (un découpage CSS ne peut pas se calculer) : elles doivent
 * redonner exactement business.tagline (« Nous faisons des sites pour les artisans. »).
 */
import { site, mailto } from '@/lib/site';
import { MONO_SUBPATHS } from './mono-subpaths';
import DemoVideo from './DemoVideo.astro';

const lignes = ['Nous faisons', 'des sites pour', 'les artisans.'];
// Mur de démos : trois colonnes, celle du milieu décalée vers le bas.
const colonnes = [
  ['encre-noire', 'chez-malo'],
  ['dentaire-morvan', 'maison-roux'],
  ['atelier-lecerf', 'studio-ambre'],
];
if (lignes.join(' ') !== site.business.tagline.replace(/<[^>]+>/g, '')) {
  throw new Error('Hero : les lignes du titre ne redonnent plus business.tagline, à réécrire ensemble.');
}
---

<section id="hero" class="ff-hero">
  <div class="ff-conteneur ff-hero-grille">
    <div class="ff-hero-texte">
      <svg class="ff-mono" viewBox="286 -1 294 281" aria-hidden="true" focusable="false">
        <defs>
          {MONO_SUBPATHS.map((d, i) => <path id={`ff-mono-p${i}`} d={d} pathLength="1000" />)}
        </defs>
        {MONO_SUBPATHS.map((_, i) => <use class="ff-mono-corps" href={`#ff-mono-p${i}`} />)}
        {MONO_SUBPATHS.map((_, i) => <use class="ff-mono-trait" href={`#ff-mono-p${i}`} style={`--i:${i}`} />)}
      </svg>

      <h1 class="ff-titre ff-hero-titre">
        {lignes.map((l, i) => <span class="ff-masque"><span style={`--l:${i}`}>{l}</span></span>)}
      </h1>

      <div class="ff-hero-suite">
        <p class="ff-texte ff-hero-offre">
          Dès <span class="ff-montant whitespace-nowrap">1 200 €</span>, payé une fois. En ligne 72 heures
          après réception de vos textes et de vos photos.
        </p>
        <div class="ff-hero-actions">
          <a href="/audit" class="ff-bouton">Réserver un audit gratuit</a>
          <a href="#realisations" class="ff-lien ff-texte">Voir des exemples</a>
        </div>
        <div class="ff-hero-presence ff-petit ff-doux">
          <p>Écrivez-nous à <a href={mailto()} class="ff-lien">{site.contact.email}</a>, c’est nous deux qui lisons.</p>
          <p data-heure hidden>Il est <span data-heure-valeur></span> à Paris.</p>
        </div>
      </div>
    </div>

    {/* Mur de démos en 3D (11 oct 2026, « un truc 3D stylé, moderne ») : six écrans de téléphone de nos
        sites d'exemple, posés en perspective sur trois colonnes, chacun défilant (DemoVideo.astro).
        Profondeur : les colonnes glissent à des vitesses différentes au défilement de la page, et le
        plan suit le pointeur sur ordinateur (script plus bas). Téléphone : une bande sous les boutons. */}
    <figure class="ff-hero-oeuvre" data-mur>
      <div class="ff-mur" aria-hidden="true">
        <div class="ff-mur-plan">
          {colonnes.map((col, c) => (
            <div class="ff-mur-col">
              {col.map((slug, i) => (
                <DemoVideo slug={slug} tel class="ff-mur-ecran" decalage={(c * 2 + i) * 3.1} prioritaire={c === 1 && i === 0} />
              ))}
            </div>
          ))}
        </div>
      </div>
      <figcaption class="sr-only">Six de nos sites d’exemple sur téléphone : cabinet dentaire, boulangerie, tatoueur, restaurant, menuisier, architecte d’intérieur.</figcaption>
    </figure>
  </div>
</section>

<script>
  // Une page vitrine s'ouvre en haut (9 oct 2026 : le navigateur restaurait parfois le bas de page).
  // Exceptions : lien vers une ancre, retour arrière.
  const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  if (!location.hash && nav?.type !== 'back_forward') {
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);
  }
</script>

<script>
  import { onPage } from '@/scripts/page';

  // Mur de démos : profondeur au défilement (--p) et plan qui suit le pointeur (--mx/--my, lissés).
  // Rien sous « réduire les animations » ; pointeur seulement avec une souris.
  onPage(() => {
    const mur = document.querySelector<HTMLElement>('[data-mur] .ff-mur-plan');
    if (!mur || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const souris = matchMedia('(hover: hover) and (pointer: fine)').matches;
    let cx = 0, cy = 0, x = 0, y = 0, raf = 0;
    let p = '', mx = '', my = '';
    // Chaque variable n'est réécrite que si elle change (une fois le hero passé, plus rien n'est écrit :
    // avant, --mx/--my étaient reposés à chaque événement de défilement, sur toute la page).
    const tick = () => {
      raf = 0;
      x += (cx - x) * 0.08;
      y += (cy - y) * 0.08;
      const np = Math.min(1, Math.max(0, window.scrollY / window.innerHeight)).toFixed(3);
      if (np !== p) { p = np; mur.style.setProperty('--p', p); }
      const nx = x.toFixed(3), ny = y.toFixed(3);
      if (nx !== mx) { mx = nx; mur.style.setProperty('--mx', mx); }
      if (ny !== my) { my = ny; mur.style.setProperty('--my', my); }
      if (Math.abs(cx - x) > 0.001 || Math.abs(cy - y) > 0.001) raf = requestAnimationFrame(tick);
    };
    const relancer = () => { if (!raf) raf = requestAnimationFrame(tick); };
    const bouge = (e: PointerEvent) => { cx = (e.clientX / window.innerWidth) * 2 - 1; cy = (e.clientY / window.innerHeight) * 2 - 1; relancer(); };
    if (souris) window.addEventListener('pointermove', bouge, { passive: true });
    window.addEventListener('scroll', relancer, { passive: true });
    relancer();
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('pointermove', bouge);
      window.removeEventListener('scroll', relancer);
    }, { once: true });
  });

  // L'heure de Paris, en direct (signe de présence vrai). Sans JavaScript, la ligne reste masquée
  // plutôt que d'afficher une heure fausse.
  onPage(() => {
    const ligne = document.querySelector<HTMLElement>('[data-heure]');
    const valeur = document.querySelector<HTMLElement>('[data-heure-valeur]');
    if (!ligne || !valeur) return;
    const fmt = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', hour: 'numeric', minute: '2-digit' });
    const maj = () => {
      const parts = fmt.formatToParts(new Date());
      const h = parts.find((p) => p.type === 'hour')?.value ?? '';
      const m = parts.find((p) => p.type === 'minute')?.value ?? '';
      valeur.textContent = `${Number(h)} h ${m}`;
      ligne.hidden = false;
    };
    maj();
    const t = window.setInterval(maj, 20_000);
    document.addEventListener('astro:before-swap', () => window.clearInterval(t), { once: true });
  });
</script>

<style is:global>
  .ff-hero { padding-block: var(--s4) var(--s8); background: var(--bg); }
  /* Téléphone : la pièce exposée (le cabinet dentaire) commence sous le premier écran ; le titre reste l'élément
     LCP, peint à la première peinture (mesuré : une bande de 56 px de l'image suffisait à en faire le LCP). */
  .ff-hero-grille { display: grid; gap: var(--s12); }
  @media (min-width: 1024px) {
    .ff-hero { min-height: calc(100svh - var(--entete)); display: flex; align-items: center; padding-block: var(--s6); }
    .ff-hero-grille { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s6); align-items: center; }
    .ff-hero-texte { grid-column: 1 / span 7; }
    .ff-hero-oeuvre { grid-column: 8 / span 5; }
  }

  /* --- Monogramme (S1) : 96 px sur téléphone, 120 px sur ordinateur --- */
  .ff-mono { display: block; width: 96px; height: auto; overflow: visible; margin-bottom: var(--s4); }
  @media (min-width: 1024px) { .ff-mono { width: 120px; margin-bottom: var(--s6); } }
  .ff-mono-corps { fill: var(--fg); opacity: 0; animation: ff-mono-corps 0.9s cubic-bezier(0.23, 1, 0.32, 1) 2.1s forwards; }
  .ff-mono-trait {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation:
      ff-mono-trait 0.8s cubic-bezier(0.4, 0, 0.2, 1) calc(var(--i) * 0.26s) forwards,
      ff-mono-trait-fin 0.6s ease 2.5s forwards;
  }
  @keyframes ff-mono-trait { to { stroke-dashoffset: 0; } }
  @keyframes ff-mono-trait-fin { to { opacity: 0; } }
  @keyframes ff-mono-corps { to { opacity: 1; } }

  /* --- Titre (S1, élément LCP) --- */
  .ff-hero-titre .ff-masque > span { animation: ff-ligne 0.6s var(--ff-power3-out) calc(0.15s + var(--l) * 0.09s) both; }
  @keyframes ff-ligne { from { transform: translateY(55%); } }

  /* --- Phrase, boutons, présence --- */
  .ff-hero-suite { animation: ff-hero-suite 0.4s var(--ff-power2-out) 0.5s both; }
  @keyframes ff-hero-suite { from { opacity: 0; transform: translateY(12px); } }
  .ff-hero-offre { margin-top: var(--s4); max-width: 32rem; }
  .ff-hero-actions { margin-top: var(--s4); display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s4); }
  .ff-hero-presence { hyphens: manual; margin-top: var(--s8); padding-top: var(--s2); border-top: 1px solid var(--line); display: grid; gap: 4px; max-width: 32rem; }
  @media (max-width: 639px) {
    .ff-hero-actions .ff-bouton { width: 100%; }
  }
  @media (max-width: 767px) {
    .ff-hero { padding-block: var(--s3) var(--s6); }
    .ff-mono { width: 80px; margin-bottom: var(--s3); }
    .ff-hero-presence { margin-top: var(--s6); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ff-mono-corps { animation: none; opacity: 1; }
    .ff-mono-trait { animation: none; opacity: 0; }
    .ff-hero-titre .ff-masque > span, .ff-hero-suite { animation: none; }
  }

  /* --- Mur de démos en 3D ---
     Le plan est incliné (rotateX/rotateZ) dans une perspective ; --mx/--my (pointeur, -1..1) et --p
     (avancée du défilement, 0..1) sont posés par le script. Entrée : le plan se redresse depuis plus
     incliné et plus bas, 1,6 s expo-out, après le titre. */
  .ff-hero { overflow: clip; }
  .ff-hero-oeuvre { margin: 0; }
  .ff-mur {
    position: relative;
    height: 380px;
    margin-inline: calc(-1 * var(--gouttiere));
    perspective: 1600px;
    perspective-origin: 50% 30%;
    overflow: hidden;
  }
  /* Fondus en haut, en bas et à gauche : deux calques dégradés vers le fond, posés sur le mur
     (12 oct 2026). Avant : mask-image sur le groupe 3D, qui obligeait à recomposer hors écran les six
     écrans animés à chaque image (saccades au défilement sur iPhone). */
  .ff-mur::before,
  .ff-mur::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .ff-mur::before { background: linear-gradient(to bottom, var(--bg), transparent 14%, transparent 80%, var(--bg)); }
  .ff-mur::after { background: linear-gradient(to right, var(--bg), transparent 18%); }
  @media (max-width: 1023px) {
    .ff-hero-grille { gap: var(--s4); }
    .ff-mur::after { content: none; }
  }
  .ff-mur-plan {
    position: absolute;
    left: 50%;
    top: 0;
    width: 520px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    transform-style: preserve-3d;
    transform:
      translateX(-50%)
      rotateX(calc(28deg + var(--my, 0) * -4deg))
      rotateZ(calc(-18deg + var(--mx, 0) * 3deg))
      rotateY(calc(var(--mx, 0) * 6deg));
    animation: ff-mur-entree 1.6s var(--ff-expo-out) 0.45s both;
  }
  @keyframes ff-mur-entree {
    from { opacity: 0; transform: translateX(-50%) translateY(120px) rotateX(52deg) rotateZ(-26deg); }
  }
  .ff-mur-col {
    display: grid;
    gap: 18px;
    align-content: start;
    will-change: transform;
  }
  .ff-mur-col:nth-child(2) { margin-top: 90px; }
  .ff-mur-col:nth-child(1) { --vitesse: 60px; }
  .ff-mur-col:nth-child(2) { --vitesse: -90px; }
  .ff-mur-col:nth-child(3) { --vitesse: 30px; }
  .ff-mur-col { transform: translateY(calc(var(--p, 0) * var(--vitesse))); }
  .ff-mur .ff-mur-ecran {
    border-radius: 16px;
    border-color: rgb(240 232 219 / 0.16);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.8);
  }
  @media (min-width: 768px) {
    .ff-mur { height: 520px; }
    .ff-mur-plan { width: 640px; }
  }
  @media (min-width: 1024px) {
    .ff-mur { height: min(80svh, 720px); margin-inline: -12vw 0; }
    .ff-mur-plan { width: 560px; left: 54%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ff-mur-plan { animation: none; }
  }
  /* Téléphone et tablette (13 oct 2026, revue DA : « premier écran mobile sans aucun visuel ») : le mur
     passe derrière le texte, sur toute la hauteur du premier écran, atténué ; le titre reste au-dessus
     et reste l'élément LCP (chaque écran du mur est plus petit que le bloc du titre). */
  @media (max-width: 1023px) {
    .ff-hero { position: relative; }
    .ff-hero-grille { position: relative; }
    .ff-hero-texte { position: relative; z-index: 1; }
    .ff-hero-oeuvre { position: absolute; inset: calc(-1 * var(--s3)) 0 auto; z-index: 0; pointer-events: none; }
    .ff-mur { height: 100svh; opacity: 0.38; }
    .ff-mur-plan { width: 600px; left: 62%; top: 4%; }
    .ff-mur::before { background: linear-gradient(to bottom, transparent 40%, var(--bg) 92%); }
  }
</style>
