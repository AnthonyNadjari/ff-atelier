---
import { site } from '@/lib/site';
import { MONO_SUBPATHS } from './mono-subpaths';
import '../styles/frontispice.css';
---

<section id="hero" data-grain class="ff-frontispice relative overflow-hidden">
  <div class="container-ff">
    <div class="ff-frontispice-signature">
      <svg class="ff-frontispice-mono" viewBox="286 -1 294 281" aria-hidden="true">
        <defs>
          {MONO_SUBPATHS.map((d, i) => <path id={`hero-mono-p${i}`} d={d} pathLength="1000" />)}
          <linearGradient id="hero-mono-grad" x1="0" y1="0" x2="0" y2="1">
            <stop class="ff-mono-top" offset="0" />
            <stop class="ff-mono-bottom" offset="1" />
          </linearGradient>
        </defs>
        {MONO_SUBPATHS.map((_, i) => <use class="ff-mono-fill" href={`#hero-mono-p${i}`} />)}
        {MONO_SUBPATHS.map((_, i) => <use class="ff-mono-trace" href={`#hero-mono-p${i}`} />)}
      </svg>
      <p class="ff-frontispice-name">Finck <span>&amp;</span> Fisch</p>
    </div>
    <hr class="ff-frontispice-rule" />
    <h1 class="ff-frontispice-title" set:html={site.business.tagline} />
    <p class="ff-frontispice-intro">Studio à deux personnes. Trois propositions visuelles à partir de vos textes et de vos photos. Un site payé une fois, qui vous appartient.</p>
    <p class="ff-frontispice-note">Le délai de 72 heures commence à réception de vos éléments. Engagement provisoire, à confirmer avant signature.</p>
    <a class="ff-frontispice-next" href="#propositions"><span>Trois sites. Un seul contenu.</span><span aria-hidden="true">↓</span></a>
    <div class="ff-frontispice-proof" aria-label="Aperçus de sites de démonstration">
      <figure>
        <img src="/images/sites/maison-roux-700.webp" alt="Aperçu du site de démonstration de boulangerie-pâtisserie" width="1400" height="900" loading="eager" decoding="async" />
        <figcaption>Boulangerie-pâtisserie <span>Démonstration</span></figcaption>
      </figure>
      <figure>
        <img src="/images/sites/atelier-lecerf-700.webp" alt="Aperçu du site de démonstration de menuiserie-ébénisterie" width="1400" height="900" loading="eager" decoding="async" />
        <figcaption>Menuisier-ébéniste <span>Démonstration</span></figcaption>
      </figure>
    </div>
  </div>
</section>
