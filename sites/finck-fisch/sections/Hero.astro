---
/**
 * Hero sur mesure Finck & Fisch — direction eclipse. Le logo de la maison en grand (version claire
 * detouree par `ff logo`, voir scripts/ff/logo.mjs), une seule phrase, deux portes. Rien d'autre :
 * c'est un studio qui vend du calme et de la place, le premier ecran doit le prouver avant de
 * l'ecrire.
 *
 * Plus de bande horizontale de vignettes ici (elle existait avant) : elle faisait doublon avec la
 * galerie « Vingt metiers, vingt sites » qui suit immediatement, et son epinglage GSAP ajoutait a
 * lui seul une hauteur d'ecran de defilement pour montrer huit images qu'on revoit trente lignes
 * plus bas. Retrait demande le 18 sept 2026 (« there is too much scrolling »).
 *
 * Le titre n'est pas decoupe mot a mot (data-split) mais revele d'un bloc, en fondu long : sur un
 * fond noir, une cascade de mots attire l'oeil sur l'animation au lieu de la phrase.
 */
import { site } from '@/lib/site';
---

<section id="hero" class="relative flex min-h-[86svh] items-center overflow-hidden pt-32 pb-20 md:pt-36">
  <div class="container-ff">
    <img
      src="/images/monogramme-clair.png"
      alt=""
      width="291"
      height="229"
      class="h-16 w-auto opacity-90 md:h-20"
      data-reveal
      loading="eager"
      fetchpriority="high"
    />

    <h1 class="mt-10 max-w-4xl text-display-xl" data-reveal data-reveal-delay="120" set:html={site.business.tagline} />

    <p class="mt-8 max-w-xl text-lg text-muted" data-reveal data-reveal-delay="240">
      Deux associés, un seul interlocuteur. Trois directions visuelles proposées dès le premier rendu,
      un prix annoncé avant de commencer, et le site vous appartient le jour de la mise en ligne.
    </p>

    <div class="mt-12 flex flex-wrap items-center gap-4" data-reveal data-reveal-delay="360">
      <a href="#contact" class="btn btn-primary">{site.wording?.devis ?? 'Parler de votre projet'}</a>
      <a href="#realisations" class="btn btn-ghost">Voir les réalisations</a>
    </div>
  </div>
</section>
