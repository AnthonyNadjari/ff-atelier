---
/**
 * Premier écran — sur mesure Finck & Fisch, direction éphéméride (refonte du 6 oct 2026, contrat
 * dans .impeccable/surfaces/).
 *
 * Un seul objet, vu une fois : le bloc éphéméride posé sur son carton rouge. La feuille du jour porte
 * l'offre entière, lisible en un regard sur un téléphone : 72 heures (le plus grand signe de l'écran,
 * seul chiffre en rouge), ce que ça veut dire, le prix et la propriété sur le talon, et la languette
 * qui appelle. Les deux feuilles suivantes dépassent sous la première : profondeur par
 * superposition, sans ombre.
 *
 * Geste signature, une fois au chargement : la feuille de la veille (« 0 heure, vos éléments
 * arrivent ») se détache vers le haut et découvre celle du jour. Animation CSS seule (transform et
 * opacity), aria-hidden, supprimée sous prefers-reduced-motion. Le contenu réel est dessous dès le
 * premier rendu : sans CSS ni JS, la page est complète.
 */
import { site, tel } from '@/lib/site';
---

<section id="hero" class="ff-carton bg-accent">
  <div class="container-ff flex min-h-[calc(100svh-4rem)] items-center justify-center py-8 sm:py-14">
    <div class="ff-bloc w-full">
      <p class="ff-reliure" aria-hidden="true">Éphéméride de l’atelier</p>

      <div class="ff-pile">
        <div class="ff-feuille bg-surface text-fg">
          <div class="flex items-baseline justify-between text-xs font-semibold uppercase tracking-[0.14em] text-muted">
            <span>{site.business.name}</span>
            <span>Feuille du jour</span>
          </div>

          <h1 class="mt-5 text-center sm:mt-7">
            <span class="ff-72 chiffre-date block text-accent">72</span>{' '}
            <span class="ff-heures mt-2 block font-extrabold uppercase">heures</span>{' '}
            <span class="mx-auto mt-4 block max-w-[24ch] text-lg font-medium leading-snug sm:text-xl">
              pour mettre votre site en ligne, à partir de vos textes et de vos photos.
            </span>
          </h1>

          <div class="perforation mt-7" aria-hidden="true"></div>

          <dl class="mt-5 grid grid-cols-2 gap-4 text-sm">
            <div>
              <dt class="text-muted">Prix</dt>
              <dd class="mt-1 font-bold tabular-nums">dès 1 200 €, payé une fois</dd>
            </div>
            <div>
              <dt class="text-muted">À qui il est</dt>
              <dd class="mt-1 font-bold">à vous, nom de domaine compris</dd>
            </div>
          </dl>

          <div class="mt-6 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
            <a href={tel()} class="btn btn-primary ff-languette inline-flex items-center justify-center gap-1.5 px-6 text-base">
              Appeler le <span class="tabular-nums">{site.contact.phoneDisplay}</span>
            </a>
            <a href="#contact" class="text-center text-sm font-semibold underline sm:text-left">ou écrire un message</a>
          </div>
        </div>

        {/* La feuille de la veille, qui se détache au chargement. Décor : aria-hidden. */}
        <div class="ff-veille bg-surface text-fg" aria-hidden="true">
          <div class="flex items-baseline justify-between text-xs font-semibold uppercase tracking-[0.14em] text-muted">
            <span>{site.business.name}</span>
            <span>La veille</span>
          </div>
          <p class="mt-5 text-center sm:mt-7">
            <span class="ff-72 chiffre-date block">0</span>{' '}
            <span class="ff-heures mt-2 block font-extrabold uppercase">heure</span>{' '}
            <span class="mx-auto mt-4 block max-w-[24ch] text-lg font-medium leading-snug sm:text-xl">vos éléments arrivent chez nous.</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ff-bloc { max-width: 34rem; }

  /* Le carton du bloc : une bande plus sombre où la feuille est agrafée. */
  .ff-reliure {
    background: var(--accent-2);
    color: var(--on-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
    padding: 0.7rem 1rem;
  }

  .ff-pile { position: relative; isolation: isolate; }
  /* Deux feuilles dépassent sous celle du jour : profondeur par superposition, aucune ombre. */
  .ff-pile::before,
  .ff-pile::after {
    content: '';
    position: absolute;
    inset-inline: 0.4rem;
    bottom: -0.45rem;
    height: 2rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-top: 0;
    z-index: -1;
  }
  .ff-pile::after { inset-inline: 0.8rem; bottom: -0.9rem; background: var(--bg); }

  .ff-feuille,
  .ff-veille { padding: 1.25rem 1.25rem 1.5rem; }
  @media (min-width: 640px) {
    .ff-feuille,
    .ff-veille { padding: 1.75rem 2.25rem 2.25rem; }
  }

  .ff-72 { font-size: clamp(8.5rem, 34vw, 15rem); }
  .ff-heures { font-size: clamp(1.4rem, 5vw, 2rem); letter-spacing: 0.24em; margin-right: -0.24em; }

  .ff-languette { min-height: 3.25rem; padding-inline: 1.5rem; }

  /* La veille recouvre la feuille du jour, puis se détache une fois. */
  .ff-veille {
    position: absolute;
    inset: 0;
    transform-origin: 0% 0%;
    animation: ff-detacher 0.75s cubic-bezier(0.5, 0, 0.75, 0) 0.35s both;
  }
  @keyframes ff-detacher {
    0% { transform: translate3d(0, 0, 0) rotate(0deg); opacity: 1; }
    25% { transform: translate3d(0, 0.4rem, 0) rotate(-1.2deg); opacity: 1; }
    100% { transform: translate3d(-6%, -120%, 0) rotate(-9deg); opacity: 0; visibility: hidden; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ff-veille { display: none; }
  }
</style>
