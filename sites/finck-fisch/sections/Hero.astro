---
/**
 * Hero sur mesure Finck & Fisch.
 *
 * REFONTE DU 9 OCT 2026 — benchmark de 30 sites (docs/veille/benchmark-2026-10/, synthèses studios,
 * marques, fr, awwwards). Ce qui change, et pourquoi :
 *
 * 1. Le travail est le hero (Pentagram, Order, twks, Linear) : un site d'exemple livré par l'atelier,
 *    en grand, avec une légende factuelle (métier, ville, « exemple »). Plus de slogan abstrait
 *    (« Votre métier mérite mieux qu'un template »), qui était la phrase la plus générique de la page.
 * 2. Une phrase à la première personne qui dit qui, pour qui, combien et en combien de temps
 *    (Pianetti, ONCE), le prix sur la même ligne que l'action (Diptyque).
 * 3. Trois tailles de texte, très écartées (Prødux) : le titre, la ligne d'offre, les petites lignes.
 * 4. Contact direct : l'e-mail en clair, pas de bouton plein (Pianetti). Signe de présence vrai et
 *    sans risque : l'heure de Paris en direct (Koto, Revelatio).
 * 5. Le monogramme tracé reste en haut, au-dessus du titre, en petit (décision du fondateur, 9 oct :
 *    « sinon ça nous distingue pas »). C'est la seule marque de la page ; il ne revient pas en bas.
 *
 * TODO(fondateurs) : téléphone réel absent (le config porte un placeholder). Quand il arrive, ajouter
 * « ou appelez le <numéro> » dans la petite ligne de contact ci-dessous, en lien tel().
 */
import { site, mailto } from '@/lib/site';
---

<section id="hero" class="relative flex flex-col justify-center pt-8 pb-14 md:pt-12 lg:min-h-[calc(100svh-68px)] lg:pb-16">
  <div class="container-ff grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-x-12">
    <div class="hero-texte lg:col-span-5">
      {/* Étape 4 bis (9 oct) : le monogramme se forme dans une fumée d'encre blanche (vidéo fal.ai /
          Veo 3.1, image de fin = le monogramme exact), lue une fois à l'ouverture, puis reste sur la
          dernière image. Le fond de la vidéo est encodé dans le noir chaud exact de la page (#15120f) : aucun
          fondu CSS (mix-blend-mode ignoré sur <video> par Chrome), aucun carré visible. Pas de masque : il coupait le haut du F (essai du 9 oct
          au matin). Mouvement réduit ou lecture bloquée : l'image fixe du logo fini. */}
      <div class="hero-mono" data-hero-mono-cadre>
        <video
          data-hero-mono
          src="/video/monogramme.mp4"
          muted
          playsinline
          preload="auto"
          width="640"
          height="640"
          aria-hidden="true"
        ></video>
        {/* Le logo fini, toujours là : par-dessus la vidéo tant qu'elle n'a pas vraiment démarré (Chrome
            retire le poster dès play() et montre du noir pendant le chargement : « le logo marche pas »,
            9 oct). Si la vidéo ne charge jamais, c'est lui qu'on voit. */}
        <img src="/video/monogramme.webp" width="640" height="640" alt="" aria-hidden="true" decoding="async" fetchpriority="high" data-hero-mono-fixe />
      </div>

      <h1 class="hero-titre" set:html={site.business.tagline} />

      <p class="hero-offre mt-10">
        Un site vitrine sur mesure pour votre atelier ou votre boutique, à partir de 1 200 €, en
        ligne 72 heures après réception de vos textes et de vos photos.
        <a href="#offre" class="ff-lien whitespace-nowrap text-fg">Voir les tarifs</a>
      </p>

      <div class="hero-contact mt-10 border-t border-line pt-5 text-[0.95rem] text-muted">
        <p>Écrivez-nous à <a href={mailto()} class="ff-lien text-fg">{site.contact.email}</a>, c’est nous deux qui lisons.</p>
        <p class="mt-1" data-heure hidden>Il est <span data-heure-valeur></span> à Paris.</p>
      </div>
    </div>

    <figure class="hero-oeuvre lg:col-span-7">
      {/* 9 oct, soir : la capture figée devient un enregistrement muet (6 s, en boucle) de l'accueil de
          la forge qui défile : le geste du forgeron bouge vraiment. L'image d'aperçu (poster, même
          cadrage 14:9) est ce que voient le premier rendu, le mouvement réduit et le téléphone (où rien
          n'est téléchargé avant un toucher). Chargement et lecture pilotés par demo-video.ts. */}
      <video
        data-demo
        data-src="/video/demos/forge-delacroix.mp4"
        poster="/images/sites/forge-delacroix.webp"
        muted
        loop
        playsinline
        preload="none"
        width="1260"
        height="810"
        aria-hidden="true"
        class="block aspect-[14/9] w-full border border-line object-cover object-top lg:aspect-[4/3]"
      ></video>
      <span class="sr-only">Page d’accueil du site d’exemple d’une ferronnerie d’art à Toulouse : un forgeron au travail, le titre « Le fer, à la main »</span>
      <figcaption class="mt-3 flex flex-wrap justify-between gap-x-6 gap-y-1 text-sm text-muted">
        <span><span class="text-fg">Ferronnerie d’art, Toulouse.</span> Le geste du forgeron défile avec la page.</span>
        <span>Site d’exemple</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  // « Le site s'ouvre par le bas parfois » (9 oct 2026) : au rechargement ou à la réouverture d'un
  // onglet, le navigateur restaurait l'ancienne position (souvent le bas de page). Une page vitrine
  // s'ouvre en haut. Exceptions : lien vers une ancre, retour arrière.
  const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
  if (!location.hash && nav?.type !== 'back_forward') {
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    window.scrollTo(0, 0);
  }
</script>

<script>
  import { onPage } from '@/scripts/page';
  import { initDemoVideos } from './demo-video';

  // La démo de la forge, en vidéo : voir demo-video.ts (aussi appelé par Realisations.astro, idempotent).
  onPage(initDemoVideos);

  // Le monogramme en vidéo : lecture une fois à l'ouverture, reste sur la dernière image. Mouvement
  // réduit : saut direct à la fin. Lecture refusée (économie d'énergie iOS) : idem.
  onPage(() => {
    const v = document.querySelector<HTMLVideoElement>('[data-hero-mono]');
    const fixe = document.querySelector<HTMLElement>('[data-hero-mono-fixe]');
    if (!v || !fixe || v.dataset.pret) return;
    v.dataset.pret = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { v.remove(); return; }
    // L'image fixe ne s'efface qu'une fois la vidéo réellement en train de jouer (première image
    // peinte), jamais avant : aucun noir possible. Lecture demandée seulement quand les données sont là.
    v.addEventListener('playing', () => { fixe.classList.add('est-cachee'); }, { once: true });
    v.addEventListener('ended', () => { fixe.classList.remove('est-cachee'); }, { once: true });
    // Lecture demandée tout de suite (iOS ne charge qu'au play()) ; l'image fixe par-dessus couvre
    // l'attente, donc aucun noir possible. Si le navigateur refuse (économie d'énergie), on retente
    // dès que des données arrivent, puis on reste sur le logo fixe.
    const lancer = () => { v.play().catch(() => {}); };
    lancer();
    v.addEventListener('canplay', lancer, { once: true });
  });

  // L'heure de Paris, en direct (signe de présence vrai, rien à promettre). Rien n'est écrit dans le
  // HTML livré : sans JavaScript, la ligne reste masquée plutôt que d'afficher une heure fausse.
  onPage(() => {
    const ligne = document.querySelector<HTMLElement>('[data-heure]');
    const valeur = document.querySelector<HTMLElement>('[data-heure-valeur]');
    if (!ligne || !valeur) return;
    const fmt = new Intl.DateTimeFormat('fr-FR', { timeZone: 'Europe/Paris', hour: 'numeric', minute: '2-digit' });
    const maj = () => {
      const parts = fmt.formatToParts(new Date());
      const h = parts.find((p) => p.type === 'hour')?.value ?? '';
      const m = parts.find((p) => p.type === 'minute')?.value ?? '';
      valeur.textContent = `${Number(h)} h ${m}`;
      ligne.hidden = false;
    };
    maj();
    const t = window.setInterval(maj, 20_000);
    document.addEventListener('astro:before-swap', () => window.clearInterval(t), { once: true });
  });
</script>

<style is:global>
  /* Trois tailles, pas une de plus : titre, ligne d'offre, petites lignes. */
  #hero .hero-titre {
    font-size: clamp(2.6rem, 5vw, 4.9rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    font-style: normal;
  }
  #hero .hero-offre {
    max-width: 30rem;
    font-size: clamp(1.15rem, 1.45vw, 1.35rem);
    line-height: 1.45;
    color: var(--fg);
  }
  .hero-oeuvre video { background: var(--surface); }

  /* #hero porte un view-transition-name (global.css), donc un contexte d'empilement : le fondu
     « screen » de la vidéo se ferait contre du transparent (carré noir visible). Le hero prend le fond
     de la page pour que le noir de la vidéo s'y dissolve. */
  #hero { background: var(--bg); isolation: isolate; }

  /* La marque en vidéo : grande, au-dessus du titre, fondue dans la page (screen), sans fond d'attente. */
  .hero-mono {
    position: relative;
    display: block;
    width: clamp(11rem, 17vw, 17rem);
    aspect-ratio: 1;
    margin: -2.5rem 0 clamp(0.5rem, 1.5vw, 1rem) -2rem;
  }
  .hero-mono video, .hero-mono img { position: absolute; inset: 0; width: 100%; height: 100%; background: transparent !important; }
  .hero-mono img { transition: opacity 240ms ease; }
  .hero-mono img.est-cachee { opacity: 0; }
  @media (max-width: 1023px) {
    .hero-mono { width: clamp(9rem, 34vw, 12rem); margin-left: -0.6rem; margin-top: -1.5rem; }
  }

  /* Entrée en CSS pur, sans attendre le chargement complet (titre visible tout de suite en 4G). */
  /* background : l'animation (fill-mode both) fait de ce bloc un contexte d'empilement, où le fondu
     « screen » de la vidéo doit trouver le fond de la page, pas du transparent. */
  .hero-texte { background: var(--bg); animation: hero-in 600ms cubic-bezier(0.23, 1, 0.32, 1) 120ms both; }
  @keyframes hero-in { from { opacity: 0; transform: translateY(10px); } }
  @media (prefers-reduced-motion: reduce) {
    .hero-texte { animation: none; }
  }
</style>
