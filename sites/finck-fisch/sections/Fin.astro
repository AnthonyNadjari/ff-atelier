---
/**
 * Fin — sur mesure Finck & Fisch.
 *
 * REFONTE DU 9 OCT 2026 (benchmark docs/veille/benchmark-2026-10/) : un seul chemin pour parler,
 * écrire, avec l'adresse e-mail en grand comme lien (Pianetti met l'e-mail à la place du bouton
 * « Contact »). Le formulaire reste à un clic (#contact ouvre le tiroir). Plus de bouton plein.
 *
 * Le monogramme F&F, seul élément de marque validé par le fondateur, quitte le premier écran et
 * signe la page ici, comme une signature au bas d'une lettre. Même tracé vectoriel qu'avant
 * (mono-subpaths.ts), en crème plein. Il se trace une fois quand il entre à l'écran (CSS, déclenché
 * par un IntersectionObserver) ; sans JavaScript ou en mouvement réduit, il est simplement posé.
 *
 * TODO(fondateurs) : vrai numéro de téléphone → ajouter sous l'e-mail « Ou appelez le <numéro> »
 * (lien tel()). Le numéro actuel du config est un placeholder et n'est jamais affiché.
 */
import { site, mailto } from '@/lib/site';
---

<section id="parler" class="section-y">
  <div class="container-ff grid gap-14 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-9">
      <h2 class="max-w-3xl text-display-lg" set:html={site.wording.ctaTitle} />
      <p class="mt-6 max-w-[34rem] text-lg leading-relaxed text-muted">{site.wording.ctaText}</p>
      <p class="mt-10">
        <a href={mailto()} class="ff-lien ff-mail font-display text-fg">{site.contact.email}</a>
      </p>
      <p class="mt-5 text-[0.95rem] text-muted">
        Vous préférez un formulaire ? <a href="#contact" class="ff-lien text-fg">Il est ici</a>.
      </p>
    </div>

  </div>
</section>

<script>
  import { onPage } from '@/scripts/page';

  onPage(() => {
    const mono = document.querySelector<SVGElement>('[data-fin-mono]');
    if (!mono || !('IntersectionObserver' in window)) return;
    mono.classList.add('fin-attente');
    const obs = new IntersectionObserver((entrees) => {
      if (entrees.some((e) => e.isIntersecting)) {
        mono.classList.add('fin-trace-on');
        obs.disconnect();
      }
    }, { threshold: 0.4 });
    obs.observe(mono);
    document.addEventListener('astro:before-swap', () => obs.disconnect(), { once: true });
  });
</script>

<style is:global>
  .ff-mail {
    font-size: clamp(1.6rem, 4.2vw, 3.2rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .fin-mono { display: block; width: clamp(7rem, 22vw, 15rem); height: auto; overflow: visible; }
  .fin-fill { fill: var(--fg); }
  .fin-trace { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 1000; stroke-dashoffset: 0; opacity: 0; }

  /* En attente (posé par le script) : corps invisible, trait prêt à se tracer. */
  .fin-attente .fin-fill { opacity: 0; }
  .fin-attente .fin-trace { opacity: 0.8; stroke-dashoffset: 1000; }
  .fin-trace-on .fin-trace { animation: fin-trace 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards, fin-trace-out 0.8s ease 2.6s forwards; animation-delay: calc(0.1s + var(--i) * 0.28s), 2.6s; }
  .fin-trace-on .fin-fill { animation: fin-fill 0.9s cubic-bezier(0.25, 1, 0.5, 1) 2.2s forwards; }
  @keyframes fin-trace { to { stroke-dashoffset: 0; } }
  @keyframes fin-trace-out { to { opacity: 0; } }
  @keyframes fin-fill { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .fin-attente .fin-fill, .fin-trace-on .fin-fill { opacity: 1; animation: none; }
    .fin-attente .fin-trace, .fin-trace-on .fin-trace { opacity: 0; animation: none; }
  }
</style>
