---
/**
 * « Comment ça se passe » — sur mesure Finck & Fisch. Cinq étapes du processus réel
 * (docs/PROCESS.md), en ligne sur desktop (grille à cinq colonnes séparées par un filet vertical,
 * façon frise), empilées sur mobile. Durées reprises telles quelles de la doc : appel de 15 minutes
 * (docs/PROCESS.md § 2), production en 48–72 h (§ 4, cohérent avec le "livré sous 72 h" de la
 * section Offre), fenêtre de corrections de deux semaines (§ 6). Aucune donnée inventée.
 * Appelée par { type: 'custom', variant: 'commentcasepasse' } (pas de label dans le nav).
 */
const etapes = [
  { n: '01', titre: 'Appel', texte: 'Quinze minutes pour comprendre votre activité et ce que le site doit accomplir.' },
  { n: '02', titre: 'Brief et photos', texte: 'Vous nous transmettez vos informations, vos textes et vos photos — ou nous vous aidons à les réunir.' },
  { n: '03', titre: 'Trois propositions', texte: 'Le site est construit en 48 à 72 heures, avec trois directions visuelles différentes.' },
  { n: '04', titre: 'Mise en ligne', texte: 'Le site est publié sur votre nom de domaine, prêt à recevoir vos premiers visiteurs.' },
  { n: '05', titre: 'Remise des clés', texte: 'Deux semaines pour ajuster un texte ou une photo, puis tout vous est transmis : accès, code, domaine.' },
];
---

<section id="comment-ca-se-passe" class="section-y bg-bg-2">
  <div class="container-ff">
    <h2 class="max-w-2xl text-display-md" data-reveal>De l’appel à la mise en ligne.</h2>

    <ol class="mt-14 grid gap-10 border-t border-line pt-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-8" data-stagger="90">
      {etapes.map((e) => (
        <li class="lg:border-l lg:border-line lg:pl-6 lg:first:border-l-0 lg:first:pl-0">
          <span class="font-mono text-sm text-muted">{e.n}</span>
          <h3 class="mt-3 text-display-sm">{e.titre}</h3>
          <p class="mt-2 text-sm text-muted">{e.texte}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
