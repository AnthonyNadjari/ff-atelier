---
/**
 * FAQ (plan-site-ff.html v2) : six questions réelles de site.faq, dont deux sur l'audit, en
 * <details> natifs (rien à charger, ouverts au clavier). Après la section Audit.
 *
 * JSON-LD FAQPage : index.astro ne l'émet que pour une section de type `faq` partagée ; cette section
 * sur mesure l'émet donc elle-même, avec exactement les questions affichées (jamais de schéma pour du
 * contenu invisible). Une seule balise statique, rendue par set:html.
 */
import { site } from '@/lib/site';
import { faqPageLd } from '@/lib/jsonld';

const ld = faqPageLd(site.faq);
const ldJson = ld ? JSON.stringify({ '@context': 'https://schema.org', ...ld }) : '';
---

{site.faq.length > 0 && (
  <section id="faq" class="ff-section ff-faq">
    <div class="ff-conteneur ff-faq-grille">
      <h2 class="ff-titre ff-masque" data-ff-titre><span>Les questions qu’on nous pose</span></h2>
      <div class="ff-faq-liste">
        {site.faq.map((item) => (
          <details class="ff-q">
            <summary class="ff-texte">
              <span>{item.q}</span>
              <svg class="ff-q-signe" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5v14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" /></svg>
            </summary>
            <p class="ff-texte ff-doux">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
{ldJson && <script type="application/ld+json" set:html={ldJson} />}

<style is:global>
  .ff-faq-grille { display: grid; gap: var(--s4); }
  @media (min-width: 1024px) {
    .ff-faq-grille { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s6); }
    .ff-faq-grille > h2 { grid-column: 1 / span 5; }
    .ff-faq-liste { grid-column: 7 / span 6; }
  }
  .ff-q { border-bottom: 1px solid var(--line); }
  .ff-q:first-child { border-top: 1px solid var(--line); }
  .ff-q > summary { display: flex; min-height: 48px; align-items: flex-start; justify-content: space-between; gap: var(--s3); padding-block: 12px; cursor: pointer; list-style: none; color: var(--fg); }
  .ff-q > summary::-webkit-details-marker { display: none; }
  .ff-q > p { max-width: 34rem; padding-bottom: var(--s3); }
  .ff-q-signe { flex-shrink: 0; margin-top: 5px; color: var(--muted); transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1); }
  .ff-q[open] .ff-q-signe { transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) { .ff-q-signe { transition: none; } }
</style>
