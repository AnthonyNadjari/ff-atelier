---
/**
 * Film — sur mesure Finck & Fisch. Extrait 6-18 s du film du studio (F-F/video-pub), muet : trois
 * propositions, les 72 heures, le mur des démonstrations, le prix. L'ouverture (le titre du site,
 * qui ferait doublon juste au-dessus) et la signature finale sont coupées.
 *
 * Squelette : un seul plan bord à bord, sans texte par-dessus, juste sous le titre. Aucun voisin n'en a (règle 19).
 * Règle 16 : c'est l'effet riche de cette zone ; rien d'autre ne bouge dans la section.
 *
 * Poids : rien n'est chargé tant que la section n'approche pas de l'écran (preload="none" + image
 * d'aperçu de 56 Ko). Un seul montage 16:9, jamais recadré, téléphone compris (6 oct :
 * le 9:16 prenait tout l'écran sur iPhone et rejouait le titre de la section suivante ; Safari
 * ignorait en plus <source media> et recadrait le 16:9 en bande verticale). 0,7 à 0,8 Mo chacun, H.264 720p/1280p 30 i/s, faststart.
 * Lecture : en boucle, muette, seulement quand le film est visible ; mis en pause hors écran.
 * prefers-reduced-motion : jamais de lecture automatique, les contrôles natifs sont affichés.
 */
---

<section id="film" class="pb-24 md:pb-32">
  <div>
    <figure class="ff-film">
      <video
        data-film
        muted
        loop
        playsinline
        preload="none"
        poster="/video/film-16x9.webp"
        data-src="/video/film-16x9.mp4"
        aria-label="Extrait du film du studio, 12 s, muet"
      >
      </video>
      <figcaption class="container-ff mt-4 text-sm text-muted">Trois propositions, soixante-douze heures, douze démonstrations, un prix écrit. Film muet.</figcaption>
    </figure>
  </div>
</section>

<style is:global>
  /* Global : evite les data-astro-cid sur chaque balise (budget html de l'accueil). */
  .ff-film video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--ink);
  }
</style>

<script>
  import { onPage } from '@/scripts/page';

  onPage(() => {
    const video = document.querySelector<HTMLVideoElement>('[data-film]');
    if (!video || video.dataset.filmReady) return;
    video.dataset.filmReady = '1';

    // src posé par script, pas par <source> : rien n'est demandé au réseau avant l'approche.
    video.src = video.dataset.src!;

    // Sur téléphone, pas de lecture automatique en bandeau (le texte du film y fait 4 px) : les
    // contrôles natifs, et un toucher ouvre le film en plein écran, à l'horizontale.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || window.matchMedia('(max-width: 639px)').matches) {
      video.controls = true;
      video.preload = 'metadata';
      return;
    }

    // Charge un peu avant l'arrivée à l'écran, lit quand la moitié du film est visible.
    const observer = new IntersectionObserver(
      ([entree]) => {
        if (entree.isIntersecting) {
          if (video.preload === 'none') video.preload = 'auto';
          if (entree.intersectionRatio >= 0.5) video.play().catch(() => (video.controls = true));
        } else {
          video.pause();
        }
      },
      { rootMargin: '200px 0px', threshold: [0, 0.5] },
    );
    observer.observe(video);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  });
</script>
