---
/**
 * Film — sur mesure Finck & Fisch. Le film du studio (F-F/video-pub), refait le 8 oct 2026 sur le site
 * actuel, en entier (21 s), muet.
 *
 * Aucune lecture automatique : une image d'aperçu et un bouton lecture. Rien n'est téléchargé avant
 * le clic (preload="none", src posé au clic). Au clic, la vidéo démarre avec les contrôles natifs ;
 * sur téléphone, elle s'ouvre en plein écran à l'horizontale avec les contrôles du système.
 * Placé après « Comment ça marche » : le film résume la page, il ne la précède pas.
 */
---

<section id="film" class="pb-16 md:pb-24">
  <div class="container-ff">
    <figure class="ff-film">
      <div class="ff-film-cadre">
        <video
          data-film
          muted
          playsinline
          preload="none"
          poster="/video/film-16x9.webp"
          data-src="/video/film-16x9.mp4"
          aria-label="Film du studio, 21 secondes, sans son"
        >
        </video>
        <button type="button" class="ff-film-lire" data-film-lire aria-label="Lire le film du studio">
          <span class="ff-film-lire-icone" aria-hidden="true"></span>
        </button>
      </div>
      <figcaption class="mt-3 text-sm text-muted">Le film du studio, 21 secondes.</figcaption>
    </figure>
  </div>
</section>

<style is:global>
  .ff-film-cadre { position: relative; border: 1px solid var(--line); }
  .ff-film video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--ink); }
  .ff-film-lire {
    position: absolute;
    inset: 50% auto auto 50%;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    translate: -50% -50%;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .ff-film-lire:active { transform: scale(0.95); }
  @media (hover: hover) and (pointer: fine) {
    .ff-film-lire:hover { transform: scale(1.04); }
  }
  .ff-film-lire[hidden] { display: none; }
  .ff-film-lire-icone {
    width: 0;
    height: 0;
    margin-left: 5px;
    border-left: 18px solid currentColor;
    border-top: 11px solid transparent;
    border-bottom: 11px solid transparent;
  }
</style>

<script>
  import { onPage } from '@/scripts/page';

  onPage(() => {
    const video = document.querySelector<HTMLVideoElement>('[data-film]');
    const bouton = document.querySelector<HTMLButtonElement>('[data-film-lire]');
    if (!video || !bouton || video.dataset.filmReady) return;
    video.dataset.filmReady = '1';

    bouton.addEventListener('click', () => {
      if (!video.src) video.src = video.dataset.src!;
      video.controls = true;
      bouton.hidden = true;
      video.play().catch(() => { bouton.hidden = false; });
    });
    video.addEventListener('ended', () => { video.controls = false; bouton.hidden = false; video.currentTime = 0; });
  });
</script>
