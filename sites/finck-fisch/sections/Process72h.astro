---
/**
 * « En ligne trois jours après vos photos » (refonte du 11 oct 2026, soir ; revue adversariale du 13 oct :
 * plus d'ondes, de pouls, de flottement, de halo ni de pilules ; plus de pages « en double », qui
 * étaient la même capture que la piste choisie).
 *
 * Retour fondateur sur la version précédente (trois blocs de texte le long d'un fil) : « beaucoup de
 * scroll pour peu de visuel ». Les trois jours se jouent sur une seule scène, avec de vrais écrans :
 * les trois propositions que l'atelier a réellement générées pour la boulangerie d'exemple Petit Pain
 * (`ff propositions`, mêmes textes, trois looks), capturées en tuiles comme les autres démos.
 * Jour 1 : les trois pistes en éventail, étiquetées. Jour 2 : un toucher choisit la piste 3, les deux
 * autres tombent, deux autres pages de la piste choisie s'ouvrent en éventail. Jour 3 : l'adresse
 * « votre-nom.fr » se tape au-dessus du téléphone, puis « En ligne ».
 * 12 oct 2026, soir : la scène collante pilotée au défilement a été jugée « pas fluide », puis, en
 * étapes, « toujours trop galère ». Plus aucun défilement bloqué : quand la section est visible, les
 * jours s'enchaînent seuls (data-etape, transitions en temps), jauge façon « stories » cliquable.
 * 14 oct 2026 (« les 3 étapes, ça serait pas mal d'avoir un scroll latéral manuel ») : plus rien ne
 * tourne seul. Les trois jours sont une bande qu'on fait glisser sur le côté (défilement natif,
 * aimanté jour par jour) : au doigt sur la bande ou sur les téléphones, au pavé tactile, aux flèches
 * du clavier, ou par les flèches et la jauge. Le jour affiché pose data-etape, la scène suit en temps.
 * Ordinateur : grand chiffre, jauge et texte du jour à gauche, téléphones à droite. Téléphone : texte
 * du jour en haut, téléphones dessous.
 * Réduire les animations ou sans JavaScript : rien ne tourne, les trois jours listés, l'éventail des
 * trois propositions posé.
 */
import DemoVideo from './DemoVideo.astro';

const jours = [
  {
    n: 'Jour 1',
    titre: 'Trois versions de votre page d’accueil',
    texte: 'Nous partons de l’audit, de vos textes et de vos photos, et nous montons trois versions de votre page d’accueil : le même contenu, montré de trois façons. Vous les ouvrez sur votre téléphone.',
  },
  {
    n: 'Jour 2',
    titre: 'Vous en gardez une',
    texte: 'Celle qui vous ressemble. Nous écrivons et montons les autres pages dessus : ce que vous faites, où, quand, et comment vous joindre.',
  },
  {
    n: 'Jour 3',
    titre: 'Publié sur votre nom de domaine',
    texte: 'Vous recevez l’adresse, vous l’ouvrez sur votre téléphone, vous l’envoyez à vos clients.',
  },
];
---

<section id="trois-jours" class="ff-section ff-p72">
  <div class="ff-conteneur">
    <h2 class="ff-titre ff-masque" data-ff-titre><span>En ligne trois jours après vos photos</span></h2>
  </div>
  <div class="ff-p72-scene">
    <div class="ff-p72-colle">
      <div class="ff-p72-texte">
        <div class="ff-p72-nav">
          <div class="ff-p72-jauge">{[1, 2, 3].map((n) => <button type="button" aria-label={`Voir le jour ${n}`}><span></span></button>)}</div>
          <button type="button" class="ff-p72-fleche" data-sens="-1" aria-label="Jour précédent"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
          <button type="button" class="ff-p72-fleche" data-sens="1" aria-label="Jour suivant"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
        </div>
        <div class="ff-p72-ligne">
          <p class="ff-p72-chiffre" aria-hidden="true"><span>1</span><span>2</span><span>3</span></p>
          <ol class="ff-p72-jours" tabindex="0" aria-label="Les trois jours : faites glisser sur le côté">
            {jours.map((j, i) => (
              <li class={`ff-p72-jour ff-p72-j${i + 1}`}>
                <p class="ff-petit ff-p72-n">{j.n}</p>
                <h3 class="ff-p72-titre">{j.titre}</h3>
                <p class="ff-texte ff-doux ff-p72-corps">{j.texte}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="ff-p72-plateau" aria-hidden="true">
        <div class="ff-p72-tel ff-p72-piste ff-p72-g"><DemoVideo slug="piste-boulangerie-1" tel decalage={2} /><span class="ff-p72-etiq">Version 1</span></div>
        <div class="ff-p72-tel ff-p72-piste ff-p72-d"><DemoVideo slug="piste-boulangerie-2" tel decalage={4} /><span class="ff-p72-etiq">Version 2</span></div>
        <div class="ff-p72-centre">
          <div class="ff-p72-flotte">
            <div class="ff-p72-tel ff-p72-choisie">
              <DemoVideo slug="piste-boulangerie-3" tel />
              <span class="ff-p72-etiq ff-p72-etiq-3">Version 3</span>
              <span class="ff-p72-etiq ff-p72-etiq-ok">Gardée</span>
            </div>
          </div>
        </div>
        <p class="ff-p72-adresse"><span class="ff-p72-url">votre-nom.fr</span><span class="ff-p72-enligne">En ligne</span></p>
      </div>
    </div>
  </div>
  <p class="sr-only">Illustration : les trois propositions de page d’accueil faites par l’atelier pour une boulangerie d’exemple ; l’une est choisie, ses autres pages se déploient, puis le site est en ligne.</p>
</section>

<style is:global>
  /* Étapes posées par scene-ff.ts (data-etape, seuils data-etapes) : 0 = avant la scène, 1 = jour 1,
     2 = jour 2, 3 = jour 3. Sans data-etape (sans JavaScript, « réduire les animations ») : le jour 1
     posé, les trois jours listés. Chaque passage est une transition EN TEMPS sur transform/opacity
     (compositeur), plus un mouvement recalculé à chaque image de défilement (12 oct 2026, soir :
     « le 1 2 3 n'est pas fluide et on ne voit pas grand-chose »). */
  .ff-p72 {
    --ff-p72-ease: cubic-bezier(0.77, 0, 0.18, 1);
    --ff-p72-sortie: cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ff-p72-colle {
    position: relative;
    display: grid;
    gap: var(--s4);
    padding-inline: var(--gouttiere);
    overflow: hidden;
  }
  .ff-p72-depart { margin: var(--s3) 0 0; max-width: 30rem; }
  .ff-p72-scene { margin-top: var(--s4); }

  /* Jauge : un segment par jour. */
  .ff-p72-jauge { display: none; gap: 6px; margin-bottom: var(--s1); }
  .ff-p72-jauge > button { flex: 1; padding: 10px 0; margin: 0; border: 0; background: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .ff-p72-jauge > button > span { display: block; width: 100%; height: 3px; border-radius: 2px; background: var(--line); position: relative; overflow: hidden; }
  .ff-p72-jauge > button > span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .ff-p72-ligne { display: grid; gap: var(--s2); }
  .ff-p72-chiffre { display: none; }
  .ff-p72-jours { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); }
  .ff-p72-n { color: var(--accent); margin: 0; }
  .ff-p72-titre { font-family: var(--ff-titres); font-weight: 450; font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1.1; color: var(--fg); margin: 4px 0 var(--s1); }
  .ff-p72-corps { margin: 0; max-width: 32rem; }

  /* Plateau : tout est empilé au même endroit et placé par transform (unités de conteneur). */
  .ff-p72-plateau {
    position: relative;
    height: min(70svh, 600px);
    display: grid;
    place-items: center;
    container-type: size;
  }
  .ff-p72-plateau > * { grid-area: 1 / 1; }
  .ff-p72-tel { width: calc(76cqh * 390 / 844); position: relative; }
  .ff-p72-tel .ff-demo { border-radius: 16px; border: 2px solid color-mix(in srgb, var(--fg) 80%, transparent); background: var(--bg); box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.9); }
  .ff-p72-tel, .ff-p72-centre, .ff-p72-flotte, .ff-p72-adresse, .ff-p72-jour, .ff-p72-chiffre > span { will-change: transform, opacity; }

  /* Étiquettes « Version 1/2/3 », posées AU-DESSUS des écrans (revue du 13 oct 2026 : à cheval sur le
     haut, elles cachaient l'en-tête des démos). */
  .ff-p72-etiq {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    translate: -50% 0;
    padding: 5px 12px;
    border-radius: 4px;
    background: var(--bg-2, var(--bg));
    border: 1px solid var(--line);
    color: var(--fg);
    font-size: 0.8rem;
    font-weight: 600;
    white-space: nowrap;
    z-index: 2;
    transition: opacity 0.4s ease;
  }
  .ff-p72-etiq-ok { background: var(--accent); border-color: var(--accent); color: var(--bg); opacity: 0; }

  /* Pistes non choisies : en éventail au jour 1, puis elles tombent. */
  .ff-p72-piste {
    --sens: -1;
    z-index: 1;
    transform: translate(calc(var(--sens) * 70%), 5%) rotate(calc(var(--sens) * 8deg)) scale(0.84);
    transition: transform 1s var(--ff-p72-ease), opacity 0.6s ease;
  }
  .ff-p72-piste.ff-p72-d { --sens: 1; }
  .ff-p72-piste .ff-demo { filter: brightness(0.85); }


  .ff-p72-centre { z-index: 2; transform: scale(0.94); transition: transform 1s var(--ff-p72-ease), opacity 0.6s ease; }
  /* Liseré de la piste choisie : calque dont seule l'opacité change. */
  .ff-p72-choisie::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    aspect-ratio: 390 / 844;
    border: 2px solid var(--accent);
    border-radius: 16px;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  /* Jour 3 : l'adresse se tape au-dessus du téléphone, puis « En ligne ». */
  .ff-p72-adresse {
    z-index: 3;
    align-self: start;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 9px 9px 14px;
    border-radius: 4px;
    background: var(--fg);
    color: var(--bg);
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
    box-shadow: 0 16px 40px -10px rgb(0 0 0 / 0.8);
    opacity: 0;
    transform: translateY(24px) scale(0.9);
    transition: transform 0.5s ease, opacity 0.3s ease;
  }
  .ff-p72-url { clip-path: inset(0 100% 0 0); }
  .ff-p72-enligne { padding: 3px 10px; border-radius: 4px; background: var(--accent); color: var(--bg); font-size: 0.8rem; opacity: 0; transform: scale(0.6); transition: transform 0.3s ease, opacity 0.2s ease; }
  @keyframes ff-p72-tape { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 -12% 0 0); } }

  /* ---- Étape 0 : avant la scène, tout attend sous le plateau. ---- */
  .ff-p72-scene[data-etape="0"] .ff-p72-piste { opacity: 0; transform: translate(calc(var(--sens) * 20%), 30%) rotate(0) scale(0.84); }
  .ff-p72-scene[data-etape="0"] .ff-p72-centre { opacity: 0; transform: translateY(20%) scale(0.94); }
  /* Entrée du jour 1 : le centre d'abord, les pistes s'ouvrent ensuite. */
  .ff-p72-scene[data-etape="1"] .ff-p72-piste { transition-delay: 0.2s; }

  /* ---- Jour 2 : toucher, les pistes tombent, les pages s'ouvrent. ---- */
  .ff-p72-scene:is([data-etape="2"], [data-etape="3"]) .ff-p72-piste {
    opacity: 0;
    transform: translate(calc(var(--sens) * 95%), 60%) rotate(calc(var(--sens) * 24deg)) scale(0.78);
    transition-delay: 0.35s;
  }
  .ff-p72-scene[data-etape="2"] .ff-p72-centre { transform: scale(1.02); transition-delay: 0.3s; }
  .ff-p72-scene:is([data-etape="2"], [data-etape="3"]) .ff-p72-choisie::after { opacity: 1; transition-delay: 0.3s; }
  .ff-p72-scene:is([data-etape="2"], [data-etape="3"]) .ff-p72-etiq-3 { opacity: 0; }
  .ff-p72-scene[data-etape="2"] .ff-p72-etiq-ok { opacity: 1; transition-delay: 0.35s; }

  /* ---- Jour 3 : les pages se rangent, l'adresse se tape, en ligne. ---- */
  .ff-p72-scene[data-etape="3"] .ff-p72-centre { transform: translateY(5%) scale(1); }
  .ff-p72-scene[data-etape="3"] .ff-p72-adresse { opacity: 1; transform: none; transition: transform 0.7s var(--ff-p72-sortie) 0.5s, opacity 0.4s ease 0.5s; }
  .ff-p72-scene[data-etape="3"] .ff-p72-url { animation: ff-p72-tape 0.9s steps(12, end) 1s both; }
  .ff-p72-scene[data-etape="3"] .ff-p72-enligne { opacity: 1; transform: none; transition: transform 0.5s var(--ff-p72-sortie) 2s, opacity 0.3s ease 2s; }

  /* Jauge et chiffre. */
  .ff-p72-scene:is([data-etape="2"], [data-etape="3"]) .ff-p72-jauge > :nth-child(1) > span::after,
  .ff-p72-scene[data-etape="3"] .ff-p72-jauge > :nth-child(2) > span::after { transform: scaleX(1); }
  .ff-p72-scene[data-etape="1"] .ff-p72-jauge > :nth-child(1) > span::after,
  .ff-p72-scene[data-etape="2"] .ff-p72-jauge > :nth-child(2) > span::after,
  .ff-p72-scene[data-etape="3"] .ff-p72-jauge > :nth-child(3) > span::after { transform: scaleX(1); }

  /* Flèches : précédent / suivant, à côté de la jauge. */
  .ff-p72-nav { display: none; align-items: center; gap: var(--s1); margin-bottom: var(--s1); }
  .ff-p72-nav .ff-p72-jauge { flex: 1; margin: 0; }
  .ff-p72-fleche {
    display: grid; place-items: center; width: 40px; height: 40px; flex: none; margin: 0; padding: 0;
    border: 1px solid var(--line); border-radius: 4px; background: none; color: var(--fg); cursor: pointer;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }
  .ff-p72-fleche:hover { border-color: var(--fg); }
  .ff-p72-fleche:disabled { opacity: 0.3; cursor: default; }

  /* Scène active : collante ; grand chiffre et texte du jour se relaient au même endroit (le sortant
     s'efface vers le haut, l'entrant monte ensuite). */
  @media (prefers-reduced-motion: no-preference) {
    .ff-p72-auto :is(.ff-p72-nav, .ff-p72-jauge) { display: flex; }
    .ff-p72-auto .ff-p72-plateau { touch-action: pan-y; cursor: grab; }
    .ff-p72-auto .ff-p72-ligne { grid-template-columns: auto minmax(0, 1fr); column-gap: var(--s3); align-items: start; }
    .ff-p72-auto .ff-p72-chiffre {
      display: grid;
      margin: 0;
      overflow: hidden;
      font-family: var(--ff-titres);
      font-size: clamp(3.6rem, 9vw, 7.5rem);
      line-height: 1;
      color: var(--accent);
      font-variant-numeric: tabular-nums;
    }
    .ff-p72-auto .ff-p72-n { display: none; }
    /* La bande des trois jours : défilement horizontal natif, aimanté. */
    .ff-p72-auto .ff-p72-jours {
      display: flex;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      outline-offset: 4px;
    }
    .ff-p72-auto .ff-p72-jours::-webkit-scrollbar { display: none; }
    .ff-p72-auto .ff-p72-jours > li { flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always; }
    .ff-p72-auto .ff-p72-chiffre > span {
      grid-area: 1 / 1;
      opacity: 0;
      transform: translateY(-24px);
      transition: transform 0.5s var(--ff-p72-ease), opacity 0.35s ease;
    }
    .ff-p72-auto .ff-p72-chiffre > span { transform: translateY(-70%); }
    .ff-p72-scene:is(:not([data-etape]), [data-etape="0"], [data-etape="1"]) .ff-p72-chiffre > span:nth-child(1),
    .ff-p72-scene[data-etape="2"] .ff-p72-chiffre > span:nth-child(2),
    .ff-p72-scene[data-etape="3"] .ff-p72-chiffre > span:nth-child(3) {
      opacity: 1;
      transform: none;
      transition: transform 0.8s var(--ff-p72-sortie) 0.3s, opacity 0.5s ease 0.3s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ff-p72 *, .ff-p72 *::before, .ff-p72 *::after { transition: none !important; animation: none !important; }
  }

  /* Téléphone et tablette : texte du jour en haut (court), téléphones dessous. */
  @media (max-width: 1023px) {
    .ff-p72-colle { gap: var(--s2); }
    .ff-p72-plateau { height: min(62svh, 560px); }
    .ff-p72-auto .ff-p72-chiffre { font-size: 3.2rem; }
    .ff-p72-corps { font-size: 0.9rem; line-height: 1.45; }
    .ff-p72-titre { font-size: 1.35rem; }
    .ff-p72-tel { width: min(46vw, calc(80cqh * 390 / 844)); }
  }
  @media (max-width: 1023px) and (max-height: 720px) {
    .ff-p72-corps { font-size: 0.82rem; }
    .ff-p72-titre { font-size: 1.15rem; }
  }
  @media (min-width: 1024px) {
    .ff-p72-colle {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      align-items: center;
      column-gap: var(--s6);
      padding-inline: max(var(--gouttiere), calc((100vw - 1200px) / 2));
    }
    .ff-p72-plateau { height: min(84svh, 760px); }
    .ff-p72-auto .ff-p72-ligne { grid-template-columns: minmax(0, 1fr); }
    .ff-p72-auto .ff-p72-chiffre { font-size: clamp(8rem, 16vw, 14rem); line-height: 0.9; }
  }
</style>

<script>
  import { onPage } from '@/scripts/page';

  // 14 oct 2026 (« un scroll latéral manuel ») : plus de minuterie. La bande des jours défile sur le côté
  // (défilement natif, aimanté) ; le jour affiché devient data-etape et la scène le joue en temps. Un
  // glissé horizontal sur les téléphones, les flèches et la jauge font défiler la bande d'un jour.
  // Tant que la section n'a pas été vue : étape 0 (tout attend sous le plateau), pour l'entrée.
  onPage(() => {
    const section = document.querySelector<HTMLElement>('.ff-p72');
    const scene = section?.querySelector<HTMLElement>('.ff-p72-scene');
    const bande = section?.querySelector<HTMLElement>('.ff-p72-jours');
    const plateau = section?.querySelector<HTMLElement>('.ff-p72-plateau');
    if (!section || !scene || !bande || !plateau || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    section.classList.add('ff-p72-auto');
    const fleches = [...section.querySelectorAll<HTMLButtonElement>('.ff-p72-fleche')];
    let vu = false;
    let jour = 1;
    const poser = () => {
      scene.dataset.etape = String(vu ? jour : 0);
      fleches.forEach((f) => { f.disabled = Number(f.dataset.sens) < 0 ? jour === 1 : jour === 3; });
    };
    const aller = (n: number) => {
      const j = Math.min(3, Math.max(1, n));
      bande.scrollTo({ left: (j - 1) * bande.clientWidth, behavior: 'smooth' });
    };
    bande.addEventListener('scroll', () => {
      const j = Math.min(3, Math.max(1, Math.round(bande.scrollLeft / Math.max(1, bande.clientWidth)) + 1));
      if (j !== jour) { jour = j; poser(); }
    }, { passive: true });
    section.querySelectorAll<HTMLButtonElement>('.ff-p72-jauge > button').forEach((b, i) => b.addEventListener('click', () => aller(i + 1)));
    fleches.forEach((f) => f.addEventListener('click', () => aller(jour + Number(f.dataset.sens))));
    // Glissé horizontal sur les téléphones (doigt ou souris) : un jour de plus ou de moins.
    let x0 = 0;
    let y0 = 0;
    let actif = false;
    plateau.addEventListener('pointerdown', (e) => { actif = true; x0 = e.clientX; y0 = e.clientY; });
    plateau.addEventListener('pointerup', (e) => {
      if (!actif) return;
      actif = false;
      const dx = e.clientX - x0;
      const dy = e.clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.2) aller(jour + (dx < 0 ? 1 : -1));
    });
    plateau.addEventListener('pointercancel', () => { actif = false; });
    // Pavé tactile sur les téléphones : un geste horizontal = un jour (pas de rafale).
    let pause = 0;
    plateau.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) < 12 || Math.abs(e.deltaX) < Math.abs(e.deltaY)) return;
      e.preventDefault();
      const t = performance.now();
      if (t < pause) return;
      pause = t + 700;
      aller(jour + (e.deltaX > 0 ? 1 : -1));
    }, { passive: false });
    poser();
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !vu) { vu = true; poser(); io.disconnect(); }
    }, { threshold: 0.5 });
    io.observe(scene);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>
