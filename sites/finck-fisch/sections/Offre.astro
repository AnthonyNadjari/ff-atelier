---
/**
 * Tarifs (plan-site-ff.html v2) : deux formules payées une fois, puis le seul appel de la page,
 * « Réserver mon audit gratuit » (→ /audit).
 *
 * Plan v2 (9 oct 2026) : ancre #tarifs (était #offre) ; la ligne de liens vers les pages
 * /services/* est retirée (pages supprimées, 301 vers /audit, voir redirects.json) ; les questions
 * quittent cette section pour leur propre bloc après l'Audit (Questions.astro, avec JSON-LD
 * FAQPage) ; « Nous écrire pour un devis » devient le bouton d'audit.
 *
 * Historique des choix plus anciens (prix affiché et argumenté, deux plaques plutôt qu'un tableau à
 * cocher, montants en display) : voir git log de ce fichier.
 */
// Montants affichés sans mention « provisoire » à la demande du fondateur (6 oct 2026), barème à
// confirmer par les deux associés (TODO fondateurs).
const formules = [
  { nom: 'Essentiel', montant: '1 200 €' },
  { nom: 'Complet', montant: '1 800 €' },
];

// true/true = commun aux deux formules ; false/true = ajouté par la formule Complet.
const lignes = [
  { label: 'Site de 1 à 5 pages', essentiel: true, complet: true },
  { label: 'Trois propositions visuelles au départ', essentiel: true, complet: true },
  { label: 'Formulaire de contact', essentiel: true, complet: true },
  { label: 'Mentions légales et politique de confidentialité', essentiel: true, complet: true },
  { label: 'Mise en ligne, nom de domaine à votre nom', essentiel: true, complet: true },
  { label: 'Pages villes pour le référencement local', essentiel: false, complet: true },
  { label: 'Retouche de vos photos', essentiel: false, complet: true },
  { label: 'Fiche Google mise à jour', essentiel: false, complet: true },
  { label: 'Deux tours de corrections après la mise en ligne', essentiel: false, complet: true },
];
---

<section id="tarifs" class="ff-section ff-tarifs">
  <div class="ff-conteneur">
    <h2 class="ff-titre ff-masque max-w-2xl" data-ff-titre><span>Combien ça coûte</span></h2>
    <p class="ff-texte mt-6 max-w-[34rem]">Deux formules, payées une fois. Vous savez avant d’appeler si c’est pour vous.</p>

    <div class="mt-8 grid gap-8 md:mt-12 md:grid-cols-2 md:gap-12">
      {formules.map((f, col) => (
        <div class="ff-formule">
          <p class="ff-texte">{f.nom}</p>
          <p class="ff-petit ff-doux mt-4">à partir de</p>
          <p class="ff-titre ff-montant mt-1">{f.montant}</p>
          <p class="ff-petit ff-doux mt-2">payé une fois</p>
          {col === 1 && <p class="ff-petit ff-doux mt-6">Tout l’Essentiel, plus&nbsp;:</p>}
          <ul class={`${col === 1 ? 'mt-3' : 'mt-6'} grid gap-2 ff-petit ff-doux`}>
            {lignes.filter((l) => (col === 0 ? l.essentiel : !l.essentiel && l.complet)).map((l) => <li>{l.label}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-8 flex flex-col items-start gap-4 md:mt-12">
      <a href="/audit" class="ff-bouton">Réserver mon audit gratuit</a>
      <p class="ff-petit ff-doux max-w-[34rem]">
        Après la mise en ligne, rien à payer. Si vous voulez qu’on garde un œil sur le site, la
        maintenance existe en option, 25 € par mois, sans engagement.
      </p>
    </div>
  </div>
</section>

<style is:global>
  .ff-tarifs { background: var(--bg-2); }
  .ff-formule { padding-top: var(--s3); border-top: 1px solid var(--line); }
</style>
