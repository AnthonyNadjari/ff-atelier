---
/**
 * Section Audit (plan-site-ff.html v2, S4 « bascule de thème ») : le seul moment fort de la page,
 * « comme quand on allume la lumière ». Quand elle atteint le milieu de l'écran, motion-ff.ts pose
 * html.ff-creme : les tokens passent d'encre à crème en 0,6 s (ff.css), la nav suit. En remontant ou
 * en la quittant, retour à l'encre. Mouvement réduit : même bascule, instantanée.
 *
 * Contrastes de l'état crème (ff.css) : encre sur crème ≈ 15:1, texte secondaire ≈ 6:1, accent
 * cuivre foncé #8A5A33 ≈ 4,8:1 ; le cuivre clair n'y porte jamais de sens (liens soulignés en encre).
 * Le contenu reste lisible avant la bascule (sans JS, la section est simplement sur fond encre).
 *
 * Le fond de la section est la page elle-même (transparent) : c'est <html> qui change de couleur.
 */
const points = [
  { titre: 'Vitesse mobile', texte: 'Le temps que met votre site à s’afficher sur un téléphone, mesuré.' },
  { titre: 'Google', texte: 'Ce qui apparaît quand on cherche votre métier et votre ville.' },
  { titre: 'Appels', texte: 'Le chemin entre votre page et votre numéro, geste par geste.' },
  { titre: 'Textes', texte: 'Ce qu’un client comprend de votre métier en quelques secondes.' },
  { titre: 'Photos', texte: 'Ce qu’elles montrent de votre travail, et ce qui manque.' },
];
---

<section id="audit" class="ff-audit">
  <div class="ff-conteneur ff-audit-grille">
    <h2 class="ff-titre ff-masque ff-audit-titre" data-ff-titre><span>L’audit gratuit, en 20 minutes.</span></h2>

    <ol class="ff-audit-points">
      {points.map((p, i) => (
        <li>
          <span class="ff-petit ff-doux ff-montant">{i + 1}</span>
          <p class="ff-texte"><span class="ff-audit-point">{p.titre}.</span> <span class="ff-doux">{p.texte}</span></p>
        </li>
      ))}
    </ol>

    <div class="ff-audit-recu">
      <p class="ff-texte">
        Vingt minutes au téléphone ou en visio avec l’un de nous deux. Vous repartez avec ces cinq
        points, concrets, même si vous ne travaillez pas avec nous.
      </p>
      <p class="ff-petit ff-doux mt-4">Pas de relance commerciale ensuite. Réponse sous 48 heures ouvrées.</p>
      <a href="/audit" class="ff-bouton mt-8">Réserver mon audit gratuit</a>
    </div>
  </div>
</section>

<style is:global>
  .ff-audit { padding-block: var(--s8); }
  @media (min-width: 768px) { .ff-audit { padding-block: var(--s12); } }
  @media (min-width: 1024px) { .ff-audit { padding-block: var(--s16); } }
  .ff-audit-grille { display: grid; gap: var(--s6); }
  .ff-audit-titre { max-width: 14ch; }
  .ff-audit-points { list-style: none; margin: 0; padding: 0; display: grid; }
  .ff-audit-points > li { display: grid; grid-template-columns: var(--s4) minmax(0, 1fr); gap: var(--s2); padding-block: var(--s2); border-top: 1px solid var(--line); }
  .ff-audit-points > li > span { padding-top: 6px; }
  .ff-audit-point { font-weight: 600; }
  @media (min-width: 1024px) {
    .ff-audit-grille { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s6); }
    .ff-audit-titre { grid-column: 1 / -1; }
    .ff-audit-points { grid-column: 1 / span 7; }
    .ff-audit-recu { grid-column: 9 / span 4; align-self: start; }
  }
</style>
