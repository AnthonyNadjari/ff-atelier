---
/**
 * Chantier — sur mesure Finck & Fisch, direction éphéméride (refonte du 6 oct 2026).
 *
 * Ce que veut dire 72 heures, sur une réglure où chaque graduation vaut une heure : 73 traits, un
 * trait long toutes les 24 h. Les trois feuilles datées (0 h, 48 h, 72 h) sont posées à leur heure :
 * la première occupe 48 h de réglure, la deuxième 24 h, la troisième arrive au bout. Seul « 72 h »
 * est en rouge. Le rouge de la réglure se remplit avec le défilement (animation liée au scroll,
 * CSS seule ; sans prise en charge ou sous reduced-motion, elle est pleine d'emblée).
 *
 * Les heures viennent de docs/PROCESS.md ; l'engagement reste marqué provisoire, une fois.
 */
const feuilles = [
  { heure: '0', unite: 'h', texte: 'Vos textes et vos photos arrivent, votre logo avec eux s’il existe. Le compte démarre là, pas au premier appel.' },
  { heure: '48', unite: 'h', texte: 'Les trois propositions sont en ligne. Vous ouvrez les trois liens, vous en gardez une.' },
  { heure: '72', unite: 'h', texte: 'Le site est publié sur votre nom de domaine, enregistré à votre nom.' },
];
---

<section id="chantier" class="section-y bg-bg-2">
  <div class="container-ff">
    <h2 class="max-w-3xl text-display-md">Ce que veut dire 72 heures.</h2>
    <p class="mt-6 max-w-[38rem] text-lg leading-relaxed">
      Le délai court à partir du moment où vos éléments sont chez nous. C’est la seule chose que nous
      vous demandons de faire vite.
    </p>

    <div class="ff-temps mt-14">
      <div class="ff-reglure" aria-hidden="true">
        <div class="ff-reglure-rouge"></div>
        <span class="ff-cote" style="left: 0%">0 h</span>
        <span class="ff-cote" style="left: 33.333%">24 h</span>
        <span class="ff-cote" style="left: 66.667%">48 h</span>
        <span class="ff-cote ff-cote-fin" style="left: 100%">72 h</span>
      </div>

      <ol class="ff-jours mt-10">
        {feuilles.map((f, i) => (
          <li class={`ff-jour bg-surface ff-jour-${i}`}>
            <p class={`chiffre-date ff-jour-chiffre ${f.heure === '72' ? 'text-accent' : ''}`}>
              {f.heure}<span class="ff-jour-unite"> {f.unite}</span>
            </p>
            <div class="perforation mt-5" aria-hidden="true"></div>
            <p class="mt-4 leading-relaxed">{f.texte}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 sm:gap-10">
      <p class="max-w-sm leading-relaxed"><strong>Avant.</strong> Un appel de quinze minutes, un devis signé, un acompte. Rien ne part avant.</p>
      <p class="max-w-sm leading-relaxed"><strong>Après.</strong> Deux semaines pour ajuster un texte ou une photo, comprises dans le prix.</p>
    </div>

    {/* ENGAGEMENT PROVISOIRE — à confirmer par les associés avant mise en ligne (docs/HANDOVER.md § P0). */}
    <p class="mt-8 text-sm text-muted">Délai de 72 heures et remise de 10 % en cas de dépassement : engagement provisoire, confirmé au devis.</p>
  </div>
</section>

<style>
  /* La réglure : 73 traits (un par heure), un trait long toutes les 24 h, le tout en tokens. */
  .ff-reglure {
    position: relative;
    height: 2.75rem;
    border-bottom: 2px solid var(--fg);
    background-image:
      linear-gradient(to right, var(--fg) 2px, transparent 2px),
      linear-gradient(to right, var(--line) 1px, transparent 1px);
    background-size: calc(100% / 3 - 0.1px) 1.1rem, calc(100% / 72) 0.55rem;
    background-position: left bottom, left bottom;
    background-repeat: repeat-x;
  }
  .ff-reglure-rouge {
    position: absolute;
    inset: auto 0 -2px 0;
    height: 6px;
    background: var(--accent);
    transform-origin: 0 50%;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .ff-reglure-rouge {
        animation: ff-remplir linear both;
        animation-timeline: view();
        animation-range: entry 30% cover 55%;
      }
    }
  }
  @keyframes ff-remplir { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .ff-cote {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-size: 0.8125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ff-cote:first-of-type { transform: none; }
  .ff-cote-fin { transform: translateX(-100%); color: var(--accent); }

  .ff-jours { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .ff-jour { border: 1px solid var(--line); padding: 1.25rem 1.25rem 1.5rem; }
  .ff-jour-chiffre { font-size: clamp(5rem, 16vw, 7.5rem); }
  .ff-jour-unite { font-size: 0.4em; font-stretch: 100%; margin-left: 0.08em; }

  /* Sur grand écran, chaque feuille occupe sa durée : 48 h, puis 24 h, puis l'arrivée. */
  @media (min-width: 900px) {
    .ff-jours { grid-template-columns: 48fr 24fr; gap: 0; }
    .ff-jour-0 { grid-column: 1; margin-right: 1.25rem; }
    .ff-jour-1 { grid-column: 2; }
    .ff-jour-2 { grid-column: 1 / -1; justify-self: end; width: min(100%, 26rem); margin-top: 1.25rem; }
  }
</style>
