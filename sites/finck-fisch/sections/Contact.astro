---
/**
 * Contact — sur mesure Finck & Fisch, direction éphéméride (refonte du 6 oct 2026).
 *
 * La carte-réponse détachable, posée sur le carton rouge : la page se termine par l'action au lieu
 * d'une FAQ et d'un pied de page (diagnostic du 6 oct : « la page ne demande jamais rien »). Le
 * téléphone d'abord, en grand ; l'e-mail ; puis le formulaire, sur la même carte, sous la perforation.
 */
import { site, tel, mailto } from '@/lib/site';
import ContactForm from '@/components/ContactForm.astro';
---

<section id="contact" class="section-y bg-accent">
  <div class="container-ff">
    <div class="ff-carte mx-auto max-w-4xl bg-surface text-fg">
      <div class="grid gap-10 p-5 sm:p-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-14">
        <div>
          <h2 class="text-display-md" set:html={site.wording.contactTitle} />
          <p class="mt-5 max-w-sm text-lg leading-relaxed">{site.wording.contactText}</p>

          <a href={tel()} class="btn btn-primary mt-8 inline-flex w-full items-center justify-center gap-1 px-6 text-base sm:w-auto" style="min-height: 3.25rem">
            Appeler le <span class="ml-1 tabular-nums">{site.contact.phoneDisplay}</span>
          </a>
          <p class="mt-5">
            <a href={mailto()} class="break-all font-semibold underline">{site.contact.email}</a>
          </p>
          <p class="mt-2 text-sm text-muted">{site.zones.label}{site.contact.hours[0] && <>. {site.contact.hours[0].days}, {site.contact.hours[0].hours}</>}.</p>
        </div>

        <div class="ff-carte-volet">
          <ContactForm />
          {site.form.provider === 'none' && <p class="text-muted">Appelez-nous ou écrivez-nous, nous répondons vite.</p>}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ff-carte { border: 1px solid var(--line); }
  /* Sur téléphone, le formulaire est sous une perforation : la carte se détache en deux. */
  .ff-carte-volet { position: relative; padding-top: 2.5rem; }
  .ff-carte-volet::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 6px;
    background-image: radial-gradient(circle at 3px 3px, var(--line) 1.6px, transparent 2px);
    background-size: 10px 6px;
    background-repeat: repeat-x;
  }
  @media (min-width: 1024px) {
    .ff-carte-volet { padding-top: 0; padding-left: 3.5rem; }
    .ff-carte-volet::before {
      inset: 0 auto 0 0;
      width: 6px;
      height: auto;
      background-size: 6px 10px;
      background-repeat: repeat-y;
    }
  }
</style>
