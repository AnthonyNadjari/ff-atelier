---
/**
 * Réalisations — sur mesure Finck & Fisch. Douze sites de démonstration (un par métier, choisis
 * dans vitrine.json parmi les vingt générés), en LISTE-INDEX : une ligne par métier, numéro en
 * chiffres tabulaires, nom du métier en display, la vignette posée au bout de la ligne. Aucune
 * figure ne pointe vers un lien (pas en ligne) : ce sont des lignes d'index, pas des cartes
 * cliquables — jamais de href="#" vide (interdit par le vérificateur). Vignettes générées depuis
 * captures/<slug>-desktop.png par `ff vitrine` (vitrine.json, une entrée par site) en 1400 et 700 px.
 *
 * Refonte du 22 sept 2026, passage à la coquille `split` : la grille à trois colonnes tenait dans une
 * page pleine largeur, pas dans la colonne de 58 rem qui défile à droite du panneau — trois captures
 * de site par rangée y devenaient illisibles. La liste-index répond au panneau : même famille que le
 * sommaire actif (numéro, filet, un mot), et elle se lit du premier coup d'œil. Pas de `data-hover-img`
 * ici : le monogramme animé du hero est le seul effet riche de la page (règle 16), les vignettes
 * restent donc visibles en permanence, ce qui marche aussi au doigt et au clavier.
 * Règle 21 : un seul groupe animé — le titre, puis la liste entière en une apparition (opacité seule).
 * Un data-stagger sur douze lignes poussait la page à 24 éléments animés, au-delà du seuil de 16
 * de `ff audit-motion` ; la liste arrive donc d'un bloc, comme un index qu'on pose sur la table.
 *
 * Règle dure n°2 (rien d'inventé) : ces douze sites sont des démonstrations, pas des clients. Le
 * titre, l'intro, la légende de chaque ligne et l'alt de chaque vignette le disent en clair ; la ville
 * (fictive) et la « signature » technique de vitrine.json ne sont pas affichées.
 * À remplacer par les vrais sites clients dès leur mise en ligne (docs/HANDOVER.md § P1).
 */
import vitrine from '../vitrine.json';

type Entry = { slug: string; metier: string; ville: string; direction: string; signature: string };
const tous = vitrine as Entry[];

// Douze métiers, une direction visuelle différente à chaque fois autant que possible.
const choisis = [
  'forge-delacroix', 'anna-vidal', 'maison-roux', 'atelier-lecerf',
  'encre-noire', 'chez-malo', 'dubois-plomberie', 'lemaire-avocats',
  'toits-cie', 'jardins-mael', 'maison-aurore', 'barbier-kessler',
];
const sites = choisis.map((slug) => tous.find((s) => s.slug === slug)).filter((s): s is Entry => Boolean(s));
---

<section id="realisations" class="section-y">
  <div class="container-ff">
    <h2 class="max-w-2xl text-display-md" data-reveal>Un site par métier, jamais le même.</h2>
    <p class="mt-5 max-w-2xl text-muted">
      Douze sites de démonstration, un par métier, pour montrer ce que deux artisans différents obtiennent chez nous.
      Nos premiers sites clients prendront leur place ici dès leur mise en ligne.
    </p>

    <ol class="mt-12 border-t border-line" data-reveal>
      {sites.map((s, i) => (
        <li class="grid grid-cols-[2rem_1fr_auto] items-center gap-4 border-b border-line py-4 sm:gap-8 sm:py-5">
          <span class="font-mono text-xs tabular-nums text-muted">{String(i + 1).padStart(2, '0')}</span>
          <div class="min-w-0">
            <h3 class="font-display text-xl leading-tight sm:text-2xl">{s.metier}</h3>
            <p class="mt-1 text-sm text-muted">Démonstration</p>
          </div>
          <div class="w-24 shrink-0 overflow-hidden rounded-card border border-line sm:w-36 lg:w-48">
            <img
              src={`/images/sites/${s.slug}-700.webp`}
              srcset={`/images/sites/${s.slug}-700.webp 700w, /images/sites/${s.slug}.webp 1400w`}
              sizes="(min-width: 1024px) 192px, (min-width: 640px) 144px, 96px"
              width="1400"
              height="900"
              alt={`Site de démonstration pour un métier : ${s.metier.toLowerCase()}`}
              loading="lazy"
              decoding="async"
              class="aspect-[14/9] w-full object-cover object-top"
            />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
