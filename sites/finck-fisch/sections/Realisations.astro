---
/**
 * Réalisations — sur mesure Finck & Fisch.
 *
 * REFONTE DU 9 OCT 2026 (benchmark docs/veille/benchmark-2026-10/) : le travail montré en grand,
 * en lignes asymétriques comme chez Order (une grande image, puis deux de largeurs différentes), avec
 * une légende d'une phrase factuelle sous chaque capture (Pentagram, Astier de Villatte) : métier,
 * ville, et ce que le site a de particulier. Pas de vignettes en grille régulière.
 *
 * Honnêteté : ce sont des sites d'exemple, faits par l'atelier pour montrer chaque métier. C'est dit
 * dans l'intro et rappelé dans le texte alternatif. Les sites d'exemple ne sont pas encore en ligne
 * (aucun domain.txt ni URL publique dans le repo) : les images ne sont donc PAS cliquables.
 * TODO(fondateurs) : quand les démos auront une adresse publique, envelopper chaque <figure> dans un
 * lien vers elle (ne jamais inventer d'URL).
 *
 * La ferronnerie de Toulouse est dans le premier écran (Hero.astro) : elle n'est pas répétée ici.
 */
import vitrine from '../vitrine.json';

type Entry = { slug: string; metier: string; ville: string };
const tous = vitrine as Entry[];

// largeur : nombre de colonnes sur 12 à partir de 1024 px. Lignes : 12 / 7 + 5 / 5 + 7.
const choix = [
  { slug: 'maison-roux', metier: 'Boulangerie-pâtisserie', ligne: 'La fournée du jour écrite comme sur l’ardoise du comptoir.', largeur: 12 },
  { slug: 'encre-noire', metier: 'Studio de tatouage', ligne: 'Les styles et les artistes du studio, face à face, noir sur papier.', largeur: 7 },
  { slug: 'chez-malo', metier: 'Restaurant de poissons', ligne: 'Les horaires du service et la carte du jour avant tout le reste.', largeur: 5 },
  { slug: 'atelier-lecerf', metier: 'Menuisier-ébéniste', ligne: 'Fabrication et restauration racontées côte à côte.', largeur: 5 },
  { slug: 'studio-ambre', metier: 'Architecte d’intérieur', ligne: 'Les projets s’empilent au défilement, une grande image à la fois.', largeur: 7 },
];
const sites = choix
  .map((c) => {
    const e = tous.find((s) => s.slug === c.slug);
    return e ? { ...c, ville: e.ville } : null;
  })
  .filter((s): s is (typeof choix)[number] & { ville: string } => Boolean(s));
const span: Record<number, string> = { 12: 'lg:col-span-12', 7: 'lg:col-span-7', 5: 'lg:col-span-5' };
---

<section id="realisations" class="section-y">
  <div class="container-ff">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="text-display-md lg:col-span-6">Un site par métier</h2>
      <p class="max-w-[32rem] text-lg leading-relaxed text-muted lg:col-span-5 lg:col-start-8">
        Ce sont des exemples : nous les avons faits pour montrer à quoi ressemble le site d’un
        boulanger, d’un tatoueur ou d’un ébéniste. Les premiers sites de clients arrivent.
      </p>
    </div>

    <div class="mt-14 grid gap-x-8 gap-y-16 lg:grid-cols-12 lg:gap-y-20">
      {sites.map((s, i) => (
        <figure class={`min-w-0 ${span[s.largeur]} ${s.largeur === 5 ? 'lg:self-end' : ''}`}>
          <img
            src={`/images/sites/${s.slug}-700.webp`}
            srcset={`/images/sites/${s.slug}-700.webp 700w, /images/sites/${s.slug}.webp 1400w`}
            sizes={s.largeur === 12 ? '(min-width: 1280px) 76rem, 92vw' : s.largeur === 7 ? '(min-width: 1024px) 50vw, 92vw' : '(min-width: 1024px) 36vw, 92vw'}
            width="1400"
            height="900"
            alt={`Site d’exemple, ${s.metier.toLowerCase()} à ${s.ville}`}
            loading="lazy"
            decoding="async"
            class={`w-full border border-line object-cover object-top ${s.largeur === 12 ? 'aspect-[14/9] lg:aspect-[21/10]' : 'aspect-[14/9]'}`}
          />
          <figcaption class="mt-4 grid gap-1 text-[0.95rem] sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-6">
            <span><span class="text-fg">{s.metier}, {s.ville}.</span> <span class="text-muted">{s.ligne}</span></span>
            <span class="text-sm text-muted">Exemple</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style is:global>
  #realisations img { background: var(--surface); }
</style>
