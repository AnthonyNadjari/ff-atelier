---
/**
 * Réalisations — sur mesure Finck & Fisch.
 *
 * REFONTE DU 9 OCT 2026 (benchmark docs/veille/benchmark-2026-10/) : le travail montré en grand,
 * en lignes asymétriques comme chez Order (une grande image, puis deux de largeurs différentes), avec
 * une légende d'une phrase factuelle sous chaque capture (Pentagram, Astier de Villatte) : métier,
 * ville, et ce que le site a de particulier. Pas de vignettes en grille régulière.
 *
 * Honnêteté : ce sont des sites d'exemple, faits par l'atelier pour montrer chaque métier. C'est dit
 * dans l'intro et rappelé dans le texte alternatif. Les sites d'exemple ne sont pas encore en ligne
 * (aucun domain.txt ni URL publique dans le repo) : les images ne sont donc PAS cliquables.
 * TODO(fondateurs) : quand les démos auront une adresse publique, envelopper chaque <figure> dans un
 * lien vers elle (ne jamais inventer d'URL).
 *
 * La ferronnerie de Toulouse est dans le premier écran (Hero.astro) : elle n'est pas répétée ici.
 *
 * Plan v2 (9 oct 2026) : titre au masque et images en clip-path à l'entrée (motion-ff.ts, une fois).
 *
 * 10 oct 2026, soir (retour fondateur : « le premier exemple est beaucoup trop gros, trop zoomé, coupé
 * comme un moule ») : plus de bandeau pleine largeur ni de recadrage. Ordinateur : deux colonnes égales,
 * chaque démo montrée en entier (écran 16:10 de la démo, HD). Téléphone : carrousel d'écrans de
 * téléphone entiers (format 390:844), rien de coupé.
 */
import vitrine from '../vitrine.json';
import DemoVideo from './DemoVideo.astro';

type Entry = { slug: string; metier: string; ville: string };
const tous = vitrine as Entry[];

// bureau : false = téléphone seulement (la forge est déjà dans le hero sur ordinateur).
const choix = [
  { slug: 'forge-delacroix', metier: 'Ferronnerie d’art', ligne: 'Le geste du forgeron en grand, le numéro toujours à portée.', bureau: false },
  { slug: 'maison-roux', metier: 'Boulangerie-pâtisserie', ligne: 'Les horaires sous le nom, la fournée du jour en photo.', bureau: true },
  { slug: 'encre-noire', metier: 'Studio de tatouage', ligne: 'Les styles et les artistes du studio, face à face.', bureau: true },
  { slug: 'chez-malo', metier: 'Restaurant de poissons', ligne: 'Les horaires du service et la carte du jour avant tout le reste.', bureau: true },
  { slug: 'barbier-kessler', metier: 'Barbier', ligne: 'Le rendez-vous en un geste, les trois fauteuils présentés.', bureau: true },
  { slug: 'atelier-lecerf', metier: 'Menuisier-ébéniste', ligne: 'Fabrication et restauration racontées côte à côte.', bureau: true },
  { slug: 'studio-ambre', metier: 'Architecte d’intérieur', ligne: 'Les projets s’empilent au défilement, une grande image à la fois.', bureau: true },
];
const sites = choix
  .map((c) => {
    const e = tous.find((s) => s.slug === c.slug);
    return e ? { ...c, ville: e.ville } : null;
  })
  .filter((s): s is (typeof choix)[number] & { ville: string } => Boolean(s));
---

<section id="realisations" class="ff-section">
  <div class="ff-conteneur">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="ff-titre ff-masque lg:col-span-6" data-ff-titre><span>Un site par métier</span></h2>
      <p class="ff-texte ff-doux max-w-[32rem] lg:col-span-5 lg:col-start-8">
        Ce sont des exemples : nous les avons faits pour montrer à quoi ressemble le site d’un
        boulanger, d’un tatoueur ou d’un ébéniste. Les premiers sites de clients arrivent.
      </p>
    </div>

    {/* Téléphone : carrousel horizontal à faire glisser, un écran de téléphone entier par carte ; la
        suivante dépasse pour inviter au geste. La vidéo jouée est celle de la carte la plus visible
        (demo-video.ts). ≥ 768 px : deux colonnes égales. */}
    <ul class="ff-real-liste mt-8 grid gap-x-8 gap-y-14 md:mt-12 md:grid-cols-2" aria-label="Sites d’exemple">
      {sites.map((s) => (
        <li class={`ff-real-carte min-w-0 ${s.bureau ? '' : 'md:hidden'}`}>
          <figure>
            <DemoVideo
              slug={s.slug}
              sizes="(min-width: 1280px) 600px, (min-width: 768px) 50vw, 60vw"
              revele
            />
            <figcaption class="ff-petit mt-3 grid gap-1 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-6">
              <span><span class="text-fg">{s.metier}, {s.ville}.</span> <span class="text-muted">{s.ligne}</span></span>
              <span class="text-muted max-md:hidden">Exemple</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="ff-petit ff-doux mt-4 md:hidden" aria-hidden="true">Faites glisser pour voir les {sites.length} exemples.</p>
  </div>
</section>

<script>
  import { onPage } from '@/scripts/page';
  import { initDemoVideos } from './demo-video';
  onPage(initDemoVideos);
</script>

<style is:global>
  .ff-real-liste { list-style: none; margin-bottom: 0; padding: 0; }
  /* Survol (souris seulement) : la démo avance d'un rien, la bordure s'éclaire. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    #realisations .ff-demo { transition: border-color 0.4s ease; }
    #realisations .ff-demo :is(img, video) { transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease; }
    #realisations .ff-real-carte:hover .ff-demo { border-color: color-mix(in srgb, var(--fg) 35%, transparent); }
    #realisations .ff-real-carte:hover .ff-demo :is(img, video) { transform: scale(1.02); }
  }
  @media (max-width: 767px) {
    #realisations .ff-real-liste {
      display: flex;
      gap: var(--s2);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gouttiere));
      padding-inline: var(--gouttiere);
      scroll-padding-inline: var(--gouttiere);
    }
    #realisations .ff-real-liste::-webkit-scrollbar { display: none; }
    #realisations .ff-real-carte { flex: 0 0 58%; scroll-snap-align: start; }
  }
</style>
