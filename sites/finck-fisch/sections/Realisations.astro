---
/**
 * Réalisations — sur mesure Finck & Fisch (refonte du 6 oct 2026, retour d'un visiteur : la galerie
 * « fait portfolio généré », le système « Direction X » sous chaque vignette « crie l'IA »).
 * Six sites, pas douze ; une légende minuscule (métier, ville) ; pas de théorie sous les images.
 * Honnêteté : ce sont des démonstrations, dit une fois, en une ligne. Vignettes produites par
 * `ff vitrine` (images/sites/<slug>-700.webp et 1400 px).
 */
import vitrine from '../vitrine.json';

type Entry = { slug: string; metier: string; ville: string };
const tous = vitrine as Entry[];

// Les six plus parlants, avec un intitulé court comme on le dirait (« Ferronnerie », pas « Ferronnerie
// d'art »). Ordre de lecture : grand, grand, puis quatre.
const choix = [
  { slug: 'forge-delacroix', metier: 'Ferronnerie' },
  { slug: 'maison-roux', metier: 'Boulangerie' },
  { slug: 'encre-noire', metier: 'Tatouage' },
  { slug: 'chez-malo', metier: 'Restaurant' },
  { slug: 'atelier-lecerf', metier: 'Ébéniste' },
  { slug: 'studio-ambre', metier: 'Architecte d’intérieur' },
];
const sites = choix
  .map((c) => {
    const e = tous.find((s) => s.slug === c.slug);
    return e ? { ...e, ...c } : null;
  })
  .filter((s): s is Entry => Boolean(s));
---

<section id="realisations" class="section-y">
  <div class="container-ff">
    <h2 class="text-display-md">Quelques sites qu’on a faits</h2>
    <p class="mt-4 max-w-[34rem] text-muted">
      Des démonstrations pour l’instant, une par métier. Les premiers sites clients arrivent.
    </p>

    <div class="ff-planche mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-6" tabindex="0" role="region" aria-label="Sites réalisés, défilement horizontal sur téléphone">
      {sites.map((s, i) => (
        <figure class={`min-w-0 ${i < 2 ? 'lg:col-span-3' : 'lg:col-span-3 xl:col-span-3'}`}>
          <img
            src={`/images/sites/${s.slug}-700.webp`}
            srcset={`/images/sites/${s.slug}-700.webp 700w, /images/sites/${s.slug}.webp 1400w`}
            sizes="(min-width: 1024px) 36rem, (min-width: 640px) 46vw, 82vw"
            width="1400"
            height="900"
            alt={`Site de démonstration, ${s.metier.toLowerCase()} à ${s.ville}`}
            loading="lazy"
            class="aspect-[14/9] w-full border border-line object-cover object-top"
          />
          <figcaption class="mt-3 text-sm text-muted">{s.metier}, {s.ville}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style is:global>
  /* Sur téléphone, les sites défilent au doigt, presque pleine largeur (la suivante dépasse). */
  @media (max-width: 639px) {
    .ff-planche {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      column-gap: 0.875rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.75rem;
      margin-inline: calc(-1 * clamp(1.25rem, 4vw, 2.5rem));
      padding-inline: clamp(1.25rem, 4vw, 2.5rem);
      scroll-padding-inline: clamp(1.25rem, 4vw, 2.5rem);
      scrollbar-width: none;
    }
    .ff-planche::-webkit-scrollbar { display: none; }
    .ff-planche > figure { scroll-snap-align: start; }
  }
  .ff-planche img { transition: border-color 0.25s ease; }
  @media (hover: hover) and (pointer: fine) {
    .ff-planche figure:hover img { border-color: var(--fg); }
  }
</style>
