---
/**
 * Réalisations — sur mesure Finck & Fisch. Douze sites de démonstration (un par métier, choisis
 * dans vitrine.json parmi les vingt générés), en grille simple, légendés par le métier seul.
 * Aucune figure ne pointe vers un lien (pas en ligne) : ce sont des figures, pas des cartes
 * cliquables — jamais de href="#" vide (interdit par le vérificateur). Vignettes générées depuis
 * captures/<slug>-desktop.png par `ff vitrine` (vitrine.json, une entrée par site) en 1400 et 700 px :
 * `sizes` ci-dessous = largeur réelle d'une vignette (3 colonnes gap 2rem dans le conteneur de 1216px
 * = 384px au-delà de 1280px ; 31vw en lg ; 47vw en 2 colonnes), à garder aligné avec scripts/ff/vitrine.mjs.
 *
 * Relecture du 20 sept 2026, règle dure n°2 (rien d'inventé) :
 * - ces vingt sites sont des démonstrations, pas des clients. L'ancien titre « Vingt métiers,
 *   vingt sites » + « ce sont les vraies pages » + une ville par vignette les faisait passer pour
 *   des références. Le titre et l'intro le disent maintenant en clair, la ville (fictive) n'est
 *   plus affichée, l'alt dit « démonstration » ;
 * - la légende « signature » (« data-frames », « data-horizontal », « data-stack »...) exposait
 *   notre jargon technique à des artisans : retirée de l'affichage, conservée dans vitrine.json
 *   pour `ff vitrine` ;
 * - filtre par famille (six pastilles mono en capitales) et data-tilt retirés : gadgets de
 *   template, et douze vignettes se parcourent sans filtre. La section fait moitié moins haut.
 * À remplacer par les vrais sites clients dès leur mise en ligne (docs/HANDOVER.md § P1).
 */
import vitrine from '../vitrine.json';

type Entry = { slug: string; metier: string; ville: string; direction: string; signature: string };
const tous = vitrine as Entry[];

// Douze métiers, une direction visuelle différente à chaque fois autant que possible.
const choisis = [
  'forge-delacroix', 'anna-vidal', 'maison-roux', 'atelier-lecerf',
  'encre-noire', 'chez-malo', 'dubois-plomberie', 'lemaire-avocats',
  'toits-cie', 'jardins-mael', 'maison-aurore', 'barbier-kessler',
];
const sites = choisis.map((slug) => tous.find((s) => s.slug === slug)).filter((s): s is Entry => Boolean(s));
---

<section id="realisations" class="section-y">
  <div class="container-ff">
    <h2 class="max-w-2xl text-display-md" data-reveal>Un site par métier, jamais le même.</h2>
    <p class="mt-5 max-w-2xl text-muted" data-reveal>
      Douze sites de démonstration, un par métier, pour montrer ce que deux artisans différents obtiennent chez nous.
      Nos premiers sites clients prendront leur place ici dès leur mise en ligne.
    </p>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-3 lg:gap-8" data-stagger="60">
      {sites.map((s) => (
        <figure data-reveal>
          <div class="overflow-hidden rounded-card border border-line">
            <img
              src={`/images/sites/${s.slug}.webp`}
              srcset={`/images/sites/${s.slug}-700.webp 700w, /images/sites/${s.slug}.webp 1400w`}
              sizes="(min-width: 1280px) 384px, (min-width: 1024px) 31vw, 47vw"
              width="1400"
              height="900"
              alt={`Site de démonstration pour un métier : ${s.metier.toLowerCase()}`}
              loading="lazy"
              decoding="async"
              class="aspect-[14/9] w-full object-cover object-top"
            />
          </div>
          <figcaption class="mt-3 text-sm text-fg">{s.metier}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
