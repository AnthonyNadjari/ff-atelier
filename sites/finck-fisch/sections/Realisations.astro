---
/**
 * « Un site par métier » (refonte du 11 oct 2026).
 *
 * Retour fondateur sur la version précédente (deux colonnes de captures défilantes) : « les sites ne
 * rendent pas très bien, on voit beaucoup de texte et pas assez d'images, ça ne pète pas aux yeux ».
 * Et sur le mur 3D du haut de page : « c'est TOP, ça ajoute du volume ».
 *
 * Maintenant, une grande carte par métier : la PHOTO du métier en plein cadre (prise dans le site
 * d'exemple, crédits dans CREDITS.md, page /credits), le nom du métier en très grand, et le téléphone
 * de la démo posé dessus, entier, qui défile (DemoVideo.astro). Une seconde photo du site flotte en
 * vignette quand il en a une. La capture n'est jamais recadrée ; seule la photo d'ambiance l'est.
 *
 * Ordinateur (≥ 1024 px) : scène collante, la piste de cartes glisse de droite à gauche au
 * défilement de la page (scene-ff.ts : --p et --dx). Téléphone et tablette : carrousel à faire glisser
 * au doigt. Dans les deux cas chaque carte reçoit --d (distance au centre) : la photo glisse moins vite
 * que la carte, le téléphone pivote et se redresse en arrivant au centre.
 * Réduire les animations : piste à faire glisser (pas de scène collante), rien ne pivote.
 *
 * Honnêteté : ce sont des sites d'exemple, faits par l'atelier ; c'est dit dans l'intro et sur chaque
 * carte. Pas de lien : les démos n'ont pas d'adresse publique (ne jamais inventer d'URL).
 * Atelier Lecerf retiré : son site n'a pas de vraie photo (que des aplats).
 */
import vitrine from '../vitrine.json';
import DemoVideo from './DemoVideo.astro';

type Entry = { slug: string; metier: string; ville: string };
const tous = vitrine as Entry[];

// grand : largeur réelle du plus grand fichier (les originaux font 1 600 à 2 400 px).
// accent : teinte de l'accent réel de la démo, éclaircie pour le fond encre (contraste >= 7:1), posée sur la
// carte seule (ville, liseré du téléphone) : sans JS ni recalcul de toute la page (revue du 13 oct 2026).
const choix = [
  { slug: 'dentaire-morvan', accent: 'hsl(168 38% 62%)', metier: 'Dentiste', ligne: 'Le devis écrit avant une couronne, avec la part remboursée.', grand: 2000, vignette: true },
  { slug: 'maison-roux', accent: 'hsl(32 80% 62%)', metier: 'Boulangerie', ligne: 'Les horaires sous le nom, la fournée du jour en photo.', grand: 1820, vignette: true },
  { slug: 'encre-noire', accent: 'hsl(36 30% 86%)', metier: 'Tatouage', ligne: 'Quatre styles, et à qui s’adresser si votre projet n’y entre pas.', grand: 1600, vignette: true },
  { slug: 'chez-malo', accent: 'hsl(14 70% 66%)', metier: 'Restaurant', ligne: 'La carte écrite chaque matin après la criée, avant tout le reste.', grand: 1600, vignette: true },
  { slug: 'barbier-kessler', accent: 'hsl(150 40% 60%)', metier: 'Barbier', ligne: 'Le samedi sans rendez-vous, écrit sous le nom.', grand: 2000, vignette: true },
  { slug: 'studio-ambre', accent: 'hsl(28 55% 64%)', metier: 'Architecte', ligne: 'Chaque chantier raconté avec sa surface, ses travaux, sa livraison.', grand: 2000, vignette: false },
];
const sites = choix
  .map((c) => {
    const e = tous.find((s) => s.slug === c.slug);
    return e ? { ...c, ville: e.ville } : null;
  })
  .filter((s): s is (typeof choix)[number] & { ville: string } => Boolean(s));
const dossier = '/images/metiers';
---

<section id="realisations" class="ff-section ff-rea">
  <div class="ff-conteneur">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="ff-titre ff-masque lg:col-span-6" data-ff-titre><span>Six sites d’exemple</span></h2>
      <p class="ff-texte ff-doux max-w-[32rem] lg:col-span-5 lg:col-start-8">
        Aucun client derrière : nous les avons faits pour montrer à quoi ressemble le site d’un
        boulanger, d’un tatoueur ou d’un barbier.
      </p>
    </div>
  </div>

  <div class="ff-rea-scene" data-scene data-scene-dx style={`--n: ${sites.length}`}>
    <div class="ff-rea-colle">
      <ul class="ff-rea-piste" data-piste data-couv aria-label="Sites d’exemple" tabindex="0">
        {sites.map((s, i) => (
          <li class="ff-rea-carte" style={`--accent: ${s.accent}`}>
            <img
              class="ff-rea-photo"
              src={`${dossier}/${s.slug}-a-1000.webp`}
              srcset={`${dossier}/${s.slug}-a-1000.webp 1000w, ${dossier}/${s.slug}-a-2000.webp ${s.grand}w`}
              sizes="(min-width: 1024px) 72vw, 88vw"
              width="1000"
              height="667"
              alt=""
              loading="lazy"
              decoding="async"
            />
            {s.vignette && (
              <img class="ff-rea-vignette" src={`${dossier}/${s.slug}-b-700.webp`} width="700" height="525" alt="" loading="lazy" decoding="async" />
            )}
            <div class="ff-rea-texte">
              <p class="ff-petit ff-rea-num">{s.ville}</p>
              <h3 class="ff-rea-metier">{s.metier}</h3>
              <p class="ff-petit ff-rea-ligne">{s.ligne}</p>
            </div>
            <div class="ff-rea-tel">
              <DemoVideo slug={s.slug} tel decalage={i * 2.6} />
            </div>
            <span class="sr-only">{s.metier} à {s.ville}, sur téléphone.</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="ff-conteneur ff-petit ff-doux ff-rea-aide" aria-hidden="true">Faites glisser pour les voir tous.</p>
</section>

<style is:global>
  .ff-rea-tel .ff-demo { border-color: var(--accent); }
  .ff-rea-scene { margin-top: var(--s6); }
  .ff-rea-piste {
    list-style: none;
    margin: 0;
    display: flex;
    gap: var(--s2);
    padding: var(--s2) var(--gouttiere) var(--s3);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gouttiere);
    scrollbar-width: none;
    perspective: 1400px;
  }
  .ff-rea-piste::-webkit-scrollbar { display: none; }

  /* Carte : photo plein cadre, voile pour le texte, téléphone posé à droite. */
  .ff-rea-carte {
    --d: 0;
    --ad: 0;
    position: relative;
    flex: 0 0 min(88vw, 520px);
    aspect-ratio: 3 / 4;
    max-height: 80svh;
    border-radius: 20px;
    overflow: hidden;
    background: var(--surface);
    scroll-snap-align: center;
    isolation: isolate;
  }
  .ff-rea-photo {
    position: absolute;
    inset: 0 -12%;
    width: 124%;
    /* Le reset (preflight) plafonne les img à max-width: 100 % : sans ceci la photo restait à 100 % mais
       décalée de -12 %, d'où une bande sombre à droite de chaque carte (revue DA du 13 oct 2026). */
    max-width: none;
    height: 100%;
    object-fit: cover;
    transform: translateX(calc(var(--d) * -9%)) scale(calc(1.04 + var(--ad) * 0.08));
    filter: brightness(0.8);
    z-index: -2;
  }
  /* Voile des cartes hors centre : opacité seule (un filtre animé repeignait la photo à chaque image). */
  .ff-rea-carte::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg);
    opacity: calc(var(--ad) * 0.45);
  }
  .ff-rea-carte::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.78), rgb(0 0 0 / 0.2) 50%, rgb(0 0 0 / 0.35));
  }
  .ff-rea-texte {
    position: absolute;
    left: var(--s3);
    right: var(--s3);
    top: var(--s3);
    color: var(--fg);
    transform: translateX(calc(var(--d) * 40px));
    opacity: calc(1 - var(--ad) * 0.7);
  }
  .ff-rea-num { color: var(--accent); margin: 0; }
  .ff-rea-metier {
    font-family: var(--ff-titres);
    font-weight: 450;
    font-size: clamp(2.4rem, 10vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 6px 0 var(--s1);
    hyphens: none;
    overflow-wrap: normal;
  }
  .ff-rea-ligne { margin: 0; color: color-mix(in srgb, var(--fg) 80%, transparent); }

  /* Le téléphone : entier, incliné hors du centre, redressé au centre. */
  .ff-rea-tel {
    position: absolute;
    right: var(--s3);
    bottom: var(--s3);
    width: 36%;
    transform-origin: 50% 100%;
    transform:
      scale(calc(1 - var(--ad) * 0.12))
      rotateY(calc(var(--d) * -28deg))
      rotateZ(calc(var(--d) * 6deg));
  }
  .ff-rea-tel .ff-demo {
    border-radius: 18px;
    border: 3px solid color-mix(in srgb, var(--fg) 85%, transparent);
    background: var(--bg);
    box-shadow: 0 30px 50px -18px rgb(0 0 0 / 0.9), 0 0 0 1px rgb(0 0 0 / 0.4);
  }
  /* Seconde photo du site, en vignette inclinée au-dessus du téléphone. */
  .ff-rea-vignette {
    position: absolute;
    left: var(--s3);
    bottom: 12%;
    width: 46%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
    border-radius: 10px;
    border: 3px solid var(--fg);
    box-shadow: 0 20px 40px -14px rgb(0 0 0 / 0.8);
    transform: rotate(calc(-5deg + var(--d) * -8deg)) translateY(calc(var(--d) * 30%));
  }
  .ff-rea-aide { margin-top: var(--s1); }
  .ff-rea-photo, .ff-rea-tel, .ff-rea-vignette, .ff-rea-texte, .ff-rea-carte::before { will-change: transform, opacity; }
  .ff-scenes .ff-rea-piste { will-change: transform; }

  /* Ordinateur : scène collante, la piste glisse au défilement de la page. */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .ff-scenes .ff-rea-scene { height: calc(var(--n) * 38vh + 100svh); margin-top: var(--s4); }
    .ff-scenes .ff-rea-colle {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow: hidden;
      display: flex;
      align-items: center;
    }
    .ff-scenes .ff-rea-piste {
      width: max-content;
      overflow: visible;
      scroll-snap-type: none;
      padding-inline: 14vw;
      gap: 4vw;
      transform: translateX(calc(var(--p, 0) * -1 * var(--dx, 0px)));
    }
    .ff-scenes .ff-rea-aide { display: none; }
  }
  @media (min-width: 1024px) {
    .ff-rea-carte { flex-basis: min(72vw, 1080px); aspect-ratio: 16 / 9; max-height: 80svh; border-radius: 28px; }
    .ff-rea-carte::after {
      background:
        linear-gradient(to top, rgb(0 0 0 / 0.82), rgb(0 0 0 / 0.2) 50%, transparent 75%),
        linear-gradient(to right, rgb(0 0 0 / 0.5), transparent 60%);
    }
    .ff-rea-texte { left: var(--s8); top: auto; bottom: var(--s8); right: 45%; }
    .ff-rea-metier { font-size: clamp(4rem, 7vw, 7.5rem); }
    .ff-rea-ligne { font-size: 1rem; max-width: 26rem; }
    .ff-rea-tel { right: 7%; bottom: 7%; width: 22%; }
    .ff-rea-vignette { left: auto; bottom: auto; right: 32%; top: var(--s6); width: 22%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ff-rea-photo, .ff-rea-texte, .ff-rea-tel, .ff-rea-vignette { transform: none; opacity: 1; filter: brightness(0.8); }
  }
</style>

<script>
  import { onPage } from '@/scripts/page';
  import { initScenes } from './scene-ff';
  onPage(initScenes);
</script>
