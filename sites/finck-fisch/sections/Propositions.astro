---
/**
 * Section sur mesure Finck & Fisch : le principe des trois propositions. Restylé pour rester
 * discret — la démonstration (même boulangerie fictive, trois directions) n'est plus présentée en
 * cartes avec survol/tilt mais en rangée simple, sous une phrase qui se remplit au défilement
 * (data-text-fill) : l'effet de l'écran est porté par le texte, pas par les vignettes. Appelée dans
 * le layout par { type: 'custom', variant: 'propositions' } (pas de label dans le nav).
 *
 * Vignettes : `propositions/demo-boulangerie/prop-{1,2,3}-desktop.png`, redimensionnees en
 * /images/prop-{1,2,3}.webp (sharp, largeur 900, qualite 75). C'est une demonstration interne
 * (meme boulangerie fictive dans les trois cas, trois directions differentes) — pas un client reel,
 * d'ou la mention "(démonstration)" dans chaque legende, comme pour la galerie de la section proof.
 *
 * Emphase du h2 en `<span class="italic text-accent-2">` plutôt qu'en `<em>` : voir
 * sites/finck-fisch/sections/Manifeste.astro (même correctif).
 */
const etapes = [
  { titre: 'Vous nous parlez de votre activité', texte: 'Un appel de quinze minutes, votre métier, vos couleurs, ce que vous aimez ou pas.' },
  { titre: 'Nous construisons trois directions', texte: 'Le même contenu, trois compositions différentes — pas une variante de couleur, trois vraies directions.' },
  { titre: 'Vous choisissez celle qui vous ressemble', texte: 'On affine la direction retenue, on ne recommence pas de zéro.' },
];

const propositions = [
  { src: '/images/prop-1.webp', direction: 'Direction atelier', texte: 'Chaleureuse et artisanale, papier et empreinte manuelle.' },
  { src: '/images/prop-2.webp', direction: 'Direction clair', texte: 'Nette et actuelle, beaucoup de blanc, lecture rapide.' },
  { src: '/images/prop-3.webp', direction: 'Direction rétro', texte: 'Crème et brun seventies, un ton plus affirmé.' },
];
---

<section id="propositions" class="section-y">
  <div class="container-ff">
    <h2 class="max-w-2xl text-display-md" data-reveal>Trois propositions, <span class="italic text-accent-2">pas une maquette.</span></h2>
    <p class="mt-5 max-w-2xl text-muted" data-reveal>
      Les offres d’entrée de gamme livrent un modèle unique, décliné par ville. Nous livrons trois directions
      visuelles construites pour votre contenu, dès le premier rendu — vous choisissez, nous n’imposons pas.
    </p>

    <ol class="mt-12 grid gap-8 border-t border-line pt-10 sm:grid-cols-3" data-stagger="100">
      {etapes.map((e, i) => (
        <li data-reveal>
          <span class="font-mono text-sm text-muted">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-3 text-display-sm">{e.titre}</h3>
          <p class="mt-2 text-sm text-muted">{e.texte}</p>
        </li>
      ))}
    </ol>

    <p class="mt-16 max-w-3xl font-display text-display-sm" data-text-fill>
      Même brief, même contenu — trois compositions qu’on ne confond jamais.
    </p>

    <div class="mt-10 grid gap-8 sm:grid-cols-3" data-stagger="100">
      {propositions.map((p) => (
        <figure data-reveal>
          <img
            src={p.src}
            alt={`Aperçu de la ${p.direction.toLowerCase()}, démonstration sur un site de boulangerie`}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full rounded-card object-cover object-top"
          />
          <figcaption class="mt-3">
            <p class="font-display text-base">{p.direction}</p>
            <p class="mt-1 text-sm text-muted">{p.texte} <span class="text-muted/70">(démonstration)</span></p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
