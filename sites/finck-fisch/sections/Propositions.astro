---
/**
 * Propositions — sur mesure Finck & Fisch (refonte du 6 oct 2026, thème eclipse conservé).
 *
 * L'argument du studio, démontré au lieu d'être dit : UN seul écran, et la même boulangerie de
 * démonstration s'y redessine dans les trois directions (atelier, clair, rétro). Sur ordinateur,
 * l'écran (colonnes 1-9) et les trois onglets (10-12) tiennent ensemble dans la fenêtre : la cause et
 * l'effet se voient en même temps. Le changement de direction est un balayage dans le sens du geste
 * (le même titre reste en place pendant que le style change : « même contenu » se voit).
 *
 * Défilement automatique : piloté par la jauge de l'onglet actif (une seule horloge, CSS), mis en
 * pause au survol de la souris, arrêté pour de bon au premier clic, flèche ou balayage.
 * Accessibilité : vrai tablist (flèches, Début/Fin), panneaux étiquetés. prefers-reduced-motion :
 * ni défilement automatique ni balayage. Sans JS : les trois images l'une sous l'autre.
 * Revue motion du 6 oct (Emil Kowalski / review-animations) appliquée : voir le commit.
 */
const planche = [
  { n: 1, direction: 'Atelier', ambiance: 'Papier crème, serif, chaleur d’atelier.', cadrage: '50%' },
  { n: 2, direction: 'Clair', ambiance: 'Blanc net, bleu franc, bande défilante.', cadrage: '22%' },
  { n: 3, direction: 'Rétro', ambiance: 'Lumière chaude, orange des années 70.', cadrage: '22%' },
];
---

<section id="propositions" class="section-y">
  <div class="container-ff">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="text-display-md lg:col-span-6">Trois sites. Un seul contenu.</h2>
      <p class="max-w-[34rem] leading-relaxed text-muted lg:col-span-5 lg:col-start-8">
        Nous construisons trois sites entiers, sur vos textes et vos photos. Vous recevez trois liens,
        vous en gardez un, nous finissons celui-là. C’est la seule décision que vous avez à prendre.
      </p>
    </div>

    <div class="ff-ecran mt-12" data-ecran>
      <div class="ff-ecran-cadre">
        <div class="ff-ecran-barre" aria-hidden="true">
          <span></span><span></span><span></span>
          <p class="ff-ecran-url">boulangerie-petit-pain.fr</p>
        </div>
        <div class="ff-ecran-vues">
          {planche.map((p, i) => (
            <figure
              class="ff-vue"
              id={`ff-vue-${p.n}`}
              role="tabpanel"
              aria-labelledby={`ff-onglet-${p.n}`}
              data-vue
              data-active={i === 0 ? '' : undefined}
            >
              <img
                src={`/images/propositions/proposition-${p.n}-700.webp`}
                srcset={`/images/propositions/proposition-${p.n}-700.webp 700w, /images/propositions/proposition-${p.n}.webp 1400w`}
                sizes="(min-width: 1024px) 54rem, 94vw"
                width="1400"
                height="900"
                alt={`Boulangerie de démonstration, direction ${p.direction.toLowerCase()} : ${p.ambiance.toLowerCase()}`}
                loading="lazy"
                style={`--cadrage: ${p.cadrage}`}
              />
              <figcaption class="ff-vue-legende">Direction {p.direction.toLowerCase()} · {p.ambiance}</figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="ff-onglets" role="tablist" aria-label="Trois directions, même contenu" data-onglets hidden>
        {planche.map((p, i) => (
          <button
            type="button"
            role="tab"
            id={`ff-onglet-${p.n}`}
            aria-controls={`ff-vue-${p.n}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="ff-onglet"
            data-onglet
          >
            <span class="ff-onglet-nom">{p.direction}</span>
            <span class="ff-onglet-texte">{p.ambiance}</span>
            <span class="ff-onglet-jauge" aria-hidden="true"></span>
          </button>
        ))}
      </div>
    </div>

    <p class="mt-8 max-w-[38rem] text-sm text-muted">
      Une boulangerie de démonstration&nbsp;: même titre, même paragraphe, même numéro sur les trois.
      Seule la direction change.
    </p>
  </div>
</section>

<style is:global>
  /* L'écran : un navigateur réduit à l'essentiel, sans ombre portée (eclipse : profondeur par la
     lumière). Les vues se superposent dans une même cellule de grille. */
  .ff-ecran-cadre { border: 1px solid var(--line); background: var(--surface); min-width: 0; }
  .ff-ecran-barre { display: flex; align-items: center; gap: 0.4rem; padding: 0.7rem 0.9rem; border-bottom: 1px solid var(--line); }
  .ff-ecran-barre > span { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: var(--line); }
  .ff-ecran-url { margin-inline: auto; padding-right: 1.4rem; font-size: 0.75rem; color: var(--muted); letter-spacing: 0.02em; }

  .ff-ecran-vues { display: grid; overflow: hidden; touch-action: pan-y; }
  .ff-vue { margin: 0; }
  .ff-vue img {
    display: block;
    width: 100%;
    aspect-ratio: 14 / 9;
    object-fit: cover;
    object-position: 50% 0;
  }
  .ff-vue-legende { padding: 0.75rem 0.9rem; font-size: 0.875rem; color: var(--muted); border-top: 1px solid var(--line); }

  /* Mode écran (posé par le script) : la vue active par-dessus, la sortante dessous jusqu'à la fin
     du balayage, les autres masquées. */
  [data-ecran-actif] .ff-ecran-vues > .ff-vue { grid-area: 1 / 1; visibility: hidden; }
  [data-ecran-actif] .ff-ecran-vues > .ff-vue[data-sortante] { visibility: visible; z-index: 1; }
  [data-ecran-actif] .ff-ecran-vues > .ff-vue[data-active] { visibility: visible; z-index: 2; }
  [data-ecran-actif] .ff-vue-legende { display: none; }

  .ff-onglets { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; margin-top: 1.5rem; }
  .ff-onglets[hidden] { display: none; }
  .ff-onglet {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 3.5rem;
    padding: 0.9rem 0 0.6rem;
    text-align: left;
    border-top: 1px solid var(--line);
    color: var(--muted);
    transition: color 0.2s ease;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .ff-onglet[aria-selected='true'] { color: var(--fg); }
  @media (hover: hover) and (pointer: fine) {
    .ff-onglet:hover { color: var(--fg); }
  }
  .ff-onglet-nom { font-family: var(--font-display); font-size: 1.375rem; line-height: 1.1; }
  .ff-onglet-texte { font-size: 0.875rem; }
  /* La jauge : un filet qui se remplit sur le bord de l'onglet actif. C'est l'horloge du défilement
     automatique (fin d'animation = vue suivante). */
  .ff-onglet-jauge {
    position: absolute;
    inset: -1px 0 auto 0;
    height: 1px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .ff-onglet[aria-selected='true'] .ff-onglet-jauge { transform: scaleX(1); }
  [data-defile] .ff-onglet[aria-selected='true'] .ff-onglet-jauge { animation: ff-jauge 4s linear both; }
  [data-defile][data-pause] .ff-onglet[aria-selected='true'] .ff-onglet-jauge { animation-play-state: paused; }
  @keyframes ff-jauge { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  /* Grand écran : l'écran (colonnes 1-9, hauteur plafonnée) et les onglets (10-12) dans la même
     fenêtre. Les onglets deviennent une liste verticale ; la jauge, un filet vertical. */
  @media (min-width: 1024px) {
    .ff-ecran { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2.5rem; align-items: start; }
    .ff-ecran-cadre { grid-column: 1 / span 9; }
    .ff-vue img { max-height: min(64vh, 600px); }
    .ff-onglets { grid-column: 10 / span 3; grid-template-columns: 1fr; gap: 0; margin-top: 0; }
    .ff-onglet { border-top: 0; border-left: 1px solid var(--line); padding: 1.1rem 0 1.1rem 1.25rem; }
    .ff-onglet-jauge { inset: 0 auto 0 -1px; width: 1px; height: auto; transform: scaleY(0); transform-origin: 50% 0; }
    .ff-onglet[aria-selected='true'] .ff-onglet-jauge { transform: scaleY(1); }
    @keyframes ff-jauge { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  }

  /* Téléphone : cadrage 4:5 sur la partie du site qui porte le titre, pour qu'on lise vraiment la
     boulangerie (la capture d'ordinateur réduite à 353 px était illisible). */
  @media (max-width: 639px) {
    .ff-vue img { aspect-ratio: 4 / 5; object-position: var(--cadrage, 50%) 0; }
    .ff-onglet-texte { display: none; }
    .ff-onglet-nom { font-size: 1.125rem; }
  }
</style>

<script>
  import { onPage } from '@/scripts/page';

  onPage(() => {
    const ecran = document.querySelector<HTMLElement>('[data-ecran]');
    if (!ecran || ecran.dataset.ecranReady) return;
    ecran.dataset.ecranReady = '1';

    const vues = Array.from(ecran.querySelectorAll<HTMLElement>('[data-vue]'));
    const onglets = Array.from(ecran.querySelectorAll<HTMLButtonElement>('[data-onglet]'));
    const liste = ecran.querySelector<HTMLElement>('[data-onglets]');
    if (vues.length < 2 || !liste) return;

    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const COURBE = 'cubic-bezier(0.77, 0, 0.175, 1)';
    ecran.setAttribute('data-ecran-actif', '');
    liste.hidden = false;
    let courant = 0;

    // Balayage dans le sens du geste : la vue entrante se découvre depuis la droite (suivante) ou la
    // gauche (précédente) ; la sortante reste dessous jusqu'à la fin. Transition CSS (pas d'images
    // clés) : des clics rapides redirigent le balayage en douceur au lieu de le relancer.
    const montrer = (cible: number, sens: number, duree: number, focus = false) => {
      const i = (cible + vues.length) % vues.length;
      if (i === courant) return;
      const avant = vues[courant];
      const apres = vues[i];
      vues.forEach((v) => { if (v !== avant && v !== apres) { v.removeAttribute('data-sortante'); v.removeAttribute('data-active'); } });
      avant.removeAttribute('data-active');
      avant.setAttribute('data-sortante', '');
      if (!reduit) {
        apres.style.transition = 'none';
        apres.style.clipPath = sens > 0 ? 'inset(0 0 0 100%)' : 'inset(0 100% 0 0)';
      }
      apres.setAttribute('data-active', '');
      if (!reduit) {
        void apres.offsetWidth;
        apres.style.transition = `clip-path ${duree}ms ${COURBE}`;
        apres.style.clipPath = 'inset(0)';
        window.setTimeout(() => { if (!apres.hasAttribute('data-active')) return; avant.removeAttribute('data-sortante'); }, duree + 30);
      } else {
        avant.removeAttribute('data-sortante');
      }
      courant = i;
      onglets.forEach((o, k) => {
        o.setAttribute('aria-selected', k === courant ? 'true' : 'false');
        o.tabIndex = k === courant ? 0 : -1;
      });
      if (focus) onglets[courant].focus();
    };

    // Défilement automatique : l'horloge est la jauge CSS de l'onglet actif (fin d'animation = vue
    // suivante). Visible à l'écran seulement ; pause au survol ; arrêt définitif au premier geste.
    let arrete = reduit;
    const arreter = () => { arrete = true; ecran.removeAttribute('data-defile'); ecran.removeAttribute('data-pause'); };
    liste.addEventListener('animationend', (e) => {
      if (arrete || (e as AnimationEvent).animationName !== 'ff-jauge') return;
      montrer(courant + 1, 1, 700);
    });
    const visible = new IntersectionObserver(([e]) => {
      if (arrete) return;
      ecran.toggleAttribute('data-defile', e.isIntersecting);
    }, { threshold: 0.5 });
    visible.observe(ecran);
    document.addEventListener('astro:before-swap', () => visible.disconnect(), { once: true });
    ecran.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') ecran.setAttribute('data-pause', ''); });
    ecran.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') ecran.removeAttribute('data-pause'); });

    onglets.forEach((o, k) => o.addEventListener('click', () => { arreter(); montrer(k, k > courant ? 1 : -1, 380); }));
    liste.addEventListener('keydown', (e) => {
      const touches: Record<string, [number, number]> = {
        ArrowRight: [courant + 1, 1], ArrowDown: [courant + 1, 1], ArrowLeft: [courant - 1, -1], ArrowUp: [courant - 1, -1],
        Home: [0, -1], End: [vues.length - 1, 1],
      };
      const t = touches[e.key];
      if (!t) return;
      e.preventDefault();
      arreter();
      montrer(t[0], t[1], 380, true);
    });

    // Au doigt : un balayage nettement horizontal (ou un geste vif) change de direction ; le
    // défilement vertical de la page n'est jamais capturé (touch-action: pan-y).
    let x0 = 0, y0 = 0, t0 = 0, actif = false;
    const cadre = ecran.querySelector<HTMLElement>('.ff-ecran-vues');
    cadre?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; t0 = performance.now(); actif = true; }, { passive: true });
    cadre?.addEventListener('touchend', (e) => {
      if (!actif) return;
      actif = false;
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      const vif = Math.abs(dx) / Math.max(1, performance.now() - t0) > 0.11 && Math.abs(dx) > Math.abs(dy);
      if ((Math.abs(dx) > 40 && Math.abs(dx) > 1.5 * Math.abs(dy)) || vif) {
        arreter();
        montrer(courant + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1, 380);
      }
    });
  });
</script>
