---
/**
 * Propositions — sur mesure Finck & Fisch (refonte du 6 oct 2026, thème eclipse conservé).
 *
 * L'argument du studio, démontré au lieu d'être dit : UN seul écran, et la même boulangerie de
 * démonstration s'y redessine dans les trois directions (atelier, clair, rétro). Trois onglets sous
 * l'écran ; sans interaction, l'écran change seul toutes les 4 s tant qu'il est visible, et s'arrête
 * dès que le visiteur touche un onglet ou survole l'écran. Remplace la rangée de trois cartes égales
 * (la mise en page « générée » par excellence, diagnostic Impeccable du 6 oct).
 *
 * Accessibilité : vrai tablist (flèches gauche/droite, Début/Fin), panneaux étiquetés ; les trois
 * images restent dans le DOM. prefers-reduced-motion : pas de défilement automatique, fondu coupé.
 * Sans JS : les trois images s'affichent l'une sous l'autre avec leur légende.
 */
const planche = [
  { n: 1, direction: 'Atelier', ambiance: 'Papier crème, serif, chaleur d’atelier.' },
  { n: 2, direction: 'Clair', ambiance: 'Blanc net, bleu franc, bande défilante.' },
  { n: 3, direction: 'Rétro', ambiance: 'Lumière chaude, orange des années 70.' },
];
---

<section id="propositions" class="section-y">
  <div class="container-ff">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="text-display-md lg:col-span-6">Trois sites. Un seul contenu.</h2>
      <p class="max-w-[34rem] leading-relaxed text-muted lg:col-span-5 lg:col-start-8">
        Nous construisons trois sites entiers, sur vos textes et vos photos. Vous recevez trois liens,
        vous en gardez un, nous finissons celui-là. C’est la seule décision que vous avez à prendre.
      </p>
    </div>

    <div class="ff-ecran mt-12" data-ecran>
      <div class="ff-ecran-cadre">
        <div class="ff-ecran-barre" aria-hidden="true">
          <span></span><span></span><span></span>
          <p class="ff-ecran-url">boulangerie-petit-pain.fr</p>
        </div>
        <div class="ff-ecran-vues">
          {planche.map((p, i) => (
            <figure
              class="ff-vue"
              id={`ff-vue-${p.n}`}
              role="tabpanel"
              aria-labelledby={`ff-onglet-${p.n}`}
              data-vue
              data-active={i === 0 ? '' : undefined}
            >
              <img
                src={`/images/propositions/proposition-${p.n}-700.webp`}
                srcset={`/images/propositions/proposition-${p.n}-700.webp 700w, /images/propositions/proposition-${p.n}.webp 1400w`}
                sizes="(min-width: 1280px) 72rem, 94vw"
                width="1400"
                height="900"
                alt={`Boulangerie de démonstration, direction ${p.direction.toLowerCase()} : ${p.ambiance.toLowerCase()}`}
                loading="lazy"
                class="aspect-[14/9] w-full object-cover object-top"
              />
              <figcaption class="ff-vue-legende">Direction {p.direction.toLowerCase()} · {p.ambiance}</figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="ff-onglets mt-6" role="tablist" aria-label="Trois directions, même contenu" data-onglets hidden>
        {planche.map((p, i) => (
          <button
            type="button"
            role="tab"
            id={`ff-onglet-${p.n}`}
            aria-controls={`ff-vue-${p.n}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="ff-onglet"
            data-onglet
          >
            <span class="ff-onglet-nom">{p.direction}</span>
            <span class="ff-onglet-texte">{p.ambiance}</span>
            <span class="ff-onglet-jauge" aria-hidden="true"></span>
          </button>
        ))}
      </div>
    </div>

    <p class="mt-8 max-w-[38rem] text-sm text-muted">
      Une boulangerie de démonstration : même titre, même paragraphe, même numéro sur les trois.
      Seule la direction change.
    </p>
  </div>
</section>

<style is:global>
  /* L'écran : un navigateur réduit à l'essentiel, sans ombre portée (eclipse : profondeur par la
     lumière). Les vues se superposent dans une même cellule de grille et se relaient en fondu. */
  .ff-ecran-cadre { border: 1px solid var(--line); background: var(--surface); }
  .ff-ecran-barre {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .ff-ecran-barre > span { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: var(--line); }
  .ff-ecran-url {
    margin-inline: auto;
    padding-right: 1.4rem;
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .ff-ecran-vues { display: grid; }
  .ff-vue { margin: 0; }
  .ff-vue-legende { padding: 0.75rem 0.9rem; font-size: 0.875rem; color: var(--muted); border-top: 1px solid var(--line); }

  /* Mode écran (posé par le script) : une seule vue visible à la fois. */
  [data-ecran-actif] .ff-ecran-vues > .ff-vue {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-brand), visibility 0s linear 0.6s;
  }
  [data-ecran-actif] .ff-ecran-vues > .ff-vue[data-active] {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s var(--ease-brand), visibility 0s;
  }
  [data-ecran-actif] .ff-vue-legende { display: none; }

  .ff-onglets { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .ff-onglets[hidden] { display: none; }
  .ff-onglet {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 3.5rem;
    padding: 0.9rem 0 0.6rem;
    text-align: left;
    border-top: 1px solid var(--line);
    color: var(--muted);
    transition: color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .ff-onglet:hover, .ff-onglet[aria-selected='true'] { color: var(--fg); }
  .ff-onglet-nom { font-family: var(--font-display); font-size: 1.375rem; line-height: 1.1; }
  .ff-onglet-texte { font-size: 0.875rem; }
  /* La jauge du défilement automatique : un filet qui se remplit sur le bord haut de l'onglet actif. */
  .ff-onglet-jauge {
    position: absolute;
    inset: -1px 0 auto 0;
    height: 1px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .ff-onglet[aria-selected='true'] .ff-onglet-jauge { transform: scaleX(1); }
  [data-defile] .ff-onglet[aria-selected='true'] .ff-onglet-jauge { animation: ff-jauge 4s linear both; }
  @keyframes ff-jauge { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  @media (max-width: 639px) {
    .ff-onglet-texte { display: none; }
    .ff-onglet-nom { font-size: 1.125rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-ecran-actif] .ff-ecran-vues > .ff-vue,
    [data-ecran-actif] .ff-ecran-vues > .ff-vue[data-active] { transition: none; }
  }
</style>

<script>
  import { onPage } from '@/scripts/page';

  onPage(() => {
    const ecran = document.querySelector<HTMLElement>('[data-ecran]');
    if (!ecran || ecran.dataset.ecranReady) return;
    ecran.dataset.ecranReady = '1';

    const vues = Array.from(ecran.querySelectorAll<HTMLElement>('[data-vue]'));
    const onglets = Array.from(ecran.querySelectorAll<HTMLButtonElement>('[data-onglet]'));
    const liste = ecran.querySelector<HTMLElement>('[data-onglets]');
    if (vues.length < 2 || !liste) return;

    ecran.setAttribute('data-ecran-actif', '');
    liste.hidden = false;
    let courant = 0;

    const montrer = (i: number, focus = false) => {
      courant = (i + vues.length) % vues.length;
      vues.forEach((v, k) => v.toggleAttribute('data-active', k === courant));
      onglets.forEach((o, k) => {
        o.setAttribute('aria-selected', k === courant ? 'true' : 'false');
        o.tabIndex = k === courant ? 0 : -1;
      });
      if (focus) onglets[courant].focus();
    };

    // Défilement automatique : jamais sous reduced-motion, seulement à l'écran, et définitivement
    // coupé au premier geste du visiteur.
    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let minuterie = 0;
    let arrete = reduit;
    const arreter = () => { arrete = true; window.clearInterval(minuterie); ecran.removeAttribute('data-defile'); };
    const lancer = () => {
      if (arrete) return;
      window.clearInterval(minuterie);
      ecran.setAttribute('data-defile', '');
      minuterie = window.setInterval(() => {
        montrer(courant + 1);
        // Relance la jauge de l'onglet devenu actif.
        ecran.removeAttribute('data-defile'); void ecran.offsetWidth; ecran.setAttribute('data-defile', '');
      }, 4000);
    };
    const visible = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) lancer(); else { window.clearInterval(minuterie); ecran.removeAttribute('data-defile'); }
    }, { threshold: 0.5 });
    visible.observe(ecran);
    document.addEventListener('astro:before-swap', () => { visible.disconnect(); window.clearInterval(minuterie); }, { once: true });

    onglets.forEach((o, k) => o.addEventListener('click', () => { arreter(); montrer(k); }));
    liste.addEventListener('keydown', (e) => {
      const touches: Record<string, number> = { ArrowRight: courant + 1, ArrowLeft: courant - 1, Home: 0, End: vues.length - 1 };
      if (!(e.key in touches)) return;
      e.preventDefault();
      arreter();
      montrer(touches[e.key], true);
    });
    ecran.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') arreter(); });

    // Au doigt : balayer l'écran vers la gauche ou la droite change de direction.
    let x0: number | null = null;
    const cadre = ecran.querySelector<HTMLElement>('.ff-ecran-vues');
    cadre?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    cadre?.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 50) { arreter(); montrer(courant + (dx < 0 ? 1 : -1)); }
    });
  });
</script>
