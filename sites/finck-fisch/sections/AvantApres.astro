---
/**
 * Avant / après au curseur (plan-site-ff.html v2, S3).
 *
 * Deux captures réelles du premier écran de Maison Roux, notre boulangerie d'exemple à Lyon : la
 * version 1 (le site tel qu'il était avant le commit 69799eb du 9 oct 2026) et la version 2
 * (aujourd'hui), prises à 1440×900 et à 390×844 (téléphone), en WebP dans
 * public/images/avant-apres/. Ce sont nos deux versions, pas le site d'un client : c'est dit.
 *
 * La version 2 est par-dessus, découpée par clip-path: inset(0 0 0 X%) ; la poignée est à X %.
 * Interaction : glisser à la souris ou au doigt (pointer events + capture), flèches du clavier
 * (role="slider", aria-valuenow, pas de 5 %, Page préc./suiv. 10 %, Début/Fin 0 et 100 %).
 * Indice une seule fois à l'entrée (motion-ff.ts) : 50 → 38 → 50 %, 1,2 s ; mouvement réduit :
 * pas d'indice. Sans JavaScript : les deux moitiés à 50 %, rien ne bouge.
 */
const pas = 5;
---

<section id="avant-apres" class="ff-section">
  <div class="ff-conteneur ff-aa-grille">
    <div class="ff-aa-tete">
      <h2 class="ff-titre ff-masque" data-ff-titre><span>Ce que change un vrai site</span></h2>
      <p class="ff-texte ff-doux mt-6 max-w-[34rem]">
        Deux versions de la même boulangerie d’exemple, faites par nous. Glissez pour passer de la
        première à celle d’aujourd’hui.
      </p>
    </div>

    <figure class="ff-aa-figure">
      <div class="ff-aa" data-aa>
        <picture>
          <source media="(max-width: 767px)" srcset="/images/avant-apres/roux-v1-mobile.webp" width="780" height="1688" />
          <img class="ff-aa-img" src="/images/avant-apres/roux-v1.webp" srcset="/images/avant-apres/roux-v1-960.webp 960w, /images/avant-apres/roux-v1.webp 1440w" sizes="(min-width: 1024px) 760px, 100vw" width="1440" height="900" alt="Maison Roux, version 1 : le nom en très grand sur fond caramel, les horaires dessous, sans photo." loading="lazy" decoding="async" />
        </picture>
        <picture>
          <source media="(max-width: 767px)" srcset="/images/avant-apres/roux-v2-mobile.webp" width="780" height="1688" />
          <img class="ff-aa-img ff-aa-apres" data-aa-apres src="/images/avant-apres/roux-v2.webp" srcset="/images/avant-apres/roux-v2-960.webp 960w, /images/avant-apres/roux-v2.webp 1440w" sizes="(min-width: 1024px) 760px, 100vw" width="1440" height="900" alt="Maison Roux, version 2 : le nom, les horaires et l’adresse à gauche, la photo des baguettes à droite." loading="lazy" decoding="async" />
        </picture>
        <span class="ff-aa-etiquette ff-petit" aria-hidden="true">Version 1</span>
        <span class="ff-aa-etiquette ff-aa-etiquette-droite ff-petit" aria-hidden="true">Version 2</span>
        <div class="ff-aa-rail" data-aa-rail>
          <div
            class="ff-aa-poignee"
            role="slider"
            tabindex="0"
            aria-label="Comparer la version 1 et la version 2"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="50"
            aria-valuetext="Moitié version 1, moitié version 2"
            data-aa-poignee
            data-pas={pas}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
        </div>
      </div>
      <figcaption class="ff-petit ff-doux mt-3">Maison Roux, boulangerie d’exemple à Lyon. À gauche notre première version, à droite celle d’aujourd’hui.</figcaption>
    </figure>

    <ul class="ff-aa-points ff-texte">
      <li><span class="text-fg">Le pain dès le premier écran.</span> <span class="ff-doux">La photo des baguettes à côté des horaires, au lieu du nom seul en très grand.</span></li>
      <li><span class="text-fg">Les horaires en premier.</span> <span class="ff-doux">Lisibles d’un coup d’œil sur un téléphone, avant tout le reste.</span></li>
      <li><span class="text-fg">L’adresse complète et le numéro.</span> <span class="ff-doux">Le code postal en plus, et un toucher pour appeler.</span></li>
    </ul>
  </div>
</section>

<script>
  import { onPage } from '@/scripts/page';

  onPage(() => {
    const el = document.querySelector<HTMLElement & { ffAa?: { poser(p: number): void; touche(): boolean } }>('[data-aa]');
    if (!el || el.ffAa) return;
    const apres = el.querySelector<HTMLElement>('[data-aa-apres]')!;
    const rail = el.querySelector<HTMLElement>('[data-aa-rail]')!;
    const poignee = el.querySelector<HTMLElement>('[data-aa-poignee]')!;
    const pas = Number(poignee.dataset.pas) || 5;
    let valeur = 50;
    let touche = false;

    // transform et clip-path seulement (aucune propriété de mise en page). Le rail fait toute la
    // largeur : translateX(p %) le décale de p % de la figure, poignée comprise.
    const poser = (p: number) => {
      valeur = Math.min(100, Math.max(0, p));
      apres.style.clipPath = `inset(0 0 0 ${valeur}%)`;
      rail.style.transform = `translateX(${valeur}%)`;
    };
    const annoncer = () => {
      const v = Math.round(valeur);
      poignee.setAttribute('aria-valuenow', String(v));
      poignee.setAttribute('aria-valuetext', v === 0 ? 'Version 2 seule' : v === 100 ? 'Version 1 seule' : `Version 1 sur ${v} %, version 2 sur ${100 - v} %`);
    };
    el.ffAa = { poser, touche: () => touche };
    el.classList.add('est-pret');

    const depuisPointeur = (x: number) => {
      const r = el.getBoundingClientRect();
      poser(((x - r.left) / r.width) * 100);
    };
    let actif: number | null = null;
    el.addEventListener('pointerdown', (e) => {
      if (actif !== null || (e.pointerType === 'mouse' && e.button !== 0)) return; // un seul doigt
      actif = e.pointerId;
      touche = true;
      el.setPointerCapture(e.pointerId);
      el.classList.add('est-glisse');
      depuisPointeur(e.clientX);
    });
    el.addEventListener('pointermove', (e) => { if (e.pointerId === actif) depuisPointeur(e.clientX); });
    const fin = (e: PointerEvent) => {
      if (e.pointerId !== actif) return;
      actif = null;
      el.classList.remove('est-glisse');
      annoncer();
    };
    el.addEventListener('pointerup', fin);
    el.addEventListener('pointercancel', fin);

    poignee.addEventListener('keydown', (e) => {
      const cibles: Record<string, number> = { ArrowLeft: valeur - pas, ArrowDown: valeur - pas, ArrowRight: valeur + pas, ArrowUp: valeur + pas, PageDown: valeur - 10, PageUp: valeur + 10, Home: 0, End: 100 };
      if (!(e.key in cibles)) return;
      e.preventDefault();
      touche = true;
      poser(Math.round(cibles[e.key] / pas) * pas);
      annoncer();
    });
  });
</script>

<style is:global>
  .ff-aa-grille { display: grid; gap: var(--s6); }
  @media (min-width: 1024px) {
    .ff-aa-grille { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--s6); row-gap: var(--s6); }
    .ff-aa-tete { grid-column: 1 / span 8; }
    .ff-aa-figure { grid-column: 1 / span 8; }
    .ff-aa-points { grid-column: 9 / span 4; align-self: center; }
  }
  .ff-aa-figure { margin: 0; min-width: 0; }
  .ff-aa {
    position: relative;
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  /* global.css pose un fond d'attente sur picture/img : ici il masquerait la version 1. */
  .ff-aa > picture { grid-area: 1 / 1; background: none; }
  .ff-aa-img { display: block; width: 100%; height: auto; background: none; pointer-events: none; -webkit-user-drag: none; }
  .ff-aa-apres { clip-path: inset(0 0 0 50%); }
  .ff-aa.est-pret { cursor: ew-resize; }
  .ff-aa-etiquette {
    position: absolute;
    bottom: var(--s2);
    left: var(--s2);
    padding: 4px var(--s1);
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
  }
  .ff-aa-etiquette-droite { left: auto; right: var(--s2); }

  /* Rail : toute la largeur, décalé de p % ; son bord gauche est la ligne de coupe. */
  .ff-aa-rail { position: absolute; inset: 0; transform: translateX(50%); pointer-events: none; }
  .ff-aa-rail::before { content: ''; position: absolute; top: 0; bottom: 0; left: -1px; width: 2px; background: var(--fg); }
  .ff-aa-poignee {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    border-radius: 4px;
    background: var(--fg);
    color: var(--bg);
    pointer-events: auto;
    cursor: ew-resize;
    transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  .ff-aa.est-glisse .ff-aa-poignee { transform: scale(0.97); }
  @media (prefers-reduced-motion: reduce) { .ff-aa.est-glisse .ff-aa-poignee { transform: none; } }

  .ff-aa-points { display: grid; gap: var(--s3); list-style: none; margin: 0; padding: 0; }
  .ff-aa-points > li { padding-top: var(--s2); border-top: 1px solid var(--line); }
</style>
