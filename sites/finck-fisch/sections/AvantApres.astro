---
/**
 * Avant / après (11 oct 2026). Retour fondateur sur la version côte à côte de la veille : « moche et
 * pas attractif » (deux captures figées et petites, liste à part).
 *
 * Maintenant : deux écrans de téléphone, grands, comme on les voit dans la main. L'« avant » est la
 * page d'ordinateur rétrécie telle qu'un iPhone l'affiche (pas de balise viewport : texte minuscule,
 * illisible sans zoomer) ; l'« après » est Maison Roux, notre boulangerie d'exemple, qui défile toute
 * seule (DemoVideo.astro, CSS pur). Trois différences en face, chacune avec son « avant » en clair.
 * Ordinateur : texte à gauche, les deux téléphones à droite. Téléphone : les deux écrans côte à côte
 * sous le titre, puis les trois différences.
 *
 * « Avant » = un site d'artisan vieillissant typique, recréé pour l'exemple (fictif, dit dans la
 * légende ; source : scratchpad avant-roux/index.html, capturé à 980 px comme le fait un iPhone).
 * Fichiers : public/video/demos/avant-roux-t-m0..3.webp et maison-roux-t-m0..3.webp (tuiles.mjs).
 */
import DemoVideo from './DemoVideo.astro';

const points = [
  { apres: 'Lisible sans zoomer.', avant: 'la page d’ordinateur rétrécie, le texte minuscule.' },
  { apres: 'Les horaires sous le nom.', avant: 'cachés dans la page Contact.' },
  { apres: 'Le numéro en un toucher.', avant: 'tout en bas, à recopier.' },
];
---

<section id="avant-apres" class="ff-section">
  <div class="ff-conteneur ff-aa">
    <div class="ff-aa-texte">
      <h2 class="ff-titre ff-masque" data-ff-titre><span>Ce que change un vrai site</span></h2>
      <p class="ff-texte ff-doux mt-6 max-w-[30rem]">
        La même boulangerie, sur le téléphone d’un client qui cherche si elle est ouverte. À gauche, le
        site qu’ont encore beaucoup d’artisans. À droite, celui que nous lui ferions.
      </p>
      <ol class="ff-aa-points mt-8 md:mt-10">
        {points.map((p, i) => (
          <li>
            <span class="ff-aa-num ff-petit" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="ff-texte text-fg">{p.apres}</span>
            <span class="ff-petit ff-doux">Avant : {p.avant}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="ff-aa-scene">
      <figure class="ff-aa-ecran ff-aa-avant">
        <figcaption class="ff-petit ff-doux">Avant</figcaption>
        <DemoVideo slug="avant-roux" tel revele />
        <span class="sr-only">Avant, exemple fictif : un site de boulangerie vieillissant affiché sur un téléphone, la page d’ordinateur rétrécie, texte illisible sans zoomer.</span>
      </figure>
      <figure class="ff-aa-ecran ff-aa-apres">
        <figcaption class="ff-petit">Après</figcaption>
        <DemoVideo slug="maison-roux" tel revele />
        <span class="sr-only">Après : Maison Roux sur téléphone, le nom en grand, les horaires et le numéro lisibles tout de suite, puis la photo des baguettes.</span>
      </figure>
    </div>

    <p class="ff-aa-legende ff-petit ff-doux">Avant : un site vieillissant typique, recréé pour l’exemple (fictif). Après : Maison Roux, boulangerie d’exemple à Lyon.</p>
  </div>
</section>

<style is:global>
  .ff-aa { display: grid; gap: var(--s6); }
  .ff-aa-scene {
    display: grid;
    grid-template-columns: 0.86fr 1fr;
    align-items: end;
    gap: var(--s2);
  }
  .ff-aa-ecran { margin: 0; min-width: 0; }
  .ff-aa-ecran figcaption { margin-bottom: var(--s1); }
  .ff-aa-apres figcaption { color: var(--accent); }
  .ff-aa-apres .ff-demo {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }

  .ff-aa-points { display: grid; list-style: none; margin: 0; padding: 0; }
  .ff-aa-points > li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: var(--s1);
    row-gap: 2px;
    padding-block: var(--s2);
    border-top: 1px solid var(--line);
  }
  .ff-aa-points > li:last-child { border-bottom: 1px solid var(--line); }
  .ff-aa-num { grid-row: span 2; color: var(--accent); padding-top: 0.2em; font-variant-numeric: tabular-nums; }
  .ff-aa-legende { margin: 0; }

  /* Téléphone : titre, les deux écrans, puis les différences. */
  @media (max-width: 1023px) {
    .ff-aa-texte { display: contents; }
    .ff-aa-texte > h2, .ff-aa-texte > p { order: 0; }
    .ff-aa-scene { order: 1; }
    .ff-aa-points { order: 2; margin-top: 0; }
    .ff-aa-legende { order: 3; }
    .ff-aa { gap: var(--s4); }
    .ff-aa-texte > p { margin-top: calc(-1 * var(--s2)); }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .ff-aa-scene { max-width: 560px; }
  }
  /* Ordinateur : texte à gauche, téléphones à droite. */
  @media (min-width: 1024px) {
    .ff-aa { grid-template-columns: minmax(0, 1fr) minmax(0, 560px); column-gap: var(--s12); align-items: center; }
    .ff-aa-scene { gap: var(--s4); }
    .ff-aa-legende { grid-column: 1 / -1; }
  }
</style>
