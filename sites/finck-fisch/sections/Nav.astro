---
/**
 * Barre du haut — sur mesure Finck & Fisch, direction éphéméride (refonte du 6 oct 2026).
 *
 * C'est le haut du carton rouge du bloc éphéméride : le monogramme et le nom à gauche, trois mots à
 * droite. Elle n'est pas fixe : elle fait partie du carton, et sur téléphone c'est la barre d'action
 * du bas (Appeler / Écrire) qui reste à portée de pouce, une fois le premier écran passé — le
 * diagnostic du 6 oct relevait que « Contact », seul moyen d'agir, disparaissait au défilement.
 *
 * Sur une page service, les ancres de l'accueil deviennent des liens vers l'accueil + ancre.
 */
import { site, tel } from '@/lib/site';

const accueil = Astro.url.pathname === '/';
const lien = (ancre: string) => (accueil ? ancre : `/${ancre}`);
const links = [
  { ancre: '#realisations', label: 'Réalisations' },
  { ancre: '#offre', label: 'Offre' },
  { ancre: '#contact', label: 'Contact' },
];
---

<header class="ff-carton-haut bg-accent text-on-accent">
  <div class="container-ff flex items-center justify-between gap-6 py-4">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.business.name}, accueil`}>
      <img src="/images/monogramme-clair.svg" alt="" width="294" height="281" class="h-8 w-auto bg-transparent" />
      <span class="ff-nom text-sm font-semibold uppercase">{site.business.name}</span>
    </a>
    <nav class="flex items-center gap-5 text-sm font-medium sm:gap-8" aria-label="Navigation principale">
      {links.map((l, i) => (
        <span class={i < 2 ? 'hidden sm:inline' : ''}>
          <a href={lien(l.ancre)} class="underline decoration-transparent hover:decoration-current">{l.label}</a>
        </span>
      ))}
    </nav>
  </div>
</header>

{/* Barre d'action du téléphone : apparaît une fois le premier écran passé (le bouton du premier
    écran fait le travail avant). Fixée en bas, sous le pouce, avec la zone de sécurité de l'iPhone. */}
<div class="ff-barre-action" data-barre-action hidden>
  <a href={tel()} class="ff-barre-appel">Appeler</a>
  <a href={lien('#contact')} class="ff-barre-ecrire">Écrire</a>
</div>

<style>
  .ff-nom { font-stretch: 112%; letter-spacing: 0.16em; }

  .ff-barre-action { display: none; }
  @media (max-width: 639px) {
  .ff-barre-action {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    padding: 0.5rem 0.75rem calc(0.5rem + env(safe-area-inset-bottom));
    background: var(--ink);
    transform: translateY(0);
    transition: transform 0.24s var(--ease-brand);
  }
  .ff-barre-action[hidden] { display: grid; transform: translateY(110%); pointer-events: none; }
  .ff-barre-action a {
    display: flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    -webkit-tap-highlight-color: transparent;
  }
  .ff-barre-appel { background: var(--accent); color: var(--on-accent); }
  .ff-barre-ecrire { color: var(--on-ink); }
  .ff-barre-appel:active { background: var(--accent-2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ff-barre-action { transition: none; }
  }
</style>

<style is:global>
  /* La barre d'action fixe ne doit jamais couvrir la fin de la page (pied de page, mentions). */
  @media (max-width: 639px) {
    body { padding-bottom: calc(4rem + env(safe-area-inset-bottom)); }
  }
</style>

<script>
  import { onPage } from '@/scripts/page';

  onPage(() => {
    const barre = document.querySelector<HTMLElement>('[data-barre-action]');
    const hero = document.getElementById('hero');
    if (!barre) return;
    // Sans premier écran (page service), la barre est là tout de suite.
    if (!hero) { barre.hidden = false; return; }
    const obs = new IntersectionObserver(([e]) => { barre.hidden = e.isIntersecting; }, { threshold: 0.15 });
    obs.observe(hero);
    document.addEventListener('astro:before-swap', () => obs.disconnect(), { once: true });
  });
</script>
