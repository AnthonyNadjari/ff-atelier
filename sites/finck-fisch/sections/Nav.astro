---
/**
 * En-tête + barre basse du site du studio (plan-site-ff.html v2, composants HeaderAudit et BarreAudit).
 *
 * En-tête : collant (position: sticky), 72 px sur ordinateur, 56 px sur téléphone, fond encre à 90 %
 * avec flou. Il ne se masque plus au défilement : le bouton « Réserver un audit » reste visible à tout
 * moment (Trueform, Apple : le CTA dans la barre). Sur /audit, pas de bouton (on y est) mais un lien
 * « Retour ». Le fond et le texte suivent la bascule crème de la section Audit (tokens, ff.css).
 *
 * Barre basse (téléphone) : « Réserver un audit » + « Écrire », au-dessus de la zone de sécurité
 * iPhone. Elle apparaît quand le premier écran est passé (translateY 110 % → 0, 0,26 s, courbe de
 * tiroir iOS) et disparaît quand la section Audit est à l'écran (son propre bouton suffit). Elle
 * n'existe pas sur /audit : le formulaire y est la page.
 *
 * Ce composant est rendu sur toutes les pages (accueil, /audit, mentions) : il importe donc le système
 * de design (ff.css) et lance le moteur du site (motion-ff.ts : Lenis, gsap.matchMedia, S2-S4).
 *
 * TODO(fondateurs) : vrai numéro de téléphone → « Écrire » peut devenir « Appeler » (tel()) dans la
 * barre basse ; le 06 00 00 00 00 du config est un placeholder, jamais affiché.
 */
import './ff.css';
import { site, mailto } from '@/lib/site';

const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
const accueil = chemin === '/';
const surAudit = chemin.startsWith('/audit');
const liens = [
  { ancre: '#realisations', label: 'Exemples' },
  { ancre: '#tarifs', label: 'Tarifs' },
].map((l) => ({ ...l, href: accueil ? l.ancre : `/${l.ancre}` }));
---

<header data-nav="fixe" class="ff-entete">
  <div class="ff-conteneur ff-entete-ligne">
    <a href="/" class="ff-entete-nom" aria-label={`${site.business.name}, accueil`}>{site.business.name}</a>
    <nav class="ff-entete-nav ff-petit" aria-label="Navigation principale">
      {surAudit ? (
        <a href="/" class="ff-lien">Retour</a>
      ) : (
        <>
          {liens.map((l) => <a href={l.href} class="ff-entete-lien hidden md:inline-flex">{l.label}</a>)}
          <a href={mailto()} class="ff-entete-lien ff-entete-mail hidden min-[1100px]:inline-flex">{site.contact.email}</a>
          <a href="/audit" class="ff-bouton ff-bouton-compact ff-entete-cta" aria-label="Réserver un audit">
            <span class="ff-entete-long">Réserver un audit</span><span class="ff-entete-court">Audit</span>
          </a>
        </>
      )}
    </nav>
  </div>
</header>

{!surAudit && (
  <div class="ff-barre" data-barre-audit>
    <a href="/audit" class="ff-barre-audit">Réserver un audit</a>
    <a href={mailto()} class="ff-barre-ecrire">Écrire</a>
  </div>
)}

<script>
  import { onPage } from '@/scripts/page';
  import { initMotionFF } from './motion-ff';

  // La barre du navigateur (theme-color) suit l'encre du site, pas le noir froid de la direction.
  document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#15120f');

  onPage(initMotionFF);

  // Barre basse : visible hors du premier écran, masquée quand la section Audit (ou un formulaire
  // d'audit) est à l'écran.
  onPage(() => {
    const barre = document.querySelector<HTMLElement>('[data-barre-audit]');
    if (!barre) return;
    const hero = document.getElementById('hero');
    const caches = [...document.querySelectorAll<HTMLElement>('#audit, [data-formulaire-audit]')];
    const vues = new Set<Element>();
    let heroVu = Boolean(hero);
    const maj = () => barre.toggleAttribute('data-shown', !heroVu && vues.size === 0);
    const obs = new IntersectionObserver((entrees) => {
      for (const e of entrees) {
        if (e.target === hero) heroVu = e.isIntersecting;
        else if (e.isIntersecting) vues.add(e.target);
        else vues.delete(e.target);
      }
      maj();
    }, { threshold: 0 });
    if (hero) obs.observe(hero);
    caches.forEach((z) => obs.observe(z));
    maj();
    document.addEventListener('astro:before-swap', () => obs.disconnect(), { once: true });
  });
</script>

<style is:global>
  .ff-entete {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--entete);
    /* Presque opaque : à 90 %, les titres qui passent dessous se lisaient en fantôme (11 oct 2026). */
    background: color-mix(in srgb, var(--bg) 97%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .ff-entete-ligne { display: flex; height: 100%; align-items: center; justify-content: space-between; gap: var(--s3); }
  .ff-entete-nom { font-family: var(--ff-titres); font-size: 1.125rem; line-height: 1; color: var(--fg); text-decoration: none; white-space: nowrap; }
  .ff-entete-nav { display: flex; align-items: center; gap: var(--s3); }
  /* Affichage des liens par les utilitaires `hidden md:inline-flex` : la règle de cible tactile de
     craft.css (header[data-nav] a:not(.btn):not(.hidden), spécificité 0,3,2) ignore les éléments
     .hidden et ne rallume donc pas ces liens sur téléphone. */
  .ff-entete-lien { min-height: 48px; align-items: center; color: var(--muted); text-decoration: none; transition: color 160ms ease; }
  @media (hover: hover) and (pointer: fine) { .ff-entete-lien:hover { color: var(--fg); } }
  .ff-entete-court { display: inline; }
  .ff-entete-long { display: none; }
  /* Le bouton : `:is(.ff-entete-cta, #ff-specificite)` porte la spécificité d'un id (le second
     sélecteur ne correspond à rien) pour passer devant la même règle de craft.css (min-height 24 px).
     Téléphone : 40 px visibles, cible de 48 px (::after) dans un en-tête de 56. */
  .ff-entete :is(.ff-entete-cta, #ff-specificite) { position: relative; min-height: 40px; }
  .ff-entete :is(.ff-entete-cta, #ff-specificite)::after { content: ''; position: absolute; inset: -4px 0; }
  @media (min-width: 768px) {
    .ff-entete-court { display: none; }
    .ff-entete-long { display: inline; }
    .ff-entete-nav { gap: var(--s4); }
    .ff-entete :is(.ff-entete-cta, #ff-specificite) { min-height: 48px; padding: 0 var(--s3); font-size: 1rem; }
  }
  .ff-entete-mail { color: var(--fg); }

  /* Barre basse (téléphone seulement). --barre : sa hauteur, pour les scènes collantes qui doivent
     garder leurs écrans au-dessus (AvantApres, Process72h). */
  :root { --barre: 0px; }
  @media (max-width: 767px) { :root { --barre: calc(64px + env(safe-area-inset-bottom)); } }
  .ff-barre { display: none; }
  @media (max-width: 767px) {
    .ff-barre {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 60;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: var(--s1);
      padding: var(--s1) var(--s2) calc(var(--s1) + env(safe-area-inset-bottom));
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      border-top: 1px solid var(--line);
      transform: translateY(110%);
      visibility: hidden;
      /* Sortie plus rapide que l'entrée ; masquée, elle n'attrape pas le doigt. */
      transition: transform 200ms cubic-bezier(0.32, 0.72, 0, 1), visibility 0s linear 200ms;
    }
    .ff-barre[data-shown] {
      transform: none;
      visibility: visible;
      transition: transform 260ms cubic-bezier(0.32, 0.72, 0, 1), visibility 0s;
    }
    .ff-barre a {
      display: flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      font-size: 1rem;
      font-weight: 550;
      text-decoration: none;
      touch-action: manipulation;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
    }
    .ff-barre a:active { transform: scale(0.97); }
    .ff-barre-audit { background: var(--fg); color: var(--bg); }
    .ff-barre-ecrire { border: 1px solid var(--line); color: var(--fg); }
    body:has(.ff-barre) { padding-bottom: calc(64px + env(safe-area-inset-bottom)); }
  }
  @media (max-width: 767px) and (prefers-reduced-motion: reduce) {
    .ff-barre, .ff-barre[data-shown] { transform: none; transition: none; }
    .ff-barre a:active { transform: none; }
  }
</style>
