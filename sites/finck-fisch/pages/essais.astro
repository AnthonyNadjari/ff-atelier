---
/**
 * Page d'essais d'effets (11 oct 2026, non indexée, hors menu). Retour fondateur : « on peut mettre
 * des trucs flashy si ça rend bien et que ça reste sobre, je veux tout voir ; j'aime le concept des
 * écrans » (mur 3D du hero). Chaque essai montre un effet en vrai, bâti sur nos écrans de démos, pour
 * choisir lesquels passent sur la page d'accueil. Ce n'est pas une page pour les clients.
 *
 * Moteur commun en bas : chaque bloc [data-progres] reçoit --p (0 → 1) selon sa traversée de l'écran
 * (blocs collants : de l'accroche du haut à la sortie). Couverture : --d par carte (-1 → 1) selon sa
 * distance au centre du carrousel. Inclinaison : --rx/--ry au pointeur.
 */
import Base from '@/layouts/Base.astro';
import { site } from '@/lib/site';
import { resolveSection } from '@/lib/sections';
import DemoVideo from '../sections/DemoVideo.astro';

const Nav = resolveSection('nav', site.layout.nav);
const Footer = resolveSection('footer', site.layout.footer);

const demos = [
  { slug: 'forge-delacroix', metier: 'Ferronnerie d’art' },
  { slug: 'maison-roux', metier: 'Boulangerie-pâtisserie' },
  { slug: 'encre-noire', metier: 'Studio de tatouage' },
  { slug: 'chez-malo', metier: 'Restaurant de poissons' },
  { slug: 'atelier-lecerf', metier: 'Menuisier-ébéniste' },
  { slug: 'studio-ambre', metier: 'Architecte d’intérieur' },
];
const colonnes = [
  ['encre-noire', 'chez-malo', 'barbier-kessler'],
  ['forge-delacroix', 'maison-roux', 'studio-ambre'],
  ['atelier-lecerf', 'studio-ambre', 'encre-noire'],
];
const metiers1 = ['Boulangers', 'Ferronniers', 'Tatoueurs', 'Ébénistes', 'Barbiers', 'Restaurateurs'];
const metiers2 = ['Plombiers', 'Fleuristes', 'Couvreurs', 'Coiffeurs', 'Architectes', 'Paysagistes'];
---

<Base title={`Essais d’effets | ${site.business.name}`} description="Page de travail interne." path="/essais" noindex>
  <Nav />
  <main id="main" class="ff-essais">
    <header class="ff-conteneur ff-section">
      <h1 class="ff-titre">Essais d’effets</h1>
      <p class="ff-texte ff-doux mt-6 max-w-[36rem]">
        Page de travail, pas pour les clients. Six effets montrés en vrai, à faire défiler. Dis-moi
        lesquels garder sur la page d’accueil (par leur numéro).
      </p>
    </header>

    {/* 1. Plongée dans le mur */}
    <section class="ff-ess-bloc" aria-labelledby="e1">
      <div class="ff-conteneur ff-ess-tete"><h2 id="e1" class="ff-ess-titre"><span>1</span> Plongée dans le mur</h2><p class="ff-petit ff-doux">Le mur d’écrans du haut de page se redresse et s’approche jusqu’à ce qu’un écran remplisse la vue.</p></div>
      <div class="ff-plonge" data-progres>
        <div class="ff-plonge-colle">
          <div class="ff-plonge-plan">
            {colonnes.map((col, c) => (
              <div class="ff-plonge-col">
                {col.map((slug, i) => <DemoVideo slug={slug} tel class="ff-ess-ecran" decalage={(c * 3 + i) * 2.7} />)}
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* 2. Couverture */}
    <section class="ff-ess-bloc" aria-labelledby="e2">
      <div class="ff-conteneur ff-ess-tete"><h2 id="e2" class="ff-ess-titre"><span>2</span> Carrousel en perspective</h2><p class="ff-petit ff-doux">Les exemples tournent en 3D en glissant : celui du centre fait face, les voisins s’inclinent. Fais glisser.</p></div>
      <div class="ff-couv" data-couv>
        {demos.map((d, i) => (
          <figure class="ff-couv-carte">
            <DemoVideo slug={d.slug} tel class="ff-ess-ecran" decalage={i * 2.9} />
            <figcaption class="ff-petit">{d.metier}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    {/* 3. Retournement avant/après */}
    <section class="ff-ess-bloc" aria-labelledby="e3">
      <div class="ff-conteneur ff-ess-tete"><h2 id="e3" class="ff-ess-titre"><span>3</span> Le téléphone se retourne</h2><p class="ff-petit ff-doux">Avant/après : en faisant défiler, le téléphone pivote et passe du vieux site au nouveau.</p></div>
      <div class="ff-tourne" data-progres>
        <div class="ff-tourne-colle">
          <p class="ff-tourne-etiq ff-petit"><span class="ff-tourne-a">Avant</span><span class="ff-tourne-b">Après</span></p>
          <div class="ff-tourne-carte">
            <div class="ff-tourne-face"><DemoVideo slug="avant-roux" tel class="ff-ess-ecran" /></div>
            <div class="ff-tourne-face ff-tourne-dos"><DemoVideo slug="maison-roux" tel class="ff-ess-ecran" /></div>
          </div>
        </div>
      </div>
    </section>

    {/* 4. Métiers en grand */}
    <section class="ff-ess-bloc" aria-labelledby="e4">
      <div class="ff-conteneur ff-ess-tete"><h2 id="e4" class="ff-ess-titre"><span>4</span> Les métiers en grand</h2><p class="ff-petit ff-doux">Deux lignes de métiers en très gros, qui glissent en sens contraire au défilement.</p></div>
      <div class="ff-metiers" data-progres aria-hidden="true">
        <p class="ff-metiers-l ff-metiers-1">{[...metiers1, ...metiers1].map((m) => <span>{m}</span>)}</p>
        <p class="ff-metiers-l ff-metiers-2">{[...metiers2, ...metiers2].map((m) => <span>{m}</span>)}</p>
      </div>
    </section>

    {/* 5. Écrans qui s'empilent */}
    <section class="ff-ess-bloc" aria-labelledby="e5">
      <div class="ff-conteneur ff-ess-tete"><h2 id="e5" class="ff-ess-titre"><span>5</span> Les exemples s’empilent</h2><p class="ff-petit ff-doux">Chaque exemple vient se poser sur le précédent, qui recule.</p></div>
      <ol class="ff-conteneur ff-pile">
        {demos.slice(0, 5).map((d, i) => (
          <li class="ff-pile-carte" style={`--i:${i}`} data-progres>
            <div class="ff-pile-panneau">
              <DemoVideo slug={d.slug} tel class="ff-ess-ecran" decalage={i * 3} />
              <div>
                <p class="ff-petit ff-doux">Exemple {i + 1} sur 5</p>
                <p class="ff-titre ff-pile-nom">{d.metier}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* 6. Inclinaison */}
    <section class="ff-ess-bloc" aria-labelledby="e6">
      <div class="ff-conteneur ff-ess-tete"><h2 id="e6" class="ff-ess-titre"><span>6</span> Les écrans suivent la main</h2><p class="ff-petit ff-doux">Ordinateur : chaque écran s’incline vers la souris. Téléphone : il s’incline quand on le touche.</p></div>
      <div class="ff-conteneur ff-incl">
        {demos.slice(0, 3).map((d, i) => (
          <div class="ff-incl-carte" data-incline><DemoVideo slug={d.slug} tel class="ff-ess-ecran" decalage={i * 4} /></div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style is:global>
  .ff-essais { overflow-x: clip; }
  .ff-ess-bloc { padding-block: var(--s8); border-top: 1px solid var(--line); }
  .ff-ess-tete { margin-bottom: var(--s4); display: grid; gap: var(--s1); }
  .ff-ess-titre { font-size: 1.5rem; line-height: 1.2; color: var(--fg); margin: 0; }
  .ff-ess-titre > span { color: var(--accent); margin-right: 0.4em; font-variant-numeric: tabular-nums; }
  .ff-essais .ff-ess-ecran { border-radius: 16px; box-shadow: 0 30px 60px -24px rgb(0 0 0 / 0.85); }

  /* 1. Plongée : bloc de 250 vh, plan collant ; --p redresse et approche. */
  .ff-plonge { height: 250vh; }
  .ff-plonge-colle { position: sticky; top: 0; height: 100svh; overflow: hidden; perspective: 1400px; display: flex; align-items: center; justify-content: center; }
  /* Plan dessiné à sa taille FINALE (un écran ≈ la largeur de la vue) puis réduit au départ : agrandir
     une couche déjà peinte petite la rend floue, la réduire non. */
  .ff-plonge-plan {
    width: calc(min(80vw, 400px) * 3.3);
    flex: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4%;
    transform-style: preserve-3d;
    transform:
      rotateX(calc((1 - var(--p, 0)) * 30deg))
      rotateZ(calc((1 - var(--p, 0)) * -20deg))
      scale(calc(0.27 + var(--p, 0) * var(--p, 0) * 0.73));
  }
  .ff-plonge-col { display: grid; gap: 6%; align-content: center; }
  .ff-plonge-col:nth-child(1) { transform: translateY(calc(var(--p, 0) * -14%)); }
  .ff-plonge-col:nth-child(3) { transform: translateY(calc(var(--p, 0) * 14%)); }

  /* 2. Couverture : carrousel à défilement horizontal, chaque carte reçoit --d (-1 → 1). */
  .ff-couv {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: var(--s4) calc(50% - 110px);
    perspective: 1200px;
  }
  .ff-couv::-webkit-scrollbar { display: none; }
  .ff-couv-carte {
    flex: 0 0 220px;
    margin: 0;
    scroll-snap-align: center;
    transform: rotateY(calc(var(--d, 0) * -38deg)) scale(calc(1 - var(--ad, 0) * 0.18)) translateZ(calc(var(--ad, 0) * -60px));
  }
  .ff-couv-carte figcaption { text-align: center; margin-top: var(--s2); opacity: calc(1 - var(--ad, 0) * 0.8); }
  @media (min-width: 768px) {
    .ff-couv { padding-inline: calc(50% - 140px); }
    .ff-couv-carte { flex-basis: 280px; }
  }

  /* 3. Retournement : bloc de 220 vh, carte collante ; rotateY 0 → 180° entre 25 % et 75 %. */
  .ff-tourne { height: 220vh; }
  .ff-tourne-colle { position: sticky; top: 0; height: 100svh; display: grid; place-items: center; align-content: center; gap: var(--s2); perspective: 1600px; }
  .ff-tourne-carte {
    position: relative;
    width: min(62vw, 300px);
    transform-style: preserve-3d;
    transform: rotateY(calc(var(--a) * 180deg)) rotateX(calc(sin(var(--a) * 3.1416) * 8deg));
  }
  /* Faces masquées par opacité à mi-tour, pas par backface-visibility : Safari l'ignore quand la face
     contient une couche animée (l'écran qui défile) et montre le dos en miroir. */
  .ff-tourne-face { opacity: calc(1 - clamp(0, (var(--a) - 0.5) * 100, 1)); }
  .ff-tourne-dos { position: absolute; inset: 0; transform: rotateY(180deg); opacity: clamp(0, (var(--a) - 0.5) * 100, 1); }
  .ff-tourne-etiq { display: grid; justify-items: center; }
  .ff-tourne-etiq > span { grid-area: 1 / 1; transition: opacity 0.3s; }
  .ff-tourne-colle { --a: clamp(0, (var(--p, 0) - 0.25) * 2, 1); }
  .ff-tourne-a { opacity: calc(1 - clamp(0, (var(--a) - 0.5) * 100, 1)); }
  .ff-tourne-b { color: var(--accent); opacity: clamp(0, (var(--a) - 0.5) * 100, 1); }

  /* 4. Métiers : deux lignes très grandes, translateX opposés selon --p. */
  .ff-metiers { display: grid; gap: var(--s1); padding-block: var(--s4); }
  .ff-metiers-l { margin: 0; white-space: nowrap; font-family: var(--ff-titres); font-size: clamp(3.5rem, 13vw, 10rem); line-height: 1; color: var(--fg); }
  .ff-metiers-l > span { margin-right: 0.45em; }
  .ff-metiers-1 { transform: translateX(calc(var(--p, 0) * -45%)); }
  .ff-metiers-2 { transform: translateX(calc(-45% + var(--p, 0) * 45%)); color: transparent; -webkit-text-stroke: 1px color-mix(in srgb, var(--fg) 55%, transparent); }

  /* 5. Pile : cartes collantes ; la précédente recule (scale) quand la suivante arrive. */
  .ff-pile { list-style: none; margin: 0; padding-block: 0; display: grid; gap: 30vh; }
  .ff-pile-carte { position: sticky; top: calc(var(--entete) + 16px + var(--i) * 14px); }
  .ff-pile-panneau {
    display: grid;
    grid-template-columns: minmax(0, 150px) minmax(0, 1fr);
    gap: var(--s3);
    align-items: end;
    padding: var(--s3);
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 18px;
    transform-origin: 50% 0;
    transform: scale(calc(1 - clamp(0, var(--p, 0) - 0.5, 0.5) * 0.12));
    filter: brightness(calc(1 - clamp(0, var(--p, 0) - 0.5, 0.5) * 0.6));
  }
  .ff-pile-nom { font-size: clamp(1.35rem, 5vw, 3rem); margin: 0; line-height: 1.1; hyphens: none; overflow-wrap: normal; }
  @media (min-width: 768px) { .ff-pile-panneau { grid-template-columns: 220px minmax(0, 1fr); padding: var(--s6); } }

  /* 6. Inclinaison au pointeur. */
  .ff-incl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); perspective: 1000px; }
  .ff-incl-carte { transform: rotateX(calc(var(--ry, 0) * -14deg)) rotateY(calc(var(--rx, 0) * 16deg)) translateZ(calc(var(--ri, 0) * 20px)); transition: transform 0.5s var(--ff-expo-out); will-change: transform; }
  .ff-incl-carte.actif { transition-duration: 0.08s; }
</style>

<script>
  import { onPage } from '@/scripts/page';

  onPage(() => {
    const blocs = [...document.querySelectorAll<HTMLElement>('[data-progres]')];
    const couv = document.querySelector<HTMLElement>('[data-couv]');
    const cartes = couv ? [...couv.querySelectorAll<HTMLElement>('.ff-couv-carte')] : [];
    let raf = 0;

    const majProgres = () => {
      raf = 0;
      const vh = window.innerHeight;
      for (const b of blocs) {
        const r = b.getBoundingClientRect();
        // Bloc plus haut que l'écran (collant) : de son haut au ras du haut jusqu'à sa fin. Sinon : de
        // son entrée en bas à sa sortie en haut.
        const p = r.height > vh * 1.2 ? -r.top / (r.height - vh) : (vh - r.top) / (vh + r.height);
        b.style.setProperty('--p', Math.min(1, Math.max(0, p)).toFixed(4));
      }
      if (couv) {
        const c = couv.getBoundingClientRect();
        const centre = c.left + c.width / 2;
        for (const k of cartes) {
          const r = k.getBoundingClientRect();
          const d = (r.left + r.width / 2 - centre) / r.width;
          k.style.setProperty('--d', d.toFixed(3));
          k.style.setProperty('--ad', Math.min(1, Math.abs(d)).toFixed(3));
          k.style.zIndex = String(10 - Math.round(Math.min(1, Math.abs(d)) * 5));
        }
      }
    };
    const relancer = () => { if (!raf) raf = requestAnimationFrame(majProgres); };
    window.addEventListener('scroll', relancer, { passive: true });
    window.addEventListener('resize', relancer);
    couv?.addEventListener('scroll', relancer, { passive: true });
    relancer();

    // Inclinaison : souris au survol, doigt pendant le toucher.
    for (const el of document.querySelectorAll<HTMLElement>('[data-incline]')) {
      const bouge = (e: PointerEvent) => {
        const r = el.getBoundingClientRect();
        const rx = ((e.clientX - r.left) / r.width) * 2 - 1;
        const ry = ((e.clientY - r.top) / r.height) * 2 - 1;
        el.style.setProperty('--rx', rx.toFixed(3));
        el.style.setProperty('--ry', ry.toFixed(3));
        el.style.setProperty('--ri', Math.min(1, (Math.abs(rx) + Math.abs(ry)) / 2).toFixed(3));
        el.classList.add('actif');
      };
      const repos = () => { el.style.setProperty('--rx', '0'); el.style.setProperty('--ry', '0'); el.style.setProperty('--ri', '0'); el.classList.remove('actif'); };
      el.addEventListener('pointermove', bouge);
      el.addEventListener('pointerdown', bouge);
      el.addEventListener('pointerleave', repos);
      el.addEventListener('pointerup', repos);
      el.addEventListener('pointercancel', repos);
    }

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', relancer);
      window.removeEventListener('resize', relancer);
    }, { once: true });
  });
</script>
