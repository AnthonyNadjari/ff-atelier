---
/**
 * La cave sous la boutique — faits du brief seulement : creusée en 2014, 11 °C, tommes et reblochons
 * fermiers qui finissent de s'affiner, date d'entrée à la craie sur chaque meule, « plus jeune » ou
 * « plus fait » à la demande, six fermes des Aravis et des Bauges (non nommées dans le brief : on ne les
 * nomme pas). Une photo pleine largeur (banque libre, CREDITS.md) et les faits dans le texte : la rangée de trois
 * « chiffres » a été retirée à la relecture du 16 oct 2026 (série de trois, GOUT § 2).
 */
import Img from '@/components/Img.astro';

---

<section id="cave" class="section-y bg-bg-2">
  <div class="container-ff">
    <h2 class="text-display-md font-display max-w-[20ch]" data-reveal>La cave est sous la boutique, à 11 °C.</h2>
    <p class="mt-5 max-w-prose text-lg text-muted">Claire l’a creusée en 2014. Les tommes et les reblochons fermiers de six fermes des Aravis et des Bauges y finissent de s’affiner, jusqu’au jour où elle les juge prêts. Chaque meule porte sa date d’entrée, écrite à la craie : demandez-la plus jeune ou plus faite.</p>
  </div>
  <div class="container-ff mt-12">
    <Img src="/images/cave.webp" alt="Meules de fromage sur des planches de bois dans une cave d’affinage" class="aspect-[16/9] w-full object-cover" sizes="(min-width: 80rem) 1200px, 100vw" />
    <p class="mt-3 text-sm text-muted">Une cave d’affinage (photo d’illustration : DimiTalen, domaine public).</p>
  </div>
</section>

