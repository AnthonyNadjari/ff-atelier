---
/**
 * Ce qui se réserve (piste A « L'ardoise ») : le coin de l'ardoise où Claire dessine l'appareil à raclette
 * et le plateau, avec les conditions écrites à côté. Les dessins se tracent quand le coin arrive à l'écran
 * (régime lent), les conditions s'écrivent ligne à ligne (régime sec). Faits du brief seulement : 4 ou 8
 * personnes, caution de 50 €, deux jours avant le week-end, il en reste rarement le samedi ; plateaux de 6
 * à 30 personnes, dès 6 € par personne, 48 heures avant, une semaine pour Noël et le Nouvel An ; Claire
 * prend les commandes.
 */
import { site, tel } from '@/lib/site';

const coupelles = [70, 120, 170, 220];
---

<section id="reserver" class="res">
  <div class="container-ff">
    <h2 class="titre-imprime res-titre">Une raclette samedi ?</h2>
    <p class="res-chapo">Alors réservez l’appareil deux jours avant le week-end : il en reste rarement le samedi.</p>

    <div class="res-grille">
      <article class="res-coin" data-craie>
        <h3 class="titre-imprime res-sous">L’appareil à raclette</h3>
        <svg class="res-dessin" viewBox="0 0 320 160" aria-hidden="true">
          <path data-trace pathLength="100" d="M28,52 Q160,40 292,52 L292,66 Q160,58 28,66 Z" />
          <path data-trace pathLength="100" d="M42,66 L42,104 L278,104 L278,66" />
          <path data-trace pathLength="100" d="M58,104 L58,118 M262,104 L262,118" />
          {coupelles.map((x) => (
            <path data-trace pathLength="100" class="trait-jaune" d={`M${x},112 L${x + 6},128 L${x + 34},128 L${x + 40},112 M${x + 20},128 L${x + 18},152`} />
          ))}
        </svg>
        <ul class="res-lignes">
          <li class="font-display" data-ecrit>Pour 4 ou 8 personnes</li>
          <li class="font-display" data-ecrit>Caution : 50 €</li>
          <li class="font-display" data-ecrit>Deux jours avant le week-end</li>
        </ul>
        <p class="res-petit" data-ecrit>Le fromage, coupé ou râpé à la demande, se prend en même temps.</p>
      </article>

      <article class="res-coin" data-craie>
        <h3 class="titre-imprime res-sous">Les plateaux</h3>
        <svg class="res-dessin" viewBox="0 0 320 160" aria-hidden="true">
          <path data-trace pathLength="100" d="M20,96 A140,50 0 1 0 300,96 A140,50 0 1 0 20,96" />
          <path data-trace pathLength="100" d="M20,96 L20,106 A140,50 0 0 0 300,106 L300,96" />
          <path data-trace pathLength="100" class="trait-jaune" d="M70,84 A36,13 0 1 0 142,84 A36,13 0 1 0 70,84 M70,84 L70,94 A36,13 0 0 0 142,94 L142,84" />
          <path data-trace pathLength="100" class="trait-jaune" d="M172,92 L248,80 L246,68 L172,80 Z M172,80 L172,92" />
          <path data-trace pathLength="100" d="M128,116 L186,110 L190,122 L132,128 Z" />
          <path data-trace pathLength="100" d="M214,118 L276,104" />
        </svg>
        <ul class="res-lignes">
          <li class="font-display" data-ecrit>De 6 à 30 personnes</li>
          <li class="font-display" data-ecrit>Dès 6 € par personne</li>
          <li class="font-display" data-ecrit>48 heures avant</li>
        </ul>
        <p class="res-petit" data-ecrit>Composé avec vous. Pour Noël et le Nouvel An, une semaine avant.</p>
      </article>
    </div>

    <div class="res-appel">
      <p class="res-appel-texte">C’est Claire qui prend les commandes. {site.wording.contactText}</p>
      <a href={tel()} class="res-btn">Réserver au {site.contact.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .res { padding: 72px 0 88px; border-top: 1px solid var(--line); }
  @media (min-width: 64rem) { .res { padding: 80px 0 96px; } }
  .res-titre { margin: 0; font-size: clamp(2.3rem, 8.4vw, 4.25rem); max-width: 14ch; }
  .res-chapo { margin-top: 16px; max-width: 36rem; font-size: 1.1rem; color: var(--muted); }

  .res-grille { margin-top: 40px; display: grid; gap: 48px; }
  @media (min-width: 56rem) { .res-grille { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .res-coin { display: grid; align-content: start; }
  .res-sous { margin: 0; font-size: 1.35rem; }
  .res-dessin { width: min(100%, 26rem); height: auto; margin-top: 18px; overflow: visible; }
  .res-dessin path { fill: none; stroke: var(--fg); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .res-dessin .trait-jaune { stroke: var(--accent); }

  .res-lignes { list-style: none; margin: 18px 0 0; padding: 0; }
  .res-lignes li { font-size: clamp(1.55rem, 5.8vw, 2.1rem); line-height: 1.15; padding: 8px 0; color: var(--fg); }
  .res-petit { margin-top: 12px; color: var(--muted); max-width: 30rem; }

  .res-appel {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 20px;
  }
  @media (min-width: 56rem) { .res-appel { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 48px; } }
  .res-appel-texte { margin: 0; max-width: 40rem; font-size: 1.05rem; }
  .res-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 24px;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 3px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 120ms linear;
  }
  .res-btn:active { transform: translateY(1px); }
</style>
