---
/**
 * Premier écran « l'ardoise du comptoir » — propre à la Fromagerie Ravanel (direction.md, phrase-idée).
 * Le défaut du métier (grande photo de plateau + « Bienvenue ») est refusé : le premier écran est l'ardoise
 * qu'on lit en entrant, sur fond --ink. Elle dit qui, où, ce qui se réserve cette semaine (faits du brief :
 * raclette deux jours avant, plateaux 48 h, marché mardi et vendredi), les horaires du jour et le téléphone.
 * Titres en Savate (grotesque dessinée à la main : la craie sans pastiche de craie). Aucune animation
 * riche ici : le seul feu d'artifice de la page est l'âge du beaufort (Age.astro).
 */
import { site, tel } from '@/lib/site';

const lignes = [
  { quoi: 'Appareil à raclette', detail: 'à réserver deux jours avant le week-end' },
  { quoi: 'Plateaux', detail: 'de 6 à 30 personnes, à commander 48 heures avant' },
  { quoi: 'Marché de la vieille ville', detail: 'mardi et vendredi matin, mêmes fromages' },
];
const JOURS = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
const joursDe = (txt: string) => {
  const noms = txt.toLowerCase().split(/\s+à\s+|\s*[–-]\s*/).map((s) => JOURS.indexOf(s.trim()));
  if (noms.some((n) => n < 0)) return [];
  if (noms.length === 2) {
    const out: number[] = [];
    for (let d = noms[0]; ; d = (d + 1) % 7) { out.push(d); if (d === noms[1] || out.length > 7) break; }
    return out;
  }
  return noms;
};
const horaires = site.contact.hours.map((h) => ({ ...h, jours: joursDe(h.days).join(',') }));
---

<section id="hero" class="ardoise bg-ink text-on-ink">
  <div class="container-ff pb-16 pt-24 md:pb-24 md:pt-36">
    <p class="text-sm text-on-ink/75">{site.business.trade}, {site.contact.address.street}, {site.contact.address.city}</p>
    <h1 class="hero-titre text-display-xl mt-4 max-w-[16ch] font-display" data-split="lines" set:html={site.business.tagline} />

    {/* Téléphone : l'horaire du jour et l'appel tout de suite sous le titre (relecture DA, 16 oct 2026 :
        sur 390 x 844, le bouton tombait sous le pli). L'ordinateur garde la colonne complète. */}
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 lg:hidden">
      <a href={tel()} class="btn inline-flex items-center justify-center rounded-ui bg-on-ink px-6 py-3 font-medium text-ink">Appeler le {site.contact.phoneDisplay}</a>
      <p class="text-sm text-on-ink/80" data-aujourdhui hidden></p>
    </div>

    <div class="mt-10 grid gap-12 lg:mt-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="font-display text-xl">À savoir avant de passer</p>
        <span class="ardoise-trait mt-3 block h-px" data-draw aria-hidden="true"></span>
        <ul class="ardoise-liste mt-2" data-stagger="110">
          {lignes.map((l) => (
            <li>
              <span class="font-display text-lg">{l.quoi}</span>
              <span class="text-on-ink/75">{l.detail}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-5">
        <dl class="ardoise-horaires" data-horaires>
          {horaires.map((h) => (
            <div data-jours={h.jours}>
              <dt>{h.days}</dt>
              <dd class="tabular-nums">{h.hours}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-8 hidden flex-wrap items-center gap-x-6 gap-y-3 lg:flex">
          <a href={tel()} class="btn inline-flex items-center justify-center rounded-ui bg-on-ink px-8 py-4 font-medium text-ink transition-opacity duration-300 hover:opacity-90">Appeler le {site.contact.phoneDisplay}</a>
          <a href="#reserver" class="underline decoration-1 underline-offset-4 text-on-ink/85 hover:text-on-ink">Réserver une raclette</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ardoise : un trait de craie entre les lignes, pas de cadre ni de texture (grain interdit, GOUT § 2). */
  .ardoise-liste { list-style: none; margin: 0; padding: 0; }
  .ardoise-trait { width: 100%; background: color-mix(in srgb, var(--on-ink) 55%, transparent); }
  .ardoise-liste li {
    display: grid;
    gap: 2px;
    padding: 14px 0;
    border-top: 1px solid color-mix(in srgb, var(--on-ink) 22%, transparent);
  }
  .ardoise-liste li:last-child { border-bottom: 1px solid color-mix(in srgb, var(--on-ink) 22%, transparent); }
  @media (min-width: 48rem) {
    .ardoise-liste li { grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); align-items: baseline; gap: 24px; }
  }
  .ardoise-horaires { margin: 0; display: grid; gap: 8px; font-size: 0.95rem; }
  /* Relecture DA, tour 3 (16 oct 2026). Dans le style de la section et non en classes Tailwind : une règle
     de <style> hors couche bat les utilitaires (`hidden`, `lg:max-w-*` restaient sans effet, CLAUDE.md § Pièges).
     Téléphone : la ligne « Aujourd'hui » suffit, le tableau complet est repris dans le contact.
     Ordinateur : le titre tient en trois lignes, le bouton reste dans le premier écran. */
  @media (max-width: 63.99rem) { .ardoise-horaires { display: none; } }
  @media (min-width: 64rem) { .ardoise h1.hero-titre.text-display-xl { max-width: 24ch; font-size: clamp(3.25rem, 5.4vw, 5.25rem); } }
  .ardoise-horaires > div { display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: 12px; color: color-mix(in srgb, var(--on-ink) 72%, transparent); }
  .ardoise-horaires > div.aujourdhui { color: var(--on-ink); font-weight: 600; }
  .ardoise-horaires dt, .ardoise-horaires dd { margin: 0; }
</style>

<script>
  // Ligne du jour en clair (heure locale du visiteur, boutique en France). Sans script : liste lisible.
  function jourDuJour() {
    const j = new Date().getDay();
    let ligne = '';
    document.querySelectorAll<HTMLElement>('[data-horaires] [data-jours]').forEach((l) => {
      const oui = (l.dataset.jours || '').split(',').filter(Boolean).map(Number).includes(j);
      l.classList.toggle('aujourdhui', oui);
      if (oui) ligne = `Aujourd’hui : ${l.querySelector('dd')?.textContent ?? ''}`;
    });
    const p = document.querySelector<HTMLElement>('[data-aujourdhui]');
    if (p && ligne) { p.textContent = ligne; p.hidden = false; }
  }
  jourDuJour();
  document.addEventListener('astro:page-load', jourDuJour);
</script>
