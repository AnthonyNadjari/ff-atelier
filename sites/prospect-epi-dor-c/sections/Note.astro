---
/**
 * Premier écran « preuve d'abord » (premiers-ecrans.md) de la version C : la note Google relevée le 17 oct 2026
 * (4,6 sur 162 avis) en très grand, et les deux avis du brief recopiés mot pour mot, AVANT les portes des rayons
 * (architecture accueil-portes). Le métier, la ville et le numéro en tête, cliquable sans défiler (socle GOUT § 0).
 * Le bloc sur mesure est ici : la note est posée comme l'étiquette du comptoir (chiffre géant, cinq épis dessinés en
 * trait qui se remplissent à la part près de 4,6), et les avis sont deux tickets décalés, l'un sur l'autre (ombre
 * réelle : deux plans), posés en partie sur le fraisier de la galerie dans son cadre. Rien d'autre que le brief : pas de moyenne recalculée, pas d'avis ajouté.
 * Mouvement (version calme) : les épis se remplissent une fois, de gauche à droite (sec), le second ticket glisse
 * sous le premier (lent) ; rien en mouvement réduit. Tokens seulement.
 */
import { site, tel } from '@/lib/site';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import Img from '@/components/Img.astro';
import HorairesDuJour from '@/components/HorairesDuJour.astro';

const g = site.proof.google;
const avis = site.proof.testimonials.slice(0, 2);
// La photo du premier écran : le fraisier au muguet, première photo de la page des pâtisseries (galerie de la boutique).
const photo = site.services.find((s) => s.images.length > 0)?.images[0];
const note = g ? g.rating.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) : '';
// Part de chaque épi remplie (4,6 → 1, 1, 1, 1, 0,6) : la note telle quelle, pas arrondie.
const parts = g ? Array.from({ length: 5 }, (_, i) => Math.max(0, Math.min(1, g.rating - i))) : [];
---

<section id="hero" class="nt" aria-labelledby="nt-titre">
  <div class="nt-in">
    <div class="nt-tete">
      <h1 id="nt-titre" class="nt-titre">{site.business.tagline}</h1>
      <p class="nt-adresse">{site.business.name}, {site.contact.address.street}</p>
      <div class="nt-actions">
        <Button href={tel()} size="lg" class="nt-tel"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</Button>
        <Button href="/#contact" variant="ghost" size="lg">{site.wording.devis}</Button>
      </div>
      {site.contact.hours.length > 0 && <HorairesDuJour class="nt-jour" />}
    </div>

    {g && (
      <div class="nt-note">
        <p class="nt-chiffre" aria-label={`${note} sur 5`}>{note}</p>
        <div class="nt-epis" aria-hidden="true">
          {parts.map((p, i) => (
            <svg viewBox="0 0 24 48" class="nt-epi" style={`--part:${p};--i:${i}`}>
              <defs>
                <clipPath id={`nt-c${i}`}><rect x="0" y={48 - 48 * p} width="24" height={48 * p} class="nt-plein" /></clipPath>
              </defs>
              <path class="nt-trait" d="M12 46V6M12 10c-5 0-7 3-7 7 4 0 7-2 7-7Zm0 0c5 0 7 3 7 7-4 0-7-2-7-7Zm0 9c-5 0-7 3-7 7 4 0 7-2 7-7Zm0 0c5 0 7 3 7 7-4 0-7-2-7-7Zm0 9c-5 0-7 3-7 7 4 0 7-2 7-7Zm0 0c5 0 7 3 7 7-4 0-7-2-7-7ZM12 6c0-2 1-4 2-5" />
              <g clip-path={`url(#nt-c${i})`}>
                <path class="nt-grain" d="M12 10c-5 0-7 3-7 7 4 0 7-2 7-7Zm0 0c5 0 7 3 7 7-4 0-7-2-7-7Zm0 9c-5 0-7 3-7 7 4 0 7-2 7-7Zm0 0c5 0 7 3 7 7-4 0-7-2-7-7Zm0 9c-5 0-7 3-7 7 4 0 7-2 7-7Zm0 0c5 0 7 3 7 7-4 0-7-2-7-7Z" />
              </g>
            </svg>
          ))}
        </div>
        <p class="nt-sur">
          sur 5, <a href={g.url} target="_blank" rel="noopener">{g.count}&nbsp;avis Google</a>
        </p>
      </div>
    )}

    <div class="nt-droite">
    {photo && (
      <figure class="nt-cadre">
        <Img src={photo.src} alt={photo.alt} priority sizes="(min-width: 1024px) 26rem, 80vw" class="nt-img" />
      </figure>
    )}
    {avis.length > 0 && (
      <ul class="nt-avis">
        {avis.map((a, i) => (
          <li class:list={['nt-ticket', `nt-ticket-${i + 1}`]}>
            <blockquote><p>« {a.text} »</p></blockquote>
            <p class="nt-qui">{a.author}, avis {a.source}{a.date ? `, ${a.date}` : ''}</p>
          </li>
        ))}
      </ul>
    )}
    </div>
  </div>
</section>

<style>
  .nt { padding-block: clamp(1.5rem, 4vw, 3.5rem) clamp(2.5rem, 6vw, 5rem); }
  .nt-in {
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 2rem);
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.5rem);
  }
  .nt-titre { font-family: var(--font-display); font-size: var(--scale-md); line-height: 1.05; }
  .nt-adresse { margin-top: 0.4rem; color: var(--muted); }
  .nt-actions { margin-top: 1.1rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .nt-tel { font-variant-numeric: tabular-nums; }
  .nt-tete :global(.nt-jour) { margin-top: 1rem; font-size: 0.95rem; }

  .nt-note { display: grid; grid-template-columns: auto 1fr; align-items: end; column-gap: 1rem; }
  /* Téléphone : la preuve d'abord (premiers-ecrans.md, preuve-d-abord) : la note, les deux tickets, puis le métier, la
     ville et le numéro (le numéro est aussi dans la barre du haut), puis le fraisier dans son cadre. */
  @media (max-width: 1023px) {
    .nt-droite { display: contents; }
    .nt-note { order: -3; }
    .nt-avis { order: -2; }
    .nt-cadre { order: 1; }
  }
  .nt-chiffre {
    font-family: var(--font-display);
    font-size: clamp(7rem, 30vw, 15rem);
    line-height: 0.8;
    letter-spacing: -0.03em;
    color: var(--fg);
    grid-row: span 2;
  }
  .nt-epis { display: flex; gap: 0.15rem; }
  .nt-epi { inline-size: clamp(1.4rem, 4vw, 2.2rem); block-size: auto; overflow: visible; }
  .nt-trait { fill: none; stroke: var(--fg); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; }
  .nt-grain { fill: var(--fill); }
  .nt-sur { font-size: 1.1rem; margin-top: 0.4rem; }
  .nt-sur a { text-decoration: underline; text-underline-offset: 0.2em; }

  .nt-droite { position: relative; }
  /* La photo dans sa marge (atome photos de meyers : cadre), les tickets d'avis posés en partie dessus. */
  .nt-cadre { background: var(--surface); padding: 0.6rem; border: 1px solid var(--line); border-radius: var(--radius-card); inline-size: 82%; margin-inline-start: auto; }
  .nt-cadre :global(.nt-img) { inline-size: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: calc(var(--radius-card) / 2); }
  .nt-avis { display: grid; gap: 1rem; position: relative; z-index: 1; }
  .nt-ticket {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    padding: 1.25rem 1.35rem;
  }
  .nt-ticket blockquote p { font-family: var(--font-display); font-size: clamp(1.35rem, 3.6vw, 2rem); line-height: 1.2; }
  .nt-qui { margin-top: 0.8rem; font-size: 0.95rem; color: var(--muted); }

  /* Ordinateur : la tête en haut à gauche, la note géante dessous, les deux tickets à droite, décalés l'un sur l'autre. */
  @media (min-width: 1024px) {
    .nt-in { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); grid-template-rows: auto 1fr; column-gap: 4rem; }
    .nt-tete { grid-column: 1; grid-row: 1; }
    .nt-note { grid-column: 1; grid-row: 2; align-self: end; }
    .nt-droite { grid-column: 2; grid-row: 1 / span 2; }
    .nt-cadre { inline-size: 58%; }
    .nt-avis { position: absolute; inset: auto auto 0 0; inline-size: 78%; margin: 0; gap: 0; }
    .nt-ticket-1 { position: relative; z-index: 2; inline-size: 82%; }
    .nt-ticket-2 { position: relative; z-index: 1; inline-size: 78%; margin: -1.5rem 0 0 auto; padding-top: 2.5rem; }
    .nt-ticket blockquote p { font-size: clamp(1.6rem, 2.3vw, 2.25rem); }
  }

  /* Mouvement (version calme) : les épis se remplissent une fois de gauche à droite (sec, 0,18 s, 70 ms d'écart) ;
     le second ticket glisse sous le premier (lent, 0,9 s). Rien en mouvement réduit. */
  @media (prefers-reduced-motion: no-preference) {
    .nt-plein { transform-box: fill-box; transform-origin: bottom; animation: nt-remplir 0.18s ease-out both; animation-delay: calc(0.35s + var(--i) * 70ms); }
    .nt-ticket-2 { animation: nt-glisser 0.9s var(--ease-brand, ease-out) 0.2s both; }
  }
  @keyframes nt-remplir { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes nt-glisser { from { transform: translateY(-1.25rem); opacity: 0; } to { transform: none; opacity: 1; } }
</style>
