---
/**
 * Premier écran « le relevé » — propre à Ampère & Fils.
 * Idée : un électricien se juge sur des mentions vérifiables, pas sur une promesse. L'écran est un
 * relevé : le titre, puis les mentions de l'entreprise en étiquette / valeur, comme sur un tableau.
 * Ni eyebrow, ni sous-titre, ni bouton, ni schéma : que des choses contrôlables.
 */
import { site, tel } from '@/lib/site';

const heures = site.contact.hours[0];
const lignes = [
  { k: 'Atelier', v: `${site.contact.address.street}, ${site.contact.address.city}` },
  ...(site.zones?.label ? [{ k: 'Zone', v: site.zones.label }] : []),
  ...(heures ? [{ k: 'Ouvert', v: `${heures.days}, ${heures.hours}` }] : []),
  ...(site.business.certifications.length ? [{ k: 'Qualifications', v: site.business.certifications.join(', ') }] : []),
  ...(site.business.since ? [{ k: 'Depuis', v: String(site.business.since) }] : []),
];
---

<section id="hero" class="bg-bg">
  <div class="container-ff flex min-h-[80svh] flex-col justify-center gap-14 pb-16 pt-32 md:pt-40">
    <h1
      class="max-w-3xl text-display-lg leading-[1.06]"
      data-reveal
      set:html={site.business.tagline}
    />

    <dl class="grid gap-x-10 gap-y-8 border-t border-line pt-10 sm:grid-cols-2 lg:grid-cols-3" data-stagger="80">
      {lignes.map((l) => (
        <div>
          <dt class="text-sm text-muted">{l.k}</dt>
          <dd class="mt-2 font-display text-xl leading-snug text-fg">{l.v}</dd>
        </div>
      ))}
    </dl>

    <p>
      <a href={tel()} class="font-display text-xl text-fg underline-offset-4 hover:underline">
        {site.contact.phoneDisplay}
      </a>
    </p>
  </div>
</section>
