---
/**
 * « L’arrivage du jour » : l’ardoise du comptoir, le bloc signature de Chez Malo (9 oct 2026). Un
 * seul bloc encre avec grain : à gauche, ce qui est arrivé de la criée ce matin (poisson, origine,
 * comment il est cuisiné, prix), un trait de craie entre chaque ligne ; à droite, les heures de
 * service (site.contact.hours) et le téléphone pour réserver, avec la règle de la bouillabaisse
 * (site.services, prix du brief). Remplace « L’essentiel » (trois cartes à icône) et « Une journée »
 * (quatre heures géantes épinglées). Démo : arrivage fictif, plausible, daté.
 */
import { site, tel } from '@/lib/site';

const date = 'Jeudi 9 octobre';
const arrivage = [
  { poisson: 'Grondin rouge', origine: 'Criée de Marseille, petit bateau', cuisson: 'Grillé entier, huile d’olive et citron', prix: '24 €' },
  { poisson: 'Loup de ligne', origine: 'Carry-le-Rouet', cuisson: 'Grillé, fenouil confit', prix: '28 €' },
  { poisson: 'Daurade royale', origine: 'Criée de Marseille', cuisson: 'En croûte de sel, pour deux', prix: '52 €' },
  { poisson: 'Rouget de roche', origine: 'Les Goudes', cuisson: 'Poêlé, tapenade', prix: '26 €' },
  { poisson: 'Poulpe', origine: 'Baie de Marseille', cuisson: 'Grillé, pommes de terre écrasées', prix: '14 €' },
];
const bouillabaisse = site.services.find((s) => s.slug === 'bouillabaisse-du-vallon');
---

<section id="arrivage" class="section-y bg-ink text-on-ink" data-grain>
  <div class="container-ff relative z-[1]">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
      <h2 class="font-display text-display-lg leading-none">L’arrivage du jour</h2>
      <p class="max-w-sm text-on-ink/70">Ce qui est rentré de la criée ce matin. Jusqu’à épuisement, et ce soir ce sera autre chose.</p>
    </div>

    <div class="mt-12 grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="font-display text-xl text-on-ink/80">{date}</p>
        <ol class="mt-4 border-t border-dashed border-on-ink/45" data-stagger="90">
          {arrivage.map((a) => (
            <li class="grid gap-x-8 gap-y-1 border-b border-dashed border-on-ink/45 py-5 sm:grid-cols-[1fr_auto] sm:items-baseline">
              <div>
                <p class="font-display text-2xl leading-tight sm:text-3xl">{a.poisson}</p>
                <p class="mt-1 text-on-ink/70">{a.origine}. {a.cuisson}.</p>
              </div>
              <p class="font-display text-2xl tabular-nums sm:text-right">{a.prix}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="lg:col-span-5 lg:pt-12">
        <h3 class="font-display text-2xl">Service</h3>
        <dl class="mt-4 border-t border-on-ink/25">
          {site.contact.hours.map((h) => (
            <div class="flex justify-between gap-6 border-b border-on-ink/25 py-3">
              <dt class="text-on-ink/70">{h.days}</dt>
              <dd class="text-right tabular-nums">{h.hours}</dd>
            </div>
          ))}
        </dl>

        <p class="mt-8 text-on-ink/80">Pour réserver, un appel suffit. On garde la table un quart d’heure.</p>
        <a href={tel()} class="mt-2 block font-display leading-none underline-offset-8 hover:underline" style="font-size: clamp(2rem, 4vw, 3rem);">{site.contact.phoneDisplay}</a>

        {bouillabaisse && (
          <p class="mt-8 border-t border-on-ink/25 pt-6 text-on-ink/80">
            <span class="font-display text-xl text-on-ink">{bouillabaisse.title}</span><br />
            {bouillabaisse.short}
          </p>
        )}
      </div>
    </div>
  </div>
</section>
