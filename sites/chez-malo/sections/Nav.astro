---
/**
 * Nav de Chez Malo : une ligne en haut, transparente sur le premier écran, fond papier dès que la
 * page défile. Le nom à gauche, trois liens en mots du quotidien et le téléphone à droite, en texte,
 * sans icône ni pastille. Se masque au défilement vers le bas (data-nav="hide-on-scroll", motion.ts
 * pose .is-hidden / .is-scrolled). Avant le 9 oct 2026 : un dock flottant en pilule, en bas de
 * l’écran, quatre entrées à icônes et un bouton « Réserver » en capsule.
 */
import { site, tel, navLinks } from '@/lib/site';
const links = navLinks().filter((l) => l.href !== '#contact');
---

<header data-nav="hide-on-scroll" class="nav-malo fixed inset-x-0 top-0 z-50 text-on-ink">
  <div class="container-ff flex items-center justify-between gap-6 py-5">
    <a href="#hero" class="font-display text-lg font-semibold">{site.business.name}</a>
    <nav aria-label="Navigation principale" class="flex items-center gap-x-5 gap-y-1 text-sm sm:gap-x-7">
      {links.map((l) => (
        <a href={l.href} class="hidden underline-offset-4 hover:underline sm:inline">{l.label}</a>
      ))}
      <a href={tel()} class="tabular-nums underline-offset-4 hover:underline">{site.contact.phoneDisplay}</a>
    </nav>
  </div>
</header>

<style>
  .nav-malo { transition: transform 0.4s var(--ease-out), background-color 0.4s ease, color 0.4s ease; }
  .nav-malo.is-hidden { transform: translateY(-100%); }
  .nav-malo.is-scrolled { background: color-mix(in oklab, var(--bg) 92%, transparent); color: var(--fg); }
  @media (prefers-reduced-motion: reduce) { .nav-malo { transition: none; } }
</style>
