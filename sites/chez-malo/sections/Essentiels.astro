---
/**
 * « L'essentiel » — propre à ce site. Les trois entrées de site.services (bouillabaisse, poisson
 * du jour, terrasse) ne sont affichées nulle part ailleurs : Carte.astro liste les plats du menu
 * (données distinctes, colonnes entrées/plats/desserts), LeLieu.astro ne parle pas de prix.
 * Composition en trois panneaux façon ardoise de comptoir, icône + prix « à partir de » quand il
 * est renseigné (jamais inventé), sans photo — pour ne pas répéter LeLieu (photos diagonales) ni
 * Carte (galerie au survol). Aucune réutilisation ailleurs.
 */
import { site } from '@/lib/site';
import Icon from '@/components/Icon.astro';

const essentiels = site.services;
// accent-2 (bleu l36) tombe sous 3:1 sur fond ink : texte accent eclairci vers on-ink (contraste AA, teinte gardee).
const accentSurInk = 'text-[color-mix(in_oklch,var(--accent-2),var(--on-ink)_50%)]';
---

<section id="essentiels" class="section-y bg-ink text-on-ink">
  <div class="container-ff">
    <p class="eyebrow text-on-ink/60">L’essentiel</p>
    <h2 class="mt-4 max-w-xl font-display text-display-lg leading-none" data-reveal>Ce qui fait <em class:list={[accentSurInk, "not-italic"]}>la maison</em></h2>
  </div>

  <ul class="mt-14 grid border-y border-on-ink/15 sm:grid-cols-3" data-stagger="110">
    {essentiels.map((s) => (
      <li class="border-t border-on-ink/15 px-8 py-10 first:border-t-0 sm:border-t-0 sm:border-l sm:px-6 sm:first:border-l-0">
        <Icon name={s.icon} size={28} class="text-accent-2" strokeWidth={1.5} />
        <h3 class="mt-6 font-display text-2xl">{s.title}</h3>
        <p class="mt-3 max-w-xs text-on-ink/70">{s.short}</p>
        {s.priceFrom && <p class:list={["mt-5 font-display text-lg", accentSurInk]}>{s.priceFrom}</p>}
      </li>
    ))}
  </ul>
</section>
