---
/**
 * « Le lieu » : l’histoire de la maison (about.story), deux photos du Vallon du dossier posées
 * côte à côte à des hauteurs différentes, comme des tirages, et les faits sur des filets : ouverture,
 * couverts, adresse, terrasse, bouillabaisse. Avant le 9 oct 2026 : deux photos qui se chevauchaient
 * avec décalage au défilement, bordure et ombre, un surtitre, et aucun fait.
 */
import { site, paragraphs, fullAddress } from '@/lib/site';
import Img from '@/components/Img.astro';

const faits = [
  site.business.since ? { k: 'Ouvert en', v: String(site.business.since) } : null,
  { k: 'Couverts', v: 'Trente-deux, salle et terrasse comprises' },
  { k: 'Adresse', v: fullAddress() },
  { k: 'Terrasse', v: 'Dès les beaux jours, au ras de l’eau, selon le mistral' },
  { k: 'Bouillabaisse', v: 'Sur commande la veille, deux personnes au minimum' },
  { k: 'Fermeture', v: 'Le lundi, et trois semaines en janvier' },
].filter((f): f is { k: string; v: string } => Boolean(f));
---

<section id="lelieu" class="section-y bg-bg">
  <div class="container-ff">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="font-display text-display-lg leading-none">{site.about.title}</h2>
        <div class="mt-8 max-w-[34rem] space-y-5 text-lg leading-relaxed" data-reveal>
          {paragraphs(site.about.story).map((p) => <p>{p}</p>)}
        </div>
      </div>

      <div class="lg:col-span-5 lg:pt-4">
        <dl class="border-t border-line">
          {faits.map((f) => (
            <div class="flex justify-between gap-6 border-b border-line py-3 text-sm">
              <dt class="shrink-0 text-muted">{f.k}</dt>
              <dd class="text-right text-fg">{f.v}</dd>
            </div>
          ))}
        </dl>
        {site.contact.mapsUrl && (
          <a href={site.contact.mapsUrl} target="_blank" rel="noopener" class="mt-5 inline-block text-sm text-fg underline underline-offset-4 hover:text-accent-2">Voir sur la carte</a>
        )}
      </div>
    </div>

    <div class="mt-16 grid grid-cols-12 gap-4 sm:gap-6" data-stagger="120">
      <figure class="col-span-7">
        <div class="overflow-hidden rounded-card">
          <Img src="/images/portrait.webp" alt="Les cabanons et les barques du Vallon des Auffes, vus du pont" class="aspect-[4/3] w-full object-cover" sizes="58vw" loading="lazy" />
        </div>
        <figcaption class="mt-3 text-sm text-muted">Le vallon, depuis le pont de la Corniche</figcaption>
      </figure>
      <figure class="col-span-5 pt-12 sm:pt-20">
        <div class="overflow-hidden rounded-card">
          <Img src="/images/galerie-1.webp" alt="Le port du Vallon des Auffes et ses cabanons, vus depuis la salle" class="aspect-[4/5] w-full object-cover" sizes="42vw" loading="lazy" />
        </div>
        <figcaption class="mt-3 text-sm text-muted">Depuis la salle, les barques</figcaption>
      </figure>
    </div>
  </div>
</section>
