---
/**
 * "Horaires" : la journée du restaurant en quatre temps, épinglée au scroll (data-pin="160",
 * quatre data-pin-step révélés tour à tour), puis les horaires d'ouverture réels. Propre à ce site.
 */
import { site } from '@/lib/site';

const temps = [
  { heure: '6h', titre: 'La criée', texte: 'Malo choisit poisson et coquillages arrivés dans la nuit, directement sur le quai.' },
  { heure: '10h', titre: 'La cuisine', texte: 'Fumets, sauces, fond de bouillabaisse. Le service du midi se prépare en silence.' },
  { heure: '12h', titre: 'Le service', texte: 'Trente-deux couverts, la salle et la terrasse face au port.' },
  { heure: '19h30', titre: 'Le soir', texte: 'Les tables se dressent à nouveau, face au soleil qui descend sur le Vallon.' },
];
---

<section id="horaires" class="section-y bg-bg-2">
  <div class="container-ff">
    <p class="eyebrow">Une journée</p>
    <h2 class="mt-4 max-w-2xl font-display text-display-lg leading-none" data-reveal>De la criée <em class="text-accent not-italic">à la table</em></h2>
  </div>

  <div data-pin="160" class="mt-4">
    <div class="container-ff flex min-h-[70svh] flex-col justify-center gap-10 py-16 md:gap-12">
      {temps.map((t) => (
        <div data-pin-step class="grid grid-cols-1 items-baseline gap-2 md:grid-cols-[minmax(0,9rem)_1fr] md:gap-12">
          <span class="font-display leading-none text-accent" style="font-size: clamp(2.5rem, 8vw, 5.5rem);">{t.heure}</span>
          <div>
            <h3 class="font-display text-2xl">{t.titre}</h3>
            <p class="mt-2 max-w-md text-muted">{t.texte}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="container-ff mt-8">
    <div class="rounded-card border border-line bg-surface p-8">
      <p class="eyebrow mb-5">Horaires d’ouverture</p>
      <dl class="grid gap-3 sm:grid-cols-3" data-stagger="90">
        {site.contact.hours.map((h) => (
          <div data-reveal class="border-t border-line pt-3">
            <dt class="font-display text-lg">{h.days}</dt>
            <dd class="mt-1 text-muted">{h.hours}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
