---
/**
 * Premier écran de Chez Malo : le poisson, en plein cadre (9 oct 2026). Les grondins rouges de la
 * criée sur la planche (images.hero, photo du dossier) couvrent l’écran ; l’accroche « La criée le
 * matin, la carte le soir. » est posée en bas à gauche, suivie d’une phrase qui dit qui, où, combien
 * de couverts, depuis quand, puis l’adresse, le téléphone et les heures de service. Le hero reste
 * épinglé sous la page qui glisse (coquille sticky-hero), c’est le seul geste.
 * Avant : la vue du Vallon en duotone, le titre qui se remplit au défilement, un badge rond
 * « Réserver » qui tourne, un surtitre, et l’accroche affichée avec ses balises <em> en clair.
 *
 * Le titre est un <h1> (titre de la page). Garder les commentaires d’intention ICI et jamais en
 * commentaire HTML : un commentaire livré dans le body repousse le contenu réel et fait échouer le
 * contrôle « lien tel: dans les 1500 premiers caractères ».
 */
import { site, tel } from '@/lib/site';
import Img from '@/components/Img.astro';
const hero = site.images.hero;
---

<section id="hero" class="relative flex min-h-svh flex-col justify-end overflow-hidden bg-ink text-on-ink">
  {hero && (
    <Img src={hero.src} alt={hero.alt} class="absolute inset-0 h-full w-full object-cover object-[55%_45%]" sizes="100vw" loading="eager" fetchpriority="high" />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent" aria-hidden="true"></div>

  <div class="container-ff relative flex flex-col gap-8 pb-12 pt-40 md:gap-10 md:pb-16">
    <h1
      class="max-w-[14ch] font-display leading-[0.95]"
      style="font-size: clamp(2.75rem, 8vw, 7rem);"
      data-split
      set:html={site.business.tagline.replace(/<\/?em>/g, '')}
    />

    <p class="max-w-[36rem] text-lg leading-snug text-on-ink/85 sm:text-xl">
      Malo Ferrer achète à la criée du Vieux-Port ce qu’il cuisine le jour même. Trente-deux couverts et une terrasse au Vallon des Auffes, depuis {site.business.since}.
    </p>

    <p class="flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm text-on-ink/65">
      <span>{site.contact.address.street}, {site.contact.address.postalCode} {site.contact.address.city}</span>
      <a href={tel()} class="text-on-ink underline-offset-4 hover:underline">{site.contact.phoneDisplay}</a>
      <span>Fermé le lundi</span>
    </p>
  </div>
</section>
