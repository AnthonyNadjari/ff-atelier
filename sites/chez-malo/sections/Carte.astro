---
/**
 * « La carte » : trois photos de plats du dossier (bouillabaisse, daurade grillée, poisson entier),
 * nom dessous en texte simple, puis la carte comme une liste typographique, entrées / plats /
 * desserts, prix aligné à droite par un filet pointillé. Sans surtitres de colonne ni photo qui
 * flotte au survol de chaque plat (9 oct 2026). Démo : plats et prix fictifs, plausibles.
 */
import Img from '@/components/Img.astro';

const photos = [
  { src: '/images/galerie-3.webp', alt: 'Assiette de bouillabaisse, rouille et croûtons', legende: 'Bouillabaisse du Vallon' },
  { src: '/images/galerie-6.webp', alt: 'Daurade entière grillée au sel, citron', legende: 'Daurade royale en croûte de sel' },
  { src: '/images/galerie-4.webp', alt: 'Poisson entier grillé servi dans un plat creux', legende: 'Poisson du jour, grillé entier' },
];

const colonnes = [
  {
    titre: 'Entrées',
    plats: [
      { nom: 'Soupe de poissons de roche, rouille et croûtons', prix: '12 €' },
      { nom: 'Anchois marinés au vinaigre de xérès', prix: '10 €' },
      { nom: 'Poulpe grillé, pommes de terre écrasées à l’huile d’olive', prix: '14 €' },
    ],
  },
  {
    titre: 'Plats',
    plats: [
      { nom: 'Bouillabaisse du Vallon, pour deux, sur commande la veille', prix: '84 €' },
      { nom: 'Loup de ligne grillé, fenouil confit', prix: '28 €' },
      { nom: 'Daurade royale en croûte de sel', prix: '26 €' },
      { nom: 'Risotto de seiche à l’encre', prix: '22 €' },
    ],
  },
  {
    titre: 'Desserts',
    plats: [
      { nom: 'Tarte au citron de Menton', prix: '9 €' },
      { nom: 'Fromage blanc, miel de lavande', prix: '8 €' },
      { nom: 'Panna cotta, coulis de fruits rouges', prix: '9 €' },
    ],
  },
];
---

<section id="carte" class="section-y bg-bg-2">
  <div class="container-ff">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="font-display text-display-lg leading-none lg:col-span-6">La carte</h2>
      <p class="max-w-md text-muted lg:col-span-5 lg:col-start-8">Écrite chaque matin après la criée. Les poissons changent tous les jours, les prix sont ceux de l’ardoise.</p>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-3" data-stagger="90">
      {photos.map((p) => (
        <li>
          <figure>
            <div class="overflow-hidden rounded-card">
              <Img src={p.src} alt={p.alt} class="aspect-[4/3] w-full object-cover" sizes="(min-width: 640px) 33vw, 100vw" loading="lazy" />
            </div>
            <figcaption class="mt-3 font-display text-lg">{p.legende}</figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="mt-16 grid gap-x-12 gap-y-12 md:grid-cols-3">
      {colonnes.map((col) => (
        <div>
          <h3 class="border-b border-fg/60 pb-3 font-display text-xl">{col.titre}</h3>
          <ul class="mt-5 space-y-5">
            {col.plats.map((p) => (
              <li class="dish">
                <span class="dish-name font-display">{p.nom}</span>
                <span class="dish-fill" aria-hidden="true"></span>
                <span class="dish-price">{p.prix}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="mt-12 max-w-prose text-sm text-muted">La carte change avec la pêche : certains plats peuvent manquer un soir, d’autres apparaître sans préavis. Carte bancaire ou espèces.</p>
  </div>
</section>

<style>
  .dish { display: flex; flex-wrap: wrap; align-items: baseline; }
  .dish-name { flex: 1 1 12rem; min-width: 0; padding-right: 0.5rem; font-size: 1.1rem; line-height: 1.3; }
  .dish-fill {
    flex: 1 1 2rem;
    min-width: 0.75rem;
    align-self: flex-end;
    margin: 0 0.4em 0.4em;
    border-bottom: 1px dotted color-mix(in oklab, var(--fg) 45%, transparent);
  }
  .dish-price { flex: 0 0 auto; white-space: nowrap; font-variant-numeric: tabular-nums; }
</style>
