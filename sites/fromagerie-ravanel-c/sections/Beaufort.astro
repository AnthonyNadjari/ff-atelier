---
/**
 * Le beaufort d'alpage à l'âge qu'on veut (piste C). Faits du brief : 12, 18 ou 24 mois ; les fromages
 * affinés longtemps (beaufort 24 mois) contiennent très peu de lactose ; on goûte avant d'acheter.
 * Les trois âges ne sont pas trois cartes égales : une marche qui grandit avec l'âge (le chiffre grossit),
 * chaque chiffre compte à l'arrivée (data-counter). Photo d'illustration CC BY-SA, créditée sous l'image.
 */
import Img from '@/components/Img.astro';

const ages = [
  { mois: 12, note: '' },
  { mois: 18, note: '' },
  { mois: 24, note: 'Très peu de lactose. Demandez à Claire.' },
];
---

<section id="beaufort" class="beaufort bg-bg text-fg">
  <div class="container-ff section-y">
    <h2 class="beaufort-titre font-display" data-split="lines">Le beaufort d’alpage, à l’âge que vous voulez.</h2>

    <ol class="marche" data-stagger="90" aria-label="Âges du beaufort">
      {ages.map((a, i) => (
        <li class={`marche-${i + 1}`}>
          <span class="marche-chiffre font-display" data-counter={a.mois}>{a.mois}</span>
          <span class="marche-mois">mois</span>
          {a.note && <span class="marche-note">{a.note}</span>}
        </li>
      ))}
    </ol>

    <p class="beaufort-texte">Plus il a vieilli, plus il est fort. Goûtez avant de choisir : à la boutique, on goûte toujours avant d’acheter.</p>

    <figure class="beaufort-photo">
      <div class="overflow-hidden" data-reveal="wipe">
        <Img src="/images/beaufort.webp" alt="Meules de beaufort empilées" class="aspect-[16/7] w-full object-cover" sizes="(min-width: 96rem) 1400px, 100vw" data-scrub="scale=1.12" />
      </div>
      <figcaption>Photo d’illustration : Ibex73, <a href="https://creativecommons.org/licenses/by-sa/4.0" rel="noopener license">CC BY-SA 4.0</a>, <a href="https://commons.wikimedia.org/wiki/File:Wheels_of_Beaufort_cheese,_France_(1).jpg" rel="noopener">Wikimedia Commons</a>.</figcaption>
    </figure>
  </div>
</section>

<style>
  .beaufort-titre { font-size: clamp(2rem, 4.6vw, 4rem); line-height: 1.02; max-width: 18ch; }
  .marche { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 8px; align-items: end; }
  .marche li { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 14px; align-items: baseline; border-bottom: 3px solid var(--fg); padding-bottom: 6px; }
  .marche-chiffre { line-height: 0.9; font-variant-numeric: tabular-nums; color: var(--accent); }
  .marche-mois { font-family: var(--font-display); font-size: clamp(1.3rem, 2.4vw, 2rem); }
  .marche-note { grid-column: 1 / -1; margin-top: 6px; font-weight: 600; }
  .marche-1 .marche-chiffre { font-size: clamp(4rem, 9vw, 7rem); color: var(--accent-2); }
  .marche-2 .marche-chiffre { font-size: clamp(5.5rem, 13vw, 10.5rem); }
  .marche-3 .marche-chiffre { font-size: clamp(7rem, 18vw, 15rem); color: var(--fg); }
  @media (min-width: 48rem) {
    .marche { grid-template-columns: 0.8fr 1fr 1.3fr; gap: 32px; margin-top: 56px; }
    .marche li { grid-template-columns: 1fr; }
  }
  .beaufort-texte { margin-top: 32px; max-width: 34rem; font-size: 1.2rem; }
  .beaufort-photo { margin: 48px 0 0; }
  .beaufort-photo figcaption { margin-top: 8px; font-size: 0.85rem; color: var(--muted); }
  .beaufort-photo figcaption a { text-decoration: underline; }
</style>
