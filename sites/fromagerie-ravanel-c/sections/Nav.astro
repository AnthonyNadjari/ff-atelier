---
/**
 * Nav de la piste C « Le comptoir » : une barre fine qui prend la couleur de l'affiche qu'elle survole
 * (fond et texte lus sur la section dessous, donc toujours des tokens de la direction). Nom à gauche,
 * cinq ancres sur ordinateur, « Appeler » à droite, partout. Pas de burger : sur téléphone, le nom et
 * l'appel suffisent, le reste se lit en descendant.
 * Règles globales du site (une seule fois, ici) : Alfa Slab One n'a qu'une graisse, `--display-weight`
 * ramené à 400 (sinon faux gras) ; feuille de la coquille sticky-hero à angle droit (affiche, pas carte).
 */
import { site, tel } from '@/lib/site';

const liens = site.layout.sections
  .filter((s) => s.type === 'custom' && s.label)
  .map((s) => ({ href: `/#${s.variant.toLowerCase()}`, label: s.label as string }));
---

<header class="nav-c" data-nav-c>
  <div class="container-ff nav-c-ligne">
    <a href="/" class="nav-c-nom font-display">{site.business.name}</a>
    <nav class="nav-c-liens" aria-label="Navigation principale">
      {liens.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a href={tel()} class="nav-c-appel" aria-label={`Appeler la fromagerie au ${site.contact.phoneDisplay}`}>
      <span class="nav-c-court">Appeler</span><span class="nav-c-long">{site.contact.phoneDisplay}</span>
    </a>
  </div>
</header>

<style is:global>
  [data-direction='pop'] { --display-weight: 400; }
  [data-shell='sticky-hero'] main > div.relative { border-radius: 0; }
</style>

<style>
  .nav-c {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: var(--nv-bg, var(--bg-2));
    color: var(--nv-fg, var(--fg));
    transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out);
  }
  .nav-c-ligne { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 10px; }
  .nav-c-nom { font-size: 1.15rem; line-height: 1; text-decoration: none; white-space: nowrap; }
  .nav-c-liens { display: none; gap: 28px; font-weight: 600; }
  .nav-c-liens a { text-decoration: none; }
  .nav-c-appel {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 2px solid currentColor;
    border-radius: 4px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--motion-ui) var(--ease-out), color var(--motion-ui) var(--ease-out);
  }
  .nav-c-long { display: none; font-variant-numeric: tabular-nums; }
  @media (min-width: 40rem) { .nav-c-court { display: none; } .nav-c-long { display: inline; } }
  @media (min-width: 64rem) { .nav-c-liens { display: flex; } }
  @media (hover: hover) and (pointer: fine) {
    .nav-c-liens a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
    .nav-c-appel:hover { background: var(--nv-fg, var(--fg)); color: var(--nv-bg, var(--bg-2)); }
  }
  .nav-c-appel:active { background: var(--nv-fg, var(--fg)); color: var(--nv-bg, var(--bg-2)); }
</style>

<script>
  import { onPage } from '@/scripts/page';
  // La barre prend le fond et la couleur de texte de la section qui passe sous elle : chaque affiche a son
  // aplat, la nav suit. Lecture des styles calculés (donc des tokens), écriture seulement si ça change.
  onPage(() => {
    const nav = document.querySelector<HTMLElement>('[data-nav-c]');
    if (!nav) return;
    const blocs = Array.from(document.querySelectorAll<HTMLElement>('#main section, footer')).filter((el) => el !== nav);
    let courant: HTMLElement | null = null;
    let attente = false;
    const maj = () => {
      attente = false;
      const y = nav.offsetHeight / 2;
      let dessous: HTMLElement | null = null;
      for (const b of blocs) {
        const r = b.getBoundingClientRect();
        if (r.top <= y && r.bottom > y) dessous = b; // le dernier dans l'ordre du document est au-dessus
      }
      if (!dessous || dessous === courant) return;
      courant = dessous;
      const cs = getComputedStyle(dessous);
      if (cs.backgroundColor === 'rgba(0, 0, 0, 0)') return;
      nav.style.setProperty('--nv-bg', cs.backgroundColor);
      nav.style.setProperty('--nv-fg', cs.color);
    };
    const demande = () => { if (!attente) { attente = true; requestAnimationFrame(maj); } };
    maj();
    window.addEventListener('scroll', demande, { passive: true });
    window.addEventListener('resize', demande);
  });
</script>
