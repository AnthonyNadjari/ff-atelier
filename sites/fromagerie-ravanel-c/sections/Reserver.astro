---
/**
 * « À réserver » : deux bons posés sur le comptoir, le bon de plateau et le bon de prêt de l'appareil à
 * raclette, avec la seule photo du site agrafée au second (raclette, réservée à cette piste, sans légende
 * d'illustration). Faits du brief seulement : 6 à 30 personnes, dès 6 € par personne, 48 heures avant, une
 * semaine pour Noël et le Nouvel An ; appareil 4 ou 8 personnes, caution 50 €, deux jours avant le week-end,
 * fromage coupé ou râpé à la demande. Les bons arrivent en paquet (MOUVEMENT 2, script dans Barre.astro).
 */
import Img from '@/components/Img.astro';
import { site, tel } from '@/lib/site';
const raclette = site.services.find((s) => s.slug === 'raclette');
---

<section id="reserver" class="res" aria-labelledby="res-titre">
  <div class="res-tete">
    <h2 id="res-titre" class="res-titre">À réserver</h2>
    <p class="res-chapo">Deux choses se réservent, toujours au téléphone : <a href={tel()}>{site.contact.phoneDisplay}</a>. Le reste se choisit au comptoir, en goûtant.</p>
  </div>

  <div class="res-bons" data-paquet>
    <article class="bon" data-fiche>
      <p class="bon-n">Bon de commande</p>
      <h3 class="bon-titre">Plateau de fromages</h3>
      <dl class="bon-champs">
        <div><dt>Pour</dt><dd>6 à 30 personnes</dd></div>
        <div><dt>Prix</dt><dd>dès 6 € par personne</dd></div>
        <div><dt>À commander</dt><dd>48 heures avant</dd></div>
        <div class="bon-fete"><dt>Noël, Nouvel An</dt><dd>une semaine avant</dd></div>
      </dl>
      <p class="bon-mot">Dites à Claire combien vous serez et pour quel jour : le plateau se compose avec vous.</p>
    </article>

    <div class="res-col2">
    <article class="bon bon-raclette" data-fiche>
      <p class="bon-n">Bon de prêt</p>
      <h3 class="bon-titre">Appareil à raclette</h3>
      <dl class="bon-champs">
        <div><dt>Taille</dt><dd>4 ou 8 personnes</dd></div>
        <div><dt>Caution</dt><dd>50 €</dd></div>
        <div><dt>À réserver</dt><dd>deux jours avant le week-end</dd></div>
        <div><dt>Le fromage</dt><dd>coupé ou râpé à la demande, pour la fondue aussi</dd></div>
      </dl>
      <p class="bon-mot">Il en reste rarement le samedi.</p>
    </article>

    {raclette?.image && (
      <figure class="agrafe" data-fiche>
        <Img src={raclette.image.src} alt={raclette.image.alt} sizes="(min-width: 64rem) 22rem, 70vw" class="agrafe-img" />
      </figure>
    )}
    </div>
  </div>
</section>

<style>
  .res { padding: 64px 16px 72px; background: var(--bg-2); color: var(--fg); border-top: 2px solid var(--ink); }
  @media (min-width: 48rem) { .res { padding: 96px 40px 104px; } }
  .res-tete { display: grid; gap: 12px; max-width: 72rem; margin-inline: auto; }
  @media (min-width: 64rem) { .res-tete { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: end; gap: 56px; } }
  .res-titre {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .res-chapo { font-size: 1.05rem; max-width: 36rem; }
  .res-chapo a { color: var(--fg); font-family: var(--font-mono); font-weight: 700; text-decoration-color: var(--accent); text-decoration-thickness: 3px; text-underline-offset: 4px; white-space: nowrap; }

  .res-bons {
    position: relative;
    display: grid;
    gap: 22px;
    max-width: 72rem;
    margin: 40px auto 0;
  }
  @media (min-width: 64rem) {
    .res-bons { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; margin-top: 56px; align-items: start; }
    .res-col2 { margin-top: 64px; }
  }

  /* Un bon de carnet : bord haut perforé, champs en mono, valeurs en gras. */
  .bon {
    --trou: 6px;
    position: relative;
    padding: 30px 22px 24px;
    background: var(--surface);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 20%, transparent), 0 14px 22px -16px color-mix(in srgb, var(--ink) 50%, transparent);
    mask:
      radial-gradient(circle at 50% 0, #0000 calc(var(--trou) / 2), #000 calc(var(--trou) / 2 + 0.5px)) top / calc(var(--trou) * 2.4) var(--trou) repeat-x,
      linear-gradient(#000 0 0) bottom / 100% calc(100% - var(--trou)) no-repeat;
  }
  @media (min-width: 48rem) { .bon { padding: 36px 34px 30px; } }
  .bon-n { font-family: var(--font-mono); font-size: 0.82rem; color: var(--muted); border-bottom: 2px dashed var(--line); padding-bottom: 10px; }
  .bon-titre { margin-top: 14px; font-family: var(--font-mono); font-weight: 800; font-size: 1.3rem; line-height: 1.2; }
  .bon-champs { margin: 16px 0 0; display: grid; }
  .bon-champs > div { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 12px; padding-block: 9px; border-bottom: 1px solid color-mix(in srgb, var(--ink) 16%, transparent); align-items: baseline; }
  .bon-champs dt { font-family: var(--font-mono); font-size: 0.85rem; color: var(--muted); }
  .bon-champs dd { margin: 0; font-weight: 800; font-size: 1.15rem; line-height: 1.25; }
  @media (min-width: 48rem) { .bon-champs dd { font-size: 1.35rem; } }
  .bon-fete dd { color: var(--accent); }
  .bon-mot { margin-top: 16px; font-size: 1rem; }

  .agrafe {
    position: relative;
    margin: -10px 14px 0 auto;
    width: min(78%, 22rem);
    padding: 10px 10px 12px;
    background: var(--surface);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 20%, transparent), 0 14px 22px -16px color-mix(in srgb, var(--ink) 50%, transparent);
  }
  .agrafe::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 50%;
    width: 46px;
    height: 7px;
    margin-left: -23px;
    background: var(--muted);
    border: 2px solid var(--ink);
  }
  .agrafe :global(.agrafe-img) { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
</style>
