---
/**
 * « Les questions du comptoir » : les trois questions du brief (site.faq), chacune sur sa fiche, posées en
 * paquet. Pas d'accordéon : les réponses tiennent en deux lignes, on les lit sans toucher.
 */
import { site } from '@/lib/site';
---

{site.faq.length > 0 && (
  <section id="questions" class="qst" aria-labelledby="qst-titre">
    <h2 id="qst-titre" class="qst-titre">{site.wording.faqTitle ?? 'Questions'}</h2>
    <div class="qst-fiches" data-paquet>
      {site.faq.map((f) => (
        <div class="qst-fiche" data-fiche>
          <h3 class="qst-q">{f.q}</h3>
          <p class="qst-r">{f.a}</p>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .qst { padding: 72px 16px 80px; background: var(--bg-2); color: var(--fg); border-top: 2px solid var(--ink); }
  @media (min-width: 48rem) { .qst { padding: 96px 40px 104px; } }
  .qst-titre {
    max-width: 80rem;
    margin-inline: auto;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .qst-fiches { max-width: 80rem; margin: 36px auto 0; display: grid; gap: 18px; }
  @media (min-width: 64rem) {
    .qst-fiches { grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 6fr); gap: 24px; align-items: start; }
    .qst-fiche:nth-child(2) { margin-top: 48px; }
    .qst-fiche:nth-child(3) { margin-top: 16px; }
  }
  .qst-fiche {
    padding: 22px 22px 24px;
    background: var(--surface);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 20%, transparent), 0 14px 22px -16px color-mix(in srgb, var(--ink) 50%, transparent);
  }
  .qst-q { font-family: var(--font-mono); font-weight: 800; font-size: 1.05rem; line-height: 1.3; padding-bottom: 12px; border-bottom: 2px dashed var(--line); }
  .qst-r { margin-top: 12px; font-size: 1.05rem; line-height: 1.5; }
</style>
