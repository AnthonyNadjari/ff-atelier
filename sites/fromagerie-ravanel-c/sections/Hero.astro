---
/**
 * Premier écran de la piste C « Le comptoir » : une affiche de marché. Le nom sur toute la largeur en
 * Alfa Slab One outremer sur fond beurre, le métier et la rue au-dessus, une phrase, les horaires (le jour
 * courant en gras), le bouton d'appel, et en pied d'écran la bande noire de ce qui se réserve (faits du
 * brief : raclette deux jours avant le week-end, plateaux 48 h avant, une semaine pour les fêtes, marché
 * mardi et vendredi). Séparateur de la bande : un petit sommet, jamais un point médian.
 * La coquille sticky-hero garde cet écran collé : chaque section arrive par-dessus comme une affiche.
 * Tout doit tenir dans un écran de téléphone (une partie cachée sous la feuille ne serait jamais vue).
 */
import { site, tel } from '@/lib/site';

const JOURS = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
const joursDe = (txt: string) => {
  const noms = txt.toLowerCase().split(/\s+à\s+|\s*[–-]\s*/).map((s) => JOURS.indexOf(s.trim()));
  if (noms.some((n) => n < 0)) return [];
  if (noms.length === 2) {
    const out: number[] = [];
    for (let d = noms[0]; ; d = (d + 1) % 7) { out.push(d); if (d === noms[1] || out.length > 7) break; }
    return out;
  }
  return noms;
};
const horaires = site.contact.hours.map((h) => ({ ...h, jours: joursDe(h.days).join(',') }));

const bande = [
  'Appareil à raclette : réservez deux jours avant le week-end',
  'Plateaux de 6 à 30 personnes : 48 heures avant',
  'Noël et Nouvel An : une semaine avant',
  'Marché de la vieille ville : mardi et vendredi matin',
  'On goûte avant d’acheter',
  'Beaufort d’alpage : 12, 18 ou 24 mois',
];
const [mot1, ...reste] = site.business.name.split(' ');
---

<section id="hero" class="affiche bg-bg-2 text-fg">
  <div class="container-ff affiche-corps">
    <p class="affiche-adresse">{site.business.trade}, {site.contact.address.street}, {site.contact.address.city}</p>
    <h1 class="affiche-nom font-display text-accent" data-split="lines"><span class="nom-1">{mot1}</span> <br /><span class="nom-2">{reste.join(' ')}</span></h1>

    <div class="affiche-bas">
      <p class="affiche-phrase">{site.business.tagline} On goûte avant d’acheter, toujours.</p>
      <div class="affiche-infos">
        <dl class="affiche-horaires" data-horaires-c>
          {horaires.map((h) => (
            <div data-jours={h.jours}>
              <dt>{h.days}</dt>
              <dd>{h.hours}</dd>
            </div>
          ))}
        </dl>
        <a href={tel()} class="affiche-appel">Appeler le {site.contact.phoneDisplay}</a>
      </div>
    </div>
  </div>

  <div class="affiche-bande bg-ink text-on-ink" data-marquee="48s" data-marquee-velocity="48" aria-label="À réserver">
    <ul class="marquee-track">
      {bande.map((t) => (
        <li>
          <span>{t}</span>
          <svg class="sommet" viewBox="0 0 20 14" aria-hidden="true"><path d="M0 14 L10 0 L20 14 Z" /></svg>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .affiche { min-height: 100svh; display: flex; flex-direction: column; }
  .affiche-corps { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-top: 76px; padding-bottom: 28px; --container: 96rem; }
  .affiche-adresse { font-weight: 600; font-size: 1rem; }
  /* Le nom remplit la largeur : « Fromagerie » en Alfa Slab mesure 6,07 em (mesuré), « Ravanel » 4,22 em.
     Taille = largeur utile / 6,15 (gouttières de 20 px, 40 px dès 48rem), plafonnée par la hauteur d'écran
     pour que tout l'écran collé reste visible sur un portable de 768 px de haut (titre ~ 2,24 em de haut). */
  .affiche .affiche-nom {
    margin-top: 8px;
    font-size: min(calc((100vw - 40px) / 6.15), calc((100svh - 480px) / 2.24));
    line-height: 0.92;
    letter-spacing: -0.01em;
    text-wrap: nowrap;
  }
  /* Chaque ligne calée sur la largeur, comme une affiche composée à la main : « Ravanel », plus court,
     monte plus gros (rapport des largeurs mesuré). */
  .affiche .affiche-nom .nom-2 { font-size: 1.43em; }
  @media (min-width: 48rem) { .affiche .affiche-nom { font-size: min(calc((100vw - 100px) / 6.15), calc((100svh - 480px) / 2.24), 15rem); } }
  .affiche-bas { margin-top: 24px; display: grid; gap: 20px; }
  .affiche-phrase { font-size: 1.05rem; max-width: 34rem; }
  .affiche-infos { display: grid; gap: 16px; }
  .affiche-horaires { margin: 0; display: grid; gap: 2px; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
  .affiche-horaires > div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 12px; }
  .affiche-horaires dt, .affiche-horaires dd { margin: 0; }
  .affiche-horaires > div.aujourdhui { font-weight: 700; }
  .affiche-horaires > div.aujourdhui dt::after { content: ' (aujourd’hui)'; font-weight: 400; }
  .affiche-appel {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 24px;
    background: var(--accent);
    color: var(--on-accent);
    border: 2px solid var(--fg);
    border-radius: 4px;
    box-shadow: 4px 4px 0 var(--fg);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    transition: transform var(--motion-ui) var(--ease-out), box-shadow var(--motion-ui) var(--ease-out);
  }
  .affiche-appel:active { transform: translate(3px, 3px); box-shadow: 1px 1px 0 var(--fg); }
  @media (hover: hover) and (pointer: fine) {
    .affiche-appel:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--fg); }
  }
  /* Téléphone : seul le jour courant est montré (script) ; sans script, les quatre lignes restent. */
  @media (max-width: 47.99rem) {
    .affiche-horaires.js-jour > div:not(.aujourdhui) { display: none; }
  }
  @media (min-width: 48rem) {
    .affiche-bas { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; gap: 48px; margin-top: 36px; }
    .affiche-phrase { font-size: 1.4rem; }
    .affiche-horaires { font-size: 1.05rem; }
  }

  .affiche-bande { padding-block: 14px; --marquee-gap: 0px; }
  .affiche-bande ul { list-style: none; margin: 0; padding: 0; }
  .affiche-bande li { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-family: var(--font-display); font-size: clamp(1.15rem, 2.4vw, 1.9rem); line-height: 1.2; }
  .sommet { width: 0.8em; height: 0.56em; fill: var(--bg-2); flex: none; }
</style>

<script>
  import { onPage } from '@/scripts/page';
  // Jour courant en gras (heure locale du visiteur, boutique en France). Sans script : les quatre lignes.
  onPage(() => {
    const dl = document.querySelector<HTMLElement>('[data-horaires-c]');
    if (!dl) return;
    const j = new Date().getDay();
    let trouve = false;
    dl.querySelectorAll<HTMLElement>('[data-jours]').forEach((l) => {
      const oui = (l.dataset.jours || '').split(',').filter(Boolean).map(Number).includes(j);
      l.classList.toggle('aujourdhui', oui);
      if (oui) trouve = true;
    });
    if (trouve) dl.classList.add('js-jour');
  });
</script>
