---
/**
 * L'appareil à raclette en étiquette géante (piste C). Faits du brief : prêt d'un appareil pour 4 ou
 * 8 personnes, caution de 50 €, à réserver deux jours avant le week-end (il en reste rarement le samedi),
 * fromage coupé ou râpé à la demande. L'étiquette se redresse au défilement (data-scrub), la photo
 * d'illustration glisse en parallaxe. Fond vert sapin (--accent-2), étiquette beurre.
 */
import { tel } from '@/lib/site';
import Img from '@/components/Img.astro';
const nbsp = ' ';
---

<section id="raclette" class="raclette bg-accent-2 text-on-accent">
  <div class="container-ff section-y">
    <h2 class="raclette-titre font-display" data-split="lines">L’appareil à raclette se prête. Réservez-le deux jours avant le week-end.</h2>

    <div class="raclette-grille">
      <div class="etiquette" data-scrub="rotate=-7,y=50">
        <span class="etiquette-trou" aria-hidden="true"></span>
        <p class="etiquette-quoi">Appareil à raclette</p>
        <p class="etiquette-pour font-display"><span>4 ou 8</span> personnes</p>
        <p class="etiquette-caution font-display">Caution 50{nbsp}€</p>
        <p class="etiquette-detail">Il en reste rarement le samedi. Le fromage, on vous le coupe ou on vous le râpe à la demande.</p>
        <a href={tel()} class="etiquette-appel">Réserver au téléphone</a>
      </div>

      <figure class="raclette-photo">
        <div class="overflow-hidden">
          <Img src="/images/raclette.webp" alt="Tranches de fromage à raclette sur une assiette" class="aspect-[4/3] w-full object-cover" sizes="(min-width: 64rem) 40vw, 100vw" data-parallax="0.15" />
        </div>
        <figcaption>Photo d’illustration (Martin Steiger, domaine public).</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .raclette-titre { font-size: clamp(2rem, 4.6vw, 4rem); line-height: 1.02; max-width: 20ch; }
  .raclette-grille { margin-top: 48px; display: grid; gap: 40px; align-items: center; }
  @media (min-width: 64rem) { .raclette-grille { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 72px; margin-top: 64px; } }

  /* L'étiquette : une encoche à gauche, un trou rond, aplat beurre bordé d'encre. */
  .etiquette {
    position: relative;
    background: var(--bg-2);
    color: var(--fg);
    padding: 36px 28px 32px 64px;
    clip-path: polygon(40px 0, 100% 0, 100% 100%, 40px 100%, 0 50%);
    transform-origin: 30% 50%;
  }
  .etiquette-trou {
    position: absolute; left: 22px; top: 50%;
    width: 22px; height: 22px; margin-top: -11px;
    border-radius: 50%;
    background: var(--accent-2);
    box-shadow: inset 0 0 0 3px var(--ink);
  }
  .etiquette-quoi { font-weight: 700; font-size: 1.1rem; }
  .etiquette-pour { margin-top: 8px; font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1; }
  .etiquette-pour span { display: block; font-size: clamp(4.5rem, 12vw, 9rem); line-height: 0.95; color: var(--accent); }
  .etiquette-caution { margin-top: 20px; padding-top: 16px; border-top: 3px solid var(--ink); font-size: clamp(2.2rem, 5vw, 3.75rem); line-height: 1; }
  .etiquette-detail { margin-top: 16px; max-width: 30rem; font-size: 1.05rem; }
  .etiquette-appel {
    margin-top: 24px;
    display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px;
    background: var(--ink); color: var(--on-ink);
    border-radius: 4px; font-weight: 700; text-decoration: none;
    transition: background-color var(--motion-ui) var(--ease-out), color var(--motion-ui) var(--ease-out);
  }
  .etiquette-appel:active { background: var(--accent); color: var(--on-accent); }
  @media (hover: hover) and (pointer: fine) { .etiquette-appel:hover { background: var(--accent); color: var(--on-accent); } }

  .raclette-photo { margin: 0; }
  .raclette-photo figcaption { margin-top: 8px; font-size: 0.85rem; opacity: 0.9; }
</style>
