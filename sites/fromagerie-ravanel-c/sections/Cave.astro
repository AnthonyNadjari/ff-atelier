---
/**
 * « La cave, 11 °C » : ce qu'on achète. Texte à gauche (la cave creusée en 2014, les six fermes, la question
 * « plus jeune ou plus fait ? »), à droite les étiquettes à piquer du beaufort d'alpage (12, 18, 24 mois, en
 * taille normale : pas de chiffre géant) et le ticket du comptoir. Étiquettes et ticket arrivent en paquet.
 * Aucune ferme nommée : le brief dit que Claire les nomme sur l'ardoise, sans donner les noms.
 */
---

<section id="cave" class="cave" aria-labelledby="cave-titre">
  <div class="cave-texte">
    <h2 id="cave-titre" class="cave-titre">La cave, 11 °C</h2>
    <p class="cave-chapo">
      Claire l’a creusée en 2014, sous la boutique. Les tommes et les reblochons fermiers de six fermes des Aravis
      et des Bauges y finissent de s’affiner, et chaque meule porte sa date d’entrée à la craie.
    </p>
    <h3 class="cave-q">Plus jeune ou plus fait ?</h3>
    <p class="cave-r">
      Dites-le au comptoir, on coupe dans la meule qui va avec. Et avant d’acheter, on goûte, toujours.
    </p>
  </div>

  <div class="cave-objets" data-paquet>
    <div class="cave-beaufort">
      <h3 class="cave-b-titre">Beaufort d’alpage</h3>
      <p class="cave-b-sous">Vendu à l’âge que vous voulez.</p>
      <ul class="etiquettes">
        <li class="etiquette" data-fiche><span class="et-age">12</span><span class="et-mois">mois</span></li>
        <li class="etiquette" data-fiche><span class="et-age">18</span><span class="et-mois">mois</span></li>
        <li class="etiquette etiquette-vieux" data-fiche><span class="et-age">24</span><span class="et-mois">mois</span><span class="et-note">très peu de lactose, demandez à Claire</span></li>
      </ul>
    </div>

    <div class="comptoir" data-fiche>
      <h3 class="comptoir-titre">Au comptoir</h3>
      <ul>
        <li>Beurre de baratte</li>
        <li>Crème crue</li>
        <li>Yaourts de la ferme</li>
        <li>Quelques vins de Savoie, pour aller avec</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .cave {
    display: grid;
    gap: 40px;
    padding: 72px 16px 80px;
    background: var(--bg);
    color: var(--fg);
    border-top: 2px solid var(--ink);
  }
  @media (min-width: 48rem) { .cave { padding: 104px 40px 112px; } }
  @media (min-width: 64rem) {
    .cave { grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: 64px; padding-inline: max(40px, calc((100% - 80rem) / 2)); align-items: start; }
  }
  .cave-titre {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: clamp(2.1rem, 5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .cave-chapo { margin-top: 18px; font-size: 1.1rem; line-height: 1.5; max-width: 34rem; }
  .cave-q {
    margin-top: 40px;
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: clamp(1.3rem, 2.4vw, 1.75rem);
    line-height: 1.2;
    padding-left: 14px;
    border-left: 6px solid var(--accent);
  }
  .cave-r { margin-top: 12px; font-size: 1.05rem; max-width: 32rem; }

  .cave-objets { display: grid; gap: 34px; }
  .cave-b-titre { font-family: var(--font-mono); font-weight: 800; font-size: 1.15rem; }
  .cave-b-sous { margin-top: 2px; color: var(--muted); }
  .etiquettes { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px; align-items: flex-start; }

  /* Étiquette à piquer : coin haut coupé, trou de la pique, chiffre en mono. */
  .etiquette {
    position: relative;
    display: grid;
    justify-items: start;
    min-width: 6.5rem;
    padding: 26px 16px 14px;
    background: var(--surface);
    border: 2px solid var(--ink);
    clip-path: polygon(14px 0, 100% 0, 100% 100%, 0 100%, 0 14px);
  }
  .etiquette::before {
    content: '';
    position: absolute;
    top: 9px;
    right: 12px;
    width: 9px;
    height: 9px;
    border: 2px solid var(--ink);
    border-radius: 50%;
  }
  .et-age { font-family: var(--font-mono); font-weight: 800; font-size: 2.4rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .et-mois { font-weight: 700; }
  .etiquette-vieux { background: var(--accent); color: var(--on-accent); border-color: var(--accent); max-width: 13rem; }
  .etiquette-vieux::before { border-color: var(--on-accent); }
  .et-note { margin-top: 8px; font-size: 0.85rem; line-height: 1.3; }

  .comptoir {
    padding: 22px 22px 24px;
    background: var(--surface);
    font-family: var(--font-mono);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--ink) 20%, transparent), 0 14px 22px -16px color-mix(in srgb, var(--ink) 50%, transparent);
    max-width: 30rem;
  }
  .comptoir-titre { font-weight: 800; font-size: 1.15rem; padding-bottom: 10px; border-bottom: 2px dashed var(--line); }
  .comptoir ul { list-style: none; margin: 10px 0 0; padding: 0; }
  .comptoir li { padding-block: 7px; border-bottom: 1px dotted color-mix(in srgb, var(--ink) 35%, transparent); }
  .comptoir li:last-child { border-bottom: 0; }
</style>
