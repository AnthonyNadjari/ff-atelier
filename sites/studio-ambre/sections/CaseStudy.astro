---
/**
 * "Projets" (custom/casestudy) : trois typologies de projet en pile (data-stack, chaque panneau
 * s'épingle puis se tasse sous le suivant), un plan au trait dessiné pour chacune (SVG inline,
 * data-draw-svg — tracés dessinés pour ce site, aucune bibliothèque d'icônes), qui se défloute
 * légèrement au scroll (data-blur-scrub="5", cumulable avec data-draw-svg sur le même élément —
 * flou volontairement faible : à 14 les plans restaient illisibles dans leur état "avant scroll",
 * y compris sur une capture qui a activé Lenis entre-temps, `smoothScroll` a donc été laissé à sa
 * valeur par défaut `false` pour ce site — voir en-tête de `site.config.ts`). Au survol (pointer
 * fin) du texte, une image flotte près du curseur avec une légère distorsion WebGL
 * (data-hover-distort, repli data-hover-img automatique si WebGL indisponible). Pas de photos de
 * projet ni de nom de client dans le contenu : ce sont trois types de lieux représentatifs des
 * missions du studio (le brief ne fournit pas de portfolio réel), présentés comme tels dans le
 * texte, jamais comme des réalisations chiffrées ou des avis. Composition propre à ce site.
 */
import { site } from '@/lib/site';
import SectionHeading from '@/components/SectionHeading.astro';

const hoverImage = site.images.hero?.src;

const projets = [
  {
    n: '01',
    type: 'Appartement haussmannien',
    zone: 'Paris',
    texte: 'Reprise des circulations et des moulures d’un trois-pièces : une cloison déplacée pour rendre la lumière du séjour à l’entrée.',
    tone: 'bg-surface text-fg',
    plan: `
      <rect x="14" y="14" width="192" height="132" />
      <line x1="90" y1="14" x2="90" y2="92" />
      <line x1="90" y1="92" x2="206" y2="92" />
      <path d="M90 92 A28 28 0 0 1 118 120" />
    `,
  },
  {
    n: '02',
    type: 'Boutique',
    zone: 'Montreuil',
    texte: 'Vitrine dégagée, comptoir redessiné en angle pour libérer le passage, réserve compacte à l’arrière.',
    tone: 'bg-bg-2 text-fg',
    plan: `
      <rect x="14" y="14" width="192" height="132" />
      <rect x="146" y="34" width="48" height="18" />
      <line x1="14" y1="78" x2="86" y2="78" />
      <rect x="24" y="98" width="40" height="38" />
    `,
  },
  {
    n: '03',
    type: 'Cabinet',
    zone: 'Vincennes',
    texte: 'Salle d’attente et bureau séparés par une cloison vitrée, pour garder la lumière sans perdre la discrétion.',
    tone: 'bg-ink text-on-ink',
    plan: `
      <line x1="104" y1="14" x2="104" y2="146" />
      <rect x="14" y="14" width="192" height="132" />
      <rect x="134" y="40" width="58" height="30" />
      <circle cx="152" cy="92" r="7" />
      <circle cx="176" cy="92" r="7" />
    `,
  },
];
---

<section id="casestudy" class="section-y">
  <div class="container-ff">
    <SectionHeading eyebrow="Trois types de lieux" title="Ce que le studio dessine" text="Pas de style imposé d’un projet à l’autre. Trois typologies représentatives du travail du studio, chacune avec sa propre logique de plan." />
  </div>

  <div class="mt-14" data-stack>
    {projets.map((p) => (
      <div class:list={['flex min-h-[70vh] flex-col justify-center py-16', p.tone]}>
        <div class="container-ff flex flex-col gap-10 lg:flex-row lg:items-center lg:gap-16">
          <div class="max-w-md" data-hover-distort={hoverImage}>
            {/* text-accent -> text-on-ink/70 sur le panneau "Cabinet" (tone bg-ink) : --accent n'est
                pas garanti contraste sur --ink (rapport impeccable, 2.9:1) ; meme convention que
                .eyebrow sur bg-ink (src/styles/global.css). */}
            <p class:list={['font-mono text-sm', p.tone.includes('bg-ink') ? 'text-on-ink/70' : 'text-accent']}>{p.n}</p>
            <h3 class="mt-3 font-display text-display-md">{p.type}</h3>
            <p class="mt-2 text-sm opacity-70">{p.zone}</p>
            <p class="mt-5 max-w-prose text-lg opacity-85">{p.texte}</p>
          </div>
          <svg data-draw-svg data-blur-scrub="5" viewBox="0 0 220 160" class="h-56 w-full max-w-sm shrink-0 stroke-current sm:h-64" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-label={`Plan schématique, ${p.type}`} set:html={p.plan} />
        </div>
      </div>
    ))}
  </div>
</section>
