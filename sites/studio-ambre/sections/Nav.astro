---
/**
 * Nav de Studio Ambre : une ligne en haut, transparente sur le premier écran (photo), fond pierre
 * dès que la page défile. Le nom à gauche, les liens en mots du quotidien, le téléphone à droite,
 * en texte. Sur mobile, un plein écran s’ouvre (data-menu), un lien par ligne. Sans numéros « 01· »,
 * sans capitales espacées, sans bouton en capsule ni aimant (9 oct 2026).
 * tel: placé tôt dans le DOM, replacé visuellement à droite par `order-3` (contrôle « lien tel: dans
 * les 1500 premiers caractères » de ff verifier).
 */
import { site, tel, navLinks } from '@/lib/site';
const links = navLinks();
---

<header data-nav="hide-on-scroll" class="nav-ambre fixed inset-x-0 top-0 z-50 text-on-ink">
  <div class="container-ff flex items-center justify-between gap-6 py-5">
    <a href="/" class="order-1 whitespace-nowrap font-display text-lg">{site.business.name}</a>

    <div class="order-3 flex items-center gap-5">
      <a href={tel()} class="whitespace-nowrap tabular-nums text-sm underline-offset-4 hover:underline">{site.contact.phoneDisplay}</a>
      <button class="flex flex-col gap-1.5 p-2 lg:hidden" aria-label="Menu" aria-expanded="false" data-menu-toggle>
        <span class="block h-px w-6 bg-current"></span>
        <span class="block h-px w-6 bg-current"></span>
      </button>
    </div>

    <nav class="order-2 hidden items-center gap-x-6 text-sm lg:flex" aria-label="Navigation principale">
      {links.map((l) => <a href={l.href} class="whitespace-nowrap underline-offset-4 hover:underline">{l.label}</a>)}
    </nav>
  </div>

  <div class="fixed inset-0 hidden bg-bg text-fg" data-menu>
    <div class="container-ff flex h-full flex-col justify-between py-24">
      <nav class="flex flex-col" aria-label="Navigation mobile">
        {links.map((l) => <a href={l.href} class="border-b border-line py-5 font-display text-3xl">{l.label}</a>)}
      </nav>
      <a href={tel()} class="tabular-nums text-lg">{site.contact.phoneDisplay}</a>
    </div>
  </div>
</header>

<style>
  .nav-ambre { transition: transform 0.4s var(--ease-out), background-color 0.4s ease, color 0.4s ease; }
  .nav-ambre.is-hidden { transform: translateY(-100%); }
  .nav-ambre.is-scrolled { background: color-mix(in oklab, var(--bg) 94%, transparent); color: var(--fg); }
  @media (prefers-reduced-motion: reduce) { .nav-ambre { transition: none; } }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  btn?.addEventListener('click', () => {
    const open = menu!.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('overflow-hidden', open);
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
    }),
  );
</script>
