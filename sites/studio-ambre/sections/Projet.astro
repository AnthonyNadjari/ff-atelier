---
/**
 * « Un projet » : le bloc signature du studio (9 oct 2026). Un seul projet, raconté : ce qu’il y
 * avait, ce qu’on a fait, en trois photos (trois cadrages de la photo du dossier, légendés pour ce
 * qu’ils montrent) et, sur des filets, les faits qu’un client veut lire avant d’appeler : surface,
 * programme, budget des travaux, honoraires, durée de la conception et du chantier, livraison.
 * Remplace « Projets » (trois panneaux épinglés avec plan au trait qui se dessine, image déformée
 * au survol, sans aucun fait). Démo : projet fictif, plausible, daté ; aucun avis.
 */
const projet = {
  titre: 'Pavillon de verre, Vincennes',
  sousTitre: 'Une maison des années 1960, un séjour à rouvrir sur le jardin.',
  recit: [
    'Les propriétaires vivaient dans une maison vitrée des années 1960 dont le séjour avait été cloisonné au fil du temps : une cuisine fermée, un couloir, des rangements posés devant les baies.',
    'Le projet a consisté à retirer, pas à ajouter. Les cloisons sont tombées, la cuisine s’est rangée dans un mur de placards en chêne clair toute hauteur, et les baies ont retrouvé le jardin sur toute la longueur. Un seul sol, un seul bois, du cuir et de l’acier pour s’asseoir.',
    'Le chantier a duré quatorze semaines, quatre corps de métier coordonnés par le studio, sans que les propriétaires n’aient à déménager.',
  ],
  faits: [
    { k: 'Surface', v: '95 m²' },
    { k: 'Programme', v: 'Séjour, cuisine, rangements' },
    { k: 'Travaux', v: '118 000 € HT' },
    { k: 'Honoraires', v: '12 % du montant des travaux' },
    { k: 'Conception', v: '10 semaines, janvier à mars 2025' },
    { k: 'Chantier', v: '14 semaines, 4 corps de métier' },
    { k: 'Livraison', v: 'Juin 2025' },
  ],
  photos: [
    { src: '/images/projet-1.webp', w: 1600, h: 1000, alt: 'Le séjour rouvert sur le jardin, vitrage toute hauteur et mur de placards en bois clair', legende: 'Le séjour, rouvert sur toute la longueur des baies.' },
    { src: '/images/projet-2.webp', w: 800, h: 1000, alt: 'Mur de placards en chêne clair toute hauteur, poignées affleurantes', legende: 'La cuisine rangée dans un mur de chêne clair.' },
    { src: '/images/projet-3.webp', w: 1200, h: 814, alt: 'Banquette de cuir et d’acier sur un sol clair, face au jardin', legende: 'Cuir, acier, un seul sol.' },
  ],
};
---

<section id="projet" class="section-y bg-bg">
  <div class="container-ff">
    <div class="md:flex md:items-baseline md:gap-10">
      <h2 class="font-display text-display-lg leading-none">Un projet, pour comprendre</h2>
      <p class="mt-4 max-w-md text-muted md:mt-0">Plutôt qu’un portfolio, un chantier raconté de bout en bout, avec ses chiffres.</p>
    </div>

    <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h3 class="font-display text-display-md leading-tight">{projet.titre}</h3>
        <p class="mt-2 text-lg text-muted">{projet.sousTitre}</p>
        <div class="mt-6 max-w-[34rem] space-y-4 leading-relaxed" data-reveal>
          {projet.recit.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="lg:col-span-5 lg:pt-3">
        <dl class="border-t border-line">
          {projet.faits.map((f) => (
            <div class="flex justify-between gap-6 border-b border-line py-3 text-sm">
              <dt class="shrink-0 text-muted">{f.k}</dt>
              <dd class="text-right text-fg">{f.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <ul class="mt-14 grid grid-cols-12 gap-4 sm:gap-6" data-stagger="120">
      <li class="col-span-12 md:col-span-8">
        <figure>
          <img src={projet.photos[0].src} width={projet.photos[0].w} height={projet.photos[0].h} alt={projet.photos[0].alt} class="aspect-[16/10] w-full object-cover" loading="lazy" decoding="async" />
          <figcaption class="mt-3 text-sm text-muted">{projet.photos[0].legende}</figcaption>
        </figure>
      </li>
      <li class="col-span-5 md:col-span-4">
        <figure>
          <img src={projet.photos[1].src} width={projet.photos[1].w} height={projet.photos[1].h} alt={projet.photos[1].alt} class="aspect-[4/5] w-full object-cover" loading="lazy" decoding="async" />
          <figcaption class="mt-3 text-sm text-muted">{projet.photos[1].legende}</figcaption>
        </figure>
      </li>
      <li class="col-span-7 md:col-span-6 md:col-start-4">
        <figure>
          <img src={projet.photos[2].src} width={projet.photos[2].w} height={projet.photos[2].h} alt={projet.photos[2].alt} class="aspect-[3/2] w-full object-cover" loading="lazy" decoding="async" />
          <figcaption class="mt-3 text-sm text-muted">{projet.photos[2].legende}</figcaption>
        </figure>
      </li>
    </ul>
  </div>
</section>
