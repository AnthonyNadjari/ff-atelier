---
/**
 * Premier écran de Studio Ambre : un intérieur, en plein cadre (9 oct 2026). La photo du dossier
 * couvre l’écran ; l’accroche est posée en bas à gauche, en romain (le <em> de la config est retiré
 * ici : pas d’italique d’emphase sur un titre), suivie d’une phrase qui dit qui, quoi, où, depuis
 * quand, puis l’adresse et le téléphone. Avant : le nom en capitales espacées qui se décodait au
 * chargement, l’accroche en italique, une ligne d’identité sous la photo coupée par le premier écran.
 */
import { site, tel } from '@/lib/site';
import Img from '@/components/Img.astro';

const hero = site.images.hero;
---

<section id="hero" class="relative flex min-h-svh flex-col justify-end overflow-hidden bg-ink text-on-ink">
  {hero && (
    <Img src={hero.src} alt={hero.alt} class="absolute inset-0 h-full w-full object-cover object-[35%_50%]" sizes="100vw" loading="eager" fetchpriority="high" />
  )}
  <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/30 to-transparent" aria-hidden="true"></div>

  <div class="container-ff relative flex flex-col gap-8 pb-12 pt-40 md:gap-10 md:pb-16">
    <h1
      class="max-w-[14ch] font-display leading-[0.98]"
      style="font-size: clamp(2.75rem, 7.5vw, 6.5rem);"
      data-split
      set:html={site.business.tagline.replace(/<\/?em>/g, '')}
    />

    <p class="max-w-[36rem] text-lg leading-snug text-on-ink/85 sm:text-xl">
      {site.legal?.owner}, architecte d’intérieur. Appartements, boutiques et cabinets, à Paris et dans les communes voisines, depuis {site.business.since}.
    </p>

    <p class="flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm text-on-ink/65">
      <span>{site.contact.address.street}, {site.contact.address.postalCode} {site.contact.address.city}</span>
      <a href={tel()} class="text-on-ink underline-offset-4 hover:underline">{site.contact.phoneDisplay}</a>
      <span>Sur rendez-vous</span>
    </p>
  </div>
</section>
