---
/**
 * « Méthode » : les quatre prestations du studio (site.services) lues comme les quatre temps d’une
 * mission, en lignes sur filets : le titre (lien vers la page de la prestation), ce qu’on y fait,
 * et la durée écrite en toutes lettres. Sans accordéon, sans barre de progression ni numéro en
 * mono (9 oct 2026). Durées indicatives, données comme telles.
 */
import { site } from '@/lib/site';

const durees: Record<string, string> = {
  conseil: 'Deux heures, chez vous',
  conception: 'Huit à douze semaines',
  'suivi-chantier': 'Le temps du chantier, trois à cinq mois',
  'amenagement-boutique': 'Même déroulé, souvent plus court',
};
const phases = site.services.map((s) => ({ ...s, duree: durees[s.slug] }));
---

<section id="methode" class="section-y bg-bg-2">
  <div class="container-ff">
    <div class="md:flex md:items-baseline md:gap-10">
      <h2 class="font-display text-display-lg leading-none">Une mission, quatre temps</h2>
      <p class="mt-4 max-w-md text-muted md:mt-0">Les mêmes, que le lieu soit un appartement ou une boutique. Plus ou moins longs selon le projet.</p>
    </div>

    <ol class="mt-12 border-t border-line">
      {phases.map((p, i) => (
        <li class="grid gap-x-10 gap-y-2 border-b border-line py-7 md:grid-cols-[3rem_minmax(0,1fr)_minmax(0,14rem)] md:items-baseline">
          <span class="tabular-nums text-muted">{i + 1}.</span>
          <div>
            <h3 class="font-display text-display-sm leading-tight"><a href={`/services/${p.slug}`} class="hover:text-accent">{p.title}</a></h3>
            <p class="mt-2 max-w-[36rem] text-muted">{p.short}</p>
          </div>
          {p.duree && <p class="text-sm text-fg md:text-right">{p.duree}</p>}
        </li>
      ))}
    </ol>

    <p class="mt-6 max-w-prose text-sm text-muted">Durées indicatives. Les honoraires sont un pourcentage du montant des travaux, écrit dans le contrat avant de commencer.</p>
  </div>
</section>
