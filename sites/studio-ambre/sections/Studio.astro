---
/**
 * « Le studio » : le temps fort de la page, un bloc encre avec grain. L’histoire (about.story) et,
 * sur des filets, les faits : fondation, adresse, équipe, projets par an, zone, rendez-vous.
 * Remplace les trois cartes de valeurs et la liste de zones en pastilles (9 oct 2026).
 */
import { site, paragraphs } from '@/lib/site';

const faits = [
  site.business.since ? { k: 'Fondé en', v: String(site.business.since) } : null,
  { k: 'Adresse', v: `${site.contact.address.street}, ${site.contact.address.postalCode} ${site.contact.address.city}` },
  { k: 'Équipe', v: 'Léa Bonnet, conception ; Karim Haddad, chantier' },
  { k: 'Projets', v: 'Cinq à six par an' },
  site.zones.cities.length ? { k: site.zones.label ?? 'Zone', v: site.zones.cities.join(', ') } : null,
  ...site.contact.hours.map((h) => ({ k: h.days, v: h.hours })),
].filter((f): f is { k: string; v: string } => Boolean(f));
---

<section id="studio" class="section-y bg-ink text-on-ink" data-grain>
  <div class="container-ff relative z-[1] grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <h2 class="font-display text-display-lg leading-none">{site.about.title}</h2>
      <div class="mt-8 max-w-[34rem] space-y-5 text-lg leading-relaxed text-on-ink/85" data-reveal>
        {paragraphs(site.about.story).map((p) => <p>{p}</p>)}
      </div>
    </div>

    <div class="lg:col-span-5 lg:pt-4">
      <dl class="border-t border-on-ink/25">
        {faits.map((f) => (
          <div class="flex justify-between gap-6 border-b border-on-ink/25 py-3 text-sm">
            <dt class="shrink-0 text-on-ink/65">{f.k}</dt>
            <dd class="text-right">{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
