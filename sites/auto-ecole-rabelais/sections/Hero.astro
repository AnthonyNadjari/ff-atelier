---
/**
 * Premier écran « le panneau » — propre à l'Auto-école Rabelais.
 * Idée : le premier signe qu'un élève apprend à lire, c'est un panneau. L'écran n'en montre qu'un :
 * un disque bordé, et le titre enfermé dedans ; sous le disque, l'adresse et le numéro, rien d'autre.
 * Ni eyebrow, ni sous-titre, ni second bouton, ni route dessinée, ni bande de mots.
 */
import { site, tel } from '@/lib/site';
---

<section id="hero" class="bg-bg">
  <div class="container-ff flex min-h-[86svh] flex-col items-center justify-center gap-10 pb-16 pt-32 md:pt-40">
    <div
      class="flex w-full max-w-[34rem] items-center justify-center rounded-card border-[6px] border-accent px-8 py-14 text-center sm:aspect-square sm:rounded-pill sm:px-14 sm:py-0"
      data-reveal
    >
      <h1 class="text-display-sm leading-snug" set:html={site.business.tagline} />
    </div>

    <p class="flex flex-wrap items-baseline justify-center gap-x-6 gap-y-1 text-center text-sm text-muted">
      <span>{site.contact.address.street}, {site.contact.address.city}</span>
      <a href={tel()} class="font-display text-base text-fg underline-offset-4 hover:underline">
        {site.contact.phoneDisplay}
      </a>
      {site.business.certifications.length > 0 && <span>{site.business.certifications.join(' · ')}</span>}
    </p>
  </div>
</section>
