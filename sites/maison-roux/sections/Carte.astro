---
/**
 * « La carte » : trois photos de ce qu'on achète (levain, croissants, pâtisserie), nom et prix
 * dessous en texte simple, puis la liste des prix à filets pointillés, par catégorie, en
 * tabular-nums (site.services filtrés sur les articles à prix fixe ; le gâteau sur commande, sans
 * prix fixe, a sa propre section « CommanderGateau »).
 * Allégée le 9 oct 2026 : plus d'inclinaison ni de reflet au survol, plus de voile dégradé sur les
 * photos, plus d'icône devant chaque ligne, plus de pastille « Spécialité », plus de prix qui se
 * décodent ni de bordure tournante. Une carte de boulangerie se lit, elle ne clignote pas.
 */
import { site } from '@/lib/site';
import Img from '@/components/Img.astro';

const priced = site.services.filter((s) => s.priceFrom);
const categories = [
  { label: 'Les pains', items: priced.filter((s) => s.slug.startsWith('pain-')) },
  { label: 'Viennoiseries, pâtisserie et midi', items: priced.filter((s) => !s.slug.startsWith('pain-')) },
];

// Les photos réelles du dossier (CREDITS.md) : pain au levain, croissants, pâtisserie. Les baguettes
// (galerie-1) sont sur le premier écran.
const photos: Record<string, string> = {
  'pain-au-levain': '/images/galerie-2.webp',
  viennoiseries: '/images/galerie-3.webp',
  'patisseries-de-saison': '/images/galerie-4.webp',
};
const favoris = priced.filter((s) => photos[s.slug]).map((s) => ({ ...s, img: photos[s.slug] }));
---

<section id="carte" class="section-y bg-bg-2">
  <div class="container-ff">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h2 class="text-display-md lg:col-span-6">Ce qui sort du four</h2>
      <p class="text-lg text-muted lg:col-span-5 lg:col-start-8">Prix affichés, sans supplément. Carte bancaire ou espèces.</p>
    </div>

    {favoris.length > 0 && (
      <ul class="mt-12 grid gap-6 sm:grid-cols-3" data-stagger="90">
        {favoris.map((f) => (
          <li>
            <figure>
              <div class="overflow-hidden rounded-card">
                <Img src={f.img} alt={f.title} class="aspect-[4/3] w-full object-cover" sizes="(min-width: 640px) 33vw, 100vw" loading="lazy" />
              </div>
              <figcaption class="mt-3 flex items-baseline justify-between gap-4">
                <span class="font-display text-lg">{f.title}</span>
                <span class="shrink-0 tabular-nums text-muted">{f.priceFrom}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}

    <div class="mt-16 grid gap-12 lg:grid-cols-2 lg:gap-16">
      {categories.map((cat) => cat.items.length > 0 && (
        <div>
          <h3 class="font-display text-xl">{cat.label}</h3>
          <ul class="mt-4 border-t-2 border-fg/70 divide-y divide-dashed divide-fg/25">
            {cat.items.map((item) => (
              <li class="flex items-baseline gap-3 py-3.5">
                <span class="font-display text-lg leading-tight [overflow-wrap:normal]">{item.title}</span>
                <span class="carte-leader" aria-hidden="true"></span>
                <span class="shrink-0 font-display text-lg tabular-nums">{item.priceFrom}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="mt-10 max-w-prose text-sm text-muted">Le pain au levain est la spécialité de la maison : fermentation longue, levain naturel, aucune levure ajoutée. Composition selon les récoltes et la saison, quelques pains ou pâtisseries peuvent manquer en fin de matinée.</p>
  </div>
</section>

<style>
  .carte-leader {
    flex: 1 1 auto;
    min-width: 1.25rem;
    border-bottom: 2px dotted color-mix(in oklch, var(--fg) 45%, transparent);
    transform: translateY(-0.3em);
  }
</style>
