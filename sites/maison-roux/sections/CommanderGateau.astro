---
/**
 * « Gâteaux sur commande » : à gauche, ce qu'il faut dire pour commander (site.services,
 * « gateaux-sur-commande » : résumé, description, points, délai de 48 h donné par le brief), le
 * bouton qui ouvre le tiroir de commande ; à droite, quatre gâteaux réellement photographiés
 * (CREDITS.md) avec leur nom en légende, en texte simple.
 * Avant le 9 oct 2026 : quatre cartes à retourner (data-flip-card, « Retourner la carte ») avec un
 * verso noir et un catalogue générique (« Number cake », « Sur mesure ») : un geste de plus à faire
 * pour lire trois lignes. Ici tout se lit sans cliquer.
 */
import { site, paragraphs } from '@/lib/site';
import Img from '@/components/Img.astro';

const gateau = site.services.find((s) => s.slug === 'gateaux-sur-commande');

const photos = [
  { img: '/images/service-1.webp', legende: 'Gâteau d’anniversaire, crème colorée' },
  { img: '/images/service-2.webp', legende: 'Entremets chocolat, part' },
  { img: '/images/service-3.webp', legende: 'Bûche de fin d’année, meringues' },
  { img: '/images/service-4.webp', legende: 'Tarte aux pommes, servie tiède' },
];
---

{gateau && (
  <section id="commandergateau" class="section-y">
    <div class="container-ff grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <h2 class="text-display-md">{gateau.title}</h2>
        {gateau.short && <p class="mt-5 text-xl leading-snug">{gateau.short}</p>}
        {gateau.description && (
          <div class="mt-5 space-y-4 text-muted">
            {paragraphs(gateau.description).map((p) => <p>{p}</p>)}
          </div>
        )}
        {gateau.bullets.length > 0 && (
          <ul class="mt-6 border-t border-fg/20">
            {gateau.bullets.map((b) => <li class="border-b border-fg/20 py-2.5 text-fg">{b}</li>)}
          </ul>
        )}
        <div class="mt-8">
          <a href="#contact" class="btn btn-primary inline-flex items-center gap-2 rounded-ui bg-accent px-7 py-4 font-display text-lg text-on-accent">
            {site.wording.devis}
          </a>
        </div>
      </div>

      <ul class="grid grid-cols-2 gap-5 lg:col-span-7" data-stagger="90">
        {photos.map((p) => (
          <li>
            <figure>
              <div class="overflow-hidden rounded-card">
                <Img src={p.img} alt={p.legende} class="aspect-square w-full object-cover" sizes="(min-width: 1024px) 28vw, 50vw" loading="lazy" />
              </div>
              <figcaption class="mt-2 text-sm text-muted">{p.legende}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
