---
/**
 * "Commander un gâteau" : grille de cartes retournables (data-flip-card) — recto photo, verso
 * description + délai (48 h, donnée réelle du brief, pas inventée). Le service
 * "gateaux-sur-commande" (site.services) fournit le délai et les bullets ; les 4 styles de gâteau
 * ci-dessous sont un catalogue indicatif générique (pas un chiffre, pas un avis, pas une donnée
 * client), au même titre que le catalogue "symptôme → cause" de
 * sites/dubois-plomberie/sections/Diagnostic.astro — composition et contenu différents (ici photo
 * recto/description verso, pas icône/texte).
 */
import { site } from '@/lib/site';
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';

const gateau = site.services.find((s) => s.slug === 'gateaux-sur-commande');

const styles = [
  { name: 'Anniversaire', img: '/images/service-1.webp', text: 'Génoise moelleuse, crème légère, décor simple ou personnalisé selon l’occasion.' },
  { name: 'Number cake', img: '/images/service-2.webp', text: 'Pâte sablée en chiffre, crème mousseline et fruits de saison.' },
  { name: 'À partager', img: '/images/service-3.webp', text: 'Entremets pour une grande tablée — baptême, communion, réunion de famille.' },
  { name: 'Sur mesure', img: '/images/service-4.webp', text: 'Une envie précise&nbsp;? Décrivez-la, on imagine la recette avec vous.' },
];
---

<section id="commandergateau" class="section-y">
  <div class="container-ff">
    <p class="eyebrow">Gâteaux sur commande</p>
    <h2 class="mt-4 max-w-2xl text-display-lg">Un gâteau pensé pour votre table.</h2>
    {gateau?.short && <p class="measure mt-4 text-lg text-muted">{gateau.short}</p>}

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-stagger="90">
      {styles.map((s) => (
        <li class="h-80 rounded-card" data-flip-card aria-label={`${s.name} — voir le détail et le délai`}>
          <div class="flip-inner rounded-card">
            <div class="flip-front relative overflow-hidden rounded-card">
              <Img src={s.img} alt={`Gâteau ${s.name}, Maison Roux`} class="absolute inset-0 h-full w-full object-cover" sizes="(min-width: 1024px) 25vw, 50vw" loading="lazy" />
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 to-transparent p-5 pt-10">
                <p class="font-display text-xl text-on-ink">{s.name}</p>
                <p class="mt-1 text-xs uppercase tracking-[0.14em] text-on-ink/70">Retourner la carte</p>
              </div>
            </div>
            <div class="flip-back flex flex-col rounded-card bg-ink p-6 text-on-ink">
              <p class="eyebrow text-on-ink/60">{s.name}</p>
              <p class="mt-3 text-sm text-on-ink/90" set:html={s.text} />
              {gateau && (
                <p class="mt-auto flex items-center gap-2 pt-6 text-xs uppercase tracking-[0.14em] text-accent">
                  <Icon name="Clock" size={14} />Délai minimum : 48 h
                </p>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-10">
      <a href="#contact" class="btn btn-primary inline-flex items-center gap-2 rounded-ui bg-accent px-7 py-4 font-display text-lg text-on-accent shadow-card" data-magnetic="0.2">
        {site.wording.devis}
      </a>
    </div>
  </div>
</section>

<style>
  #commandergateau .flip-front,
  #commandergateau .flip-back {
    display: flex;
    flex-direction: column;
  }
</style>
