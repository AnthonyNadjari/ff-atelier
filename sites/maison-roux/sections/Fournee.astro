---
/**
 * « La fournée du jour » : l'ardoise du comptoir. Les 4 heures de sortie du four (site.process,
 * config réelle) écrites sur un seul bloc encre avec grain, l'heure en très grand à gauche, ce qui
 * sort à droite, un trait de craie en pointillé entre chaque ligne. C'est le temps fort de la page,
 * placé juste sous la devanture.
 * Avant le 9 oct 2026 : quatre panneaux sticky de 54 vh (data-sticky-stack) avec une horloge
 * ronde et une phrase chacun, soit deux écrans de blocs de couleur presque vides pour quatre
 * phrases, plus une barre de progression. Une ardoise se lit d'un coup d'œil.
 */
import { site } from '@/lib/site';

const fournees = site.process.map((p) => {
  const [time, ...rest] = p.title.split(', ');
  return { time, label: rest.join(', '), text: p.text };
});
---

{fournees.length > 0 && (
  <section id="fournee" class="section-y bg-ink text-on-ink" data-grain>
    <div class="container-ff relative z-[1]">
      <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
        <h2 class="text-display-lg">La fournée du jour</h2>
        <p class="max-w-sm text-on-ink/70">Les heures de sortie du four, les mêmes chaque jour d’ouverture. Jusqu’à épuisement.</p>
      </div>

      <ol class="ardoise mt-12 border-t border-dashed border-on-ink/45" data-stagger="110">
        {fournees.map((f) => (
          <li class="grid gap-x-10 gap-y-2 border-b border-dashed border-on-ink/45 py-7 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-baseline md:py-9">
            <p class="font-display text-display-lg leading-none tabular-nums">{f.time}</p>
            <div>
              {f.label && <p class="font-display text-xl sm:text-2xl">{f.label}</p>}
              <p class="mt-2 max-w-[34rem] text-on-ink/75">{f.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="mt-8 text-on-ink/70">Le dimanche, ça part vite. Venez tôt.</p>
    </div>
  </section>
)}
