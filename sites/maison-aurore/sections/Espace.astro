---
/**
 * "L'espace" (custom/Espace) : bande de cinq photos au défilement horizontal sur desktop
 * (data-horizontal + .h-track), colonne verticale sur mobile — même mécanique que
 * sites/anna-vidal/sections/Series.astro, composition différente : cartes de taille et de
 * ratio uniformes (4:5, aucune rotation ni décalage), pour un rendu posé plutôt que "posé sur
 * une table". <Img> (pas de data-duotone ici, le manifeste sert donc normalement).
 */
import Img from '@/components/Img.astro';

const pieces = [
  { src: '/images/galerie-1.webp', alt: 'Accueil de Maison Aurore, entrée feutrée', caption: 'Accueil' },
  { src: '/images/galerie-2.webp', alt: 'Cabine de soin, lumière tamisée', caption: 'Cabine de soin' },
  { src: '/images/galerie-3.webp', alt: 'Salle de massage', caption: 'Salle de massage' },
  { src: '/images/galerie-4.webp', alt: 'Hammam de l’institut', caption: 'Hammam' },
  { src: '/images/galerie-5.webp', alt: 'Espace onglerie', caption: 'Espace onglerie' },
];
---

<section id="espace" class="section-y overflow-hidden">
  <div class="container-ff">
    <div class="mx-auto max-w-xl text-center" data-reveal>
      <p class="eyebrow">L’espace</p>
      <h2 class="mt-4 text-display-md">Un lieu pensé pour ralentir</h2>
    </div>
  </div>

  <div class="relative mt-14 md:mt-20" data-horizontal>
    <ul class="h-track flex flex-col gap-10 px-6 md:flex-row md:items-start md:gap-8 md:px-[8vw]">
      {pieces.map((p) => (
        <li class="shrink-0 max-md:max-w-[86%] md:w-[24vw]">
          <figure data-reveal="scale">
            <div class="overflow-hidden rounded-card shadow-card">
              <Img src={p.src} alt={p.alt} class="aspect-[4/5] w-full object-cover" sizes="(min-width: 768px) 24vw, 86vw" loading="lazy" />
            </div>
            <figcaption class="mt-3 text-center font-mono text-xs uppercase tracking-[0.2em] text-muted">{p.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
