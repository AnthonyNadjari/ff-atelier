---
/**
 * "Rituels" (custom/Rituels) — cœur du mandat : trois panneaux plein cadre empilés
 * (data-sticky-stack, chacun reste collé à l'écran jusqu'à ce que le suivant le recouvre),
 * grand numéro romain, durée et prix en tabular-nums, une seule phrase de promesse. Purement
 * typographique (aucune photo) — à la différence de sites/jardins-mael/sections/Saisons.astro
 * (même effet, quatre panneaux avec photo en duotone) : ici le silence vient de l'absence
 * d'image, pas d'un habillage supplémentaire. Un seul accent (token --accent), jamais de
 * couleur par panneau en dur. Durée/prix repris tels quels des trois données réelles du brief
 * (soin visage 75 €, massage 60 min 85 €, rituel Aurore 90 min 140 €) — aucun chiffre inventé ;
 * le soin du visage n'a pas de durée donnée par le brief, seul son prix est donc affiché.
 */
import { site } from '@/lib/site';

const bySlug = Object.fromEntries(site.services.map((s) => [s.slug, s]));

const panels = [
  { numeral: 'I', slug: 'soin-visage', duration: null, price: '75 €', promise: 'Un geste précis pour une peau qui respire à nouveau.' },
  { numeral: 'II', slug: 'massages', duration: '60 min', price: '85 €', promise: 'Les mains guident, le temps s’efface.' },
  { numeral: 'III', slug: 'rituel-aurore', duration: '90 min', price: '140 €', promise: 'Du visage aux épaules, jusqu’au silence.' },
].filter((p) => bySlug[p.slug]);
---

<section id="rituels" class="relative" data-sticky-stack>
  {panels.map((p) => (
    <article class="relative flex min-h-[92vh] flex-col items-center justify-center bg-ink px-6 text-center text-on-ink">
      <p class="font-display text-[6rem] italic leading-none text-accent sm:text-[9rem]" aria-hidden="true">{p.numeral}</p>
      <h3 class="mt-3 font-display text-display-sm text-on-ink" data-reveal>{bySlug[p.slug].title}</h3>
      <p class="mt-4 flex items-center justify-center gap-3 text-on-ink/80">
        {p.duration && <span class="tabular-nums text-lg">{p.duration}</span>}
        {p.duration && <span aria-hidden="true" class="text-on-ink/40">·</span>}
        <span class="tabular-nums text-lg">{p.price}</span>
        <span class="text-xs uppercase tracking-[0.14em] text-on-ink/45">indicatif</span>
      </p>
      <p class="measure mt-6 text-on-ink/75" data-reveal data-reveal-delay="120">{p.promise}</p>
    </article>
  ))}
</section>
