---
/**
 * Premier écran « le territoire » — propre aux Jardins de Maël.
 * Idée : un paysagiste se choisit d'abord sur la distance. Les communes où l'équipe intervient
 * occupent l'écran, une par ligne, alignées alternativement à gauche et à droite comme des parcelles.
 * Ni eyebrow, ni sous-titre, ni bouton, ni photo, ni carte flottante : le titre, puis le terrain.
 */
import { site, tel } from '@/lib/site';

const villes = site.zones?.cities ?? [];
---

<section id="hero" class="bg-bg">
  <div class="container-ff flex min-h-[88svh] flex-col justify-center gap-10 pb-14 pt-32 md:pt-40">
    <h1
      class="max-w-2xl text-display-md leading-[1.05]"
      data-reveal
      set:html={site.business.tagline}
    />

    <ul class="border-t border-line" data-stagger="70">
      {villes.map((v, i) => (
        <li
          class:list={['border-b border-line py-2 font-display leading-tight md:py-3', i % 2 === 1 && 'text-right']}
          style="font-size: clamp(1.3rem, 4.2vw, 2.6rem);"
        >{v}</li>
      ))}
    </ul>

    <p class="flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm text-muted">
      {site.zones?.label && <span>{site.zones.label}</span>}
      <a href={tel()} class="text-fg underline-offset-4 hover:underline">{site.contact.phoneDisplay}</a>
    </p>
  </div>
</section>
