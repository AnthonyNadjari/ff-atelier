---
/**
 * Les avis (GOUT § 0, point 4). Seulement ce que le brief a recopié de sa fiche Google : la note (5,0), le nombre
 * d'avis (3), et les deux avis qui ont un texte, mot pour mot (fautes comprises), prénom + initiale, « avis Google »
 * et le mois. Le troisième avis n'a pas de texte : il n'est compté que dans la note. Un avis est déjà en citation au
 * premier écran ; ici, la page « courrier » de la revue : la note en grand à gauche, les deux avis en colonnes,
 * filets. Aucun mouvement.
 */
import { site } from '@/lib/site';

const g = site.proof.google;
const avis = site.proof.testimonials;
---

{g && (
  <section id="avis" class="avi" aria-labelledby="avi-titre">
    <div class="avi-in">
      <div class="avi-note">
        <h2 id="avi-titre" class="avi-titre">Avis Google</h2>
        <p class="avi-chiffre">{g.rating.toFixed(1).replace('.', ',')}<span class="sr-only"> sur 5</span></p>
        <p class="avi-etoiles" aria-hidden="true">★★★★★</p>
        <p class="avi-compte">{g.count} avis sur sa fiche.</p>
        <a href={g.url} class="avi-lien" target="_blank" rel="noopener">Voir la fiche Google</a>
      </div>
      <ul class="avi-liste">
        {avis.map((a) => (
          <li>
            <figure class="avi-avis">
              <blockquote class="avi-texte">« {a.text} »</blockquote>
              <figcaption class="avi-auteur"><strong>{a.author}</strong>, {a.source.replace(/^Avis/, 'avis')}{a.date && `, ${a.date}`}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style is:global>
  .avi { padding: clamp(2.6rem, 6vw, 5rem) 0; }
  .avi-in { width: min(100% - 2rem, 84rem); margin-inline: auto; display: grid; gap: 1.4rem; padding-top: 0.9rem; border-top: 3px solid var(--fg); }
  .avi-note { display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 0.9rem; }
  .avi-titre { grid-column: 1 / -1; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; margin-bottom: 0.4rem; }
  .avi-chiffre { grid-row: span 2; font-family: var(--font-display); font-weight: 780; font-size: 3.4rem; line-height: 1; letter-spacing: -0.03em; color: var(--fg); }
  .avi-etoiles { color: var(--accent); letter-spacing: 0.08em; font-size: 1.2rem; line-height: 1; }
  .avi-compte { font-size: 0.95rem; color: var(--muted); }
  .avi-lien { grid-column: 1 / -1; justify-self: start; margin-top: 0.6rem; font-weight: 600; color: var(--fg); text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  .avi-liste { display: grid; list-style: none; }
  .avi-avis { margin: 0; padding: 1rem 0; border-top: 1px solid var(--line); }
  .avi-texte { font-family: var(--font-display); font-weight: 700; font-size: 1.45rem; line-height: 1.15; letter-spacing: -0.015em; color: var(--fg); }
  .avi-auteur { margin-top: 0.55rem; font-size: 0.9rem; color: var(--muted); }
  .avi-auteur strong { color: var(--fg); font-weight: 650; }
  @media (hover: hover) and (pointer: fine) {
    .avi-lien:hover { color: var(--accent); }
  }
  @media (min-width: 64rem) {
    .avi-in { width: min(100% - 6rem, 84rem); grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.6rem; padding-top: 1.2rem; }
    .avi-note { grid-column: 1 / 4; grid-template-columns: 1fr; align-content: start; }
    .avi-chiffre { grid-row: auto; font-size: 5rem; }
    .avi-liste { grid-column: 4 / -1; grid-template-columns: 1fr 1fr; }
    .avi-avis { height: 100%; padding: 0 1.6rem; border-top: 0; border-left: 1px solid var(--line); }
    .avi-texte { font-size: clamp(1.7rem, 2.4vw, 2.3rem); }
  }
</style>
