---
/**
 * Venir et appeler : adresse de l'atelier, horaires de sa fiche Google (état du jour calculé par Horaires), le
 * numéro en grand, l'e-mail de son site (mailto : rien n'est envoyé par le site, aucun formulaire) et le lien vers
 * sa fiche Google pour l'itinéraire. Une planche posée sur un fond plus sombre (le bas du mur), chant brun noyer.
 */
import { site, tel, mailto } from '@/lib/site';
import Icon from '@/components/Icon.astro';
import Horaires from '@/components/Horaires.astro';

const ecrire = mailto();
const c = site.contact;
---

<section id="venir" class="ven" aria-labelledby="ven-titre">
  <div class="ven-planche">
    <div class="ven-col">
      <h2 id="ven-titre" class="ven-titre">{site.wording.contactTitle}</h2>
      <p class="ven-adresse">{c.address.street}<br />{c.address.postalCode} {c.address.city}</p>
      <p class="ven-texte">{site.wording.contactText}</p>
      {c.mapsUrl && <a href={c.mapsUrl} class="ven-lien" target="_blank" rel="noopener">L’itinéraire sur Google Maps</a>}
    </div>
    <div class="ven-col">
      <a href={tel()} class="ven-tel" aria-label={`Appeler Guy Andries au ${c.phoneDisplay}`}>
        <Icon name="Phone" size={24} />
        <span>{c.phoneDisplay}</span>
      </a>
      {ecrire && (
        <a href={`${ecrire}?subject=${encodeURIComponent('Un projet')}`} class="ven-mail">
          <Icon name="Mail" size={18} />
          <span>{c.email}</span>
        </a>
      )}
      <Horaires class="ven-horaires" />
    </div>
  </div>
</section>

<style is:global>
  .ven {
    padding: clamp(3rem, 7vw, 6rem) 0.85rem clamp(3.5rem, 8vw, 7rem) 0.6rem;
    background: linear-gradient(to bottom, var(--bg), var(--bg-2));
  }
  .ven-planche {
    width: min(100%, 60rem);
    margin-inline: auto;
    display: grid;
    gap: 1.8rem;
    padding: 1.6rem 1.3rem;
    background: var(--surface);
    border-radius: 2px;
    box-shadow:
      6px 6px 0 color-mix(in oklab, var(--accent-2) 88%, var(--accent)),
      0 1px 0 color-mix(in oklab, var(--ink) 8%, transparent),
      0 30px 56px -22px color-mix(in oklab, var(--ink) 40%, transparent);
  }
  .ven-titre { font-family: var(--font-display); font-weight: 750; font-size: clamp(1.75rem, 4.4vw, 2.5rem); letter-spacing: -0.015em; }
  .ven-adresse { margin-top: 0.8rem; font-size: 1.15rem; line-height: 1.45; }
  .ven-texte { margin-top: 0.6rem; color: var(--muted); }
  .ven-lien, .ven-mail { color: var(--fg); font-weight: 600; text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }
  .ven-lien { display: inline-block; margin-top: 1rem; }
  .ven-tel {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 750;
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }
  .ven-mail { margin-top: 0.9rem; display: inline-flex; align-items: center; gap: 0.5rem; overflow-wrap: anywhere; }
  .ven-horaires { margin-top: 1.3rem; font-size: 0.98rem; }
  .ven-horaires .horaires-etat { font-weight: 700; margin-bottom: 0.4rem; }
  @media (hover: hover) and (pointer: fine) {
    .ven-tel:hover, .ven-lien:hover, .ven-mail:hover { color: var(--fg); text-decoration-color: var(--fg); }
  }
  @media (min-width: 64rem) {
    .ven-planche { grid-template-columns: 1fr 1fr; gap: 3rem; padding: 2.4rem 2.6rem; }
  }
</style>
