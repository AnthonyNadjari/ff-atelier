---
/**
 * Premier écran « la colonne de matière » — propre à l'Atelier Lecerf.
 * Idée : un ébéniste vend du bois avant de vendre un meuble. Une seule planche, photographiée du
 * haut en bas de l'écran, tient une colonne ; le titre occupe le reste, et rien ne s'y superpose.
 * Ni eyebrow, ni sous-titre, ni bouton : la matière fait la promesse, le titre la nomme.
 */
import { site, tel } from '@/lib/site';

const planche = { src: '/images/service-1.webp', alt: 'Grain de chêne massif, veinage prononcé' };
---

<section id="hero" class="bg-bg">
  <div class="container-ff">
    <div class="grid min-h-[80svh] grid-cols-1 items-stretch gap-10 md:grid-cols-[1fr_minmax(0,32%)] md:gap-14">
      <div class="flex flex-col justify-center gap-10 pb-12 pt-32 md:py-24">
        <h1
          class="text-display-xl leading-[0.94]"
          data-split
          set:html={site.business.tagline}
        />
        <p class="flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm text-muted">
          <span>{site.contact.address.street}, {site.contact.address.city}</span>
          <a href={tel()} class="text-fg underline-offset-4 hover:underline">{site.contact.phoneDisplay}</a>
        </p>
      </div>

      <div class="relative order-first h-48 w-full overflow-hidden rounded-card md:order-none md:h-auto">
        <img
          src={planche.src}
          alt={planche.alt}
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
