---
/**
 * Premier écran de l'Atelier Lecerf : le croquis (10 oct 2026).
 * Un ébéniste vend d'abord un dessin : élévation, coupe, perspective, validés avant la première
 * coupe. La planche (table et banc de chêne, W. B. Sanders, 1883, domaine public) occupe la moitié
 * droite en grand, sur le papier de la direction ; le titre, une phrase avec les noms, l'endroit et
 * l'année, puis l'adresse. Trois tailles de texte, aucun bouton, aucun surtitre. Avant : une
 * colonne « grain de chêne » qui était en fait la photo d'un mur de brique.
 */
import { site, tel } from '@/lib/site';
import Img from '@/components/Img.astro';
---

<section id="hero" class="bg-bg">
  <div class="container-ff grid min-h-[88svh] grid-cols-1 items-center gap-10 pb-16 pt-28 md:grid-cols-12 md:gap-12 md:pt-32">
    <div class="flex flex-col gap-8 md:col-span-6">
      <h1 class="leading-[0.95]" style="font-size: clamp(2.75rem, 5.4vw, 5.25rem);" data-split set:html={site.business.tagline} />
      <p class="max-w-[30rem] text-lg leading-relaxed sm:text-xl">
        Thomas Lecerf dessine chaque meuble à l’échelle, avec vous, avant de toucher au bois. Hugo Desmet le fabrique. Depuis 1998, rue de l’Alma à Roubaix, dans une ancienne filature.
      </p>
      <p class="flex flex-wrap items-baseline gap-x-6 gap-y-1 text-sm text-muted">
        <span>{site.contact.address.street}, {site.contact.address.postalCode} {site.contact.address.city}</span>
        <a href={tel()} class="text-fg underline-offset-4 hover:underline">{site.contact.phoneDisplay}</a>
      </p>
    </div>

    <figure class="md:col-span-6">
      <div class="border border-line bg-surface p-3 sm:p-5">
        <Img src="/images/apres.webp" alt="Planche de menuiserie : table et banc de chêne en élévation, coupe et perspective" sizes="(min-width: 768px) 50vw, 100vw" priority class="block h-auto w-full mix-blend-multiply" />
      </div>
      <figcaption class="mt-3 text-sm text-muted">Table et banc de chêne, planche de W. B. Sanders (1883). Chez nous aussi, tout commence par l’élévation et la coupe.</figcaption>
    </figure>
  </div>
</section>
