---
/**
 * "Contact" (custom/Contact) : panneau de coordonnées avec halo qui suit le curseur
 * (data-spotlight, mandat explicite), fond veiné en CSS pur (repeating-linear-gradient depuis les
 * tokens, jamais une couleur en dur) plutôt que la bande data-marquee déjà posée par
 * sites/veto-du-drac/sections/Contact.astro et sites/ampere-fils/sections/Contact.astro — variation
 * volontaire pour ne pas répéter le même habillage. Zone d'intervention (site.zones) affichée en
 * puces : seule section du site à exposer cette donnée. `<ContactForm />`/`<Carte />` partagés
 * réutilisés tels quels, aucune logique dupliquée.
 */
import { site, tel, mailto, fullAddress } from '@/lib/site';
import ContactForm from '@/components/ContactForm.astro';
import Carte from '@/components/Carte.astro';
import Icon from '@/components/Icon.astro';
---

<section id="contact" class="section-y">
  <div class="container-ff grid gap-8 lg:grid-cols-12 lg:gap-10">
    <div class="relative overflow-hidden rounded-card bg-ink p-8 text-on-ink md:p-10 lg:col-span-5" data-spotlight>
      <div class="pointer-events-none absolute inset-0 opacity-[0.14]" aria-hidden="true" style="background-image: repeating-linear-gradient(95deg, color-mix(in oklch, var(--accent) 70%, white) 0 4px, transparent 4px 11px);"></div>

      <p class="eyebrow relative z-[2] text-on-ink/60">Contact</p>
      <h2 class="relative z-[2] mt-4 text-display-md" set:html={site.wording.contactTitle} />
      <p class="relative z-[2] mt-4 max-w-sm text-on-ink/75">{site.wording.contactText}</p>

      <ul class="relative z-[2] mt-9 space-y-5">
        <li class="flex gap-4"><Icon name="Phone" class="mt-0.5 shrink-0 text-accent" /><a href={tel()} class="text-lg font-medium">{site.contact.phoneDisplay}</a></li>
        <li class="flex gap-4"><Icon name="Mail" class="mt-0.5 shrink-0 text-accent" /><a href={mailto()} class="break-all font-medium">{site.contact.email}</a></li>
        <li class="flex gap-4"><Icon name="MapPin" class="mt-0.5 shrink-0 text-accent" /><p>{fullAddress()}</p></li>
        {site.contact.hours.length > 0 && (
          <li class="flex gap-4">
            <Icon name="Clock" class="mt-0.5 shrink-0 text-accent" />
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
              {site.contact.hours.map((h) => (
                <>
                  <dt class="text-on-ink/60">{h.days}</dt>
                  <dd>{h.hours}</dd>
                </>
              ))}
            </dl>
          </li>
        )}
      </ul>

      {site.zones.cities.length > 0 && (
        <div class="relative z-[2] mt-9 border-t border-on-ink/15 pt-6">
          <p class="text-xs uppercase tracking-[0.16em] text-on-ink/50">{site.zones.label ?? 'Zone d’intervention'}</p>
          <ul class="mt-3 flex flex-wrap gap-2" data-stagger="60">
            {site.zones.cities.map((c) => (
              <li class="rounded-pill border border-on-ink/20 px-3 py-1 text-sm text-on-ink/85">{c}</li>
            ))}
          </ul>
        </div>
      )}
    </div>

    <div class="lg:col-span-7">
      {site.contact.coordinates && (
        <div class="mb-6" data-reveal>
          <Carte />
        </div>
      )}
      <div class="card rounded-card bg-surface p-6 shadow-card md:p-8" data-reveal="right">
        <ContactForm />
        {site.form.provider === 'none' && <p class="text-muted">Appelez-nous ou écrivez-nous, nous répondons vite.</p>}
      </div>
    </div>
  </div>
</section>
