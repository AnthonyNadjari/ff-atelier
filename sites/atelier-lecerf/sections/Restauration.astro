---
/**
 * « Restauration » (10 oct 2026) : le curseur avant/après a été retiré. Ses deux images n'étaient
 * pas le même meuble (une chaise devant un mur, puis une planche de dessin) : un faux avant/après.
 * Reste le récit du geste, en étapes de texte, et une commode à vantaux (domaine public) présentée
 * pour ce qu'elle est : le genre de pièce qui passe à l'atelier, pas un chantier de l'atelier.
 */
import SectionHeading from '@/components/SectionHeading.astro';
import Img from '@/components/Img.astro';

const gestes = [
  { t: 'On regarde avant de toucher.', d: 'Essence, assemblages, finition d’origine. On vous dit ce qui se sauve et ce qui se refait, et combien.' },
  { t: 'On défait ce qui a lâché.', d: 'Décapage de l’ancienne finition, assemblages démontés puis recollés à la colle chaude quand le meuble en avait.' },
  { t: 'On refait ce qui manque.', d: 'Un pied, une moulure, un fond de tiroir, dans une essence compatible et un fil de bois dans le même sens.' },
  { t: 'On finit sans vernis plastique.', d: 'Huile ou cire, qui laissent le bois respirer et se reprennent dans dix ans.' },
];
---

<section id="restauration" class="section-y">
  <div class="container-ff grid gap-12 lg:grid-cols-2 lg:items-start">
    <div>
      <SectionHeading
        title="Le meuble de famille garde ses rides"
        text="Une commode qui a déménagé quatre fois, une armoire de grand-mère, des chaises de bistrot. Le bois massif se ponce, se recolle et se reprend. Il a rarement besoin d’être remplacé, et il ne doit pas ressortir d’ici comme s’il était neuf."
      />
      <dl class="mt-10 border-t border-line">
        {gestes.map((g) => (
          <div class="border-b border-line py-4">
            <dt class="font-display text-lg">{g.t}</dt>
            <dd class="mt-1 text-muted">{g.d}</dd>
          </div>
        ))}
      </dl>
    </div>

    <figure data-reveal>
      <Img src="/images/service-4.webp" alt="Commode à vantaux ancienne, marqueterie de fruits et pieds tournés" sizes="(min-width: 1024px) 46vw, 100vw" class="aspect-[4/3] w-full object-cover" />
      <figcaption class="mt-3 text-sm text-muted">Commode à vantaux, XVIIIe siècle. Le genre de pièce qu’on reçoit à l’atelier : marqueterie, placages anciens, bronzes à déposer avant tout le reste.</figcaption>
    </figure>
  </div>
</section>
