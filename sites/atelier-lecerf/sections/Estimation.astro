---
/**
 * "Estimation" : grille de prix indicatifs en tabular-nums (tous "(indicatif)", exception
 * explicitement autorisée par le mandat pour cette démo — voir en-tête de site.config.ts). Lignes
 * de tableau bordées plutôt que les pointillés déjà utilisés par
 * sites/dubois-plomberie/sections/Tarifs.astro (même idée de repère de prix, rendu différent).
 * Le « décodage » des montants (data-scramble) a été retiré le 10 oct 2026 (gadget). Historique : (data-scramble, 7 usages dans un site dessiné à la main
 * avant ce tour — sous le seuil de 5 demandé par le mandat) : le prix se révèle plutôt que de
 * simplement apparaître, cohérent avec le reste du site (le geste, la révélation progressive).
 */
import { site } from '@/lib/site';
import SectionHeading from '@/components/SectionHeading.astro';

const rows = site.services.filter((s) => s.priceFrom);
---

<section id="estimation" class="section-y bg-bg-2">
  <div class="container-ff">
    <SectionHeading
      title="Une idée du budget, avant le devis"
      text="Des ordres de grandeur pour se projeter. Chaque pièce est dessinée pour l’endroit qui l’attend. Le montant exact vient après une visite."
    />

    <div class="mt-10 overflow-hidden rounded-card border border-line bg-surface" data-stagger="80">
      {rows.map((s, i) => (
        <div class:list={['grid grid-cols-1 items-baseline gap-2 px-6 py-5 sm:grid-cols-[1fr_auto] sm:gap-4', i > 0 && 'border-t border-line']} data-reveal>
          <div>
            <p class="font-display text-lg">{s.title}</p>
            <p class="mt-1 text-sm text-muted">{s.short}</p>
          </div>
          <p class="shrink-0 whitespace-nowrap font-display text-lg tabular-nums text-accent">{s.priceFrom}</p>
        </div>
      ))}
    </div>

    <p class="measure mt-6 text-sm text-muted">Montants indicatifs. Le devis, lui, est établi après le relevé chez vous, et il est ferme.</p>
  </div>
</section>
