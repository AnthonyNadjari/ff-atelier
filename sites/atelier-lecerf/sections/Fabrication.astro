---
/**
 * "Du croquis à la pose" : les quatre étapes réelles du process (site.process, aucun texte
 * détaché) en quatre cartes qui s'épinglent puis se tassent au scroll (data-stack — 8 usages dans
 * un site dessiné à la main avant ce tour, sous le seuil de 5 demandé par le mandat). La première
 * carte porte une esquisse de chaise dessinée à la main en SVG inline, tracée au scroll
 * (data-draw-svg) : mandat explicite, une seule esquisse pour toute la section — à la différence
 * de sites/studio-ambre/sections/CaseStudy.astro (même data-stack, mais un plan tracé sur CHACUNE
 * de ses trois cartes) : ici seul le premier temps, "le croquis", porte un dessin ; les trois
 * suivants illustrent leur étape autrement (essences, geste, pièce posée), composition distincte.
 */
import { site } from '@/lib/site';
import Icon from '@/components/Icon.astro';
import Img from '@/components/Img.astro';
import SectionHeading from '@/components/SectionHeading.astro';

const steps = site.process;
const woods = [
  { name: 'Chêne', tex: 'chene' },
  { name: 'Frêne', tex: 'frene' },
  { name: 'Noyer', tex: 'noyer' },
];
---

<section id="fabrication" class="section-y overflow-hidden">
  <div class="container-ff">
    <SectionHeading eyebrow="Du croquis à la pose" title="Quatre étapes, les mêmes mains" text="Rien n’est sous-traité : la personne qui dessine votre pièce est celle qui la fabrique et la pose." />
  </div>

  <div class="mt-12 md:mt-16" data-stack>
    {steps.map((step, i) => (
      <article class="relative flex min-h-[82vh] flex-col justify-center overflow-hidden border-t border-line bg-surface">
        <div class="container-ff grid items-center gap-10 py-16 md:grid-cols-2 md:py-0">
          <div class={i % 2 === 1 ? 'md:order-2' : ''}>
            <p class="eyebrow flex items-center gap-3 text-accent">
              <span class="tabular-nums">0{i + 1}</span>
              <span class="h-px w-8 bg-current opacity-50" aria-hidden="true"></span>
              Étape {i + 1} sur {steps.length}
            </p>
            <h3 class="mt-5 text-display-md" data-reveal>{step.title}</h3>
            <p class="measure mt-5 text-lg text-muted">{step.text}</p>
          </div>

          <div class={['flex items-center justify-center', i % 2 === 1 ? 'md:order-1' : ''].join(' ')}>
            {i === 0 && (
              <figure class="w-full max-w-xs">
                <svg viewBox="0 0 160 200" class="h-auto w-full text-accent" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" data-draw-svg aria-hidden="true">
                  <line x1="50" y1="20" x2="110" y2="20"></line>
                  <line x1="50" y1="20" x2="50" y2="112"></line>
                  <line x1="110" y1="20" x2="110" y2="112"></line>
                  <line x1="50" y1="58" x2="110" y2="58"></line>
                  <line x1="38" y1="112" x2="122" y2="112"></line>
                  <line x1="44" y1="112" x2="36" y2="188"></line>
                  <line x1="116" y1="112" x2="124" y2="188"></line>
                  <line x1="56" y1="112" x2="52" y2="180"></line>
                  <line x1="104" y1="112" x2="108" y2="180"></line>
                </svg>
                <figcaption class="mt-4 text-center text-sm text-muted">Esquisse d’une chaise, dessinée avant la première coupe.</figcaption>
              </figure>
            )}
            {i === 1 && (
              <ul class="flex w-full max-w-xs gap-4" aria-hidden="true">
                {woods.map((w) => (
                  <li class="flex-1 text-center">
                    <div class:list={['aspect-[3/5] rounded-card border border-line', `wood-chip--${w.tex}`]}></div>
                    <p class="mt-2 text-xs text-muted">{w.name}</p>
                  </li>
                ))}
              </ul>
            )}
            {i === 2 && (
              <div class="grid h-40 w-40 place-items-center rounded-full border-2 border-accent/30 bg-accent/10" aria-hidden="true">
                <Icon name="Hammer" size={56} class="text-accent" strokeWidth={1.25} />
              </div>
            )}
            {i === 3 && (
              <Img
                src="/images/service-4.webp"
                alt="Meuble en bois massif installé chez le client"
                class="aspect-[4/3] w-full max-w-sm rounded-card object-cover shadow-card"
                sizes="(min-width: 768px) 24rem, 100vw"
                loading="lazy"
                data-reveal="scale"
              />
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .wood-chip--chene {
    background-image: repeating-linear-gradient(96deg, color-mix(in oklch, #8a5a2b 65%, var(--bg-2)) 0 3px, color-mix(in oklch, #8a5a2b 30%, var(--bg-2)) 3px 7px, color-mix(in oklch, #8a5a2b 50%, var(--bg-2)) 7px 11px);
  }
  .wood-chip--frene {
    background-image: repeating-linear-gradient(94deg, color-mix(in oklch, #c9a468 60%, var(--bg-2)) 0 4px, color-mix(in oklch, #c9a468 25%, var(--bg-2)) 4px 9px);
  }
  .wood-chip--noyer {
    background-image: repeating-linear-gradient(98deg, color-mix(in oklch, #4a2f1c 70%, var(--bg-2)) 0 2px, color-mix(in oklch, #4a2f1c 35%, var(--bg-2)) 2px 6px, color-mix(in oklch, #4a2f1c 55%, var(--bg-2)) 6px 9px);
  }
</style>
