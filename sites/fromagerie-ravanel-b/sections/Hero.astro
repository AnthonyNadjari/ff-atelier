---
/**
 * Premier écran « la cave d'abord » (direction.md, PREMIER ÉCRAN). Ordinateur : une colonne de texte, puis
 * la photo de la cave en pleine hauteur, rien de posé dessus ; le nom et l'horaire du jour sont juste à
 * gauche, dans le panneau. Téléphone : titre, ligne du jour, bouton Appeler, puis la photo.
 * Mouvement : titre par lignes (data-split="lines"), la photo se découvre de bas en haut au chargement (animation CSS)
 * puis glisse doucement au défilement (data-parallax, sur l'image seule, agrandie pour ne jamais montrer
 * de bord).
 */
import Img from '@/components/Img.astro';
import { site, tel } from '@/lib/site';
const hero = site.images.hero!;
---

<section id="hero" class="hero">
  <div class="hero-texte">
    <p class="text-sm text-muted">{site.business.trade}, {site.contact.address.street}, {site.contact.address.city}. Depuis {site.business.since}.</p>
    <h1 class="hero-titre font-display" data-split="lines">{site.business.tagline}</h1>
    <div class="hero-mobile">
      <p class="text-base" data-aujourdhui hidden></p>
      <a href={tel()} class="hero-appel btn">Appeler le {site.contact.phoneDisplay}</a>
    </div>
  </div>

  <div class="hero-photo">
    <Img src={hero.src} alt={hero.alt} priority sizes="(min-width: 64rem) 46vw, 100vw" class="hero-img" data-parallax="0.12" />
  </div>

  <div class="hero-suite">
    <p class="hero-chapo">Ils viennent de six fermes des Aravis et des Bauges. Chaque meule porte sa date d’entrée à la craie. On goûte avant d’acheter, toujours. Et on vous le coupe plus jeune ou plus fait.</p>
    <a href="#calendrier" class="hero-lien">Lire le calendrier d’affinage</a>
  </div>
</section>

<style>
  .hero { display: grid; grid-template-areas: 'texte' 'photo' 'suite'; background: var(--bg); }
  .hero-texte { grid-area: texte; padding: 28px 16px 28px; min-width: 0; }
  .hero-suite { grid-area: suite; padding: 28px 16px 8px; min-width: 0; display: flex; flex-direction: column; }
  .hero-titre { margin-top: 14px; font-size: clamp(2.5rem, 11vw, 3.4rem); line-height: 1.02; letter-spacing: 0; max-width: 15ch; }
  .hero-chapo { font-size: 1.125rem; line-height: 1.55; max-width: 38ch; color: var(--fg); }
  .hero-mobile { margin-top: 20px; display: grid; gap: 12px; justify-items: start; }
  .hero-appel {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px;
    background: var(--accent); color: var(--on-accent); border-radius: var(--radius); text-decoration: none; font-weight: 500;
  }
  .hero-lien {
    margin-top: 24px; align-self: flex-start; color: var(--fg); text-decoration: underline;
    text-decoration-thickness: 1px; text-underline-offset: 5px; text-decoration-color: var(--accent);
  }
  .hero-photo { grid-area: photo; position: relative; overflow: hidden; height: 62svh; min-height: 380px; background: var(--bg-2); }
  .hero-photo :global(picture) { display: block; height: 100%; }
  .hero-photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 55%; scale: 1.14; }
  /* Entrée : la photo se découvre de bas en haut au chargement (pas à l'observateur : elle est déjà là). */
  @media (prefers-reduced-motion: no-preference) {
    [data-motion='rich'] .hero-photo { animation: hero-devoile 1.1s var(--ease-brand) 0.15s both; }
  }
  @keyframes hero-devoile { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }

  @media (min-width: 64rem) {
    .hero { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr); grid-template-rows: 1fr auto auto 0.8fr; grid-template-areas: '. photo' 'texte photo' 'suite photo' '. photo'; min-height: 100svh; }
    .hero-texte { padding: 0 clamp(32px, 4vw, 64px); }
    .hero-suite { padding: 28px clamp(32px, 4vw, 64px) 0; }
    .hero-titre { font-size: clamp(2.5rem, 3.15vw, 3.6rem); max-width: none; }
    .hero-mobile { display: none; }
    .hero-photo { height: 100svh; min-height: 0; }
  }
</style>
