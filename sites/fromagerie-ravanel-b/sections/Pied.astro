---
/** Pied sur mesure : le sol de la cave, à l'encre. Nom, numéro, pages légales, mention de démonstration. */
import { site, tel, hasCredits } from '@/lib/site';
const year = new Date().getFullYear();
---

<footer class="pied">
  <div class="escalier-col" style="--pas: 5">
    <p class="pied-nom font-display">{site.business.name}</p>
    <p class="pied-demo">{site.business.trade}, {site.contact.address.street}, {site.contact.address.postalCode} {site.contact.address.city}, depuis {site.business.since}.</p>
    <p class="pied-lignes">
      <a href={tel()}>{site.contact.phoneDisplay}</a>
      <a href="/mentions-legales">Mentions légales</a>
      <a href="/confidentialite">Confidentialité</a>
      {hasCredits && <a href="/credits">Crédits</a>}
    </p>
    {site.legal.demo && <p class="pied-demo">Site de démonstration : l’entreprise, les personnes et les coordonnées sont inventées, aucun client derrière.</p>}
    <p class="pied-demo">© {year}. Site réalisé par <a href="https://finckfisch.fr" rel="noopener" target="_blank">Finck &amp; Fisch</a></p>
  </div>
</footer>

<style>
  .pied { background: var(--ink); color: var(--craie-2); padding: 40px 0 48px; border-top: 1px solid color-mix(in oklab, var(--on-ink) 14%, var(--ink)); }
  .pied-nom { font-size: 1.5rem; font-weight: 600; color: var(--craie); }
  .pied-lignes { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 8px 22px; font-size: 0.9375rem; }
  .pied a { color: var(--craie); text-underline-offset: 3px; }
  .pied-demo { margin-top: 14px; font-size: 0.8125rem; line-height: 1.5; max-width: 52ch; }
</style>
