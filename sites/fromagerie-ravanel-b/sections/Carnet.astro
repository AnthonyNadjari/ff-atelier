---
/**
 * « Raclette et plateaux » : deux colonnes d'un carnet réglé (direction.md). Chaque ligne du carnet est
 * une condition exacte du brief (appareil 4 ou 8 personnes, caution 50 €, deux jours avant le week-end ;
 * 6 à 30 personnes, dès 6 € par personne, 48 heures avant, une semaine pour les fêtes). Pas de carte, pas
 * de coche : des lignes, comme on les écrit. Une marge verticale sépare les deux pages.
 * Mouvement : titre par lignes, photo révélée par un volet, lignes du carnet en cascade (un groupe par page).
 */
import Img from '@/components/Img.astro';
import { site, tel } from '@/lib/site';

const pages = [
  {
    titre: 'La raclette',
    lignes: [
      { quoi: 'Le fromage', val: 'coupé ou râpé à la demande, pour la raclette comme pour la fondue' },
      { quoi: 'L’appareil', val: 'prêté, pour 4 ou 8 personnes' },
      { quoi: 'La caution', val: '50 €' },
      { quoi: 'Réserver', val: 'deux jours avant le week-end ; il en reste rarement le samedi' },
    ],
  },
  {
    titre: 'Les plateaux',
    lignes: [
      { quoi: 'Pour', val: '6 à 30 personnes' },
      { quoi: 'Composés', val: 'avec vous' },
      { quoi: 'Prix', val: 'à partir de 6 € par personne' },
      { quoi: 'Commander', val: '48 heures avant ; une semaine avant pour Noël et le Nouvel An' },
    ],
  },
];
const raclette = site.services.find((s) => s.slug === 'raclette')?.image;
---

<section id="carnet" class="carnet section-y">
  <div class="carnet-cadre">
    <div class="carnet-tete">
      <div>
        <h2 class="carnet-titre font-display" data-split="lines">Raclette et plateaux, ce qu’il faut savoir avant de réserver.</h2>
        <p class="carnet-chapo" data-reveal>Tout se réserve par téléphone, aux heures d’ouverture.</p>
      </div>
      {raclette && (
        <figure class="carnet-photo" data-reveal="wipe">
          <Img src={raclette.src} alt={raclette.alt} sizes="(min-width: 64rem) 30vw, 100vw" />
        </figure>
      )}
    </div>

    <div class="carnet-pages" data-stagger="120">
      {pages.map((p) => (
        <div class="carnet-page">
          <h3 class="carnet-page-titre font-display">{p.titre}</h3>
          <dl class="carnet-lignes">
            {p.lignes.map((l) => (
              <div>
                <dt>{l.quoi}</dt>
                <dd>{l.val}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>

    <div class="carnet-pied" data-reveal>
      <p>Au comptoir, pour aller avec : beurre de baratte, crème crue, yaourts de la ferme, et quelques vins de Savoie.</p>
      <a href={tel()} class="carnet-appel btn">Réserver au {site.contact.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .carnet { background: var(--surface); border-top: 1px solid var(--line); }
  .carnet-cadre { padding-inline: 16px; max-width: 72rem; }
  .carnet-tete { display: grid; gap: 32px; }
  .carnet-titre { font-size: clamp(2.1rem, 7.5vw, 3.4rem); line-height: 1.04; max-width: 18ch; }
  .carnet-chapo { margin-top: 18px; font-size: 1.1rem; color: var(--muted); }
  .carnet-photo { margin: 0; overflow: hidden; }
  .carnet-photo :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  .carnet-pages { margin-top: 56px; display: grid; gap: 48px; }
  .carnet-page-titre { font-size: 2rem; line-height: 1.1; padding-bottom: 12px; border-bottom: 2px solid var(--fg); }
  /* Carnet réglé : chaque condition sur sa ligne, un filet fin dessous. */
  .carnet-lignes { margin: 0; }
  .carnet-lignes > div { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .carnet-lignes dt { color: var(--muted); font-size: 0.95rem; padding-top: 2px; }
  .carnet-lignes dd { margin: 0; font-size: 1.08rem; line-height: 1.45; }

  .carnet-pied { margin-top: 48px; display: grid; gap: 20px; justify-items: start; max-width: 48rem; }
  .carnet-pied p { font-size: 1.05rem; line-height: 1.55; }
  .carnet-appel {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px;
    background: var(--accent); color: var(--on-accent); border-radius: var(--radius); text-decoration: none; font-weight: 500;
    transition: background-color var(--motion-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .carnet-appel:hover { background: var(--fg); } }

  @media (min-width: 64rem) {
    .carnet-cadre { padding-inline: clamp(32px, 4vw, 64px); }
    .carnet-tete { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); align-items: end; gap: 56px; }
    /* Les deux pages du carnet ouvert, la marge au milieu. */
    .carnet-pages { grid-template-columns: 1fr 1fr; gap: 0; margin-top: 72px; }
    .carnet-page:first-child { padding-right: 40px; border-right: 1px solid var(--line); }
    .carnet-page:last-child { padding-left: 40px; }
  }
</style>
