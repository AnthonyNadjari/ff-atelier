---
/**
 * Premier écran sur mesure « la rue » (direction.md, PREMIER ÉCRAN et MOUVEMENT 1 et 4). En haut, la lumière
 * de la rue de la Gare : le nom, la cave en deux phrases, le numéro en mono. Puis l'escalier de la cave,
 * dessiné en coupe : un palier avec la porte sur la rue, neuf marches qui descendent vers la droite. La pierre
 * de l'escalier est sombre, l'air au-dessus passe du clair de la rue au ton de la cave, et l'arête de chaque
 * marche, éclairée par la porte, pâlit en descendant. La lumière baisse en suivant le doigt, sans script :
 * c'est le document lui-même qui s'assombrit.
 *
 * Téléphone : l'escalier sous le texte, sur toute la largeur. Ordinateur : l'escalier part du haut de l'écran
 * à droite du texte et descend jusqu'à la cave (dessin derrière le texte, l'air y reste clair).
 *
 * Entrée (régime sec) : la porte, puis les arêtes des marches apparaissent l'une après l'autre en descendant,
 * 0,12 s chacune, linéaire. Image qui bouge : la porte rapetisse et pâlit quand on descend (timeline de
 * défilement CSS ; sans elle, la porte reste fixe). Le h1 ne bouge pas.
 */
import { site, tel } from '@/lib/site';

type Geo = { x0: number; palier: number; y0: number; y1: number };
const N = 9; // marches après le palier
const MOBILE: Geo = { x0: 0, palier: 24, y0: 22, y1: 93 };
const BUREAU: Geo = { x0: 47, palier: 9, y0: 19, y1: 92 };
const r = (n: number) => Math.round(n * 100) / 100;

// Arêtes : le palier (k = 0) puis N marches ; x, largeur et hauteur en % de l'escalier.
const aretes = (g: Geo) => {
  const dx = (100 - g.x0 - g.palier) / N;
  const dy = (g.y1 - g.y0) / N;
  return Array.from({ length: N + 1 }, (_, k) => ({
    x: k === 0 ? g.x0 : g.x0 + g.palier + (k - 1) * dx,
    w: k === 0 ? g.palier : dx,
    y: g.y0 + k * dy,
  }));
};
// La pierre : un seul polygone en marches, du bas à gauche du palier jusqu'au bas à droite.
const forme = (g: Geo) => {
  const pts: string[] = [`${g.x0}% 100%`];
  for (const a of aretes(g)) pts.push(`${r(a.x)}% ${r(a.y)}%`, `${r(a.x + a.w)}% ${r(a.y)}%`);
  pts.push('100% 100%');
  return `polygon(${pts.join(', ')})`;
};
const am = aretes(MOBILE);
const ab = aretes(BUREAU);
const marches = am.map((m, k) => ({
  k,
  style: `--k:${k};--xm:${r(m.x)}%;--wm:${r(m.w)}%;--ym:${r(m.y)}%;--xb:${r(ab[k].x)}%;--wb:${r(ab[k].w)}%;--yb:${r(ab[k].y)}%;--lum:${Math.round(92 - k * 5.5)}%`,
}));
const porte = `--xm:${MOBILE.x0 + 5}%;--ym:${MOBILE.y0}%;--xb:${BUREAU.x0 + 1.5}%;--yb:${BUREAU.y0}%`;
---

<section class="rue" aria-labelledby="rue-titre">
  <div class="escalier-col rue-texte" style="--pas: 0">
    <h1 id="rue-titre" class="rue-h1"><span>Fromagerie</span> <span>Ravanel</span></h1>
    <p class="rue-lead">Sous la boutique du {site.contact.address.street}, à {site.contact.address.city}, une cave à 11 °C. Les tommes et les reblochons de six fermes des Aravis et des Bauges y finissent de s’affiner.</p>
    <p class="rue-voix">On goûte avant d’acheter, toujours.</p>
    <a href={tel()} class="rue-tel">
      <span class="etiquette">Appeler la boutique</span>
      <span class="rue-num">{site.contact.phoneDisplay}</span>
    </a>
    <p class="rue-jour" data-aujourdhui hidden></p>
  </div>

  <div class="escalier" aria-hidden="true" style={`--forme-m:${forme(MOBILE)};--forme-b:${forme(BUREAU)}`}>
    <span class="escalier-pierre"></span>
    <span class="escalier-porte" style={porte}><span class="escalier-jour"></span></span>
    {marches.map((m) => <span class="arete" style={m.style}></span>)}
  </div>
</section>

<style>
  .rue { position: relative; background: var(--cave-0); color: var(--fg); }
  .rue-texte { position: relative; z-index: 1; padding-top: clamp(1.75rem, 6vw, 3.5rem); }
  .rue-h1 { font-weight: 700; font-size: clamp(3.9rem, 17vw, 8rem); line-height: 0.88; letter-spacing: -0.015em; }
  .rue-h1 span { display: block; }
  .rue-lead { margin-top: 24px; font-size: clamp(1.125rem, 4.4vw, 1.3rem); line-height: 1.45; max-width: 34ch; }
  .rue-voix { margin-top: 12px; font-size: clamp(1.125rem, 4.4vw, 1.3rem); line-height: 1.45; font-weight: 600; }
  .rue-tel {
    margin-top: 28px; display: inline-flex; flex-direction: column; gap: 2px; text-decoration: none; color: var(--fg);
    border-bottom: 2px solid var(--fg); padding-bottom: 6px;
    transition: color var(--sec) linear, border-color var(--sec) linear;
  }
  .rue-tel:active { color: var(--accent); border-color: var(--accent); }
  @media (hover: hover) and (pointer: fine) { .rue-tel:hover { color: var(--accent); border-color: var(--accent); } }
  .rue-tel .etiquette { color: var(--muted); }
  .rue-num { font-family: var(--font-mono); font-size: clamp(1.7rem, 7.6vw, 2.6rem); font-weight: 500; line-height: 1.1; letter-spacing: -0.02em; white-space: nowrap; }
  .rue-jour { margin-top: 16px; font-family: var(--font-mono); font-size: 0.875rem; }
  
  /* L'escalier en coupe. L'air : clair en haut, ton de la cave en bas (raccord avec la section suivante). */
  .escalier {
    --forme: var(--forme-m);
    position: relative; margin-top: 1.25rem;
    height: clamp(460px, 82svh, 760px); overflow: hidden;
    background: linear-gradient(to bottom,
      var(--cave-0) 0%,
      color-mix(in oklab, var(--ink) 14%, var(--bg)) 30%,
      color-mix(in oklab, var(--ink) 38%, var(--bg)) 62%,
      var(--cave-1) 100%);
    view-timeline: --escalier block;
  }
  .escalier-pierre {
    position: absolute; inset: 0; clip-path: var(--forme);
    background: linear-gradient(to bottom,
      color-mix(in oklab, var(--ink) 46%, var(--bg)) 0%,
      color-mix(in oklab, var(--ink) 80%, var(--bg)) 62%,
      var(--cave-1) 100%);
  }
  .arete {
    position: absolute; left: var(--xm); width: calc(var(--wm) + 1px); top: var(--ym); height: 4px;
    background: color-mix(in oklab, var(--bg) var(--lum), var(--ink));
  }
  .escalier-porte {
    position: absolute; left: var(--xm); bottom: calc(100% - var(--ym)); width: clamp(44px, 13vw, 76px); aspect-ratio: 5 / 11;
    transform-origin: 50% 100%;
    border: 5px solid color-mix(in oklab, var(--ink) 62%, var(--bg)); border-bottom: 0;
    background: var(--bg);
  }
  .escalier-jour { position: absolute; inset: 0; background: color-mix(in oklab, var(--accent) 14%, var(--bg)); }

  @media (min-width: 64rem) {
    .rue { min-height: calc(100svh + 40vh); }
    .rue-h1 { font-size: clamp(5rem, 8.4vw, 8.5rem); }
    .escalier {
      --forme: var(--forme-b);
      position: absolute; inset: 0; margin: 0; height: auto;
      background: linear-gradient(to bottom,
        var(--cave-0) 0%,
        var(--cave-0) 38%,
        color-mix(in oklab, var(--ink) 22%, var(--bg)) 58%,
        color-mix(in oklab, var(--ink) 44%, var(--bg)) 78%,
        var(--cave-1) 100%);
    }
    .arete { left: var(--xb); width: calc(var(--wb) + 1px); top: var(--yb); }
    .escalier-porte { left: var(--xb); bottom: calc(100% - var(--yb)); width: clamp(60px, 4.6vw, 80px); }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-motion='rich']) .escalier-pierre { animation: apparait 0.12s linear 0.1s both; }
    :global([data-motion='rich']) .escalier-porte { animation: apparait 0.12s linear 0.22s both; }
    :global([data-motion='rich']) .arete { animation: arete-pose 0.12s linear both; animation-delay: calc(0.36s + var(--k) * 0.09s); }
    @supports (animation-timeline: view()) {
      :global([data-motion='rich']) .escalier-porte {
        animation: apparait 0.12s linear 0.22s both, porte-loin linear both;
        animation-timeline: auto, --escalier;
        animation-range: normal, cover 42% cover 85%;
      }
    }
  }
  @keyframes apparait { from { opacity: 0; } }
  @keyframes arete-pose { from { opacity: 0; translate: 0 -10px; } }
  @keyframes porte-loin { to { scale: 0.4; opacity: 0.35; } }
</style>
