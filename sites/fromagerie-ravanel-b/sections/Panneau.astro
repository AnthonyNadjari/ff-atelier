---
/**
 * Nav sur mesure « le panneau du carnet » (direction.md, SQUELETTE). Ordinateur : un panneau fixe à gauche,
 * comme la page de garde d'un carnet qu'on garde ouverte : nom, métier, adresse, l'horaire du jour, le
 * téléphone, quatre ancres sans numéro (GOUT § 2), le marché en bas. Le reste de la page défile à droite
 * (décalage posé ici, en style global, sur #main et le pied de page : la coquille `flow` ne bouge pas).
 * Téléphone : une barre fine en haut, nom et « Appeler », toujours au pouce.
 *
 * Horaire du jour : calculé chez le visiteur à partir de `contact.hours` ; le même script remplit toutes
 * les lignes `[data-aujourdhui]` de la page et marque le jour courant de toute liste `[data-horaires]`
 * (hero, Venir). Sans script : rien de faux, la ligne reste cachée et la semaine complète est dans « Venir ».
 */
import { site, tel } from '@/lib/site';

const ancres = [
  { href: '#calendrier', label: 'Le calendrier d’affinage' },
  { href: '#carnet', label: 'Raclette et plateaux' },
  { href: '#faq', label: 'Questions' },
  { href: '#venir', label: 'Venir' },
];
const JOURS = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
const joursDe = (txt: string) => {
  const noms = txt.toLowerCase().split(/\s+à\s+/).map((s) => JOURS.indexOf(s.trim()));
  if (noms.some((n) => n < 0)) return [];
  if (noms.length === 2) {
    const out: number[] = [];
    for (let d = noms[0]; ; d = (d + 1) % 7) { out.push(d); if (d === noms[1] || out.length > 7) break; }
    return out;
  }
  return noms;
};
const semaine = site.contact.hours.map((h) => ({ jours: joursDe(h.days), hours: h.hours }));
---

<header class="panneau" data-panneau>
  <div class="panneau-barre">
    <a href="/" class="font-display panneau-nom-court">{site.business.name}</a>
    <a href={tel()} class="panneau-appel">Appeler</a>
  </div>

  <div class="panneau-page">
    <div>
      <a href="/" class="panneau-nom font-display">{site.business.name}</a>
      <p class="mt-3 text-sm text-muted">{site.business.trade}<br />{site.contact.address.street}, {site.contact.address.city}</p>

      <p class="panneau-jour mt-10" data-aujourdhui hidden></p>
      <a href={tel()} class="panneau-tel btn mt-4">Appeler le {site.contact.phoneDisplay}</a>

      <nav class="panneau-ancres mt-12" aria-label="Navigation principale" data-scrollspy>
        {ancres.map((a) => <a href={a.href} class="spy-link">{a.label}</a>)}
      </nav>
    </div>
    <p class="text-sm text-muted">Au marché de la vieille ville le mardi et le vendredi matin, avec les mêmes fromages.</p>
  </div>
</header>

<script type="application/json" data-semaine set:html={JSON.stringify(semaine)} />

<style is:global>
  :root { --panneau-l: clamp(17rem, 21vw, 20rem); }
  @media (min-width: 64rem) {
    [data-shell='flow'] #main, [data-shell='flow'] #main ~ footer { margin-left: var(--panneau-l); }
  }
  @media (max-width: 63.99rem) { html { scroll-padding-top: 4.5rem; } }
  /* FAQ partagée : même bord gauche que les pages du carnet (sinon elle se centre seule dans la colonne). */
  @media (min-width: 64rem) { #faq > .container-ff { margin-left: 0; padding-left: clamp(32px, 4vw, 64px); } }
</style>

<style>
  .panneau-barre {
    position: sticky; top: 0; z-index: 40;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 12px 16px; background: var(--bg); border-bottom: 1px solid var(--line);
  }
  .panneau { position: sticky; top: 0; z-index: 40; }
  .panneau-nom-court { font-size: 1.45rem; line-height: 1; text-decoration: none; color: var(--fg); }
  .panneau-appel {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px;
    background: var(--accent); color: var(--on-accent); border-radius: var(--radius); text-decoration: none; font-weight: 500;
  }
  .panneau-page { display: none; }

  @media (min-width: 64rem) {
    .panneau { position: fixed; inset: 0 auto 0 0; width: var(--panneau-l); }
    .panneau-barre { display: none; }
    .panneau-page {
      display: flex; flex-direction: column; justify-content: space-between; height: 100%;
      padding: 40px 32px 32px; background: var(--bg-2); border-right: 1px solid var(--line); overflow-y: auto;
    }
  }
  .panneau-nom { display: block; font-size: clamp(2.6rem, 3.4vw, 3.4rem); line-height: 0.95; color: var(--fg); text-decoration: none; }
  .panneau-jour { font-size: 1rem; line-height: 1.45; color: var(--fg); padding-top: 14px; border-top: 1px solid var(--line); }
  .panneau-tel {
    display: flex; justify-content: center; align-items: center; min-height: 48px; padding: 0 16px;
    background: var(--accent); color: var(--on-accent); border-radius: var(--radius); text-decoration: none; font-weight: 500;
    transition: background-color var(--motion-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) { .panneau-tel:hover { background: var(--fg); } }
  .panneau-ancres { display: grid; gap: 2px; }
  .panneau-ancres a {
    display: block; padding: 7px 0 7px 14px; color: var(--muted); text-decoration: none; font-size: 1rem;
    border-left: 1px solid var(--line);
    transition: color var(--motion-ui) var(--ease-out), border-color var(--motion-ui) var(--ease-out);
  }
  .panneau-ancres a.is-active { color: var(--fg); border-left-color: var(--accent); }
  @media (hover: hover) and (pointer: fine) { .panneau-ancres a:hover { color: var(--fg); } }
</style>

<script>
  import { onPage } from '@/scripts/page';
  import { initScrollSpy } from '@/scripts/scrollspy';
  const NOMS = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
  function jourDuJour() {
    const src = document.querySelector('[data-semaine]');
    if (!src) return;
    let semaine: { jours: number[]; hours: string }[] = [];
    try { semaine = JSON.parse(src.textContent || '[]'); } catch { return; }
    const j = new Date().getDay();
    const ligne = semaine.find((s) => s.jours.includes(j));
    if (ligne) {
      const h = ligne.hours.toLowerCase() === 'fermé' ? 'fermé' : ligne.hours;
      document.querySelectorAll<HTMLElement>('[data-aujourdhui]').forEach((p) => {
        p.textContent = `Aujourd’hui, ${NOMS[j]} : ${h}`;
        p.hidden = false;
      });
    }
    document.querySelectorAll<HTMLElement>('[data-horaires] [data-jours]').forEach((l) => {
      const oui = (l.dataset.jours || '').split(',').filter(Boolean).map(Number).includes(j);
      l.classList.toggle('aujourdhui', oui);
    });
  }
  onPage(jourDuJour);
  onPage(initScrollSpy);
</script>
