---
/**
 * « 12 rue de la Gare » (contact) : le bas de l'escalier, le palier le plus sombre. La semaine complète, le
 * jour courant marqué (script de Porte.astro), le marché de la vieille ville avec Théo, le numéro en mono.
 * Pas de formulaire (pas d'e-mail au brief) : on appelle. Rien ne bouge.
 */
import { site, tel } from '@/lib/site';
const JOURS = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
const joursDe = (txt: string) => {
  const noms = txt.toLowerCase().split(/\s+à\s+/).map((s) => JOURS.indexOf(s.trim()));
  if (noms.some((n) => n < 0)) return [];
  if (noms.length === 2) {
    const out: number[] = [];
    for (let d = noms[0]; ; d = (d + 1) % 7) { out.push(d); if (d === noms[1] || out.length > 7) break; }
    return out;
  }
  return noms;
};
const horaires = site.contact.hours.map((h) => ({ ...h, jours: joursDe(h.days).join(',') }));
const a = site.contact.address;
---

<section id="venir" class="palier venir" aria-labelledby="venir-titre">
  <div class="escalier-col a-marche" style="--pas: 5">
    <p class="marche etiquette" aria-hidden="true">mardi et vendredi, marché</p>
    <h2 id="venir-titre" class="font-display">{site.wording.contactTitle}</h2>
    <p class="venir-ville">{a.postalCode} {a.city}</p>

    <dl class="venir-semaine">
      {horaires.map((h) => (
        <div data-jours={h.jours}>
          <dt>{h.days}</dt>
          <dd>{h.hours}</dd>
        </div>
      ))}
    </dl>

    <p class="venir-p">Le mardi et le vendredi matin, Théo tient le stand du marché de la vieille ville, avec les mêmes fromages.</p>
    <p class="venir-p">{site.wording.contactText}</p>
    <a href={tel()} class="venir-tel"><span class="etiquette">appeler la boutique</span><span class="venir-num">{site.contact.phoneDisplay}</span></a>
  </div>
</section>

<style>
  .venir { background: linear-gradient(to bottom, var(--cave-4), var(--cave-5) 30%); }
  .venir-ville { margin-top: 8px; font-family: var(--font-mono); font-size: 0.9375rem; }
  .venir-semaine { margin: 36px 0 0; }
  .venir-semaine > div {
    display: grid; grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); gap: 4px 16px;
    padding: 12px 0 12px 14px; border-left: 3px solid transparent;
  }
  .venir-semaine dt { font-weight: 600; color: var(--craie); }
  .venir-semaine dd { margin: 0; font-family: var(--font-mono); font-size: 0.9375rem; color: var(--craie-2); }
  .venir-semaine > :global(.est-aujourdhui) { border-left-color: var(--croute-tomme); background: color-mix(in oklab, var(--on-ink) 7%, transparent); }
  .venir-semaine > :global(.est-aujourdhui) dd { color: var(--craie); }
  @media (max-width: 30rem) { .venir-semaine > div { grid-template-columns: 1fr; } }
  .venir-p { margin-top: 24px; font-size: 1.0625rem; line-height: 1.6; max-width: 40ch; }
  .venir-tel {
    margin-top: 32px; display: inline-flex; flex-direction: column; gap: 2px;
    color: var(--craie); text-decoration: none; border-bottom: 2px solid var(--craie); padding-bottom: 6px;
    transition: color var(--sec) linear, border-color var(--sec) linear;
  }
  .venir-tel .etiquette { color: var(--craie-2); }
  .venir-tel:active { color: var(--croute-tomme); border-color: var(--croute-tomme); }
  @media (hover: hover) and (pointer: fine) { .venir-tel:hover { color: var(--croute-tomme); border-color: var(--croute-tomme); } }
  .venir-num { font-family: var(--font-mono); font-size: clamp(1.7rem, 7.6vw, 2.4rem); font-weight: 500; line-height: 1.1; white-space: nowrap; }
</style>
