---
/**
 * « La cave à 11 °C » (direction.md, faits 1 à 4, MOUVEMENT 2). Premier palier en bas de l'escalier. Deux
 * planches dessinées, les tommes en haut, les reblochons en bas ; chaque meule porte « entrée » et un trait
 * de craie illisible (le brief dit que chaque meule porte sa date d'entrée, il ne donne aucune date : on n'en
 * écrit pas). Les meules se posent l'une après l'autre quand les planches arrivent (régime lent, rebond léger,
 * réglé dans Porte.astro). La parole de Claire reprend le brief (« plus jeune » ou « plus fait »).
 */
// Téléphone : 3 tommes, 5 reblochons ; ordinateur : 5 et 8 (les planches y sont plus longues).
const tommes = 5;
const reblochons = 8;
---

<section id="cave" class="palier cave" aria-labelledby="cave-titre">
  <div class="escalier-col a-marche" style="--pas: 1">
    <p class="marche etiquette" aria-hidden="true">cave, 11 °C</p>
    <h2 id="cave-titre" class="font-display">La cave à 11 °C</h2>
    <p class="cave-p">Claire l’a creusée en 2014, sous la boutique. Les tommes et les reblochons fermiers y restent le temps qu’il faut, et chaque meule porte sa date d’entrée à la craie.</p>
  </div>

  <div class="escalier-large cave-planches" style="--pas: 1">
    <div class="cave-rang" data-pose>
      <div class="planche">
        {Array.from({ length: tommes }, (_, i) => (
          <span class:list={['meule tomme', i >= 3 && 'large-seul']} data-meule><svg class="meule-craie" viewBox="0 0 62 12" aria-hidden="true"><text x="0" y="9">entrée</text><path d="M1 6 C4 1, 6 9, 9 4 S14 2, 16 6 S22 7, 25 3" transform="translate(35 1)" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg></span>
        ))}
      </div>
      <p class="etiquette cave-etiq">tommes fermières</p>
    </div>
    <div class="cave-rang" data-pose>
      <div class="planche">
        {Array.from({ length: reblochons }, (_, i) => (
          <span class:list={['meule reblochon', i >= 5 && 'large-seul']} data-meule><svg class="meule-craie" viewBox="0 0 26 12" aria-hidden="true"><path d="M1 5 C5 8, 7 1, 11 5 S17 8, 20 3 S24 4, 25 6" transform="translate(0 1)" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" /></svg></span>
        ))}
      </div>
      <p class="etiquette cave-etiq">reblochons fermiers</p>
    </div>
  </div>

  <div class="escalier-col" style="--pas: 1">
    <blockquote class="cave-voix">
      <p class="font-display">« Plus jeune ou plus fait ? Dites-le-moi, je vous coupe celui qu’il vous faut, et vous goûtez avant. »</p>
      <footer class="etiquette">Claire Ravanel, affineuse</footer>
    </blockquote>
    <p class="cave-p">Chaque fromage a sa ferme, et Claire vous dit laquelle.</p>
  </div>
</section>

<style>
  .cave { --craie-2: var(--craie); background: var(--cave-1); padding-top: clamp(2.5rem, 7vw, 5rem); }
  .large-seul { display: none; }
  @media (min-width: 64rem) { .large-seul { display: grid; } }
  .cave-p { margin-top: 20px; font-size: 1.0625rem; line-height: 1.6; max-width: 40ch; }
  .cave-planches { margin-top: clamp(2.5rem, 7vw, 4rem); display: grid; gap: clamp(3rem, 8vw, 4.5rem); }
  /* Ordinateur : les planches débordent la colonne de 34 rem vers la droite (direction.md, SQUELETTE), et les
     meules les remplissent (5 tommes ≈ 46 rem, 8 reblochons ≈ 48 rem). */
  @media (min-width: 72rem) {
    .cave { padding-top: var(--palier-haut); }
    .cave-planches { width: min(60vw, 52rem); }
  }
  .cave-rang .planche { padding-top: 70px; }
  .cave-etiq { margin-top: 20px; padding-left: 12px; color: var(--craie-2); }
  .cave-voix { margin: clamp(3rem, 8vw, 4.5rem) 0 0; padding-left: 18px; border-left: 3px solid var(--croute-tomme); }
  .cave-voix p { font-size: clamp(1.5rem, 5.6vw, 2rem); line-height: 1.15; font-weight: 400; color: var(--craie); }
  .cave-voix footer { margin-top: 12px; color: var(--craie-2); }
</style>
