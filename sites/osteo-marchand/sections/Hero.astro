---
/**
 * Premier écran « le vide » — propre au cabinet Léa Marchand.
 * Idée : un cabinet d'ostéopathe se juge au calme. L'écran ne porte qu'une phrase et beaucoup de
 * blanc ; la photo est réduite à une vignette de la taille d'un timbre, posée à côté de l'adresse.
 * Ni eyebrow, ni sous-titre, ni bouton : rien à décider avant d'avoir respiré.
 */
import { site, tel } from '@/lib/site';

const hero = site.images.hero;
---

<section id="hero" class="bg-bg">
  <div class="container-ff flex min-h-[78svh] flex-col justify-center gap-16 pb-16 pt-32 md:pt-40">
    <h1
      class="max-w-[18ch] text-display-lg leading-[1.06]"
      data-reveal
      set:html={site.business.tagline}
    />

    <div class="flex items-end gap-6">
      {hero && (
        <img
          src={hero.src}
          alt={hero.alt}
          class="h-24 w-[4.5rem] shrink-0 rounded-card object-cover sm:h-32 sm:w-24"
          loading="eager"
          fetchpriority="high"
        />
      )}
      <div class="text-sm leading-relaxed text-muted">
        <p>{site.contact.address.street}</p>
        <p>{site.contact.address.postalCode} {site.contact.address.city}</p>
        <p class="mt-3">
          <a href={tel()} class="text-fg underline-offset-4 hover:underline">{site.contact.phoneDisplay}</a>
        </p>
      </div>
    </div>
  </div>
</section>
