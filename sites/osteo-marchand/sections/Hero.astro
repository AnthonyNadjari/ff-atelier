---
/**
 * Hero dessiné pour le cabinet Léa Marchand. Texte à gauche, photo en forme de galet à droite,
 * carte « rendez-vous » qui chevauche la photo, fond avec une tache douce. Rien de plein écran :
 * un cabinet, pas une affiche.
 */
import { site, tel } from '@/lib/site';
import Icon from '@/components/Icon.astro';
const hero = site.images.hero!;
---

<section id="hero" class="relative pt-16 pb-24 md:pt-24 md:pb-32">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true"><div class="absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-accent/10 blur-3xl"></div></div>
  <div class="container-ff grid items-center gap-14 lg:grid-cols-[1.05fr_1fr]">
    <div data-stagger="120">
      <p class="eyebrow">{site.business.trade} · {site.contact.address.city}</p>
      <h1 class="mt-6 text-display-lg" set:html={site.business.tagline} />
      <p class="mt-6 max-w-lg text-lg text-muted">{site.business.description.split(/\n/)[0]}</p>
      <ul class="mt-8 flex flex-wrap gap-2">
        {site.services.map((s) => <li class="rounded-pill border border-line bg-surface px-4 py-1.5 text-sm">{s.title}</li>)}
      </ul>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href={tel()} class="btn btn-primary inline-flex items-center gap-2 rounded-pill bg-accent px-7 py-3.5 font-medium text-on-accent"><Icon name="Phone" size={18} />{site.contact.phoneDisplay}</a>
        <a href="#seance" class="text-muted underline-offset-4 hover:underline">Comment se passe une séance&nbsp;?</a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-none" data-reveal="scale">
      <div class="overflow-hidden" style="border-radius: 58% 42% 46% 54% / 52% 44% 56% 48%;">
        <img src={hero.src} alt={hero.alt} class="aspect-[4/5] w-full object-cover" loading="eager" fetchpriority="high" />
      </div>
      <div class="card absolute -bottom-6 left-2 w-64 rounded-card bg-surface p-5 shadow-lift md:-left-10" data-reveal="wipe" data-reveal-delay="500">
        <p class="eyebrow">Rendez-vous</p>
        <p class="mt-2 font-display text-2xl">45 minutes</p>
        <dl class="mt-3 space-y-1 text-sm text-muted">
          {site.contact.hours.slice(0, 2).map((h) => <div class="flex justify-between gap-3"><dt>{h.days}</dt><dd class="text-fg">{h.hours}</dd></div>)}
        </dl>
      </div>
    </div>
  </div>
</section>
