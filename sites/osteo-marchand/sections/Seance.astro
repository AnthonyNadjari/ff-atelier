---
/**
 * « Une séance, 45 minutes » : frise horizontale à quatre temps reliés par un trait, minutes en
 * marge, puis un encart pratique (durée, moyens de paiement, facture). Composition propre à ce site.
 */
import { site } from '@/lib/site';
const etapes = [
  { min: '0–10 min', titre: 'On parle', texte: 'Ce qui vous amène, depuis quand, ce qui soulage ou aggrave. Vos examens si vous en avez.' },
  { min: '10–20 min', titre: 'On regarde', texte: 'Posture, mobilité, tests simples. Léa explique ce qu’elle cherche pendant qu’elle le fait.' },
  { min: '20–40 min', titre: 'On traite', texte: 'Techniques douces, articulaires ou tissulaires, adaptées à l’âge et à la situation.' },
  { min: '40–45 min', titre: 'On conclut', texte: 'Ce qui a été fait, ce que vous pouvez faire chez vous, et si une autre séance est utile.' },
];
---

<section id="seance" class="section-y">
  <div class="container-ff">
    <div class="section-heading mx-auto max-w-2xl text-center">
      <p class="eyebrow">La séance</p>
      <h2 class="mt-4 text-display-md">Quarante-cinq minutes, <em>quatre temps</em></h2>
    </div>

    <ol class="relative mt-16 grid gap-10 md:grid-cols-4 md:gap-6" data-stagger="140">
      <span class="absolute left-0 right-0 top-3 hidden h-px bg-accent/50 md:block" aria-hidden="true" data-draw></span>
      {etapes.map((e) => (
        <li class="relative md:pt-10">
          <span class="absolute left-0 top-0 hidden h-6 w-6 rounded-full border-2 border-accent bg-bg md:block" aria-hidden="true"></span>
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-accent">{e.min}</p>
          <h3 class="mt-2 text-display-sm">{e.titre}</h3>
          <p class="mt-2 text-muted">{e.texte}</p>
        </li>
      ))}
    </ol>

    <div class="card mx-auto mt-16 grid max-w-3xl gap-6 rounded-card bg-surface p-8 shadow-card sm:grid-cols-3">
      <div><p class="eyebrow">Durée</p><p class="mt-2 font-display text-2xl">45 min</p></div>
      <div><p class="eyebrow">Règlement</p><p class="mt-2">Carte, espèces, chèque</p></div>
      <div><p class="eyebrow">Mutuelle</p><p class="mt-2">Facture fournie à chaque séance</p></div>
    </div>
    <p class="mt-6 text-center text-sm text-muted">{site.contact.hours.map((h) => `${h.days} : ${h.hours}`).join(' · ')}</p>
  </div>
</section>
