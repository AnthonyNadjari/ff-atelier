---
/**
 * Premier écran « l'instruction » — propre à la Clinique vétérinaire du Drac.
 * Idée : quand on s'inquiète pour un animal, on n'a pas besoin d'un argumentaire mais d'un ordre de
 * marche. Le titre situe la clinique, puis une seule consigne occupe l'écran, suivie du numéro.
 * Ni eyebrow, ni sous-titre, ni bouton, ni décor abstrait : une phrase, un geste à faire.
 */
import { site, tel } from '@/lib/site';

const consigne = site.process[1] ?? site.process[0];
---

<section id="hero" class="bg-bg">
  <div class="container-ff flex min-h-[80svh] flex-col justify-center gap-12 pb-16 pt-32 md:pt-40">
    <h1
      class="max-w-2xl text-display-sm leading-snug text-fg"
      data-reveal
      set:html={site.business.tagline}
    />

    {consigne && (
      <p
        class="max-w-4xl font-display leading-[1.04] text-fg"
        style="font-size: clamp(2rem, 7vw, 5rem);"
      >{consigne.title}</p>
    )}

    <p class="flex flex-wrap items-baseline gap-x-6 gap-y-2">
      <a href={tel()} class="font-display text-2xl text-fg underline-offset-4 hover:underline">
        {site.contact.phoneDisplay}
      </a>
      <span class="text-muted">{site.contact.address.street}, {site.contact.address.city}</span>
    </p>
  </div>
</section>
